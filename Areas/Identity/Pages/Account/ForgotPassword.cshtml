@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Zaboravljena lozinka";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0"><i class="fas fa-unlock-alt me-2"></i> Zaboravili ste lozinku?</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4 text-center">
                        Unesite svoju email adresu kako bismo vam poslali link za resetovanje lozinke.
                    </p>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email adresa</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">
                            <i class="fas fa-envelope"></i> Pošalji link za reset lozinke
                        </button>
                    </form>
                    <div class="mt-4 text-center">
                        <a asp-page="./Login" class="btn btn-link">
                            <i class="fas fa-arrow-left"></i> Povratak na prijavu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
