@page
@model LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <form id="account" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ime@primjer.com" />
                            <label asp-for="Input.Email" class="form-label">Email adresa</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" placeholder="Lozinka" />
                            <label asp-for="Input.Password" class="form-label">Lozinka</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheckbox" />
                            <label asp-for="Input.RememberMe" class="form-check-label" for="rememberMeCheckbox">
                                Zapamti me
                            </label>
                        </div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                            <i class="fas fa-sign-in-alt"></i> Prijavi se
                        </button>
                        <div class="mt-3 d-flex flex-column gap-2 text-center">
                            <a id="forgot-password" asp-page="./ForgotPassword" class="small">Zaboravili ste lozinku?</a>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="small">Ponovo pošalji email potvrdu</a>
                            @* Registracija je dostupna samo Studentskoj službi – automatski prikaži ako je ulogiran *@
                            @if (User.IsInRole("Studentska služba"))
                            {
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small">Registruj novog korisnika</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
