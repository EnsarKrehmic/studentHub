@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <h2>Prijavite se na vaš nalog</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ime@primjer.com" />
                    <label asp-for="Input.Email" class="form-label">Email adresa</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" placeholder="Lozinka" />
                    <label asp-for="Input.Password" class="form-label">Lozinka</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheckbox" />
                    <label asp-for="Input.RememberMe" class="form-check-label" for="rememberMeCheckbox">
                        Zapamti me
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Prijavi se</button>
                </div>
                <div class="mt-3">
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">Zaboravili ste lozinku?</a>
                    </p>
                    @if (User.IsInRole("Studentska služba"))
                    {
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registruj novog korisnika</a>
                        </p>
                    }
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Ponovo pošalji email potvrdu</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
