@page
@model LogoutModel
@{
    ViewData["Title"] = "Odjava";
}

<header>
    <h1>@ViewData["Title"]</h1>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="btn btn-danger">Kliknite ovdje za odjavu</button>
        </form>
    }
    else
    {
        <p>Uspješno ste se odjavili iz aplikacije.</p>
        <a class="btn btn-primary" asp-area="" asp-page="/Account/Login">Prijavite se ponovo</a>
    }
</header>
