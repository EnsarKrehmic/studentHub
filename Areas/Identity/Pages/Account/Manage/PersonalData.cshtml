@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Osobni podaci";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>Vaš račun sadrži osobne podatke koje ste nam dali. Ova stranica vam omogućava da preuzmete ili obrišete te podatke.</p>
        <p>
            <strong>Brisanje ovih podataka trajno će ukloniti vaš račun, i to neće biti moguće oporaviti.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Preuzmite podatke</button>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Obrišite podatke</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
