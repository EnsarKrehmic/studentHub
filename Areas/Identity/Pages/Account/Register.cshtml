@page
@model RegisterModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">

                    @if (!User.IsInRole("Studentska služba"))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-ban"></i> <strong>Pristup odbijen!</strong> Samo korisnici iz Studentske službe mogu registrovati nove korisnike.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-4" role="alert">
                            <h5><i class="fas fa-info-circle"></i> Administracija korisnika</h5>
                            <p>
                                <b>Preporučujemo</b> kreiranje novih korisnika putem sekcija: <a href="/Studenti" class="fw-bold">Studenti</a>,
                                <a href="/Profesori" class="fw-bold">Profesori</a>, <a href="/Asistenti" class="fw-bold">Asistenti</a>, <a href="/StudentskaSluzba" class="fw-bold">Studentska služba</a>.
                            </p>
                            <p>
                                <small>Kreirajte korisnike samo ako nije moguće koristiti standardni način ili je potrebna posebna registracija.</small>
                            </p>
                        </div>
                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ime@primjer.com" />
                                <label asp-for="Input.Email">Email adresa</label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" placeholder="Lozinka" />
                                <label asp-for="Input.Password">Lozinka</label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Ponovite lozinku" />
                                <label asp-for="Input.ConfirmPassword">Potvrda lozinke</label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
                                <i class="fas fa-user-plus"></i> Kreiraj korisnika
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
