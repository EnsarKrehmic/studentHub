@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Potvrda registracije";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-8">
            <div class="card shadow-lg text-center">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    @if (Model.DisplayConfirmAccountLink)
                    {
                        <div class="alert alert-info mt-2">
                            <i class="fas fa-envelope"></i> <b>Email server nije podešen:</b><br />
                            Ova aplikacija trenutno nema registrovan pravi email server. <br />
                            Pogledajte <a href="https://aka.ms/aspaccountconf" target="_blank">ovu dokumentaciju</a> kako konfigurirati email server.<br>
                            Normalno, link za potvrdu bi bio poslan na email.<br>
                            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="fw-bold">Kliknite ovdje da potvrdite svoj račun</a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mt-2">
                            <i class="fas fa-check-circle"></i> Molimo vas da provjerite svoj email kako biste potvrdili svoj račun.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
