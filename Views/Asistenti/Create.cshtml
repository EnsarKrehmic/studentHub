@model StudentHub.ViewModels.AsistentCreateViewModel
@{
    ViewData["Title"] = "Dodaj novog asistenta";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <h5 class="mb-3 mt-2">Prijava</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Unesite e-mail adresu" />
                                <small class="form-text text-muted">Unesite službenu e-mail adresu asistenta.</small>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Unesite lozinku" autocomplete="new-password" />
                                <small class="form-text text-muted">Lozinka mora imati najmanje 6 karaktera.</small>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Ponovite lozinku" autocomplete="new-password" />
                                <small class="form-text text-muted">Ponovite istu lozinku radi potvrde.</small>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3">Podaci o asistentu</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="JMBG" class="form-label"></label>
                                <input asp-for="JMBG" class="form-control" placeholder="Unesite JMBG" maxlength="13" />
                                <small class="form-text text-muted">Unesite tačno 13 cifara.</small>
                                <span asp-validation-for="JMBG" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Ime" class="form-label"></label>
                                <input asp-for="Ime" class="form-control" placeholder="Unesite ime" />
                                <span asp-validation-for="Ime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Prezime" class="form-label"></label>
                                <input asp-for="Prezime" class="form-control" placeholder="Unesite prezime" />
                                <span asp-validation-for="Prezime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AsistentTitula" class="form-label"></label>
                                <input asp-for="AsistentTitula" class="form-control" placeholder="Npr. mr., dr., viši asistent..." />
                                <small class="form-text text-muted">Unesite punu akademsku titulu.</small>
                                <span asp-validation-for="AsistentTitula" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudijskiProgramIds" class="form-label"></label>
                                <select asp-for="StudijskiProgramIds" class="form-control" asp-items="ViewBag.StudijskiProgrami" id="StudijskiProgramIds" multiple></select>
                                <small class="form-text text-muted">Držite <kbd>Ctrl</kbd> ili <kbd>Cmd</kbd> za višestruki odabir.</small>
                                <span asp-validation-for="StudijskiProgramIds" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PredmetIds" class="form-label"></label>
                                <select asp-for="PredmetIds" class="form-control" asp-items="ViewBag.Predmeti" id="PredmetIds" multiple></select>
                                <small class="form-text text-muted">Predmeti na kojima asistent učestvuje.</small>
                                <span asp-validation-for="PredmetIds" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4">Dodaj asistenta</button>
                            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const ddlProg = document.getElementById('StudijskiProgramIds');
            const ddlPred = document.getElementById('PredmetIds');

            function loadPredmeti() {
                const selectedProgramIds = Array.from(ddlProg.selectedOptions).map(o => o.value);
                fetch('/Asistenti/GetPredmetiByStudijskiProgram', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(selectedProgramIds)
                })
                .then(r => r.json())
                .then(data => {
                    ddlPred.innerHTML = '';
                    data.forEach(p => ddlPred.add(new Option(p.naziv, p.id)));
                });
            }

            ddlProg?.addEventListener('change', loadPredmeti);
            if (ddlProg && ddlProg.selectedOptions.length) loadPredmeti();
        })();
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
