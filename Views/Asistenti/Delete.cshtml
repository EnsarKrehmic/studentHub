@model StudentHub.Models.Asistent
@{
    ViewData["Title"] = "Brisanje asistenta";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovog asistenta?";
    ViewData["WarningDetails"] = "Ova akcija je <span class='fw-bold text-danger'>nepovratna</span> i trajno će ukloniti sve podatke o asistentu.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Ime"] = Model.Ime,
        ["Prezime"] = Model.Prezime,
        ["JMBG"] = Model.JMBG,
        ["Email"] = Model.Email,
        ["Titula"] = Model.AsistentTitula,
        ["Uloga"] = Model.Uloga
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
