@model StudentHub.ViewModels.AsistentEditViewModel
@{
    ViewData["Title"] = "Izmijeni asistenta";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <h5 class="mb-3">Prijava</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Unesite e-mail adresu" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="ChangePassword" id="chkChangePassword" />
                                    <label class="form-check-label" for="chkChangePassword">Želim promijeniti lozinku</label>
                                </div>
                            </div>
                            <div id="passwordFields" class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="NewPassword" class="form-label"></label>
                                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmNewPassword" class="form-label"></label>
                                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <small class="form-text text-muted">
                                        Ako ne želiš mijenjati lozinku, ostavi polja na
                                        <code>@StudentHub.ViewModels.AsistentEditViewModel.PasswordSentinel</code>.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <h5 class="mb-3">Podaci o asistentu</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Ime" class="form-label"></label>
                                <input asp-for="Ime" class="form-control" placeholder="Unesite ime" />
                                <span asp-validation-for="Ime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Prezime" class="form-label"></label>
                                <input asp-for="Prezime" class="form-control" placeholder="Unesite prezime" />
                                <span asp-validation-for="Prezime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JMBG" class="form-label"></label>
                                <input asp-for="JMBG" class="form-control" placeholder="Unesite JMBG" maxlength="13" />
                                <small class="form-text text-muted">Unesite tačno 13 cifara.</small>
                                <span asp-validation-for="JMBG" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AsistentTitula" class="form-label"></label>
                                <input asp-for="AsistentTitula" class="form-control" placeholder="Npr. mr., dr., viši asistent..." />
                                <small class="form-text text-muted">Unesite punu akademsku titulu.</small>
                                <span asp-validation-for="AsistentTitula" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Uloga" class="form-label"></label>
                                <select asp-for="Uloga" class="form-control" asp-items="Html.GetEnumSelectList<Uloga>()"></select>
                                <span asp-validation-for="Uloga" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudijskiProgramIds" class="form-label"></label>
                                <select asp-for="StudijskiProgramIds" class="form-control" asp-items="ViewBag.StudijskiProgrami" id="StudijskiProgramIds" multiple></select>
                                <small class="form-text text-muted">Držite <kbd>Ctrl</kbd> ili <kbd>Cmd</kbd> za višestruki odabir.</small>
                                <span asp-validation-for="StudijskiProgramIds" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="PredmetIds" class="form-label"></label>
                                <select asp-for="PredmetIds" class="form-control" asp-items="ViewBag.Predmeti" id="PredmetIds" multiple></select>
                                <small class="form-text text-muted">Predmeti na kojima asistent učestvuje.</small>
                                <span asp-validation-for="PredmetIds" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4">Sačuvaj promjene</button>
                            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // toggle password
            const chk = document.getElementById('chkChangePassword');
            const fields = document.getElementById('passwordFields');
            function toggle() {
                const enable = chk.checked;
                fields.querySelectorAll('input[type="password"]').forEach(i => i.readOnly = !enable);
                fields.style.opacity = enable ? '1' : '0.6';
            }
            if (chk) { toggle(); chk.addEventListener('change', toggle); }

            // predmeti po SP + očuvanje selekcije
            const ddlProg = document.getElementById('StudijskiProgramIds');
            const ddlPred = document.getElementById('PredmetIds');

            function loadPredmeti(preserveSelection) {
                const selectedProgramIds = Array.from(ddlProg.selectedOptions).map(o => o.value);
                fetch('/Asistenti/GetPredmetiByStudijskiProgram', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(selectedProgramIds)
                })
                .then(r => r.json())
                .then(data => {
                    const prevSel = new Set(Array.from(ddlPred.selectedOptions).map(o => o.value));
                    ddlPred.innerHTML = '';
                    data.forEach(p => {
                        const opt = new Option(p.naziv, p.id);
                        if (preserveSelection && prevSel.has(String(p.id))) opt.selected = true;
                        ddlPred.add(opt);
                    });
                });
            }

            ddlProg?.addEventListener('change', () => loadPredmeti(true));
            if (ddlProg) loadPredmeti(true);
        })();
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
