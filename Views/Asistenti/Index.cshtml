@model IEnumerable<StudentHub.Models.Asistent>
@{
    ViewData["Title"] = "Lista svih asistenata na fakultetu";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    @if (User.IsInRole("Studentska služba"))
    {
        <a class="btn btn-success shadow-sm" asp-controller="Asistenti" asp-action="Create">
            <i class="fas fa-user-plus"></i> Dodaj asistenta
        </a>
    }
</div>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="searchString" class="form-control" placeholder="Pretraga po imenu/prezimenu asistenta..." value="@Context.Request.Query["searchString"]">
        </div>
        <div class="col-md-4">
            <select name="studijskiProgramId" class="form-control">
                <option value="">Svi studijski programi</option>
                @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                {
                    <option value="@program.Value" selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">@program.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <button type="submit" class="btn btn-primary me-2">Filtriraj</button>
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                                Ime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["SurnameSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                                Prezime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Asistent"))
                        {
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewData["JMBGSortParm"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                                    JMBG <i class="fas fa-sort"></i>
                                </a>
                            </th>
                        }
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["EmailSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                                Email <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["TitulaSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                                Titula <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                        {
                            <th class="text-center">Akcije</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                            <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                            @if (User.IsInRole("Studentska služba") || User.IsInRole("Asistent"))
                            {
                                <td>@Html.DisplayFor(modelItem => item.JMBG)</td>
                            }
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td>@Html.DisplayFor(modelItem => item.AsistentTitula)</td>
                            <td class="text-center">
                                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Detalji">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                }
                                @if (User.IsInRole("Studentska služba"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="Izmjena">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Brisanje">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Index" asp-controller="Home" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
</a>
