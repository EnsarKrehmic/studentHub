@model IEnumerable<StudentHub.Models.Asistent>

@{
    ViewData["Title"] = "Lista asistenata";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Ime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Prezime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().JMBG)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Email)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Titula)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                <td>@Html.DisplayFor(modelItem => item.JMBG)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Titula)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.JMBG">Detalji</a> |
                    <a asp-action="Edit" asp-route-id="@item.JMBG">Izmjena</a> |
                    <a asp-action="Delete" asp-route-id="@item.JMBG">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>