@model IEnumerable<StudentHub.Models.Asistent>
@{
    ViewData["Title"] = "Lista svih asistenata na fakultetu";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-controller="Asistenti" asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-user-plus me-2"></i> Dodaj asistenta
            </a>
        }
    </div>

    <form method="get" class="card card-body shadow-sm mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text"
                       name="searchString"
                       class="form-control"
                       placeholder="Pretraga po imenu/prezimenu asistenta..."
                       value="@Context.Request.Query["searchString"]" />
            </div>
            <div class="col-md-4">
                <select name="studijskiProgramId"
                        class="form-select"
                        onchange="this.form.submit()">
                    <option value="">Svi studijski programi</option>
                    @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                    {
                        <option value="@program.Value"
                                selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">
                            @program.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Filtriraj
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-undo"></i> Reset
                </a>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["NameSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]"
                               class="text-decoration-none text-white">
                                Ime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["SurnameSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]"
                               class="text-decoration-none text-white">
                                Prezime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Asistent"))
                        {
                            <th class="no-wrap">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["JMBGSortParm"]"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]"
                                   class="text-decoration-none text-white">
                                    JMBG <i class="fas fa-sort"></i>
                                </a>
                            </th>
                        }
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["EmailSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]"
                               class="text-decoration-none text-white">
                                Email <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["TitulaSortParm"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]"
                               class="text-decoration-none text-white">
                                Titula <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                        {
                            <th class="text-center no-wrap">Akcije</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="no-wrap">@item.Ime</td>
                            <td class="no-wrap">@item.Prezime</td>
                            @if (User.IsInRole("Studentska služba") || User.IsInRole("Asistent"))
                            {
                                <td class="no-wrap">@item.JMBG</td>
                            }
                            <td class="no-wrap">@item.Email</td>
                            <td class="no-wrap">@item.AsistentTitula</td>
                            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                            {
                                <td class="text-center no-wrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Detalji">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Studentska služba"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Izmjena">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Brisanje">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index"
           asp-controller="Home"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Povratak na početnu stranici
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Dodatno osiguranje no-wrap na linkovima:
        document.querySelectorAll('thead a.text-decoration-none').forEach(a => {
            a.classList.add('no-wrap');
        });
    </script>
}
