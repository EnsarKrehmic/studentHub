@model StudentHub.Models.BugReport
@{
    ViewData["Title"] = "Brisanje prijave";
}

<h2>@ViewData["Title"]</h2>
<hr />
<p>Da li ste sigurni da želite obrisati ovu prijavu?</p>
<dl class="row">
    <dt class="col-sm-3">Tip prijave:</dt>
    <dd class="col-sm-9">@((Model.Tip == BugTip.Bug) ? "Greška" : "Prijedlog")</dd>
    <dt class="col-sm-3">Naslov:</dt>
    <dd class="col-sm-9">@Model.Naslov</dd>
    <dt class="col-sm-3">Opis:</dt>
    <dd class="col-sm-9">@Model.Opis</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
