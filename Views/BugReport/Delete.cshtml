@model StudentHub.Models.BugReport
@{
    ViewData["Title"] = "Brisanje prijave";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovu prijavu?";
    ViewData["WarningDetails"] = null;
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Tip prijave"] = Model.Tip == BugTip.Bug ? "Bug" : "Suggestion",
        ["Naslov"] = Model.Naslov,
        ["Opis"] = Model.Opis
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
