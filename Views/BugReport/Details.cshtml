@model StudentHub.Models.BugReport
@using StudentHub.Models
@{
    ViewData["Title"] = "Detalji prijave";
    bool isSluzba = User.IsInRole("Studentska služba");
    var aspNetUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container my-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-bug me-2"></i>@ViewData["Title"]
            </h5>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-4">Tip prijave</dt>
                <dd class="col-sm-8">
                    @if (Model.Tip == BugTip.Bug)
                    {
                        <span class="badge bg-danger">Greška u radu sistema</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">Prijedlog za poboljšanje</span>
                    }
                </dd>

                <dt class="col-sm-4">Naslov</dt>
                <dd class="col-sm-8">@Model.Naslov</dd>

                <dt class="col-sm-4">Opis</dt>
                <dd class="col-sm-8">@Model.Opis</dd>

                <dt class="col-sm-4">Datum prijave</dt>
                <dd class="col-sm-8">@Model.DatumPrijave</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @switch (Model.Status)
                    {
                        case BugStatus.Podnesen:
                            <span class="badge bg-warning text-dark">Podnesen</span>
                            ;
                            break;
                        case BugStatus.UObradi:
                            <span class="badge bg-info text-dark">U obradi</span>
                            ;
                            break;
                        case BugStatus.Zatvoren:
                            <span class="badge bg-success">Zatvoren</span>
                            ;
                            break;
                    }
                </dd>

                <dt class="col-sm-4">Prijavio/la</dt>
                <dd class="col-sm-8">@($"{Model.Korisnik?.Ime} {Model.Korisnik?.Prezime}")</dd>

                @if (!string.IsNullOrEmpty(Model.Slika))
                {
                    <dt class="col-sm-4">Screenshot</dt>
                    <dd class="col-sm-8">
                        <img src="~/uploads/bugreport/@Model.Slika"
                             class="img-fluid border rounded shadow-sm"
                             style="max-width:350px; max-height:180px;" />
                    </dd>
                }

                @if (!string.IsNullOrEmpty(Model.Odgovor))
                {
                    <dt class="col-sm-4 text-success">Odgovor službe</dt>
                    <dd class="col-sm-8 text-success">@Model.Odgovor</dd>

                    <dt class="col-sm-4">Datum odgovora</dt>
                    <dd class="col-sm-8">@Model.DatumOdgovora:dd.MM.yyyy HH:mm</dd>
                }
            </dl>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Nazad
                </a>

                <!-- Autor može uređivati i brisati dok je Podnesen -->
                @if (!isSluzba
                                && Model.Korisnik.AspNetUserId == aspNetUserId
                                && Model.Status == BugStatus.Podnesen)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Uredi
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Obriši
                    </a>
                }

                <!-- Staff akcije -->
                @if (isSluzba && Model.Status == BugStatus.Podnesen)
                {
                    <form asp-action="PostaviUObradi"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-hourglass-half me-1"></i> U obradi
                        </button>
                    </form>
                }
                @if (isSluzba && Model.Status == BugStatus.UObradi)
                {
                    <a asp-action="Odgovori"
                       asp-route-id="@Model.Id"
                       class="btn btn-secondary">
                        <i class="fas fa-reply me-1"></i> Odgovori
                    </a>
                }
                @if (isSluzba && Model.Status == BugStatus.Zatvoren)
                {
                    <a asp-action="EditOdgovor"
                       asp-route-id="@Model.Id"
                       class="btn btn-info">
                        <i class="fas fa-edit me-1"></i> Uredi odgovor
                    </a>
                }
            </div>
        </div>
    </div>
</div>
