@model StudentHub.Models.BugReport
@{
    ViewData["Title"] = "Uredi prijavu";
}
<h2>@ViewData["Title"]</h2>
<hr />
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Tip" class="form-label">Tip prijave</label>
        <select asp-for="Tip" class="form-select">
            <option value="1" selected="@(Model.Tip == BugTip.Bug)">Greška u radu sistema</option>
            <option value="2" selected="@(Model.Tip == BugTip.Suggestion)">Prijedlog za poboljšanje</option>
        </select>
        <span asp-validation-for="Tip" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Naslov" class="form-label">Naslov (opcionalno)</label>
        <input asp-for="Naslov" class="form-control" />
        <span asp-validation-for="Naslov" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Opis" class="form-label"></label>
        <textarea asp-for="Opis" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Slika))
    {
        <div class="mb-3">
            <label class="form-label">Trenutna slika:</label><br />
            <img src="~/uploads/bugreport/@Model.Slika" style="max-width:250px;max-height:150px;" class="mb-2" />
        </div>
    }
    <div class="mb-3">
        <label for="slika" class="form-label">Zamijeni ili dodaj novu sliku (opcionalno)</label>
        <input type="file" name="slika" id="slika" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-success">Sačuvaj</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Nazad</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
