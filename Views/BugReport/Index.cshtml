@model IEnumerable<StudentHub.Models.BugReport>
@using StudentHub.Models
@{
    ViewData["Title"] = "Prijave grešaka i prijedloga";
    var aspNetUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isSluzba = User.IsInRole("Studentska služba");
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="tip" class="form-select">
            <option value="">Svi tipovi</option>
            @{
                var selectedTip = Context.Request.Query["tip"];
            }
            <option value="Bug" selected="@(selectedTip == "Bug" ? "selected" : null)">Greška u radu sistema</option>
            <option value="Suggestion" selected="@(selectedTip == "Suggestion" ? "selected" : null)">Prijedlog za poboljšanje</option>
        </select>
    </div>
    <div class="col-md-4">
        <select name="status" class="form-select">
            <option value="">Svi statusi</option>
            @{
                var selectedStatus = Context.Request.Query["status"];
            }
            <option value="Podnesen" selected="@(selectedStatus == "Podnesen" ? "selected" : null)">Podnesen</option>
            <option value="UObradi" selected="@(selectedStatus == "UObradi" ? "selected" : null)">U obradi</option>
            <option value="Zatvoren" selected="@(selectedStatus == "Zatvoren" ? "selected" : null)">Zatvoren</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <button type="submit" class="btn btn-primary me-2"><i class="fas fa-filter me-1"></i> Filtriraj</button>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-undo me-1"></i> Reset</a>
    </div>
</form>

<div class="d-flex justify-content-end mb-3">
    <!-- SADA: svi prijavljeni vide ovo -->
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> Nova prijava
    </a>
</div>

<div class="table-responsive shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Korisnik</th>
                <th>Naslov</th>
                <th>Tip</th>
                <th>Datum</th>
                <th>Status</th>
                <th class="text-center">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prijava in Model)
            {
                <tr>
                    <td>@($"{prijava.Korisnik?.Ime} {prijava.Korisnik?.Prezime}")</td>
                    <td>@prijava.Naslov</td>
                    <td>
                        @if (prijava.Tip == BugTip.Bug)
                        {
                            <span class="badge bg-danger">Greška</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">Prijedlog</span>
                        }
                    </td>
                    <td>@prijava.DatumPrijave</td>
                    <td>
                        @switch (prijava.Status)
                        {
                            case BugStatus.Podnesen:
                                <span class="badge bg-warning text-dark">Podnesen</span>
                                ;
                                break;
                            case BugStatus.UObradi:
                                <span class="badge bg-info text-dark">U obradi</span>
                                ;
                                break;
                            case BugStatus.Zatvoren:
                                <span class="badge bg-success">Zatvoren</span>
                                ;
                                break;
                        }
                    </td>
                    <td class="text-center">
                        <!-- Svi mogu vidjeti detalje -->
                        <a asp-action="Details"
                           asp-route-id="@prijava.Id"
                           class="btn btn-sm btn-outline-primary me-1"
                           title="Detalji">
                            <i class="fas fa-eye"></i>
                        </a>

                        <!-- Autor može uređivati i brisati dok je Podnesen -->
                        @if (!isSluzba
                                            && prijava.Korisnik.AspNetUserId == aspNetUserId
                                            && prijava.Status == BugStatus.Podnesen)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@prijava.Id"
                               class="btn btn-sm btn-outline-warning me-1"
                               title="Uredi">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@prijava.Id"
                               class="btn btn-sm btn-outline-danger me-1"
                               title="Obriši">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }

                        <!-- Staff opcije -->
                        @if (isSluzba)
                        {
                            @if (prijava.Status == BugStatus.UObradi)
                            {
                                <a asp-action="Odgovori"
                                   asp-route-id="@prijava.Id"
                                   class="btn btn-sm btn-outline-secondary me-1"
                                   title="Odgovori">
                                    <i class="fas fa-reply"></i>
                                </a>
                            }
                            else if (prijava.Status == BugStatus.Zatvoren)
                            {
                                <a asp-action="EditOdgovor"
                                   asp-route-id="@prijava.Id"
                                   class="btn btn-sm btn-outline-info me-1"
                                   title="Uredi odgovor">
                                    <i class="fas fa-edit"></i>
                                </a>
                            }
                            <a asp-action="Delete"
                               asp-route-id="@prijava.Id"
                               class="btn btn-sm btn-outline-danger"
                               title="Obriši">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
    </a>
</div>
