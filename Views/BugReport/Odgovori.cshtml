@model StudentHub.Models.BugReport
@{
    var isEdit = !string.IsNullOrEmpty(Model.Odgovor);
    ViewData["Title"] = isEdit
        ? "Uredi odgovor na prijavu"
        : "Odgovori na prijavu";
}

<div class="card shadow-sm mx-auto my-5" style="max-width: 560px;">
    <div class="card-body">
        <h2 class="card-title text-center">@ViewData["Title"]</h2>
        <hr />

        <div class="mb-4">
            <strong>Tip prijave:</strong> @(Model.Tip == BugTip.Bug ? "Greška" : "Prijedlog")<br />
            <strong>Naslov:</strong> @Model.Naslov<br />
            <strong>Opis:</strong> @Model.Opis<br />
            <strong>Prijavio/la:</strong> @($"{Model.Korisnik?.Ime} {Model.Korisnik?.Prezime}")<br />
            <strong>Datum prijave:</strong> @Model.DatumPrijave.ToString("dd.MM.yyyy HH:mm")
            @if (!string.IsNullOrEmpty(Model.Slika))
            {
                <div class="mt-3 text-center">
                    <strong>Slika/Screenshot:</strong><br />
                    <img src="~/uploads/bugreport/@Model.Slika"
                         class="img-fluid border rounded shadow-sm"
                         style="max-width:100%; max-height:300px;"
                         alt="screenshot" />
                </div>
            }
        </div>

        <form asp-action="@(isEdit ? "EditOdgovor" : "Odgovori")" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Odgovor" class="form-label fw-bold">
                    @(isEdit ? "Uredi odgovor" : "Odgovor službe") <span class="text-danger">*</span>
                </label>
                <textarea asp-for="Odgovor"
                          class="form-control"
                          rows="5"
                          placeholder="Unesite odgovor službe..."
                          required></textarea>
                <span asp-validation-for="Odgovor" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-paper-plane me-1"></i>
                    @(isEdit ? "Sačuvaj odgovor" : "Pošalji odgovor")
                </button>
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Nazad
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
