@model StudentHub.ViewModels.DokumentCreateViewModel

@{
    ViewData["Title"] = "Dodaj novi dokument";
}

<h2>@ViewData["Title"]</h2>

<h4>Dokument</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="Naziv" class="control-label"></label>
                <input asp-for="Naziv" class="form-control" />
                <span asp-validation-for="Naziv" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Slike" class="control-label">Dodaj slike</label>
                <input asp-for="Slike" type="file" class="form-control" multiple />
                <span asp-validation-for="Slike" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StudentId" class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.Studenti">
                    <option value="">-- Izaberite Studenta --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StudentskaSluzbaId" class="control-label">Studentska Služba</label>
                <select asp-for="StudentskaSluzbaId" class="form-control" asp-items="ViewBag.StudentskeSluzbe">
                    <option value="">-- Izaberite Studentsku Službu --</option>
                </select>
                <span asp-validation-for="StudentskaSluzbaId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Otkaži</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
