@model StudentHub.Models.Dokument

@{
    ViewData["Title"] = "Brisanje dokumenta";
}

<h2>@ViewData["Title"]</h2>

<h3>Da li ste sigurni da želite obrisati ovaj dokument?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Naziv)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Naziv)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Putanja)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Putanja)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.JMBG)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.StudentskaSluzba)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StudentskaSluzba.JMBG)</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button> |
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>