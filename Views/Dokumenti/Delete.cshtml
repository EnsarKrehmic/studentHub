@model StudentHub.Models.Dokument

@{
    ViewData["Title"] = "Brisanje dokumenta";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovaj dokument?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti sve podatke o dokumentu.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o dokumentu</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student:</dt>
            <dd class="col-sm-9">@Model.Student.Ime @Model.Student.Prezime</dd>

            <dt class="col-sm-3">Broj indeksa:</dt>
            <dd class="col-sm-9">@Model.Student.BrojIndeksa</dd>

            <dt class="col-sm-3">Naziv:</dt>
            <dd class="col-sm-9">@Model.Naziv</dd>

            <dt class="col-sm-3">Priložene slike</dt>
            <dd class="col-sm-9">
                @if (Model.Slike != null && Model.Slike.Any())
                {
                    <div class="d-flex flex-wrap">
                        @foreach (var slika in Model.Slike)
                        {
                            <a href="@Url.Content("~/uploads/" + slika.Putanja)" target="_blank">
                                <img src="@Url.Content("~/uploads/" + slika.Putanja)" alt="Slika" class="img-thumbnail me-2"
                                     style="width: 100px; height: 100px; object-fit: cover;">
                            </a>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">Nema priloženih slika</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>
