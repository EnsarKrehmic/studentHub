@model StudentHub.Models.Dokument
@{
    ViewData["Title"] = "Brisanje dokumenta";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj dokument?";
    ViewData["WarningDetails"] = "Ova akcija je <span class='fw-bold text-danger'>nepovratna</span> i trajno će ukloniti sve podatke o dokumentu.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Student"] = Model.Student.Ime + " " + Model.Student.Prezime,
        ["Broj indeksa"] = Model.Student.BrojIndeksa,
        ["Naziv"] = Model.Naziv,
        ["Broj slika"] = Model.Slike?.Count() ?? 0
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
