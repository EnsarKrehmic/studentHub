@model StudentHub.Models.Dokument

@{
    ViewData["Title"] = "Detalji dokumenta";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Podaci o dokumentu</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Naziv)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Naziv)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Putanja)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Putanja)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student.BrojIndeksa)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.BrojIndeksa)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student.Ime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.Ime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student.Prezime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.Prezime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.StudentskaSluzba.Ime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StudentskaSluzba.Ime)</dd>
    </dl>
</div>

<div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Izmjena</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>
