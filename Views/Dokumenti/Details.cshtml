@model StudentHub.Models.Dokument

@{
    ViewData["Title"] = "Detalji dokumenta";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Podaci o dokumentu</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Student:</dt>
                <dd class="col-sm-9">@Model.Student.Ime @Model.Student.Prezime</dd>

                <dt class="col-sm-3">Broj indeksa:</dt>
                <dd class="col-sm-9">@Model.Student.BrojIndeksa</dd>

                <dt class="col-sm-3">Studentska služba:</dt>
                <dd class="col-sm-9">@Model.StudentskaSluzba.Ime @Model.StudentskaSluzba.Prezime</dd>

                <dt class="col-sm-3">Naziv dokumenta:</dt>
                <dd class="col-sm-9">@Model.Naziv</dd>

                <dt class="col-sm-3 align-self-start">Priložene slike:</dt>
                <dd class="col-sm-9">
                    @if (Model.Slike != null && Model.Slike.Any())
                    {
                        <div class="d-flex flex-wrap">
                            @foreach (var slika in Model.Slike)
                            {
                                <a href="@Url.Content($"~/uploads/{slika.Putanja}")"
                                   target="_blank"
                                   class="me-2 mb-2">
                                    <img src="@Url.Content($"~/uploads/{slika.Putanja}")"
                                         alt="Slika"
                                         class="img-thumbnail"
                                         style="width:100px; height:100px; object-fit:cover;" />
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Nema priloženih slika</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Izmjena
            </a>
        }
        <a asp-action="Index"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na listu
        </a>
    </div>
</div>
