@model StudentHub.Models.Dokument

@{
    ViewData["Title"] = "Izmjena dokumenta";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit">
    <div class="form-group">
        <label asp-for="Naziv" class="control-label"></label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Putanja" class="control-label"></label>
        <input asp-for="Putanja" class="form-control" />
        <span asp-validation-for="Putanja" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StudentId" class="control-label"></label>
        <select asp-for="StudentId" class="form-control" asp-items="ViewBag.Studenti"></select>
        <span asp-validation-for="StudentId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Sačuvaj promjene" class="btn btn-primary mt-3" />
        <a asp-action="Index" class="btn btn-secondary mt-3">Odustani</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}