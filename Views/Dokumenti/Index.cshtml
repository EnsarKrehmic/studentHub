@model IEnumerable<StudentHub.ViewModels.DokumentGroupedByProgramViewModel>
@{
    ViewData["Title"] = "Dokumenti";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <h2 class="mb-0">
            <i class="fas fa-file-alt text-primary me-2"></i>
            @ViewData["Title"]
        </h2>
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-file-medical me-1"></i> Novi dokument
            </a>
        }
    </div>

    @if (User.IsInRole("Studentska služba"))
    {
        <form method="get" class="card card-body shadow-sm mb-4">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Pretraga po imenu/prezimenu..."
                           value="@Context.Request.Query["searchString"]" />
                </div>
                <div class="col-md-4">
                    <select name="studijskiProgramId" class="form-select">
                        <option value="">Svi studijski programi</option>
                        @foreach (var p in (SelectList)ViewBag.StudijskiProgrami)
                        {
                            <option value="@p.Value"
                                    selected="@(Context.Request.Query["studijskiProgramId"] == p.Value ? "selected" : null)">
                                @p.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i> Filtriraj
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-undo"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="no-wrap">Student</th>
                        <th class="no-wrap">Dokument</th>
                        <th class="no-wrap">Slike</th>
                        <th class="text-center no-wrap">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grp in Model)
                    {
                        @foreach (var dok in grp.Dokumenti)
                        {
                            <tr>
                                <td class="no-wrap">
                                    @dok.Student.Ime @dok.Student.Prezime
                                    <br /><small class="text-muted">(@dok.Student.BrojIndeksa)</small>
                                </td>
                                <td class="no-wrap">@dok.Naziv</td>
                                <td>
                                    @if (dok.Slike?.Any() == true)
                                    {
                                        <div class="d-flex flex-wrap">
                                            @foreach (var img in dok.Slike)
                                            {
                                                <img src="@Url.Content($"~/uploads/{img.Putanja}")"
                                                     class="img-thumbnail me-1 mb-1 preview-image"
                                                     style="width:50px;height:50px;cursor:pointer;"
                                                     data-bs-toggle="modal"
                                                     data-bs-target="#imageModal"
                                                     data-bs-src="@Url.Content($"~/uploads/{img.Putanja}")" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nema slika</span>
                                    }
                                </td>
                                <td class="text-center no-wrap">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@dok.Id"
                                           class="btn btn-sm btn-outline-primary" title="Detalji">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Studentska služba"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@dok.Id"
                                               class="btn btn-sm btn-outline-warning" title="Izmjena">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@dok.Id"
                                               class="btn btn-sm btn-outline-danger" title="Brisanje">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
        </a>
    </div>
</div>

<!-- Modal za prikaz slike -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pregled slike</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" alt="Slika" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
          const modalImage = document.getElementById("modalImage");
          document.querySelectorAll(".preview-image").forEach(img => {
            img.addEventListener("click", () => {
              modalImage.src = img.dataset.bsSrc;
            });
          });
        });
    </script>
}
