@model IEnumerable<StudentHub.Models.Dokument>

@{
    ViewData["Title"] = "Lista dokumenata";
}

<h2>@ViewData["Title"]</h2>

<p>
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Create" class="btn btn-primary">Kreiraj novi dokument</a>
    }
</p>

<table class="table table-bordered table-hover mt-3">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Naziv)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Putanja)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Student.BrojIndeksa)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Student.Ime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Student.Prezime)</th>
            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
            {
                <th>Akcije</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Naziv)</td>
                <td>@Html.DisplayFor(modelItem => item.Putanja)</td>
                <td>@Html.DisplayFor(modelItem => item.Student.BrojIndeksa)</td>
                <td>@Html.DisplayFor(modelItem => item.Student.Ime)</td>
                <td>@Html.DisplayFor(modelItem => item.Student.Prezime)</td>
                <td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                    }
                    @if (User.IsInRole("Studentska služba"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>