@model IEnumerable<StudentHub.ViewModels.DokumentGroupedByProgramViewModel>

@{
    ViewData["Title"] = "Dokumenti";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

@if (User.IsInRole("Studentska služba"))
{
    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" name="searchString" class="form-control" placeholder="Pretraga po imenu/prezimenu studenta..." value="@Context.Request.Query["searchString"]">
            </div>
            <div class="col-md-4">
                <select name="studijskiProgramId" class="form-control">
                    <option value="">Svi studijski programi</option>
                    @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                    {
                        <option value="@program.Value" selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">@program.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <button type="submit" class="btn btn-primary me-2">Filtriraj</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </div>
        </div>
    </form>
}

@if (User.IsInRole("Studentska služba"))
{
    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="fas fa-file-alt"></i> Kreiraj novi dokument
    </a>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Dokument</th>
                <th>Slike</th>
                <th class="text-center">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model)
            {
                @foreach (var dokument in group.Dokumenti)
                {
                    <tr>
                        <td>@dokument.Student?.Ime @dokument.Student?.Prezime (@dokument.Student?.BrojIndeksa)</td>
                        <td>@dokument.Naziv</td>
                        <td>
                            @if (dokument.Slike != null && dokument.Slike.Any())
                            {
                                <div class="d-flex">
                                    @foreach (var slika in dokument.Slike)
                                    {
                                        <img src="@Url.Content("~/uploads/" + slika.Putanja)"
                                             alt="Slika"
                                             class="img-thumbnail me-1 preview-image"
                                             style="width: 50px; height: 50px; cursor: pointer;"
                                             data-bs-toggle="modal"
                                             data-bs-target="#imageModal"
                                             data-bs-src="@Url.Content("~/uploads/" + slika.Putanja)">
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Nema slika</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@dokument.Id" class="btn btn-sm btn-info" title="Detalji">
                                <i class="fas fa-eye"></i>
                            </a>
                            @if (User.IsInRole("Studentska služba"))
                            {
                                <a asp-action="Edit" asp-route-id="@dokument.Id" class="btn btn-sm btn-warning" title="Izmjena">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@dokument.Id" class="btn btn-sm btn-danger" title="Brisanje">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
</a>

<!-- Modal za prikaz slike -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Pregled slike</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" alt="Slika">
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const imageModal = document.getElementById("imageModal");
        const modalImage = document.getElementById("modalImage");

        document.querySelectorAll(".preview-image").forEach(img => {
            img.addEventListener("click", function () {
                modalImage.src = this.getAttribute("data-bs-src");
            });
        });
    });
</script>
