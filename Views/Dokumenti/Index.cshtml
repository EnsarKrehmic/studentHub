@model IEnumerable<StudentHub.Models.Dokument>

@{
    ViewData["Title"] = "Lista dokumenata";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novi dokument</a>
</p>

<table class="table table-bordered table-hover mt-3">
    <thead>
        <tr>
            <th>Naziv</th>
            <th>Putanja</th>
            <th>Student</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Naziv</td>
                <td>@item.Putanja</td>
                <td>@item.Student.BrojIndeksa</td>
                <td>@item.Student.Ime</td>
                <td>@item.Student.Prezime</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>