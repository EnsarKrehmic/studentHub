@model StudentHub.Models.FaqPitanje

@{
    ViewData["Title"] = "Brisanje FAQ pitanja";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovo pitanje?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti pitanje iz FAQ baze.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o pitanju</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Kategorija:</dt>
            <dd class="col-sm-9">@Model.Kategorija</dd>
            <dt class="col-sm-3">Pitanje:</dt>
            <dd class="col-sm-9">@Model.Pitanje</dd>
            <dt class="col-sm-3">Odgovor:</dt>
            <dd class="col-sm-9">@Model.Odgovor</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>
