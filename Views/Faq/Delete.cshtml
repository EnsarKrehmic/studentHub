@model StudentHub.Models.FaqPitanje

@{
    ViewData["Title"] = "Brisanje FAQ pitanja";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovo pitanje?";
    ViewData["WarningDetails"] = "Ova akcija je <span class='fw-bold text-danger'>nepovratna</span> i trajno će ukloniti pitanje iz FAQ baze.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Kategorija"] = Model.Kategorija,
        ["Pitanje"] = Model.Pitanje,
        ["Odgovor"] = Model.Odgovor
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
