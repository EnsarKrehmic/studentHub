@model StudentHub.ViewModels.FaqPitanjeViewModel

@{
    ViewData["Title"] = "Izmjena FAQ pitanja";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Kategorija" class="form-label">Kategorija <span class="text-danger">*</span></label>
                            <select asp-for="Kategorija" class="form-select" id="KategorijaDropdown" required>
                                <option value="">-- Odaberite kategoriju --</option>
                                @foreach (var kat in Model.SveKategorije ?? Enumerable.Empty<string>())
                                {
                                    <option value="@kat" selected="@(Model.Kategorija == kat ? "selected" : null)">
                                        @kat
                                    </option>
                                }
                                <option value="__nova__">+ Nova kategorija...</option>
                            </select>
                            <input type="text"
                                   id="NovaKategorija"
                                   name="NovaKategorija"
                                   class="form-control mt-2"
                                   style="display:none;"
                                   placeholder="Unesite novu kategoriju..." />
                            <span asp-validation-for="Kategorija" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Pitanje" class="form-label">Pitanje <span class="text-danger">*</span></label>
                            <input asp-for="Pitanje"
                                   class="form-control"
                                   maxlength="300"
                                   placeholder="Unesite pitanje..." />
                            <span asp-validation-for="Pitanje" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Odgovor" class="form-label">Odgovor <span class="text-danger">*</span></label>
                            <textarea asp-for="Odgovor"
                                      class="form-control"
                                      rows="5"
                                      maxlength="2000"
                                      placeholder="Unesite odgovor..."></textarea>
                            <span asp-validation-for="Odgovor" class="text-danger"></span>
                        </div>

                        @if (User.IsInRole("Studentska služba"))
                        {
                            <div class="form-check mb-4">
                                <input asp-for="Preporuceno" class="form-check-input" type="checkbox" id="preporucenoFaq" />
                                <label asp-for="Preporuceno" class="form-check-label">
                                    Prikaži kao preporučeno pitanje
                                </label>
                            </div>
                        }

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Sačuvaj izmjene
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        var dropdown = document.getElementById('KategorijaDropdown');
        var nova = document.getElementById('NovaKategorija');

        dropdown.addEventListener('change', function () {
            if (this.value === '__nova__') {
                nova.style.display = '';
                nova.required = true;
            } else {
                nova.style.display = 'none';
                nova.required = false;
            }
        });

        document.querySelector('form').addEventListener('submit', function (e) {
            if (dropdown.value === '__nova__' && nova.value.trim()) {
                dropdown.value = nova.value.trim();
            }
        });
    </script>
}
