@model StudentHub.ViewModels.FaqPitanjeViewModel

@{
    ViewData["Title"] = "Izmjena FAQ pitanja";
}

<h2>@ViewData["Title"]</h2>

<hr />
<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit" method="post">
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="Kategorija" class="control-label"></label>
                <select asp-for="Kategorija" class="form-control" id="KategorijaDropdown" required>
                    <option value="">-- Odaberite kategoriju --</option>
                    @if (Model.SveKategorije != null)
                    {
                        foreach (var kat in Model.SveKategorije)
                        {
                            <option value="@kat" selected="@(Model.Kategorija == kat ? "selected" : null)">@kat</option>
                        }
                    }
                    <option value="__nova__">+ Nova kategorija...</option>
                </select>
                <input type="text" id="NovaKategorija" name="NovaKategorija" class="form-control mt-2" style="display:none;" placeholder="Unesite novu kategoriju..." />
                <span asp-validation-for="Kategorija" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Pitanje" class="control-label"></label>
                <input asp-for="Pitanje" class="form-control" maxlength="300" />
                <span asp-validation-for="Pitanje" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Odgovor" class="control-label"></label>
                <textarea asp-for="Odgovor" class="form-control" rows="5" maxlength="2000"></textarea>
                <span asp-validation-for="Odgovor" class="text-danger"></span>
            </div>
            @if (User.IsInRole("Studentska služba"))
            {
                <div class="form-check mb-3">
                    <input asp-for="Preporuceno" class="form-check-input" type="checkbox" id="preporucenoFaq" />
                    <label class="form-check-label" for="preporucenoFaq">Prikaži kao preporučeno pitanje</label>
                </div>
            }
            <div class="form-group mt-3">
                <input type="submit" value="Sačuvaj izmjene" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Odustani</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('KategorijaDropdown').addEventListener('change', function () {
            var nova = document.getElementById('NovaKategorija');
            if (this.value === '__nova__') {
                nova.style.display = '';
                nova.required = true;
            } else {
                nova.style.display = 'none';
                nova.required = false;
            }
        });

        document.querySelector('form').addEventListener('submit', function (e) {
            var dropdown = document.getElementById('KategorijaDropdown');
            var nova = document.getElementById('NovaKategorija');
            if (dropdown.value === '__nova__' && nova.value.trim() !== '') {
                dropdown.value = nova.value.trim();
            }
        });
    </script>
}
