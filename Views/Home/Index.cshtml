@model StudentHub.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Dobrodošli u StudentHub";
}

<div class="container">
    <div class="jumbotron text-center">
        <h1 class="display-4">Dobrodošli u StudentHub!</h1>
        <p class="lead">Vaš centralizovani sistem za upravljanje fakultetom.</p>
        <hr class="my-4" />
        <p>Pratite najnovije objave, podatke o korisnicima i još mnogo toga.</p>
    </div>

    <div class="row text-center mt-5">
        @foreach (var program in Model.StudijskiProgrami)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@program.Naziv</h5>
                        <p>Pogledajte više informacija o navedenom studijskom programu</p>
                        <a href="@Url.Action("Details", "StudijskiProgrami", new { id = program.Id })" class="btn btn-primary">Pogledaj detalje</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-5">
        <h2>Najnovije obavijesti</h2>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Naslov</th>
                    <th>Autor</th>
                    <th>Studijski program</th>
                    <th>Datum objave</th>
                    <th>Detalji</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obavijest in Model.NajnovijeObavijesti)
                {
                    <tr>
                        <td>@obavijest.Naslov</td>
                        <td>@obavijest.AutorIme</td>
                        <td>@string.Join(", ", obavijest.StudijskiProgramNazivi)</td>
                        <td>@obavijest.DatumObjave.ToShortDateString()</td>
                        <td>
                            <a href="@Url.Action("Details", "Obavjestenja", new { id = obavijest.Id })" class="btn btn-primary btn-sm">Pogledaj</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- YouTube video -->
    <div class="mt-5 text-center">
        <h2>Da li želite saznati više o nama?</h2>
        <p>U ovom videu možete doći do osnovnih informacija o ovom fakultetu.</p>
        <div class="embed-responsive embed-responsive-16by9">
            <iframe class="embed-responsive-item"
                    src="https://www.youtube.com/embed/fJhbTdVyZBI"
                    allowfullscreen>
            </iframe>
        </div>
    </div>
</div>
