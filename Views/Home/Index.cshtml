@model StudentHub.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Dobrodošli u StudentHub";
}

<div class="container">
    <div class="jumbotron text-center">
        <h1 class="display-4">Dobrodošli u StudentHub!</h1>
        <p class="lead">Vaš centralizovani sistem za upravljanje fakultetom.</p>
        <hr class="my-4" />
        <p>Pratite najnovije objave, podatke o korisnicima i još mnogo toga.</p>
    </div>

    <div class="row text-center mt-5">
        <div class="col-md-4">
            <h3>Proizvodni biznis</h3>
            <p>Detalji o studijskom programu proizvodnog biznisa.</p>
            <a href="@Url.Action("Details", "StudijskiProgrami", new { id = 1 })" class="btn btn-primary">Pogledaj detalje</a>
        </div>
        <div class="col-md-4">
            <h3>Građevinarstvo</h3>
            <p>Detalji o studijskom programu građevinarstva.</p>
            <a href="@Url.Action("Details", "StudijskiProgrami", new { id = 2 })" class="btn btn-primary">Pogledaj detalje</a>
        </div>
        <div class="col-md-4">
            <h3>Softversko inženjerstvo</h3>
            <p>Detalji o studijskom programu softverskog inženjerstva.</p>
            <a href="@Url.Action("Details", "StudijskiProgrami", new { id = 3 })" class="btn btn-primary">Pogledaj detalje</a>
        </div>
    </div>

    <div class="mt-5">
        <h2>Najnovije obavijesti</h2>
        <ul>
            @foreach (var obavijest in Model.NajnovijeObavijesti)
            {
                <li>@obavijest.Naslov - @obavijest.DatumObjave.ToShortDateString()</li>
            }
        </ul>
    </div>
</div>
