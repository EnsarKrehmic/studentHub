@model StudentHub.Models.Ispit

@{
    ViewData["Title"] = "Kreiranje novog ispita";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="datumOdrzavanja" class="control-label"></label>
        <input asp-for="datumOdrzavanja" class="form-control" />
        <span asp-validation-for="datumOdrzavanja" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Lokacija" class="control-label"></label>
        <input asp-for="Lokacija" class="form-control" />
        <span asp-validation-for="Lokacija" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="brojBodova" class="control-label"></label>
        <input asp-for="brojBodova" class="form-control" />
        <span asp-validation-for="brojBodova" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PredmetId" class="control-label"></label>
        <select asp-for="PredmetId" class="form-control" asp-items="ViewBag.PredmetId"></select>
    </div>
    <div class="form-group">
        <label asp-for="ProfesorId" class="control-label"></label>
        <select asp-for="ProfesorId" class="form-control" asp-items="ViewBag.ProfesorId"></select>
    </div>
    <div class="form-group">
        <label asp-for="AsistentId" class="control-label"></label>
        <select asp-for="AsistentId" class="form-control" asp-items="ViewBag.AsistentId"></select>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Kreiraj</button>
    </div>
</form>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}