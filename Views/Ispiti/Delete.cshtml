@model StudentHub.Models.Ispit

@{
    ViewData["Title"] = "Brisanje ispita";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovaj ispit?</h4>
    <p>Ova akcija je <strong>nepovratna</strong> i trajno će ukloniti sve podatke o ispitu.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o ispitu</h5>
    </div>
    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">Predmet:</dt>
            <dd class="col-sm-9">@Model.Predmet.Naziv</dd>

            <dt class="col-sm-3">Lokacija:</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Lokacija))
                {
                    @Model.Lokacija
                }
                else
                {
                    <span class="text-muted">Nije definisana.</span>
                }
            </dd>

            <dt class="col-sm-3">Datum održavanja ispita:</dt>
            <dd class="col-sm-9">
                @(Model.DatumOdrzavanja != null
                                ? Model.DatumOdrzavanja.ToString("dd.MM.yyyy. HH:mm")
                                : "<span class=\"text-muted\">N/A</span>")
            </dd>

            <dt class="col-sm-3">Bodovna vrijednost ispita:</dt>
            <dd class="col-sm-9">
                @Model.BrojBodova
            </dd>

            <dt class="col-sm-3">Uslov za polaganje:</dt>
            <dd class="col-sm-9">
                @if (Model.UslovZaPolaganje > 0)
                {
                    <span class="badge bg-success">@Model.UslovZaPolaganje bodova</span>
                }
                else
                {
                    <span class="text-muted">Nema posebnih uslova.</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>
