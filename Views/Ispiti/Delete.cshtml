@model StudentHub.Models.Ispit

@{
    ViewData["Title"] = "Brisanje ispita";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj ispit?";
    ViewData["WarningDetails"] = "Ova akcija je <span class='fw-bold text-danger'>nepovratna</span> i trajno će ukloniti sve podatke o ispitu.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Predmet"] = Model.Predmet?.Naziv ?? (object)Html.Raw("<span class='text-muted'>Nije definisano</span>"),
        ["Lokacija"] = !string.IsNullOrWhiteSpace(Model.Lokacija)
                                ? Model.Lokacija
                                : (object)Html.Raw("<span class='text-muted'>Nije definirana</span>"),
        ["Datum održavanja"] = Model.DatumOdrzavanja.ToString("dd.MM.yyyy. HH:mm"),
        ["Bodovna vrijednost"] = Model.BrojBodova,
        ["Uslov za polaganje"] = Model.UslovZaPolaganje > 0
                                ? (object)Html.Raw($"<span class='badge bg-success'>{Model.UslovZaPolaganje:N0} bodova</span>")
                                : (object)Html.Raw("<span class='text-muted'>Nema posebnih uslova.</span>")
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
