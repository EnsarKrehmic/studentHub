@model StudentHub.Models.Ispit

@{
    ViewData["Title"] = "Brisanje ispita";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-lg border-danger">
                <div class="card-body">
                    <h2 class="card-title mb-3 text-center text-danger">
                        <i class="fas fa-trash-alt me-2"></i>@ViewData["Title"]
                    </h2>
                    <hr />
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                        <div>
                            <strong>Da li ste sigurni da želite obrisati ovaj ispit?</strong><br />
                            <span class="small">Ova akcija je <span class="fw-bold text-danger">nepovratna</span> i trajno će ukloniti sve podatke o ispitu.</span>
                        </div>
                    </div>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Predmet:</dt>
                        <dd class="col-sm-8">@Model.Predmet?.Naziv</dd>

                        <dt class="col-sm-4">Lokacija:</dt>
                        <dd class="col-sm-8">
                            @(!string.IsNullOrWhiteSpace(Model.Lokacija) ? Model.Lokacija : "<span class=\"text-muted\">Nije definisana.</span>")
                        </dd>

                        <dt class="col-sm-4">Datum održavanja:</dt>
                        <dd class="col-sm-8">
                            @Model.DatumOdrzavanja.ToString("dd.MM.yyyy. HH:mm")
                        </dd>

                        <dt class="col-sm-4">Bodovna vrijednost:</dt>
                        <dd class="col-sm-8">@Model.BrojBodova</dd>

                        <dt class="col-sm-4">Uslov za polaganje:</dt>
                        <dd class="col-sm-8">
                            @Html.Raw(
                            Model.UslovZaPolaganje > 0
                            ? $"<span class=\"badge bg-success\">{Model.UslovZaPolaganje:N0} bodova</span>"
                            : "<span class=\"text-muted\">Nema posebnih uslova.</span>"
                                                        )
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="d-flex gap-2">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt"></i> Obriši
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Odustani
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
