@model StudentHub.ViewModels.IspitDetailsViewModel

@{
    ViewData["Title"] = "Detalji ispita";
    var ispit = Model.Predmeti?.FirstOrDefault()?.Ispiti?.FirstOrDefault();
    var ispitProsao = ispit != null && ispit.DatumOdrzavanja < DateTime.Now;
    var trenutniKorisnikId = ViewBag.TrenutniKorisnikId as long?;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
        @TempData["Message"]
        <button type="button" class="btn-close" data-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <div class="card-body">
            <h1 class="card-title text-center mb-4">Detalji ispita</h1>

            <div class="mb-4">
                <h5 class="text-primary">Studijski program:</h5>
                <p class="lead">
                    @if (Model.StudijskiProgram != null)
                    {
                        @Model.StudijskiProgram.Naziv
                    }
                    else
                    {
                        <span class="text-danger">Nema povezanog studijskog programa</span>
                    }
                </p>
            </div>

            <hr />

            <h5 class="text-primary">Predmet:</h5>
            <p class="lead">
                @if (Model.Predmeti != null && Model.Predmeti.Any())
                {
                    @Model.Predmeti.First().Predmet.Naziv
                }
                else
                {
                    <span class="text-danger">Nepoznat predmet</span>
                }
            </p>

            <hr />

            <h4 class="text-primary mb-3">Detalji ispita</h4>

            @if (ispit != null)
            {
                <div class="card bg-light mb-4 shadow-sm">
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>📍 Lokacija:</strong> @ispit.Lokacija</li>
                            <li class="list-group-item"><strong>📅 Datum:</strong> @ispit.DatumOdrzavanja.ToString("dd.MM.yyyy HH:mm")</li>
                            <li class="list-group-item"><strong>💯 Ukupni bodovi ispita:</strong> @ispit.BrojBodova</li>
                            <li class="list-group-item"><strong>Uslov za polaganje (minimalni broj bodova):</strong> @ispit.UslovZaPolaganje</li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">Detalji o ispitu trenutno nisu dostupni.</div>
            }

            <div class="d-flex justify-content-between mt-4 align-items-center">
                @if (User.IsInRole("Student") && ispit != null)
                {
                    if (!Model.Prijavljen && ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now)
                    {
                        <form asp-action="Prijavi" asp-route-id="@Model.IspitId" method="post">
                            <button type="submit" class="btn btn-success">✅ Prijavi se</button>
                        </form>
                    }
                    else if (Model.Prijavljen && ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now)
                    {
                        <form asp-action="Odjavi" asp-route-id="@Model.IspitId" method="post">
                            <button type="submit" class="btn btn-danger">❌ Odjavi se</button>
                        </form>
                    }
                }

                @if ((User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Studentska služba"))
                                && ispit != null && ispitProsao && !ispit.Arhivirano)
                {
                    <form asp-action="Arhiviraj" asp-route-id="@Model.IspitId" method="post" class="me-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary">
                            <i class="fas fa-archive"></i> Arhiviraj ispit
                        </button>
                    </form>
                }
                else if (ispit != null && ispit.Arhivirano)
                {
                    <span class="badge bg-info align-self-center">
                        <i class="fas fa-archive"></i> Ispit je arhiviran
                    </span>
                }

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Povratak na listu ispita
                </a>
            </div>
        </div>
    </div>
</div>

@if ((User.IsInRole("Profesor") || User.IsInRole("Asistent")) && Model.PrijavljeniStudenti.Any())
{
    <div class="container mt-5">
        <div class="card shadow-lg p-4">
            <h4>Rezultati ispita</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Bodovi</th>
                        <th>Status</th>
                        <th>Akcija</th>
                    </tr>
                </thead>
                <tbody id="registeredStudents">
                    @foreach (var student in Model.PrijavljeniStudenti)
                    {
                        var prijava = Model.Prijave.FirstOrDefault(p => p.StudentId == student.Id);
                        var bodovi = prijava?.Bodovi;
                        var polozen = bodovi.HasValue && bodovi >= Model.UslovZaPolaganje;
                        <tr>
                            <td>@student.Ime @student.Prezime (@student.BrojIndeksa)</td>
                            <td>
                                <input type="number" class="form-control" id="bodovi-@student.Id"
                                       value="@(bodovi ?? 0)" disabled />
                            </td>
                            <td id="status-@student.Id">
                                @if (bodovi.HasValue)
                                {
                                    <span class="badge @(polozen ? "bg-success" : "bg-danger")">
                                        @(polozen ? "Položen" : "Nije položen")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Bez bodova</span>
                                }
                            </td>
                            <td>
                                @if (ispitProsao)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary mb-1"
                                            onclick="omoguciUredjivanje(@student.Id)">✏️ Uredi</button>

                                    <button type="button" class="btn btn-sm btn-primary d-none"
                                            id="spasi-@student.Id"
                                            onclick="unesiBodove(@Model.IspitId, @student.Id)">💾 Spasi</button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>Očekivanje ispita</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


@if (ViewBag.JePrijavljen == true)
{
    <div class="container mt-5">
        <div class="card shadow-lg p-4">
            <h4 class="mb-3">Vaš rezultat</h4>
            @{
                var bodovi = Model.Bodovi;
                var polozen = bodovi.HasValue && bodovi >= Model.UslovZaPolaganje;
            }
            <p><strong>Bodovi:</strong> @(bodovi.HasValue ? bodovi.ToString() : "Nisu još uneseni")</p>
            <p><strong>Status:</strong>
                <span class="badge @(bodovi.HasValue ? (polozen ? "bg-success" : "bg-danger") : "bg-warning")">
                    @(bodovi.HasValue ? (polozen ? "Položen" : "Nije položen") : "Rezultat nije objavljen")
                </span>
            </p>
        </div>
    </div>
}

<!-- Forma za komentar -->
@if (User.IsInRole("Student") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
{
    <div class="container mt-5">
        <div class="card shadow-lg p-4">
            <h4 class="mb-3">Komentari</h4>
            <input class="form-control mb-3" id="komentarSearch" onkeyup="filtrirajKomentare()" placeholder="Pretraga komentara..." />

            <form asp-action="DodajKomentar" enctype="multipart/form-data" class="mb-4">
                <input type="hidden" name="ispitId" value="@Model.IspitId" />
                <textarea name="sadrzaj" class="form-control mb-2" placeholder="Unesite komentar..." required></textarea>
                <input type="file" name="prilog" class="form-control mb-2" />
                <select name="vidljivost" class="form-control mb-2" id="vidljivostSelect">
                    <option value="Javno">Javno</option>
                    <option value="Privatno">Privatno</option>
                </select>
                <div id="odabirKorisnika" style="display: none;">
                    <select name="odabraniKorisnici" multiple class="form-control" id="korisniciSelect"></select>
                </div>
                <button type="submit" class="btn btn-primary">Objavi komentar</button>
            </form>

            <div class="komentari-lista">
                @foreach (var komentar in Model.Komentari)
                {
                    var mozeVidjeti = komentar.Vidljivost == StudentHub.Models.VidljivostKomentara.Javno ||
                    (komentar.Vidljivost == StudentHub.Models.VidljivostKomentara.Privatno &&
                    (komentar.KorisnikId == trenutniKorisnikId || komentar.VidljivostKorisnici.Any(vk => vk.KorisnikId == trenutniKorisnikId)));

                    @if (mozeVidjeti)
                    {
                        <div class="komentar border rounded p-2 mb-2">
                            <div><strong>@komentar.Korisnik.Ime @komentar.Korisnik.Prezime</strong></div>
                            <div class="text-muted">@komentar.DatumVrijeme.ToString("dd.MM.yyyy HH:mm")</div>
                            <div class="mt-1 komentar-sadrzaj">@komentar.Sadrzaj</div>
                            @if (!string.IsNullOrEmpty(komentar.PrilogPath))
                            {
                                <a class="btn btn-sm btn-link mt-1" href="@komentar.PrilogPath">📎 Prilog</a>
                            }
                            @if (komentar.Vidljivost == StudentHub.Models.VidljivostKomentara.Privatno)
                            {
                                <span class="badge bg-warning">🔒 Privatni komentar</span>
                            }

                            <!-- DUGMAD Edit / Delete -->
                            @if (komentar.KorisnikId == trenutniKorisnikId || User.IsInRole("Studentska služba"))
                            {
                                <div class="mt-2">
                                    <a asp-action="EditKomentar" asp-route-id="@komentar.Id" class="btn btn-sm btn-outline-secondary">✏️ Uredi</a>

                                    <form asp-action="DeleteKomentar" asp-route-id="@komentar.Id" method="post" class="d-inline-block ms-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Da li ste sigurni da želite obrisati komentar?');">🗑️ Obriši</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.11/signalr.min.js"></script>
    <script>
        function toggleExam(ispitId, prijavljen) {
            let url = prijavljen ? "/Odjavi/" + ispitId : "/Prijavi/" + ispitId;
            let method = "POST";

            fetch(url, {
                method: method,
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    let button = document.getElementById("examButton");
                    button.textContent = prijavljen ? "✅ Prijavi ispit" : "❌ Odjavi ispit";
                    button.classList.toggle("btn-success");
                    button.classList.toggle("btn-danger");
                    button.setAttribute("onclick", `toggleExam(${ispitId}, ${!prijavljen})`);

                    let messageBox = document.getElementById("successMessage");
                    if (!messageBox) {
                        messageBox = document.createElement("div");
                        messageBox.classList.add("alert", "alert-success", "alert-dismissible", "fade", "show");
                        messageBox.setAttribute("role", "alert");
                        messageBox.setAttribute("id", "successMessage");
                        document.querySelector(".container").prepend(messageBox);
                    }
                    messageBox.innerHTML = `${data.message} <button type="button" class="btn-close" data-dismiss="alert" aria-label="Close"></button>`;
                } else {
                    alert("Došlo je do greške.");
                }
            })
            .catch(error => console.error("Greška:", error));
        }
    </script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/examHub")
            .build();

        connection.on("UpdateRegisteredStudents", function (examId) {
            fetch(`/Ispiti/GetRegisteredStudents/${examId}`)
                .then(response => response.json())
                .then(data => {
                    const tbody = document.getElementById("registeredStudents");
                    tbody.innerHTML = "";
                    data.forEach(student => {
                        const row = `<tr>
                            <td>${student.ime} ${student.prezime} (${student.brojIndeksa})</td>
                            <td colspan="3" class="text-muted"> -- Bodovi će biti prikazani nakon učitavanja cijele stranice -- </td>
                        </tr>`;
                        tbody.innerHTML += row;
                    });
                });
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>

    <script>
        function unesiBodove(ispitId, studentId) {
            let bodoviInput = document.getElementById(`bodovi-${studentId}`);
            let bodovi = parseFloat(bodoviInput.value);

            fetch(`/Ispiti/UnesiBodove`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    IspitId: ispitId,
                    StudentId: studentId,
                    Bodovi: bodovi
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Ažuriraj prikaz bodova
                    let statusElement = document.getElementById(`status-${studentId}`);
                    if (data.bodovi != null) {
                        bodoviInput.value = data.bodovi;
                        bodoviInput.disabled = true; // Sprječavanje ponovnog unosa
                        statusElement.innerHTML = `<span class="badge ${data.polozen ? 'bg-success' : 'bg-danger'}">
                                                      ${data.polozen ? 'Položen' : 'Nije položen'}
                                                   </span>`;
                    }
                } else {
                    alert("Greška prilikom unosa bodova: " + data.message);
                }
            })
            .catch(error => console.error("Greška:", error));
        }
    </script>

    <script>
        function omoguciUredjivanje(studentId) {
            let bodoviInput = document.getElementById(`bodovi-${studentId}`);
            let spasiButton = document.getElementById(`spasi-${studentId}`);

            bodoviInput.disabled = false;  // Omogućava unos bodova
            spasiButton.classList.remove("d-none");  // Prikazuje dugme "Spasi"
        }
    </script>

    <script>
        $(document).ready(function () {
            const ispitId = '@Model.IspitId';

            // JEDINSTVENA funkcija za punjenje korisnika:
            function ucitajVidljiveKorisnike(oznaceniKorisnici = []) {
                $.get('/Ispiti/GetVidljiviKorisnici/' + ispitId, function (data) {
                    var korisniciSelect = $('#korisniciSelect');
                    korisniciSelect.empty();
                    data.forEach(function (k) {
                        var option = new Option(k.ime + ' (' + k.uloga + ')', k.id);
                        if (oznaceniKorisnici.includes(k.id)) {
                            option.selected = true;
                        }
                        korisniciSelect.append(option);
                    });
                });
            }

            // Kada mijenjaš "Vidljivost"
            $('#vidljivostSelect').change(function () {
                $('#odabirKorisnika').toggle($(this).val() === 'Privatno');
                if ($(this).val() === 'Privatno') {
                    ucitajVidljiveKorisnike();
                }
            });

            // Ako je "Privatno" već na loadu
            if ($('#vidljivostSelect').val() === 'Privatno') {
                $('#odabirKorisnika').show();

                // Ako smo na EDIT stranici i imamo već selektovane korisnike
                var oznaceniKorisnici = [];
                $('#korisniciSelect option:selected').each(function () {
                    oznaceniKorisnici.push(parseInt($(this).val()));
                });

                ucitajVidljiveKorisnike(oznaceniKorisnici);
            }
        });
    </script>
    <script>
        function filtrirajKomentare() {
            var input = document.getElementById("komentarSearch");
            var filter = input.value.toLowerCase();
            var komentari = document.getElementsByClassName("komentar");
            Array.from(komentari).forEach(function (k) {
                var tekst = k.textContent || k.innerText;
                k.style.display = tekst.toLowerCase().includes(filter) ? "block" : "none";
            });
        }
    </script>
}