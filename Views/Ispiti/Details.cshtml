@model StudentHub.ViewModels.IspitDetailsViewModel
@using StudentHub.Models
@using System.Globalization
@using System.Security.Claims

@{
    ViewData["Title"] = "Detalji ispita";
    var ispit = Model.Predmeti?.FirstOrDefault()?.Ispiti?.FirstOrDefault();
    var ispitProsao = ispit != null && ispit.DatumOdrzavanja < DateTime.Now;
    var trenutniKorisnikId = ViewBag.TrenutniKorisnikId as long?;
    var isPrijavljen = ViewBag.JePrijavljen as bool? ?? false;
    var aktivnostId = Model.IspitId;
}

@Html.AntiForgeryToken()
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<input type="hidden"
       name="__RequestVerificationToken"
       value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">

    <!-- Detalji ispita -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h1 class="card-title text-center mb-4">Detalji ispita</h1>

            <dl class="row mb-0">
                <dt class="col-sm-3">Studijski program:</dt>
                <dd class="col-sm-9">
                    @if (Model.StudijskiProgram != null)
                    {
                        @Model.StudijskiProgram.Naziv
                    }
                    else
                    {
                        <span class="text-danger">Nema povezanog studijskog programa</span>
                    }
                </dd>

                <dt class="col-sm-3">Predmet:</dt>
                <dd class="col-sm-9">
                    @if (Model.Predmeti.Any())
                    {
                        @Model.Predmeti.First().Predmet.Naziv
                    }
                    else
                    {
                        <span class="text-danger">Nepoznat predmet</span>
                    }
                </dd>
            </dl>

            <hr />

            @if (ispit != null)
            {
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>📍 Lokacija:</strong> @ispit.Lokacija</li>
                    <li class="list-group-item"><strong>📅 Datum:</strong> @ispit.DatumOdrzavanja.ToString("dd.MM.yyyy HH:mm")</li>
                    <li class="list-group-item"><strong>💯 Ukupni bodovi:</strong> @ispit.BrojBodova</li>
                    <li class="list-group-item"><strong>🔢 Uslov (min):</strong> @ispit.UslovZaPolaganje</li>
                </ul>
            }
            else
            {
                <div class="alert alert-info mb-0">Detalji o ispitu trenutno nisu dostupni.</div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">
                @* Prijava / odjava *@
                @if (User.IsInRole("Student") && ispit != null)
                {
                    if (!Model.Prijavljen && ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now)
                    {
                        <form asp-action="Prijavi" asp-route-id="@aktivnostId" method="post">
                            <button class="btn btn-success"><i class="fas fa-check me-1"></i> Prijavi se</button>
                        </form>
                    }
                    else if (Model.Prijavljen && ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now)
                    {
                        <form asp-action="Odjavi" asp-route-id="@aktivnostId" method="post">
                            <button class="btn btn-danger"><i class="fas fa-times me-1"></i> Odjavi se</button>
                        </form>
                    }
                }

                @* Arhiviranje *@
                @if ((User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Studentska služba"))
                                && ispit != null && ispitProsao && !ispit.Arhivirano)
                {
                    <form asp-action="Arhiviraj" asp-route-id="@aktivnostId" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-secondary"><i class="fas fa-archive me-1"></i> Arhiviraj ispit</button>
                    </form>
                }
                else if (ispit != null && ispit.Arhivirano)
                {
                    <span class="badge bg-info align-self-center">
                        <i class="fas fa-archive me-1"></i> Ispit je arhiviran
                    </span>
                }

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Povratak na listu ispita
                </a>
            </div>
        </div>
    </div>

    @* Rezultati ispita za nastavnika/službu *@
    @if ((User.IsInRole("Profesor") || User.IsInRole("Asistent")) && Model.PrijavljeniStudenti.Any())
    {
        <div class="card shadow-sm p-4 mb-4">
            <h4 class="mb-3">Rezultati ispita</h4>
            <div class="alert alert-info">
                Unos bodova <strong>ne stvara automatski ocjenu</strong>. Za dodavanje ocjene, koristite sekciju za ocjene predmeta.
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Bodovi</th>
                            <th>Status</th>
                            <th>Akcija</th>
                        </tr>
                    </thead>
                    <tbody id="registeredStudents">
                        @foreach (var student in Model.PrijavljeniStudenti)
                        {
                            var prijava = Model.Prijave.FirstOrDefault(p => p.StudentId == student.Id);
                            var bodovi = prijava?.Bodovi;
                            var polozen = bodovi.HasValue && bodovi >= Model.UslovZaPolaganje;
                            <tr>
                                <td>@student.Ime @student.Prezime (@student.BrojIndeksa)</td>
                                <td>
                                    <input type="number"
                                           class="form-control"
                                           id="bodovi-@student.Id"
                                           value="@(bodovi.HasValue? bodovi.Value.ToString(CultureInfo.InvariantCulture) : "")"
                                           disabled />
                                </td>
                                <td id="status-@student.Id">
                                    @if (bodovi.HasValue)
                                    {
                                        <span class="badge @(polozen ? "bg-success" : "bg-danger")">
                                            @(polozen ? "Položen" : "Nije položen")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Bez bodova</span>
                                    }
                                </td>
                                <td>
                                    @if (ispitProsao)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary mb-1"
                                                onclick="omoguciUredjivanje(@student.Id)">
                                            ✏️ Uredi
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-primary d-none"
                                                id="spasi-@student.Id"
                                                onclick="unesiBodove(@Model.IspitId, @student.Id)">
                                            💾 Spasi
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled>
                                            Očekivanje ispita
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

@* Vaš rezultat *@
@if (isPrijavljen)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4 class="mb-3">Vaš rezultat</h4>
            @{
                var bod = Model.Bodovi;
                var polozen = bod.HasValue && bod >= Model.UslovZaPolaganje;
            }
            <p><strong>Bodovi:</strong> @(bod.HasValue? bod.Value.ToString(CultureInfo.InvariantCulture) : "Nisu još uneseni")</p>
            <p>
                <strong>Status:</strong>
                <span class="badge @(bod.HasValue ? (polozen ? "bg-success" : "bg-danger") : "bg-warning text-dark")">
                    @(bod.HasValue ? (polozen ? "Položen" : "Nije položen") : "Rezultat nije objavljen")
                </span>
            </p>
        </div>
    </div>
}

@* Komentari i forma *@
@if (User.IsInRole("Student") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
{
    <div class="card shadow-sm mb-4 p-4">
        <h4 class="mb-3">Komentari</h4>

        <input class="form-control mb-3" id="komentarSearch" onkeyup="filtrirajKomentare()" placeholder="Pretraga komentara..." />

        @if (ispit?.Arhivirano == true)
        {
            <div class="alert alert-warning">Ispit je arhiviran. Dodavanje komentara nije moguće.</div>
        }
        else
        {
            <form asp-action="DodajKomentar" enctype="multipart/form-data" class="mb-4">
                <input type="hidden" name="ispitId" value="@Model.IspitId" />
                <textarea name="sadrzaj" class="form-control mb-2" placeholder="Unesite komentar..." required></textarea>
                <input type="file" name="prilog" class="form-control mb-2" />
                <select name="vidljivost" class="form-control mb-2" id="vidljivostSelect">
                    <option value="Javno">Javno</option>
                    <option value="Privatno">Privatno</option>
                </select>
                <div id="odabirKorisnika" class="mb-2" style="display: none;">
                    <select name="odabraniKorisnici" multiple class="form-control" id="korisniciSelect"></select>
                </div>
                <button class="btn btn-primary">Objavi komentar</button>
            </form>
        }

        <div id="komentariLista">
            @foreach (var komentar in Model.Komentari)
            {
                var mozeVidjeti = komentar.Vidljivost == VidljivostKomentara.Javno ||
                (komentar.Vidljivost == VidljivostKomentara.Privatno &&
                (komentar.KorisnikId == trenutniKorisnikId ||
                komentar.VidljivostKorisnici.Any(vk => vk.KorisnikId == trenutniKorisnikId)));

                if (mozeVidjeti)
                {
                    <div class="border rounded p-3 mb-3 komentar-item" data-sadrzaj="@komentar.Sadrzaj">
                        <div>
                            <strong>
                                @(komentar.Student != null
                                                    ? komentar.Student.Ime + " " + komentar.Student.Prezime
                                                    : komentar.Korisnik.Ime + " " + komentar.Korisnik.Prezime)
                </strong>
            </div>
            <div class="text-muted small">@komentar.DatumVrijeme.ToString("dd.MM.yyyy HH:mm")</div>
            <p class="mt-2">@komentar.Sadrzaj</p>
            @if (!string.IsNullOrEmpty(komentar.PrilogPath))
                        {
                            <a href="@komentar.PrilogPath" class="small">📎 Prilog</a>
                        }
                        @if (komentar.Vidljivost == VidljivostKomentara.Privatno)
                        {
                            <span class="badge bg-warning text-dark ms-2">🔒 Privatni</span>
                        }
                        @if ((komentar.KorisnikId == trenutniKorisnikId) || User.IsInRole("Studentska služba"))
                        {
                            <div class="mt-2">
                                <a asp-action="EditKomentar" asp-route-id="@komentar.Id" class="btn btn-sm btn-outline-secondary me-2">✏️ Uredi</a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteKomentarModal"
                                        data-id="@komentar.Id"
                                        data-sadrzaj="@komentar.Sadrzaj"
                                        data-prilog="@komentar.PrilogPath">
                                    🗑️ Obriši
                                </button>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

</div>

<!-- Modal za brisanje komentara -->
<div class="modal fade" id="deleteKomentarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="DeleteKomentar" method="post" id="deleteKomentarForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-trash-alt me-2"></i> Potvrda brisanja</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-center"><strong>Ova akcija je nepovratna.</strong></p>
                    <div class="border rounded p-2 mb-3" id="modalKomentarSadrzaj"></div>
                    <div id="modalKomentarPrilog"></div>
                    <input type="hidden" name="id" id="modalKomentarId" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Obriši</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Odustani</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"
            integrity="sha512-894YeK...==" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.11/signalr.min.js"
            integrity="sha512-+K+X...==" crossorigin="anonymous"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
          // 1) Bootstrap alert close
          document.querySelectorAll('.alert .btn-close').forEach(btn =>
            btn.addEventListener('click', () => btn.closest('.alert').style.display = 'none')
          );

          // 2) SignalR + live refresh
            const tbody = document.getElementById('registeredStudents');
        let connection;
        if (tbody) {
          connection = new signalR.HubConnectionBuilder()
            .withUrl('/examHub')
            .build();

          connection.on('UpdateRegisteredStudents', examId => {
            fetch(`/Ispiti/PrikaziRezultate/${examId}`)
              .then(r=>r.json())
              .then(data => {
                tbody.innerHTML = '';
                data.forEach(s => {
                  tbody.innerHTML += `
                  <tr>
                    <td>${s.ime} ${s.prezime} (${s.brojIndeksa})</td>
                    <td><input type="number" id="bodovi-${s.studentId}" class="form-control" value="${s.bodovi??''}" disabled/></td>
                    <td id="status-${s.studentId}">
                      ${s.bodovi!=null
                        ? `<span class="badge ${s.polozen?'bg-success':'bg-danger'}">${s.polozen?'Položen':'Nije položen'}</span>`
                        : `<span class="badge bg-warning text-dark">Bez bodova</span>`
                      }
                    </td>
                    <td>
                      <button class="btn btn-sm btn-outline-secondary" onclick="omoguciUredjivanje(${s.studentId})">✏️</button>
                      <button id="spasi-${s.studentId}" class="btn btn-sm btn-primary d-none"
                              onclick="unesiBodove(${examId},${s.studentId})">💾</button>
                    </td>
                  </tr>`;
                });
              });
          });

          connection.start().catch(_=>{/* ignore if hub missing */});
        }

        // 3) Omogući edit
        window.omoguciUredjivanje = function(studentId) {
          const inp = document.getElementById(`bodovi-${studentId}`);
          const btn = document.getElementById(`spasi-${studentId}`);
          if (!inp||!btn) return;
          inp.disabled = false;
          btn.classList.remove('d-none');
        };

            // 4) AJAX unesi bodove
        window.unesiBodove = function(ispitId, studentId) {
          const inp = document.getElementById(`bodovi-${studentId}`);
          const statusEl = document.getElementById(`status-${studentId}`);
          const btn = document.getElementById(`spasi-${studentId}`);
          if (!inp||!statusEl) return;
          const bod = parseFloat(inp.value);
          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
          fetch('/Ispiti/UnesiBodove', {
            method:'POST',
            headers:{
              'Content-Type':'application/json',
              'RequestVerificationToken':token
            },
            body: JSON.stringify({ IspitId:ispitId, StudentId:studentId, Bodovi:bod })
          })
          .then(r=>r.json())
          .then(data=>{
            if (data.success) {
              inp.value = data.bodovi ?? '';
              inp.disabled = true;
              btn.classList.add('d-none');
              statusEl.innerHTML = data.bodovi!=null
                ? `<span class="badge ${data.polozen?'bg-success':'bg-danger'}">${data.polozen?'Položen':'Nije položen'}</span>`
                : `<span class="badge bg-warning text-dark">Bez bodova</span>`;
              if (connection) connection.invoke('UpdateRegisteredStudents', ispitId);
            } else {
              alert('Greška: '+(data.message||''));
            }
          })
          .catch(e=>{ console.error(e); alert('Greška prilikom unosa bodova.'); });
        };

          // --- 5) pretraga komentara ---
          document.getElementById('komentarSearch')?.addEventListener('keyup', function(){
            const q = this.value.toLowerCase();
            document.querySelectorAll('.komentar-item').forEach(el =>
              el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none'
            );
          });

          // --- 6) privatni komentari: load korisnika ---
          const ispitId = '@Model.IspitId';
          if (document.getElementById('vidljivostSelect')) {
            function ucitajVidljiveKorisnike(sel=[]) {
              $.get(`/Ispiti/GetVidljiviKorisnici/${ispitId}`, data=>{
                const selEl = $('#korisniciSelect').empty();
                data.forEach(u=>{
                  selEl.append(new Option(`${u.ime} (${u.uloga})`, u.id, sel.includes(u.id), sel.includes(u.id)));
                });
              });
            }
            $('#vidljivostSelect').on('change',function(){
              const ok = this.value==='Privatno';
              $('#odabirKorisnika').toggle(ok);
              if (ok) ucitajVidljiveKorisnike();
            });
            if ($('#vidljivostSelect').val()==='Privatno') {
              $('#odabirKorisnika').show();
              const sel = $('#korisniciSelect option:selected').map((i,e)=>+e.value).get();
              ucitajVidljiveKorisnike(sel);
            }
          }

          // --- 7) AJAX delete komentara ---
          const deleteModalEl = document.getElementById('deleteKomentarModal');
          if (deleteModalEl) {
            deleteModalEl.addEventListener('show.bs.modal', e => {
              const btn = e.relatedTarget;
              document.getElementById('modalKomentarId').value      = btn.dataset.id;
              document.getElementById('modalKomentarSadrzaj').textContent = btn.dataset.sadrzaj;
              document.getElementById('modalKomentarPrilog').innerHTML   = btn.dataset.prilog
                ? `<span class="fw-bold">Prilog:</span> <a href="${btn.dataset.prilog}" target="_blank">📎</a>`
                : '';
            });
            document.getElementById('deleteKomentarForm')?.addEventListener('submit', function(e){
              e.preventDefault();
              const id    = this.querySelector('#modalKomentarId').value;
              const token = this.querySelector('input[name="__RequestVerificationToken"]').value;
              fetch(`/Ispiti/DeleteKomentar/${id}`, {
                method:'POST',
                headers:{
                  'X-Requested-With':'XMLHttpRequest',
                  'RequestVerificationToken':token
                }
              })
              .then(r=>{
                if (!r.ok) throw 'Greška pri brisanju';
                bootstrap.Modal.getInstance(deleteModalEl).hide();
                document.querySelector(`[data-sadrzaj="${this.querySelector('#modalKomentarSadrzaj').textContent}"]`)?.remove();
                if (!document.querySelector('.komentar-item')) {
                  document.getElementById('komentariLista').innerHTML =
                    '<div class="alert alert-info">Nema komentara.</div>';
                }
              })
              .catch(err=>alert(err));
            });
          }

        });
    </script>
}