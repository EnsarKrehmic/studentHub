@model StudentHub.Models.Ispit

@{
    ViewData["Title"] = "Detalji ispita";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Podaci o ispitu</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.datumOdrzavanja)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.datumOdrzavanja)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Lokacija)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Lokacija)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.brojBodova)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.brojBodova)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Predmet)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Predmet.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Profesor)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Profesor.JMBG)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Asistent)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Asistent.JMBG)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Izmjena</a> |
    <a asp-action="Index">Nazad</a>
</div>