@model StudentHub.ViewModels.IspitCreateViewModel

@{
    ViewData["Title"] = "Izmjena podataka ispita";
}

<h2>@ViewData["Title"]</h2>

<h4>Ispit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div class="form-group">
                <label asp-for="StudijskiProgramId" class="control-label"></label>
                <select asp-for="StudijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgramId"></select>
                    <option value="">Odaberite studijski program</option>
                </select>
                <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NastavniPlanId" class="control-label"></label>
                <select asp-for="NastavniPlanId" class="form-control" asp-items="ViewBag.NastavniPlanId"></select>
                    <option value="">Odaberite nastavni plan</option>
                </select>
                <span asp-validation-for="NastavniPlanId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PredmetId" class="control-label"></label>
                <select asp-for="PredmetId" class="form-control" asp-items="ViewBag.PredmetId"></select>
                    <option value="">Odaberite predmet</option>
                </select>
                <span asp-validation-for="PredmetId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DatumOdrzavanja" class="control-label"></label>
                <input asp-for="DatumOdrzavanja" class="form-control" />
                <span asp-validation-for="DatumOdrzavanja" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Lokacija" class="control-label"></label>
                <input asp-for="Lokacija" class="form-control" />
                <span asp-validation-for="Lokacija" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BrojBodova" class="control-label"></label>
                <input asp-for="BrojBodova" class="form-control" type="number" step="1" />
                <span asp-validation-for="BrojBodova" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UslovZaPolaganje" class="control-label"></label>
                <input asp-for="UslovZaPolaganje" class="form-control" type="number" step="1" />
                <span asp-validation-for="UslovZaPolaganje" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sačuvaj promjene" class="btn btn-primary mt-3" />
                <a asp-action="Index" class="btn btn-secondary mt-3">Odustani</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#StudijskiProgramId').change(function () {
                var studijskiProgramId = $(this).val();
                $.getJSON('/Ispiti/GetNastavniPlanoviByStudijskiProgram/' + studijskiProgramId, function (data) {
                    var items = '<option value="">Select Nastavni Plan</option>';
                    $.each(data, function (i, nastavniPlan) {
                        items += "<option value='" + nastavniPlan.id + "'>" + nastavniPlan.godinaStudija + "</option>";
                    });
                    $('#NastavniPlanId').html(items);
                });
            });

            $('#NastavniPlanId').change(function () {
                var nastavniPlanId = $(this).val();
                $.getJSON('/Ispiti/GetPredmetiByNastavniPlan/' + nastavniPlanId, function (data) {
                    var items = '<option value="">Select Predmet</option>';
                    $.each(data, function (i, predmet) {
                        items += "<option value='" + predmet.id + "'>" + predmet.naziv + "</option>";
                    });
                    $('#PredmetId').html(items);
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}