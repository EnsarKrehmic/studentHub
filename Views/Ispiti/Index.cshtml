@model IEnumerable<StudentHub.ViewModels.IspitDetailsViewModel>

@{
    ViewData["Title"] = "Lista ispita po studijskim programima i predmetima";
}

<h1 class="text-center mt-4">@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p class="text-center text-muted">Rok za prijavu ispita je 3 dana prije ispitnog roka, ne računajući neradne dane i vikende.</p>

@if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
{
    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary">Kreiraj novi ispit</a>
    </div>
}

<div class="container mt-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var program in Model)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@program.StudijskiProgram.Naziv</h2>
                </div>
                <div class="card-body">
                    @foreach (var plan in program.NastavniPlanovi)
                    {
                        <h4 class="text-secondary mt-3">Nastavni plan za @plan.NastavniPlan.GodinaStudija. godinu studija</h4>

                        @if (plan.Predmeti.Any())
                        {
                            <div class="accordion mt-3" id="predmetAccordion-@plan.NastavniPlan.Id">
                                @for (int i = 0; i < plan.Predmeti.Count; i++)
                                {
                                    var predmet = plan.Predmeti[i];
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading-@i-@plan.NastavniPlan.Id">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@i-@plan.NastavniPlan.Id" aria-expanded="false">
                                                @predmet.Predmet.Naziv
                                            </button>
                                        </h2>
                                        <div id="collapse-@i-@plan.NastavniPlan.Id" class="accordion-collapse collapse" data-bs-parent="#predmetAccordion-@plan.NastavniPlan.Id">
                                            <div class="accordion-body">
                                                <ul class="list-group">
                                                    @foreach (var ispit in predmet.Ispiti)
                                                    {
                                                        <li class="list-group-item">
                                                            <strong>Datum:</strong> @ispit.DatumOdrzavanja.ToString("dd.MM.yyyy")<br />
                                                            <strong>Lokacija:</strong> @ispit.Lokacija<br />
                                                            <strong>Bodovi:</strong> @ispit.BrojBodova<br />
                                                            <strong>Granica:</strong> @ispit.UslovZaPolaganje<br />
                                                            <div class="mt-2">
                                                                <a asp-action="Details" asp-route-id="@ispit.Id" class="btn btn-info btn-sm">Detalji</a>
                                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                                {
                                                                    <a asp-action="Edit" asp-route-id="@ispit.Id" class="btn btn-warning btn-sm">Izmjena</a>
                                                                    <a asp-action="Delete" asp-route-id="@ispit.Id" class="btn btn-danger btn-sm">Brisanje</a>
                                                                }
                                                                @if (User.IsInRole("Student"))
                                                                {
                                                                    var prijavljen = program.PrijavljeniIspitiIds.Contains(ispit.Id);
                                                                    var imaOcjenu = program.Ocjene.ContainsKey(ispit.PredmetId);

                                                                    @if (!prijavljen && !imaOcjenu && ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now)
                                                                    {
                                                                        <form asp-action="Prijavi" asp-route-id="@ispit.Id" method="post" style="display:inline;">
                                                                            <button type="submit" class="btn btn-success btn-sm">✅ Prijavi se</button>
                                                                        </form>
                                                                    }
                                                                    else if (prijavljen)
                                                                    {
                                                                        <form asp-action="Odjavi" asp-route-id="@ispit.Id" method="post" style="display:inline;">
                                                                            <button type="submit" class="btn btn-danger btn-sm">❌ Odjavi se</button>
                                                                        </form>
                                                                    }
                                                                    else if (imaOcjenu)
                                                                    {
                                                                        <span class="text-muted">Već imate ocjenu iz ovog predmeta.</span>
                                                                    }
                                                                }
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Nema dostupnih ispita za ovaj nastavni plan.</p>
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            <strong>Nema dostupnih ispita!</strong>
        </div>
    }
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Funkcija za slanje AJAX zahtjeva
            function sendAjaxRequest(url, ispitId, successMessage, button, newButtonHtml) {
                fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": document.querySelector("input[name='__RequestVerificationToken']")?.value
                    },
                    body: JSON.stringify({})
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        button.outerHTML = newButtonHtml;
                        showToast(successMessage);
                    } else {
                        showToast(data.message, "danger");
                    }
                })
                .catch(error => showToast("Došlo je do greške!", "danger"));
            }

            // Prijava ispita
            document.addEventListener("click", function (event) {
                if (event.target.classList.contains("prijavi-ispit")) {
                    let button = event.target;
                    let ispitId = button.getAttribute("data-id");
                    sendAjaxRequest(`/Ispiti/Prijavi/${ispitId}`, ispitId, "Uspješno ste prijavili ispit.", button,
                        `<button class="btn btn-danger btn-sm odjavi-ispit" data-id="${ispitId}">❌ Odjavi se</button>`);
                }
            });

            // Odjava ispita
            document.addEventListener("click", function (event) {
                if (event.target.classList.contains("odjavi-ispit")) {
                    let button = event.target;
                    let ispitId = button.getAttribute("data-id");
                    sendAjaxRequest(`/Ispiti/Odjavi/${ispitId}`, ispitId, "Uspješno ste odjavili ispit.", button,
                        `<button class="btn btn-success btn-sm prijavi-ispit" data-id="${ispitId}">✅ Prijavi se</button>`);
                }
            });

            // Funkcija za prikaz poruka
            function showToast(message, type = "success") {
                let toast = document.createElement("div");
                toast.className = `alert alert-${type} alert-dismissible fade show position-fixed bottom-0 end-0 m-3`;
                toast.style.zIndex = "1050";
                toast.innerHTML = `${message} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 4000);
            }
        });
    </script>
}
