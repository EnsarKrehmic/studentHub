@model IEnumerable<StudentHub.ViewModels.IspitDetailsViewModel>
@using System.Security.Claims
@using StudentHub.Data
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Lista ispita po studijskim programima i predmetima";
}

<h2>@ViewData["Title"]</h2>

<p>Obavještenje: Rok za prijavu ispita je 3 dana prije ispitnog roka, ne računajući neradne dane i vikende.</p>

<div class="container mt-4">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Create" class="btn btn-primary">Kreiraj novi ispit</a>
    }
    @if (Model != null && Model.Any())
    {
        foreach (var program in Model)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@program.StudijskiProgram.Naziv</h3>
                </div>
                <div class="card-body">
                    @foreach (var plan in program.NastavniPlanovi)
                    {
                        <h4>Nastavni plan za @plan.NastavniPlan.GodinaStudija. godinu</h4>
                        <table class="table table-bordered table-fixed">
                            <thead>
                                <tr>
                                    <th style="width: 25%;">Predmet</th>
                                    <th style="width: 8%;">
                                        <a asp-action="Index" asp-route-sortOrder="@program.DateSortParm">Datum održavanja</a>
                                    </th>
                                    <th style="width: 4%;">
                                        <a asp-action="Index" asp-route-sortOrder="@program.LocationSortParm">Lokacija</a>
                                    </th>
                                    <th style="width: 3%;">
                                        <a asp-action="Index" asp-route-sortOrder="@program.PointsSortParm">Broj bodova</a>
                                    </th>
                                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                    {
                                        <th style="width: 30%%;">Akcije</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var predmet in plan.Predmeti)
                                {
                                    foreach (var ispit in predmet.Ispiti)
                                    {
                                        <tr>
                                            <td style="width: 21%;">@predmet.Predmet.Naziv</td>
                                            <td style="width: 12%;">@ispit.DatumOdrzavanja.ToShortDateString()</td>
                                            <td style="width: 5%;">@ispit.Lokacija</td>
                                            <td style="width: 12%;">@ispit.BrojBodova</td>
                                            <td style="width: 40%;">
                                                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                {
                                                    <a asp-action="Details" asp-route-id="@ispit.Id" class="btn btn-info btn-sm">Detalji</a>
                                                }
                                                @if (User.IsInRole("Profesor"))
                                                {
                                                    <a asp-action="Edit" asp-route-id="@ispit.Id" class="btn btn-warning btn-sm">Izmjena</a>
                                                    <a asp-action="Delete" asp-route-id="@ispit.Id" class="btn btn-danger btn-sm">Brisanje</a>
                                                }
                                                @if (ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now || User.IsInRole("Student"))
                                                {
                                                    <form asp-action="Prijavi" method="post" style="display:inline;">
                                                        <input type="hidden" name="id" value="@ispit.Id" />
                                                        <button type="submit" class="btn btn-success btn-sm">Prijavi se</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            <strong>Nema dostupnih ispita!</strong>
        </div>
    }
</div>

<div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>

<style>
    .table-fixed thead th {
        position: center;
        top: 0;
        background-color: #f8f9fa;
    }
</style>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            $(".prijavi-form").validate({
                rules: {
                    id: {
                        required: true
                    }
                },
                messages: {
                    id: {
                        required: "Morate odabrati ispit."
                    }
                }
            });
        });
    </script>
}