@model IEnumerable<StudentHub.Models.Ispit>

@{
    ViewData["Title"] = "Lista ispita";
}

<h2>@ViewData["Title"]</h2>

<p>Obavještenje: Rok za prijavu ispita je 3 dana prije ispitnog roka, ne računajući neradne dane i vikende.</p>


<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novi ispit</a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Predmet)</th>
                <th>@Html.DisplayNameFor(model => model.Lokacija)</th>
                <th>@Html.DisplayNameFor(model => model.BrojBodova)</th>
                <th>@Html.DisplayNameFor(model => model.DatumOdrzavanja)</th>
                <th>@Html.DisplayNameFor(model => model.DatumObjave)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Predmet.Naziv)</td>
                    <td>@Html.DisplayFor(modelItem => item.Lokacija)</td>
                    <td>@Html.DisplayFor(modelItem => item.BrojBodova)</td>
                    <td>@item.DatumOdrzavanja.ToShortDateString()</td>
                    <td>@item.DatumObjave.ToShortDateString()</td>
                    <td>
                        <form asp-action="Prijavi" asp-controller="Ispiti" method="post">
                            <input type="hidden" name="ispitId" value="@item.Id" />
                            <button type="submit" class="btn btn-success">Prijavi se</button>
                        </form>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nema ispita za prikaz.</p>
}
