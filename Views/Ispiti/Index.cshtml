@model IEnumerable<StudentHub.ViewModels.IspitDetailsViewModel>

@{
    ViewData["Title"] = "Lista ispita po studijskim programima i predmetima";
    bool showArchivedParam = ViewBag.ShowArchived ?? false;
}

<h1 class="text-center my-4">@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<p class="text-center text-muted mb-4">
    Rok za prijavu ispita je 3 dana prije ispitnog roka, ne računajući neradne dane i vikende.
</p>

@if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
{
    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Kreiraj novi ispit
        </a>
    </div>

    <!-- FILTERI: showArchived, Sort, Search -->
    <form method="get" class="text-center mb-4">

        <div class="form-check form-switch d-inline-block me-4">
            <input class="form-check-input" type="checkbox" id="showArchived" name="showArchived" value="true"
                   @(showArchivedParam ? "checked" : "") onchange="this.form.submit()" />
            <label class="form-check-label ms-2" for="showArchived">Prikaži arhivirane ispite</label>
        </div>

        <div class="form-group d-inline-block me-4">
            <label for="sortOrder" class="me-2">Sortiraj po:</label>
            <select name="sortOrder" id="sortOrder" class="form-select d-inline-block w-auto" onchange="this.form.submit()">
                <option value="">Datum rastuće</option>
                <option value="date_desc" selected="@(Context.Request.Query["sortOrder"] == "date_desc" ? "selected" : null)">Datum opadajuće</option>
                <option value="Location" selected="@(Context.Request.Query["sortOrder"] == "Location" ? "selected" : null)">Lokacija A-Z</option>
                <option value="location_desc" selected="@(Context.Request.Query["sortOrder"] == "location_desc" ? "selected" : null)">Lokacija Z-A</option>
                <option value="Points" selected="@(Context.Request.Query["sortOrder"] == "Points" ? "selected" : null)">Broj bodova rastuće</option>
                <option value="points_desc" selected="@(Context.Request.Query["sortOrder"] == "points_desc" ? "selected" : null)">Broj bodova opadajuće</option>
            </select>
        </div>

        <div class="form-group d-inline-block">
            <input type="text" name="searchPredmet" value="@Context.Request.Query["searchPredmet"]"
                   class="form-control d-inline-block w-auto" placeholder="Pretraži predmet..." onchange="this.form.submit()" />
        </div>

    </form>
}

<div class="container">
    @if (Model != null && Model.Any())
    {
        @foreach (var program in Model)
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@program.StudijskiProgram.Naziv</h4>
                </div>
                <div class="card-body">
                    @foreach (var plan in program.NastavniPlanovi)
                    {
                        <h5 class="text-secondary mt-3">Nastavni plan za @plan.NastavniPlan.GodinaStudija. godinu</h5>

                        @if (plan.Predmeti.Any())
                        {
                            <div class="accordion mt-3" id="predmetAccordion-@plan.NastavniPlan.Id">
                                @for (int i = 0; i < plan.Predmeti.Count; i++)
                                {
                                    var predmet = plan.Predmeti[i];
                                    <div class="card">
                                        <div class="card-header" id="heading-@i-@plan.NastavniPlan.Id">
                                            <h5 class="mb-0">
                                                <button class="btn btn-link collapsed" type="button"
                                                        data-toggle="collapse"
                                                        data-target="#collapse-@i-@plan.NastavniPlan.Id"
                                                        aria-expanded="false">
                                                    @predmet.Predmet.Naziv
                                                </button>
                                            </h5>
                                        </div>
                                        <div id="collapse-@i-@plan.NastavniPlan.Id"
                                             class="collapse"
                                             data-parent="#predmetAccordion-@plan.NastavniPlan.Id">
                                            <div class="card-body">
                                                @foreach (var ispit in predmet.Ispiti)
                                                {
                                                    <div class="card mb-3">
                                                        <div class="card-body">
                                                            <h6 class="card-title text-primary mb-2">
                                                                Datum održavanja: @ispit.DatumOdrzavanja.ToString("dd.MM.yyyy")
                                                            </h6>
                                                            <p class="mb-1"><strong>Lokacija:</strong> @ispit.Lokacija</p>
                                                            <p class="mb-1"><strong>Broj bodova:</strong> @ispit.BrojBodova</p>
                                                            <p class="mb-3"><strong>Uslov za polaganje:</strong> @ispit.UslovZaPolaganje</p>

                                                            <div class="d-flex flex-wrap">
                                                                <a asp-action="Details" asp-route-id="@ispit.Id"
                                                                   class="btn btn-info btn-sm mr-2 mb-2">
                                                                    <i class="fas fa-info-circle"></i> Detalji
                                                                </a>

                                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                                {
                                                                    <a asp-action="Edit" asp-route-id="@ispit.Id"
                                                                       class="btn btn-warning btn-sm mr-2 mb-2">
                                                                        <i class="fas fa-edit"></i> Izmjena
                                                                    </a>
                                                                    <a asp-action="Delete" asp-route-id="@ispit.Id"
                                                                       class="btn btn-danger btn-sm mr-2 mb-2">
                                                                        <i class="fas fa-trash-alt"></i> Brisanje
                                                                    </a>
                                                                }

                                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Studentska služba"))
                                                                {
                                                                    if (ispit.DatumOdrzavanja < DateTime.Now && !ispit.Arhivirano)
                                                                    {
                                                                        <form asp-action="Arhiviraj" asp-route-id="@ispit.Id" method="post" class="mr-2 mb-2">
                                                                            @Html.AntiForgeryToken()
                                                                            <button type="submit" class="btn btn-secondary btn-sm">
                                                                                <i class="fas fa-archive"></i> Arhiviraj
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    else if (ispit.Arhivirano)
                                                                    {
                                                                        <form asp-action="VratiIzArhive" asp-route-id="@ispit.Id" method="post" class="mr-2 mb-2 d-inline-block">
                                                                            @Html.AntiForgeryToken()
                                                                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                                                                <i class="fas fa-undo"></i> Vrati iz arhive
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                }

                                                                @if (User.IsInRole("Student"))
                                                                {
                                                                    var prijavljen = program.PrijavljeniIspitiIds.Contains(ispit.Id);
                                                                    var imaOcjenu = program.Ocjene.ContainsKey(ispit.PredmetId);
                                                                    var prijavaDozvoljena = ispit.DatumOdrzavanja.AddDays(-3) > DateTime.Now;

                                                                    // DODANO: provjera da li je student upisan na ovaj predmet
                                                                    var studentNaPredmetu = program.NastavniPlanovi
                                                                    .SelectMany(np => np.Predmeti)
                                                                    .Any(p => p.Predmet.Id == ispit.PredmetId);

                                                                    // Ako NIJE student na predmetu — NE prikazuj ništa (dodajemo ovaj zaštitni sloj)
                                                                    if (!studentNaPredmetu)
                                                                    {
                                                                        <span class="text-muted small align-self-center mr-2 mb-2">
                                                                            Niste upisani na ovaj predmet.
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        // Ako IMA OCJENU → tekst
                                                                        if (imaOcjenu)
                                                                        {
                                                                            <span class="text-muted small align-self-center mr-2 mb-2">
                                                                                Već imate ocjenu iz ovog predmeta
                                                                            </span>
                                                                        }
                                                                        // Ako je PRIJAVLJEN → prikaz odjave
                                                                        else if (prijavljen)
                                                                        {
                                                                            if (prijavaDozvoljena)
                                                                            {
                                                                                <form asp-action="Odjavi" asp-route-id="@ispit.Id" method="post" class="mr-2 mb-2">
                                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                                                        <i class="fas fa-times"></i> Odjavi se
                                                                                    </button>
                                                                                </form>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted small align-self-center mr-2 mb-2">
                                                                                    Rok za odjavu je istekao.
                                                                                </span>
                                                                            }
                                                                        }
                                                                        // Ako NIJE prijavljen → prikaz prijave
                                                                        else
                                                                        {
                                                                            if (prijavaDozvoljena)
                                                                            {
                                                                                <form asp-action="Prijavi" asp-route-id="@ispit.Id" method="post" class="mr-2 mb-2">
                                                                                    <button type="submit" class="btn btn-success btn-sm">
                                                                                        <i class="fas fa-check"></i> Prijavi se
                                                                                    </button>
                                                                                </form>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted small align-self-center mr-2 mb-2">
                                                                                    Rok za prijavu je istekao.
                                                                                </span>
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-2">Nema dostupnih ispita za ovaj nastavni plan.</p>
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            <strong>Nema dostupnih ispita!</strong>
        </div>
    }
</div>

<div class="text-center mt-5">
    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
    </a>
</div>

@section Scripts {
    <script>
        // Inicijalizacija Bootstrap komponenti
        $(document).ready(function(){
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}

<style>
    .btn-sm {
        font-size: 0.85rem;
        padding: 0.35rem 0.75rem;
    }

    .card-header .btn-link {
        color: #495057;
        text-decoration: none;
        width: 100%;
        text-align: left;
        position: relative;
    }

        .card-header .btn-link:after {
            content: '\f107';
            font-family: 'Font Awesome 5 Free';
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
        }

        .card-header .btn-link.collapsed:after {
            content: '\f105';
        }

    .card-title {
        font-weight: 600;
    }

    .accordion .card {
        margin-bottom: 0.5rem;
        border: 1px solid rgba(0,0,0,.125);
    }
</style>