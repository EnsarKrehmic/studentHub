@model StudentHub.Models.Komentar

@{
    ViewData["Title"] = "Brisanje komentara";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj komentar?";
    ViewData["WarningDetails"] = null;
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Sadržaj"] = Model.Sadrzaj,
        ["Student"] = Model.Student != null
                                     ? $"{Model.Student.Ime} {Model.Student.Prezime}"
                                     : "–",
        ["Datum i vrijeme"] = Model.DatumVrijeme.ToString("dd.MM.yyyy HH:mm"),
        ["Nastavna aktivnost"] = Model.NastavnaAktivnost?.Naziv ?? "–"
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
