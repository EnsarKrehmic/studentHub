@model StudentHub.Models.Komentar
@using StudentHub.Models

@{
    ViewData["Title"] = "Detalji komentara";
}

<div class="container my-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Sadržaj:</dt>
                <dd class="col-sm-8">@Model.Sadrzaj</dd>

                <dt class="col-sm-4">Autor:</dt>
                <dd class="col-sm-8">
                    @if (Model.Student != null)
                    {
                        <i class="fas fa-user-graduate text-primary me-1"></i>
                        @Model.AutorDisplayName
                    }
                    else if (Model.Korisnik != null)
                    {
                        <i class="fas fa-user text-secondary me-1"></i>
                        @Model.AutorDisplayName
                    }
                    else
                    {
                        <span class="text-muted">Nepoznat</span>
                    }
                </dd>

                <dt class="col-sm-4">Datum i vrijeme:</dt>
                <dd class="col-sm-8">@Model.DatumVrijeme.ToString("dd.MM.yyyy HH:mm")</dd>

                @if (Model.NastavnaAktivnost != null || Model.Ispit != null)
                {
                    <dt class="col-sm-4">Povezano uz:</dt>
                    <dd class="col-sm-8">@Model.PovezanaEntitetDisplay</dd>
                }

                <dt class="col-sm-4">Vidljivost:</dt>
                <dd class="col-sm-8">@Model.Vidljivost.GetDisplayName()</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        @if (Model.NastavnaAktivnostId.HasValue)
        {
            <a asp-controller="NastavneAktivnosti"
               asp-action="Details"
               asp-route-id="@Model.NastavnaAktivnostId"
               class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad
            </a>
        }
        else if (Model.IspitId.HasValue)
        {
            <a asp-controller="Ispiti"
               asp-action="Details"
               asp-route-id="@Model.IspitId"
               class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad
            </a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad
            </a>
        }
    </div>
</div>
