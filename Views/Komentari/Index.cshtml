@model IEnumerable<StudentHub.Models.Komentar>
@{
    ViewData["Title"] = $"Komentari za {ViewBag.NastavnaAktivnostNaziv}";
    var aktivnostId = (long)ViewBag.NastavnaAktivnostId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="fas fa-comments me-2"></i>@ViewData["Title"]</h2>
        @if (User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Student"))
        {
            <a asp-action="Create"
               asp-route-nastavnaAktivnostId="@aktivnostId"
               class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Novi komentar
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> Još nema komentara za ovu aktivnost.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Sadržaj</th>
                                <th>Autor</th>
                                <th>Datum i vrijeme</th>
                                <th class="text-center">Akcije</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in Model)
                            {
                                <tr>
                                    <td>@k.Sadrzaj</td>
                                    <td>
                                        @if (k.Student != null)
                                        {
                                            <i class="fas fa-user-graduate text-primary me-1"></i>
                                            @($"{k.Student.Ime} {k.Student.Prezime}")
                                        }
                                        else if (k.Korisnik != null)
                                        {
                                            <i class="fas fa-user text-secondary me-1"></i>
                                            @($"{k.Korisnik.Ime} {k.Korisnik.Prezime}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Nepoznat</span>
                                        }
                                    </td>
                                    <td>@k.DatumVrijeme.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-action="Details"
                                           asp-route-id="@k.Id"
                                           class="btn btn-sm btn-outline-info me-1"
                                           title="Detalji">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @* Ovdje se mogu vraćati i Edit/Delete dugmad prema pravima *@
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <a asp-controller="NastavneAktivnosti"
       asp-action="Details"
       asp-route-id="@aktivnostId"
       class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Nazad na aktivnost
    </a>
</div>
