@model List<StudentHub.Models.ZahtjevZaPrisustvo>

@{
    ViewData["Title"] = "Zahtjevi za prisustvo";
    var predmeti = Model.Select(z => z.NastavnaAktivnost?.Predmet?.Naziv).Distinct().OrderBy(n => n).ToList();
    var ukupno = Model.Count;
    var brojVazecih = Model.Count(z => z.NastavnaAktivnost?.KodAktivanDo > DateTime.Now);
    var brojIsteklih = Model.Count(z => z.NastavnaAktivnost?.KodAktivanDo <= DateTime.Now);
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-user-check text-primary me-2"></i> @ViewData["Title"]
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="fas fa-info-circle me-2"></i> Trenutno nema zahtjeva za obradu.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <span class="badge bg-primary w-100 py-2">Ukupno: @ukupno</span>
            </div>
            <div class="col-md-3">
                <span class="badge bg-success w-100 py-2">Važećih: @brojVazecih</span>
            </div>
            <div class="col-md-3">
                <span class="badge bg-danger w-100 py-2">Isteklih: @brojIsteklih</span>
            </div>
        </div>

        <div class="card card-body shadow-sm mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" id="pretragaStudenta" placeholder="🔍 Pretraga po imenu ili indeksu..." />
                </div>
                <div class="col-md-6">
                    <select class="form-select" id="filterPredmeta">
                        <option value="">🎓 Filter po predmetu</option>
                        @foreach (var predmet in predmeti)
                        {
                            <option value="@predmet">@predmet</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- ISPRAVLJENA FORMA -->
        <form method="post" asp-controller="MojiPodaci" asp-action="ObradiOznaceneZahtjeve" id="obradaForma">
            @Html.AntiForgeryToken()

            <div class="table-responsive shadow-sm">
                <table class="table table-bordered table-hover align-middle" id="tabelaZahtjeva">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th><input type="checkbox" id="selectAll" /></th>
                            <th>Student</th>
                            <th>Indeks</th>
                            <th>Predmet</th>
                            <th>Aktivnost</th>
                            <th>Kod</th>
                            <th>Status</th>
                            <th>Vrijeme</th>
                            <th>Napomena</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var zahtjev in Model)
                        {
                            var kodValidan = zahtjev.NastavnaAktivnost?.KodAktivanDo > DateTime.Now;
                            var novo = (DateTime.Now - zahtjev.VrijemePodnosenja).TotalMinutes <= 60;

                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" name="oznaceniZahtjevi" value="@zahtjev.Id" />
                                </td>
                                <td>@zahtjev.Student.Ime @zahtjev.Student.Prezime</td>
                                <td>@zahtjev.Student.BrojIndeksa</td>
                                <td>@zahtjev.NastavnaAktivnost?.Predmet?.Naziv</td>
                                <td>@zahtjev.NastavnaAktivnost?.Naziv</td>
                                <td><code>@zahtjev.KodUnesen</code></td>
                                <td class="text-center">
                                    <span class="badge @(kodValidan ? "bg-success" : "bg-danger")">
                                        @(kodValidan ? "Važeći" : "Istekao")
                                    </span>
                                    @if (novo)
                                    {
                                        <span class="badge bg-info text-dark ms-1">Novo</span>
                                    }
                                </td>
                                <td class="text-nowrap">@zahtjev.VrijemePodnosenja.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" name="napomena_@zahtjev.Id" placeholder="Npr. kasni unos" />
                                </td>
                                <td class="text-center">
                                    <form asp-controller="NastavneAktivnosti" asp-action="PotvrdiPrisustvoStudentu"
                                          asp-route-zahtjevId="@zahtjev.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-success" title="Potvrdi">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="NastavneAktivnosti" asp-action="OdbijPrisustvoStudentu"
                                          asp-route-zahtjevId="@zahtjev.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" title="Odbij">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-check-double me-1"></i> Obradi označene
                </button>
                <a asp-controller="MojiPodaci" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Nazad na Moje podatke
                </a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('selectAll').addEventListener('click', function () {
            document.querySelectorAll('input[name="oznaceniZahtjevi"]').forEach(cb => cb.checked = this.checked);
        });

        document.getElementById('pretragaStudenta').addEventListener('input', filterTabela);
        document.getElementById('filterPredmeta').addEventListener('change', filterTabela);

        function filterTabela() {
            let tekst = document.getElementById('pretragaStudenta').value.toLowerCase();
            let predmet = document.getElementById('filterPredmeta').value.toLowerCase();
            document.querySelectorAll('#tabelaZahtjeva tbody tr').forEach(row => {
                let tekstReda = row.innerText.toLowerCase();
                let predmetReda = row.children[3].innerText.toLowerCase();
                row.style.display = (!tekst || tekstReda.includes(tekst)) && (!predmet || predmetReda.includes(predmet)) ? '' : 'none';
            });
        }

        document.getElementById('obradaForma').addEventListener('submit', function (e) {
            const checked = Array.from(document.querySelectorAll('input[name="oznaceniZahtjevi"]:checked'));
            if (checked.length === 0) {
                e.preventDefault();
                alert("Niste označili nijedan zahtjev za obradu.");
            }
        });

        document.addEventListener("DOMContentLoaded", () => {
            [...document.querySelectorAll('[data-bs-toggle="tooltip"]')]
                .forEach(el => new bootstrap.Tooltip(el));
        });
    </script>
}
