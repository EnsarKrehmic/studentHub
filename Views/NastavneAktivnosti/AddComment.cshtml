@model StudentHub.Models.Komentar

@{
    ViewData["Title"] = "Dodaj komentar";
    var nastId = Model.NastavnaAktivnostId;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-comment-alt me-2"></i>@ViewData["Title"]
        </h2>
        <a asp-controller="NastavneAktivnosti"
           asp-action="Details"
           asp-route-id="@nastId"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na aktivnost
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-plus-circle me-1"></i> Novi komentar</h5>
        </div>
        <div class="card-body">
            <form asp-action="AddComment"
                  asp-route-nastavnaAktivnostId="@nastId"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Sadrzaj" class="form-label fw-bold">Sadržaj:</label>
                    <textarea asp-for="Sadrzaj"
                              class="form-control"
                              rows="5"
                              placeholder="Unesite svoj komentar..."
                              required></textarea>
                    <span asp-validation-for="Sadrzaj" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Vidljivost" class="form-label fw-bold">Vidljivost:</label>
                    <select asp-for="Vidljivost"
                            class="form-select"
                            id="vidljivostSelect"
                            required>
                        <option value="">-- Odaberite --</option>
                        <option value="Javno">Javno</option>
                        <option value="Privatno">Privatno</option>
                    </select>
                    <span asp-validation-for="Vidljivost" class="text-danger small"></span>
                </div>

                <div class="mb-3" id="odabirKorisnika" style="display:none;">
                    <label for="korisniciSelect" class="form-label fw-bold">
                        Odaberi korisnike:
                    </label>
                    <select id="korisniciSelect"
                            name="OdabraniKorisnici"
                            class="form-select"
                            multiple
                            size="6">
                        <!-- puni se AJAX-om -->
                    </select>
                    <small class="form-text text-muted">
                        Držite <kbd>Ctrl</kbd> ili <kbd>Cmd</kbd> za višestruki odabir.
                    </small>
                </div>

                <div class="mb-4">
                    <label for="prilog" class="form-label fw-bold">Prilog (opcionalno):</label>
                    <input type="file"
                           name="Prilog"
                           id="prilog"
                           class="form-control"
                           accept="image/*,.pdf,.docx" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-1"></i> Objavi komentar
                    </button>
                    <a asp-controller="NastavneAktivnosti"
                       asp-action="Details"
                       asp-route-id="@nastId"
                       class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var nastId = '@nastId';
            function loadUsers(selected = []) {
                if (!nastId) return;
                $.get('/NastavneAktivnosti/GetVidljiviKorisnici/' + nastId, function (data) {
                    var sel = $('#korisniciSelect').empty();
                    if (!data.length) {
                        sel.append(new Option('Nema dostupnih korisnika', ''));
                    } else {
                        data.forEach(function (u) {
                            var opt = new Option(u.ime + ' ('+u.uloga+')', u.id);
                            if (selected.includes(u.id)) opt.selected = true;
                            sel.append(opt);
                        });
                    }
                });
            }

            $('#vidljivostSelect').change(function () {
                var isPriv = $(this).val() === 'Privatno';
                $('#odabirKorisnika').toggle(isPriv);
                if (isPriv) loadUsers();
            });

            // on load
            if ($('#vidljivostSelect').val() === 'Privatno') {
                $('#odabirKorisnika').show();
                loadUsers();
            }
        });
    </script>
}
