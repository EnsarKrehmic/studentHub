@model StudentHub.Models.Komentar

@{
    ViewData["Title"] = "Dodaj komentar";
    var nastavnaAktivnostId = Model.NastavnaAktivnostId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Dodaj komentar</h2>
        <a asp-controller="NastavneAktivnosti" asp-action="Details" asp-route-id="@nastavnaAktivnostId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Nazad na aktivnost
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-comment"></i> Novi komentar</h5>
        </div>
        <div class="card-body">
            <form asp-action="AddComment" asp-route-nastavnaAktivnostId="@nastavnaAktivnostId" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="sadrzaj" class="form-label">Sadržaj komentara:</label>
                    <textarea name="sadrzaj" id="sadrzaj" class="form-control" rows="5" required placeholder="Unesite svoj komentar..."></textarea>
                </div>

                <div class="form-group mt-3">
                    <label for="vidljivostSelect" class="form-label">Vidljivost komentara:</label>
                    <select name="vidljivost" id="vidljivostSelect" class="form-control" required>
                        <option value="Javno">Javno</option>
                        <option value="Privatno">Privatno</option>
                    </select>
                </div>

                <div class="form-group mt-3" id="odabirKorisnika" style="display:none;">
                    <label for="korisniciSelect" class="form-label">Odaberi korisnike koji mogu vidjeti komentar:</label>
                    <select id="korisniciSelect" name="odabraniKorisnici" class="form-control" multiple size="6">
                        <!-- puni se AJAX-om -->
                    </select>
                </div>

                <div class="form-group mt-3">
                    <label for="prilog" class="form-label">Prilog (opcionalno):</label>
                    <input type="file" name="prilog" id="prilog" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary mt-3">
                    <i class="fas fa-paper-plane"></i> Objavi komentar
                </button>
                <a asp-controller="NastavneAktivnosti" asp-action="Details" asp-route-id="@nastavnaAktivnostId" class="btn btn-outline-secondary">
                    ↩️ Nazad
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const nastavnaAktivnostId = '@nastavnaAktivnostId'.trim();

            function ucitajVidljiveKorisnike(oznaceniKorisnici = []) {
                if (!nastavnaAktivnostId) {
                    console.error("Greška: nastavnaAktivnostId nije postavljen!");
                    return;
                }

                $.get('/NastavneAktivnosti/GetVidljiviKorisnici/' + nastavnaAktivnostId, function (data) {
                    var korisniciSelect = $('#korisniciSelect');
                    korisniciSelect.empty();

                    if (data.length === 0) {
                        korisniciSelect.append(new Option("Nema dostupnih korisnika", ""));
                    } else {
                        data.forEach(function (k) {
                            var option = new Option(k.ime + ' (' + k.uloga + ')', k.id);
                            if (oznaceniKorisnici.includes(parseInt(k.id))) {
                                option.selected = true;
                            }
                            korisniciSelect.append(option);
                        });
                    }
                });
            }

            $('#vidljivostSelect').change(function () {
                $('#odabirKorisnika').toggle($(this).val() === 'Privatno');
                if ($(this).val() === 'Privatno') {
                    ucitajVidljiveKorisnike([]);
                }
            });

            // Ako je već PRIVATNO na loadu (edge case)
            if ($('#vidljivostSelect').val() === 'Privatno') {
                $('#odabirKorisnika').show();
                ucitajVidljiveKorisnike([]);
            }
        });
    </script>
}

