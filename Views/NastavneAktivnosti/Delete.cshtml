@model StudentHub.Models.NastavnaAktivnost

@{
    ViewData["Title"] = "Brisanje nastavne aktivnosti";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovu aktivnost?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve povezane podatke (materijale, komentare i ocjene).";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Naziv"] = Model.Naziv,
        ["Tip"] = Model.Tip,
        ["Datum i vrijeme"] = Model.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm"),
        ["Status"] = Html.Raw(
                        (Model.JeDostupno
                            ? "<span class='badge bg-success'>Dostupno</span>"
                            : "<span class='badge bg-secondary'>Zaključano</span>")
                        + (Model.ManuelnoOtkljucano
                            ? " <span class='badge bg-warning text-dark'>Manuelno otključano</span>"
                            : "")
                    ),
        ["Predmet"] = Model.Predmet?.Naziv ?? "–",
        ["Broj materijala"] = Model.NastavniMaterijali?.Count ?? 0,
        ["Broj komentara"] = Model.Komentari?.Count ?? 0
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
