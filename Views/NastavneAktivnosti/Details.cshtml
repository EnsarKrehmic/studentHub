@model StudentHub.Models.NastavnaAktivnost
@using StudentHub.Models
@using System.Security.Claims

<div class="container py-4">
    <!-- Naslov i navigacija -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">@Model.Naziv</h2>
            <small class="text-muted">Predmet: <strong>@Model.Predmet.Naziv</strong></small>
        </div>
        <div class="btn-group">
            <a asp-controller="Predmeti"
               asp-action="Details"
               asp-route-id="@Model.PredmetId"
               class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad
            </a>
            @if (!User.IsInRole("Student"))
            {
                <a asp-action="Index"
                   asp-route-predmetId="@Model.PredmetId"
                   class="btn btn-outline-primary ms-2">
                    <i class="fas fa-list me-1"></i> Sve aktivnosti
                </a>
            }
        </div>
    </div>

    <!-- Osnovne informacije -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-info-circle text-secondary me-2"></i> Osnovne informacije</h5>
            @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
            {
                <div class="btn-group">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-warning d-flex align-items-center">
                        <i class="fas fa-edit me-1"></i> Uredi
                    </a>
                    <form asp-action="ToggleLock" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit"
                                class="btn btn-sm @GetLockButtonClass() d-flex align-items-center ms-2"
                                data-bs-toggle="tooltip"
                                title="@GetLockButtonTooltip()">
                            <i class="@GetLockButtonIcon() me-1"></i> @GetLockButtonText()
                        </button>
                    </form>
                </div>
            }
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Lijevi stupac -->
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-5">Tip aktivnosti:</dt>
                        <dd class="col-7">@Model.Tip</dd>

                        <dt class="col-5">Datum i vrijeme:</dt>
                        <dd class="col-7">@Model.DatumVrijemeOdrzavanja</dd>

                        <dt class="col-5">Status pristupa:</dt>
                        <dd class="col-7">
                            <span class="badge @(Model.JeDostupno ? "bg-success" : "bg-secondary")">
                                @(Model.JeDostupno ? "Dostupno" : "Zaključano")
                            </span>
                            @if (Model.ManuelnoOtkljucano)
                            {
                                <span class="badge bg-warning text-dark ms-1">Manuelno otključano</span>
                            }
                        </dd>

                        @* Student: Prijava prisustva *@
                        @if (User.IsInRole("Student") && Model.JeDostupno)
                        {
                            var statusZahtjeva = TempData["StatusZahtjeva"] as string;
                            var prisPotvrdjeno = ViewBag.PrisustvoPotvrđeno as bool? ?? false;
                            <dt class="col-5">Prisustvo:</dt>
                            <dd class="col-7">
                                @if (!prisPotvrdjeno && (string.IsNullOrEmpty(statusZahtjeva) || statusZahtjeva.Contains("odbijen")))
                                {
                                    <a asp-action="PrijavaPrisustva"
                                       asp-route-nastavnaAktivnostId="@Model.Id"
                                       class="btn btn-sm btn-outline-success">
                                        <i class="fas fa-qrcode me-1"></i> Prijavi prisustvo
                                    </a>
                                }
                                @if (prisPotvrdjeno || !string.IsNullOrEmpty(statusZahtjeva))
                                {
                                    var poruka = prisPotvrdjeno
                                    ? "Vaše prisustvo je potvrđeno."
                                    : statusZahtjeva;
                                    var klasa = prisPotvrdjeno
                                    ? "alert-success"
                                    : statusZahtjeva.Contains("odbijen") ? "alert-danger" : "alert-warning";

                                    <div class="alert @klasa py-1 px-2 mt-2 mb-0">
                                        <i class="fas fa-info-circle me-1"></i>@poruka
                                    </div>
                                }
                            </dd>
                        }
                    </dl>
                </div>

                <!-- Desni stupac -->
                <div class="col-md-6 border-start">
                    <dl class="row mb-0">
                        <dt class="col-5">Broj prisutnih:</dt>
                        <dd class="col-7">@ViewBag.BrojPrisutnih / @ViewBag.BrojUkupnoStudenata</dd>

                        <dt class="col-5">Broj materijala:</dt>
                        <dd class="col-7">@Model.NastavniMaterijali.Count</dd>

                        <dt class="col-5">Broj komentara:</dt>
                        <dd class="col-7">@Model.Komentari.Count</dd>
                    </dl>
                </div>
            </div>

            @* Kod za prisustvo za profesore/asistente *@
            @if ((User.IsInRole("Profesor") || User.IsInRole("Asistent")))
            {
                <div class="mt-4">
                    @if (!string.IsNullOrEmpty(Model.KodZaPrisustvo) && Model.KodAktivanDo > DateTime.Now)
                    {
                        <div class="alert alert-success d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Kod za prisustvo:</strong> <code class="fs-5">@Model.KodZaPrisustvo</code>
                                <br />Važi do: <strong>@Model.KodAktivanDo:HH:mm</strong>
                            </div>
                            <form asp-action="GenerisiKodPrisustva"
                                  asp-route-aktivnostId="@Model.Id"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-redo-alt me-1"></i> Novi kod
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form asp-action="GenerisiKodPrisustva"
                              asp-route-aktivnostId="@Model.Id"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-success btn-sm">
                                <i class="fas fa-key me-1"></i> Generiši kod
                            </button>
                        </form>
                    }

                    @if (Model.ManuelnoZakljucano)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Aktivnost je zaključana.
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Nastavni materijali -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i> Nastavni materijali</h5>
        </div>
        <div class="card-body">
            @if (Model.NastavniMaterijali.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var m in Model.NastavniMaterijali)
                    {
                        var fajlovi = m.Fajlovi?.Count() ?? 0;
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@m.Naziv</strong>
                                @if (!string.IsNullOrEmpty(m.Opis))
                                {
                                    <div class="text-muted small">@m.Opis</div>
                                }
                                <div class="small text-muted">
                                    <i class="fas fa-paperclip me-1"></i>@fajlovi @((fajlovi == 1) ? "fajl" : "fajla")
                                </div>
                            </div>
                            @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                            {
                                <a asp-controller="NastavniMaterijali"
                                   asp-action="Index"
                                   asp-route-nastavnaAktivnostId="@Model.Id"
                                   class="btn btn-outline-light btn-sm">
                                    <i class="fas fa-cog me-1"></i> Upravljaj
                                </a>
                            }
                            else if (fajlovi > 0)
                            {
                                <a asp-controller="NastavniMaterijali"
                                   asp-action="Index"
                                   asp-route-nastavnaAktivnostId="@Model.Id"
                                   class="btn btn-outline-success btn-sm">
                                    <i class="fas fa-download me-1"></i> Preuzmi
                                </a>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-1"></i> Nema dostupnih materijala.
                </div>
            }
        </div>
    </div>

    <!-- Komentari -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-comments me-2"></i> Komentari</h5>
            <a asp-controller="NastavneAktivnosti"
               asp-action="AddComment"
               asp-route-nastavnaAktivnostId="@Model.Id"
               class="btn btn-light btn-sm">
                <i class="fas fa-plus me-1"></i> Dodaj komentar
            </a>
        </div>
        <div class="card-body">
            @if (Model.Komentari.Any())
            {
                var currId = (long)ViewBag.TrenutniKorisnikId;
                @foreach (var k in Model.Komentari.OrderByDescending(c => c.DatumVrijeme))
                {
                    var canView = k.Vidljivost == VidljivostKomentara.Javno
                    || (k.Vidljivost == VidljivostKomentara.Privatno
                    && (k.KorisnikId == currId
                    || k.VidljivostKorisnici.Any(v => v.KorisnikId == currId)));
                    if (!canView) continue;

                    <div class="border rounded p-3 mb-3 komentar-item">
                        <div class="d-flex justify-content-between mb-2">
                            <div class="fw-semibold">
                                <i class="@(k.Student != null ? "fas fa-user-graduate" : "fas fa-user") me-1"></i>
                                @(k.Student != null
                                                        ? $"{k.Student.Ime} {k.Student.Prezime}"
                                                        : $"{k.Korisnik.Ime} {k.Korisnik.Prezime}")
                    </div>
                    <small class="text-muted">@k.DatumVrijeme:dd.MM.yyyy HH:mm</small>
                </div>
                <p class="mb-2">@k.Sadrzaj</p>
                @if (!string.IsNullOrEmpty(k.PrilogPath))
                        {
                            <p class="small">
                                📎 <a href="@k.PrilogPath" target="_blank">Preuzmi prilog</a>
                            </p>
                        }
                        <div class="d-flex justify-content-end gap-2">
                            @if ((k.KorisnikId == currId) || User.IsInRole("Studentska služba"))
                            {
                                <a asp-action="EditKomentar"
                                   asp-route-id="@k.Id"
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="fas fa-edit me-1"></i> Uredi
                                </a>
                                <form asp-action="DeleteKomentar"
                                      asp-route-id="@k.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Obrisati komentar?');">
                                        <i class="fas fa-trash me-1"></i> Obriši
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-1"></i> Nema komentara.
                </div>
            }
        </div>
    </div>

    @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
    {
        var statusi = ViewBag.StudentStatusi as List<(StudentHub.Models.Student student, string status, StudentHub.Models.ZahtjevZaPrisustvo zahtjev)>;
        if (statusi != null && statusi.Any())
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-user-check me-2"></i>Prisustvo studenata</h5>
                    <a asp-action="EvidentirajPrisustvo"
                       asp-route-nastavnaAktivnostId="@Model.Id"
                       class="btn btn-sm btn-outline-light">
                        <i class="fas fa-edit me-1"></i> Evidentiraj sve
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ime i prezime</th>
                                    <th>Broj indeksa</th>
                                    <th>Status</th>
                                    <th class="text-center">Akcija</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in statusi)
                                {
                                    var student = entry.student;
                                    var status = entry.status;
                                    var zahtjev = entry.zahtjev;
                                    <tr>
                                        <td>@student.Ime @student.Prezime</td>
                                        <td>@student.BrojIndeksa</td>
                                        <td>
                                            @if (status == "Prisutan")
                                            {
                                                <span class="badge bg-success">Prisutan</span>
                                            }
                                            else if (status == "Čeka potvrdu")
                                            {
                                                <span class="badge bg-warning text-dark">Čeka potvrdu</span>
                                                <div class="small text-muted mt-1">
                                                    Kod: <code>@zahtjev.KodUnesen</code><br />
                                                    @zahtjev.VrijemePodnosenja:HH:mm:ss
                                                    @if (!string.IsNullOrEmpty(zahtjev.Napomena))
                                                    {
                                                        <div class="mt-1">Napomena: @zahtjev.Napomena</div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Nije prisutan</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (status == "Čeka potvrdu" && zahtjev != null)
                                            {
                                                <div class="btn-group gap-1">
                                                    <form asp-action="PotvrdiPrisustvoStudentu"
                                                          asp-route-zahtjevId="@zahtjev.Id"
                                                          method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="btn btn-sm btn-success"
                                                                title="Potvrdi prisustvo">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    </form>
                                                    <form asp-action="OdbijPrisustvoStudentu"
                                                          asp-route-zahtjevId="@zahtjev.Id"
                                                          method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Odbij zahtjev">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning d-flex align-items-center">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Nema dostupnih podataka o studentima za ovu aktivnost.
            </div>
        }
    }
</div>

@functions {
    public string GetLockButtonClass()
    {
        return Model.JeDostupno ? "btn-outline-secondary" : "btn-outline-success";
    }


    public string GetLockButtonIcon()
    {
        return Model.JeDostupno ? "fas fa-lock" : "fas fa-unlock";
    }


    public string GetLockButtonText()
    {
        return Model.JeDostupno ? "Zaključaj" : "Otključaj";
    }


    public string GetLockButtonTooltip()
    {
        return Model.JeDostupno ? "Zaključaj aktivnost" : "Otključaj aktivnost";
    }

}

@section Styles {
    <style>
        .komentar-item {
            transition: transform .2s;
        }

            .komentar-item:hover {
                transform: translateX(4px);
            }

        .badge {
            font-size: .9em;
        }
        
        .card-header h5 {
            font-weight: 500;
        }

        .list-group-item {
            transition: all 0.3s ease;
        }

            .list-group-item:hover {
                transform: translateX(5px);
            }

        .media h6 {
            font-weight: 600;
        }
    </style>
}
