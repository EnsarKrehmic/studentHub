@model StudentHub.Models.NastavnaAktivnost
@using StudentHub.Models

<div class="container">
    <!-- Naslov i povratne navigacije -->
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h2 class="mb-1">@Model.Naziv</h2>
            <span class="text-muted">Predmet: <strong>@Model.Predmet.Naziv</strong></span>
        </div>
        <div class="btn-group">
            <a asp-controller="Predmeti"
               asp-action="Details"
               asp-route-id="@Model.PredmetId"
               class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Nazad
            </a>
            @if (!User.IsInRole("Student"))
            {
                <a asp-action="Index"
                   asp-route-predmetId="@Model.PredmetId"
                   class="btn btn-outline-primary ml-2">
                    <i class="fas fa-list"></i> Sve aktivnosti
                </a>
            }
        </div>
    </div>

    <!-- Info kartica -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-info-circle text-secondary"></i> Osnovne informacije</h5>
            @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
            {
                <div class="d-flex gap-2">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-warning d-flex align-items-center">
                        <i class="fas fa-edit me-1"></i> Uredi
                    </a>

                    <form asp-action="ToggleLock" method="post" class="mb-0">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit"
                                class="btn btn-sm @GetLockButtonClass() d-flex align-items-center"
                                data-toggle="tooltip"
                                title="@GetLockButtonTooltip()">
                            <i class="@GetLockButtonIcon() me-1"></i> @GetLockButtonText()
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Lijevi stupac -->
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-5">Tip aktivnosti:</dt>
                        <dd class="col-sm-7">@Model.Tip</dd>

                        <dt class="col-sm-5">Datum i vrijeme:</dt>
                        <dd class="col-sm-7">@Model.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt class="col-sm-5">Status pristupa:</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.JeDostupno ? "badge-success" : "badge-secondary")">
                                @(Model.JeDostupno ? "Dostupno" : "Zaključano")
                            </span>
                            @if (Model.ManuelnoOtkljucano)
                            {
                                <span class="badge badge-warning ml-1">Manuelno otključano</span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Desni stupac -->
                <div class="col-md-6 border-left">
                    <dl class="row">
                        <dt class="col-sm-5">Prosječna ocjena:</dt>
                        <dd class="col-sm-7">
                            <span class="badge badge-primary">@Model.ProsjecnaOcjena.ToString("F2")</span>
                        </dd>

                        <dt class="col-sm-5">Broj materijala:</dt>
                        <dd class="col-sm-7">@Model.NastavniMaterijali.Count</dd>

                        <dt class="col-sm-5">Broj komentara:</dt>
                        <dd class="col-sm-7">@Model.Komentari.Count</dd>
                    </dl>
                </div>
            </div>

            @if (Model.ManuelnoZakljucano)
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle"></i>
                    Aktivnost je zaključana uprkos isteku vremena održavanja.
                </div>
            }
        </div>
    </div>

    <!-- Materijali -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-file-download"></i> Nastavni materijali</h5>
        </div>
        <div class="card-body">
            @if (Model.NastavniMaterijali.Any())
            {
                <div class="list-group">
                    @foreach (var materijal in Model.NastavniMaterijali)
                    {
                        <a href="@materijal.PutanjaDoFajla" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>@materijal.Naziv</span>
                            <i class="fas fa-download text-primary"></i>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">Nema dostupnih materijala.</div>
            }

            <div class="mt-3">
                <a asp-controller="NastavniMaterijali"
                   asp-action="Index"
                   asp-route-nastavnaAktivnostId="@Model.Id"
                   class="btn btn-outline-primary">
                    <i class="fas fa-cog"></i> Upravljaj materijalima
                </a>
            </div>
        </div>
    </div>

    <!-- Komentari -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-comments"></i> Komentari</h5>
        </div>
        <div class="card-body">
            @if (Model.Komentari.Any())
            {
                foreach (var komentar in Model.Komentari)
                {
                    <div class="media border-bottom pb-3 mb-3">
                        <div class="media-body">
                            <h6 class="mt-0">@komentar.Student.Ime @komentar.Student.Prezime</h6>
                            <p>@komentar.Sadrzaj</p>
                            <small class="text-muted">@komentar.DatumVrijeme.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">Nema komentara.</div>
            }

            <div class="mt-3">
                <a asp-controller="Komentari"
                   asp-action="Index"
                   asp-route-nastavnaAktivnostId="@Model.Id"
                   class="btn btn-outline-info">
                    <i class="fas fa-cog"></i> Upravljaj komentarima
                </a>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetLockButtonClass()
    {
        return Model.JeDostupno ? "btn-outline-secondary" : "btn-outline-success";
    }


    public string GetLockButtonIcon()
    {
        return Model.JeDostupno ? "fas fa-lock" : "fas fa-unlock";
    }


    public string GetLockButtonText()
    {
        return Model.JeDostupno ? "Zaključaj" : "Otključaj";
    }


    public string GetLockButtonTooltip()
    {
        return Model.JeDostupno ? "Zaključaj aktivnost" : "Otključaj aktivnost";
    }

}

@section Styles {
    <style>
        .card-header h5 {
            font-weight: 500;
        }

        .list-group-item {
            transition: all 0.3s ease;
        }

            .list-group-item:hover {
                transform: translateX(5px);
            }

        .media h6 {
            font-weight: 600;
        }

        .badge {
            font-size: 0.9em;
        }
    </style>
}
