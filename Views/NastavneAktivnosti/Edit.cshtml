@model StudentHub.Models.NastavnaAktivnost

@{
    ViewData["Title"] = "Uredi nastavnu aktivnost";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h2>
        <a asp-action="Index" asp-route-predmetId="@Model.PredmetId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Lista aktivnosti
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="PredmetId" />

                <div class="mb-3">
                    <label asp-for="Naziv" class="form-label fw-bold"></label>
                    <input asp-for="Naziv" class="form-control" />
                    <span asp-validation-for="Naziv" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Opis" class="form-label fw-bold"></label>
                    <textarea asp-for="Opis"
                              class="form-control"
                              rows="3"
                              placeholder="Obavezan opis aktivnosti"></textarea>
                    <span asp-validation-for="Opis" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tip" class="form-label fw-bold"></label>
                    <select asp-for="Tip"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<TipNastavneAktivnosti>()">
                    </select>
                    <span asp-validation-for="Tip" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DatumVrijemeOdrzavanja" class="form-label fw-bold"></label>
                    <input asp-for="DatumVrijemeOdrzavanja"
                           type="datetime-local"
                           step="60"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           value="@Model.DatumVrijemeOdrzavanja.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control" />
                    <span asp-validation-for="DatumVrijemeOdrzavanja" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="ManuelnoOtkljucano"
                           type="checkbox"
                           class="form-check-input"
                           id="ManuelnoOtkljucano" />
                    <label asp-for="ManuelnoOtkljucano" class="form-check-label fw-bold"></label>
                </div>

                <div class="alert alert-warning mb-4 @(Model.ManuelnoOtkljucano ? "" : "d-none")" id="lockWarning">
                    <i class="fas fa-exclamation-triangle me-1"></i> Aktivnost je manuelno otključana
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Spremi promjene
                    </button>
                    <a asp-action="Index" asp-route-predmetId="@Model.PredmetId" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var chk = document.getElementById('ManuelnoOtkljucano'),
                warn = document.getElementById('lockWarning');
            chk.addEventListener('change', function() {
                warn.classList.toggle('d-none', !this.checked);
            });
        });
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
