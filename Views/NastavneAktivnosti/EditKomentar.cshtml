@model StudentHub.Models.Komentar

@{
    ViewData["Title"] = "Uredi komentar";
    var nastId = Model.NastavnaAktivnostId;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h2>
        <a asp-controller="NastavneAktivnosti"
           asp-action="Details"
           asp-route-id="@nastId"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na aktivnost
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditKomentar"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.NastavnaAktivnostId)

                <div class="mb-3">
                    <label asp-for="Sadrzaj" class="form-label fw-bold">Sadržaj:</label>
                    <textarea asp-for="Sadrzaj"
                              class="form-control"
                              rows="4"
                              required>@Model.Sadrzaj</textarea>
                    <span asp-validation-for="Sadrzaj" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Vidljivost" class="form-label fw-bold">Vidljivost:</label>
                    <select asp-for="Vidljivost"
                            class="form-select"
                            id="vidljivostSelect">
                        <option value="Javno" selected="@(Model.Vidljivost == VidljivostKomentara.Javno ? "selected" : null)">Javno</option>
                        <option value="Privatno" selected="@(Model.Vidljivost == VidljivostKomentara.Privatno ? "selected" : null)">Privatno</option>
                    </select>
                </div>

                <div class="mb-3" id="odabirKorisnika" style="display:@(Model.Vidljivost == VidljivostKomentara.Privatno ? "block" : "none")">
                    <label for="korisniciSelect" class="form-label fw-bold">
                        Vidljivo korisnicima:
                    </label>
                    <select name="OdabraniKorisnici"
                            id="korisniciSelect"
                            class="form-select"
                            multiple
                            size="6">
                        <!-- puni se AJAX-om -->
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Prilog (opcionalno):</label>
                    <input type="file"
                           name="Prilog"
                           class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.PrilogPath))
                    {
                        <p class="mt-2">
                            Trenutni prilog:
                            <a href="@Model.PrilogPath" target="_blank">📎 Preuzmi</a>
                        </p>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Spasi izmjene
                    </button>
                    <a asp-controller="NastavneAktivnosti"
                       asp-action="Details"
                       asp-route-id="@nastId"
                       class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            var nastId = '@nastId';
            var pre = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.VidljivostKorisnici.Select(v => v.KorisnikId)));
            function load(checked) {
                $.get('/NastavneAktivnosti/GetVidljiviKorisnici/' + nastId, function (data) {
                    var sel = $('#korisniciSelect').empty();
                    data.forEach(function (u) {
                        var opt = new Option(u.ime + ' ('+u.uloga+')', u.id);
                        if (checked.includes(u.id)) opt.selected = true;
                        sel.append(opt);
                    });
                });
            }

            $('#vidljivostSelect').change(function () {
                var priv = $(this).val() === 'Privatno';
                $('#odabirKorisnika').toggle(priv);
                if (priv) load(pre);
            });

            if ($('#vidljivostSelect').val() === 'Privatno') {
                load(pre);
            }
        });
    </script>
}
