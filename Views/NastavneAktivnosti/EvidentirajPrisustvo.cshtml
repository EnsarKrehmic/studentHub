@model StudentHub.ViewModels.EvidencijaPrisustvaViewModel

@{
    ViewData["Title"] = "Evidentiraj prisustvo";
    var aktivnost = Model.NastavnaAktivnost;
}

<div class="container mt-4">
    <!-- Zaglavlje i navigacija -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fas fa-check-square me-2"></i>@ViewData["Title"]</h2>
        <a asp-controller="NastavneAktivnosti"
           asp-action="Details"
           asp-route-id="@aktivnost.Id"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na aktivnost
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-list-check me-2"></i>Odaberi prisutne studente</h5>
        </div>
        <div class="card-body">
            <form asp-action="EvidentirajPrisustvo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="nastavnaAktivnostId" value="@aktivnost.Id" />

                @if (!Model.Studenti.Any())
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Nema studenata na predmetu.
                    </div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 50px;">✔️</th>
                                    <th>Ime i prezime</th>
                                    <th>Broj indeksa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.Studenti)
                                {
                                    var isChecked = Model.PrisutniStudentiIds.Contains(student.Id);
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   name="prisutniStudentiIds"
                                                   value="@student.Id"
                                                   id="student-@student.Id"
                                                   class="form-check-input"
                                                   @(isChecked ? "checked" : "") />
                                        </td>
                                        <td>
                                            <label for="student-@student.Id" class="form-check-label mb-0">
                                                @student.Ime @student.Prezime
                                            </label>
                                        </td>
                                        <td>@student.BrojIndeksa</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Spasi prisustvo
                    </button>
                }
            </form>
        </div>
    </div>
</div>
