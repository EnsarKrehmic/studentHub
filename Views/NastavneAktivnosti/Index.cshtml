@model IEnumerable<StudentHub.Models.NastavnaAktivnost>
@using StudentHub.Models

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-calendar-alt text-primary me-2"></i>
            Nastavne aktivnosti za <span class="text-primary">@ViewBag.PredmetNaziv</span>
        </h2>
        <a asp-controller="Predmeti"
           asp-action="Details"
           asp-route-id="@ViewBag.PredmetId"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na predmet
        </a>
    </div>

    @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
    {
        <div class="mb-4">
            <a asp-action="Create"
               asp-route-predmetId="@ViewBag.PredmetId"
               class="btn btn-primary">
                <i class="fas fa-plus-circle me-1"></i> Dodaj aktivnost
            </a>
        </div>
    }

    <div class="row gy-4">
        @* Predavanja *@
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-chalkboard-teacher me-2"></i> Predavanja
                </div>
                <div class="card-body p-0">
                    @{
                        var predavanja = Model
                        .Where(a => a.Tip == TipNastavneAktivnosti.Predavanje)
                        .OrderBy(a => a.DatumVrijemeOdrzavanja);
                    }
                    @if (predavanja.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Datum</th>
                                        <th>Status</th>
                                        <th class="text-center">Akcije</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in predavanja)
                                    {
                                        <tr class="@(a.JeDostupno ? "" : "table-secondary")">
                                            <td>@a.Naziv</td>
                                            <td>@a.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(a.JeDostupno ? "bg-success" : "bg-secondary")">
                                                    @(a.JeDostupno ? "Dostupno" : "Zaključano")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @if (a.JeDostupno || !User.IsInRole("Student"))
                                                    {
                                                        <a asp-action="Details"
                                                           asp-route-id="@a.Id"
                                                           class="btn btn-outline-info"
                                                           title="Detalji"
                                                           data-bs-toggle="tooltip">
                                                            <i class="fas fa-info-circle"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline-secondary" disabled
                                                                data-bs-toggle="tooltip"
                                                                title="Bit će dostupno @a.DatumVrijemeOdrzavanja:dd.MM.yyyy HH:mm">
                                                            <i class="fas fa-info-circle"></i>
                                                        </button>
                                                    }

                                                    <a asp-controller="Komentari"
                                                       asp-action="Index"
                                                       asp-route-nastavnaAktivnostId="@a.Id"
                                                       class="btn btn-outline-secondary"
                                                       title="Komentari"
                                                       data-bs-toggle="tooltip">
                                                        <i class="fas fa-comments"></i>
                                                    </a>

                                                    @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                    {
                                                        <a asp-action="Edit"
                                                           asp-route-id="@a.Id"
                                                           class="btn btn-outline-warning"
                                                           title="Uredi"
                                                           data-bs-toggle="tooltip">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <a asp-action="Delete"
                                                           asp-route-id="@a.Id"
                                                           class="btn btn-outline-danger"
                                                           title="Obriši"
                                                           data-bs-toggle="tooltip">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">Nema planiranih predavanja</div>
                    }
                </div>
            </div>
        </div>

        @* Vježbe *@
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-dumbbell me-2"></i> Vježbe
                </div>
                <div class="card-body p-0">
                    @{
                        var vjezbe = Model
                        .Where(a => a.Tip == TipNastavneAktivnosti.Vjezba)
                        .OrderBy(a => a.DatumVrijemeOdrzavanja);
                    }
                    @if (vjezbe.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Datum</th>
                                        <th>Status</th>
                                        <th class="text-center">Akcije</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in vjezbe)
                                    {
                                        <tr class="@(a.JeDostupno ? "" : "table-secondary")">
                                            <td>@a.Naziv</td>
                                            <td>@a.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(a.JeDostupno ? "bg-success" : "bg-secondary")">
                                                    @(a.JeDostupno ? "Dostupno" : "Zaključano")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @if (a.JeDostupno || !User.IsInRole("Student"))
                                                    {
                                                        <a asp-action="Details"
                                                           asp-route-id="@a.Id"
                                                           class="btn btn-outline-info"
                                                           title="Detalji"
                                                           data-bs-toggle="tooltip">
                                                            <i class="fas fa-info-circle"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline-secondary" disabled
                                                                data-bs-toggle="tooltip"
                                                                title="Bit će dostupno @a.DatumVrijemeOdrzavanja:dd.MM.yyyy HH:mm">
                                                            <i class="fas fa-info-circle"></i>
                                                        </button>
                                                    }

                                                    <a asp-controller="Komentari"
                                                       asp-action="Index"
                                                       asp-route-nastavnaAktivnostId="@a.Id"
                                                       class="btn btn-outline-secondary"
                                                       title="Komentari"
                                                       data-bs-toggle="tooltip">
                                                        <i class="fas fa-comments"></i>
                                                    </a>

                                                    @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                    {
                                                        <a asp-action="Edit"
                                                           asp-route-id="@a.Id"
                                                           class="btn btn-outline-warning"
                                                           title="Uredi"
                                                           data-bs-toggle="tooltip">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <a asp-action="Delete"
                                                           asp-route-id="@a.Id"
                                                           class="btn btn-outline-danger"
                                                           title="Obriši"
                                                           data-bs-toggle="tooltip">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">Nema planiranih vježbi</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // inicijaliziraj Bootstrap tooltipove
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>
}
