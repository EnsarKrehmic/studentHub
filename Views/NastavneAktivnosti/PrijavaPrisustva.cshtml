@{
    ViewData["Title"] = "Prijava prisustva";
    var naziv = ViewBag.NazivAktivnosti;
    var id = ViewBag.AktivnostId;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-qrcode me-2"></i>@ViewData["Title"]</h5>
            <a asp-action="Details"
               asp-route-id="@id"
               class="btn btn-outline-light btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Nazad
            </a>
        </div>
        <div class="card-body">
            @if (TempData["StatusZahtjeva"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-1"></i> @TempData["StatusZahtjeva"]
                </div>
            }

            <p>Prijava prisustva za: <strong class="text-primary">@naziv</strong></p>

            <form asp-action="PrijavaPrisustva" asp-route-nastavnaAktivnostId="@id" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="kod" class="form-label">Unesite kod za prisustvo</label>
                    <input type="text"
                           name="kod"
                           id="kod"
                           class="form-control"
                           required
                           placeholder="npr. A1B2C3"
                           maxlength="10" />
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-paper-plane me-1"></i> Pošalji zahtjev
                </button>
                <a asp-action="Details"
                   asp-route-id="@id"
                   class="btn btn-outline-secondary ms-2">
                    <i class="fas fa-undo me-1"></i> Odustani
                </a>
            </form>
        </div>
    </div>
</div>
