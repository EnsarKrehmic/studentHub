@model StudentHub.Models.NastavniMaterijal

<h2>Obriši nastavni materijal</h2>
<h3>Jeste li sigurni da želite obrisati "@Model.Naziv"?</h3>
<div>
    <p><strong>Nastavna aktivnost:</strong> @Model.NastavnaAktivnost.Naziv</p>
    <p><strong>Opis:</strong> @Model.Opis</p>
    <p><strong>Fajl:</strong> <a href="@Model.PutanjaDoFajla" target="_blank">Preuzmi</a></p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-controller="NastavneAktivnosti" asp-action="Details" asp-route-id="@Model.NastavnaAktivnostId" class="btn btn-secondary">Nazad</a>
    </form>
</div>