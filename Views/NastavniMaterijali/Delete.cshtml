@model StudentHub.Models.NastavniMaterijal
@using System.IO

@{
    ViewData["Title"] = "Brisanje materijala";
    ViewData["WarningMessage"] = $"Jeste li sigurni da želite obrisati materijal \"{Model.Naziv}\"?";
    ViewData["WarningDetails"] = null;
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Naziv"] = Model.Naziv,
        ["Nastavna aktivnost"] = Model.NastavnaAktivnost?.Naziv ?? "–",
        ["Opis"] = Model.Opis,
        ["Fajlovi"] = (object)Html.Raw(
                                    (Model.Fajlovi != null && Model.Fajlovi.Any())
                                      ? "<ul>" + string.Join("", Model.Fajlovi.Select(f =>
                                          $"<li>{System.IO.Path.GetFileName(f.PutanjaDoFajla)}</li>"))
                                         + "</ul>"
                                      : "<span class='text-muted fst-italic'>Nema dodanih fajlova.</span>"
                                  )
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
