@model StudentHub.Models.NastavniMaterijal

@{
    ViewBag.Title = "Detalji Materijala";
}

<h2>@Model.Naziv</h2>

<div>
    <h4>Opis</h4>
    <p>@Model.Opis</p>
</div>
<div>
    <h4>Tip Fajla</h4>
    <p>@Model.TipFajla</p>
</div>
<div>
    <h4>Fajl</h4>
    <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary">Preuzmi</a>
</div>

<a href="@Url.Action("Index", new { nastavnaAktivnostId = Model.NastavnaAktivnostId })" class="btn btn-secondary">Nazad</a>
