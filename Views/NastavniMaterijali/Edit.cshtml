@model StudentHub.Models.NastavniMaterijal
@using System.IO

<h2>Uredi nastavni materijal za @(Model.NastavnaAktivnost?.Naziv ?? "Nepoznata aktivnost")</h2>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="NastavnaAktivnostId" />

    <div class="form-group">
        <label asp-for="Naziv"></label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Opis"></label>
        <textarea asp-for="Opis" class="form-control"></textarea>
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>

    <div class="form-group">
        @if (!string.IsNullOrEmpty(Model.PutanjaDoFajla))
        {
            <div class="mb-2">
                <label class="font-weight-bold">Trenutni fajl:</label>
                <div>
                    <a href="@Model.PutanjaDoFajla" target="_blank" class="btn btn-sm btn-outline-primary">
                        @System.IO.Path.GetFileName(Model.PutanjaDoFajla)
                    </a>
                    <span class="text-muted">(@Model.TipFajla?.ToUpper())</span>
                </div>
            </div>
        }
        <label for="fajl">@(!string.IsNullOrEmpty(Model.PutanjaDoFajla) ? "Zamijeni fajl" : "Dodaj fajl")</label>
        <input type="file" name="fajl" class="form-control-file" />
        <span class="text-danger">@Html.ValidationMessage("fajl")</span>
        <small class="form-text text-muted">
            Dozvoljeni formati: PDF, DOCX, XLSX, PPTX, JPG, PNG (max 100MB)
        </small>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Spremi promjene</button>
        <a asp-controller="NastavneAktivnosti"
           asp-action="Details"
           asp-route-id="@Model.NastavnaAktivnostId"
           class="btn btn-secondary">Odustani</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}