@model StudentHub.Models.NastavniPlan

@{
    ViewData["Title"] = "Kreiranje nastavnog plana";
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group">
                <label asp-for="GodinaStudija" class="control-label"></label>
                <input asp-for="GodinaStudija" class="form-control" />
                <span asp-validation-for="GodinaStudija" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudijskiProgramId" class="control-label"></label>
                <select asp-for="StudijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgramId"></select>
                <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Kreiraj</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}