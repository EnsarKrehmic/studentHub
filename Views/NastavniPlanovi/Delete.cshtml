@model StudentHub.Models.NastavniPlan

@{
    ViewData["Title"] = "Brisanje nastavnog plana";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovaj nastavni plan?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti sve podatke o nastavnom planu.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o nastavnom planu</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nastavni plan pripada sljedećem studijskom programu:</dt>
            <dd class="col-sm-9">@Model.StudijskiProgram</dd>

            <dt class="col-sm-3">Nastavni plan pripada sljedećoj godini studija:</dt>
            <dd class="col-sm-9">@Model.GodinaStudija</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>