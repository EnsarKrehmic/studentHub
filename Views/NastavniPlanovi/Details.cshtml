@model StudentHub.Models.NastavniPlan

@{
    ViewData["Title"] = "Detalji nastavnog plana";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Podaci o nastavnom planu</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.GodinaStudija)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.GodinaStudija)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.StudijskiProgram)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StudijskiProgram.Id)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Izmjena</a> |
    <a asp-action="Index">Nazad</a>
</div>