@model IEnumerable<StudentHub.Models.NastavniPlan>
@using StudentHub.Models
@{
    ViewData["Title"] = "Nastavni planovi po studijskim programima";
    Layout = "_Layout";
    var predmeti = ViewBag.Predmeti as List<Predmet>;
    bool jeSluzba = User.IsInRole("Studentska služba");
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <h2 class="mb-0">
            <i class="fas fa-book-open text-primary me-2"></i>@ViewData["Title"]
        </h2>
        @if (jeSluzba)
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> Kreiraj novi nastavni plan
            </a>
        }
    </div>

    @if (Model?.Any() != true)
    {
        <div class="alert alert-warning text-center">
            <strong>Nema dostupnih nastavnih planova!</strong>
        </div>
    }
    else
    {
        var poProgramu = Model
        .GroupBy(np => np.StudijskiProgram)
        .OrderBy(g => g.Key.Naziv);

        @foreach (var grupa in poProgramu)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div>
                            <h3 class="mb-0">@grupa.Key.Naziv</h3>
                            <span class="badge bg-light text-dark ms-2">@grupa.Key.TrajanjeUGodinama godina</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <p><strong>Opis programa:</strong> @grupa.Key.Opis</p>

                    <h5 class="mt-4 mb-3">Nastavni planovi:</h5>
                    <ul class="list-group">
                        @foreach (var np in grupa.OrderBy(x => x.GodinaStudija))
                        {
                            var povezani = predmeti?.Where(p => p.NastavniPlanId == np.Id).ToList() ?? new List<Predmet>();
                            var ukupno = povezani.Count;
                            var izborni = povezani.Count(p => p.TipPredmeta == TipPredmeta.Izborni);
                            var obavezni = ukupno - izborni;
                            var ectsUk = povezani.Sum(p => p.ECTS);

                            <li class="list-group-item">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                    <h6 class="mb-2 mb-md-0">
                                        <i class="fas fa-calendar-alt me-1"></i>
                                        @np.GodinaStudija. godina
                                        <span class="badge bg-info text-dark ms-2">Predmeta: @ukupno</span>
                                        <span class="badge bg-success ms-1">ECTS: @ectsUk</span>
                                        <span class="badge bg-warning text-dark ms-1">Izbornih: @izborni</span>
                                        <span class="badge bg-primary ms-1">Obaveznih: @obavezni</span>
                                    </h6>
                                    <div class="mt-3 mt-md-0">
                                        <a asp-action="Details" asp-route-id="@np.Id" class="btn btn-sm btn-info me-1">
                                            <i class="fas fa-eye"></i> Detalji
                                        </a>
                                        @if (jeSluzba)
                                        {
                                            <a asp-action="Edit" asp-route-id="@np.Id" class="btn btn-sm btn-warning me-1">
                                                <i class="fas fa-edit"></i> Izmjena
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@np.Id" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash-alt"></i> Brisanje
                                            </a>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    }

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu stranicu
        </a>
    </div>
</div>
