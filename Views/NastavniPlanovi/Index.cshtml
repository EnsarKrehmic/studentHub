@model IEnumerable<StudentHub.Models.NastavniPlan>

@{
    ViewData["Title"] = "Lista nastavnih planova";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Kreiraj novi nastavni plan</a>
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().GodinaStudija)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().StudijskiProgram)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.GodinaStudija)</td>
                <td>@Html.DisplayFor(modelItem => item.StudijskiProgram.Naziv)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>