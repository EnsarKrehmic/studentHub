@model StudentHub.Models.Obavjestenje

@{
    ViewData["Title"] = "Brisanje obavještenja";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovo obavještenje?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o obavještenju.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Studijski program/i"] = (object)Html.Raw(
            Model.ObavjestenjeStudijskiProgrami != null && Model.ObavjestenjeStudijskiProgrami.Any()
                ? string.Join(", ", Model.ObavjestenjeStudijskiProgrami.Select(sp => sp.StudijskiProgram.Naziv))
                : "Nema povezanih studijskih programa"
        ),
        ["Naslov"] = Model.Naslov,
        ["Sadržaj"] = Model.Sadrzaj,
        ["Datum objave"] = Model.DatumObjave.ToString("dd.MM.yyyy")
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
