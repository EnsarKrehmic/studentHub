@model StudentHub.Models.Obavjestenje

@{
    ViewData["Title"] = "Brisanje obavještenja";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovo obavještenje?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti sve podatke o obavještenju.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o obavještenju</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Studijski program/i:</dt>
            <dd class="col-sm-9">
                @(Model.ObavjestenjeStudijskiProgrami != null && Model.ObavjestenjeStudijskiProgrami.Any()
                    ? string.Join(", ", Model.ObavjestenjeStudijskiProgrami.Select(sp => sp.StudijskiProgram.Naziv))
                    : "Nema povezanih studijskih programa")
            </dd>

            <dt class="col-sm-3">Naslov:</dt>
            <dd class="col-sm-9">@Model.Naslov</dd>

            <dt class="col-sm-3">Sadržaj:</dt>
            <dd class="col-sm-9">@Model.Sadrzaj</dd>

            <dt class="col-sm-3">Datum objave:</dt>
            <dd class="col-sm-9">@Model.DatumObjave</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>