@using System.Security.Claims

@model StudentHub.ViewModels.ObavjestenjeViewModel

@{
    ViewData["Title"] = Model.Naslov;
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <div class="card-body">
            <h1 class="card-title text-center mb-4">@Model.Naslov</h1>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">
                    <i class="bi bi-person-circle"></i>
                    <strong>Autor:</strong> @Model.AutorIme
                </span>

                <span class="text-muted">
                    <i class="bi bi-calendar-event"></i>
                    <strong>Datum objave:</strong> @Model.DatumObjave.ToString("dd.MM.yyyy")
                </span>
            </div>

            <hr />

            <div class="mb-3">
                <h5 class="text-primary">Studijski programi:</h5>
                @if (Model.StudijskiProgramNazivi != null && Model.StudijskiProgramNazivi.Any())
                {
                    @foreach (var naziv in Model.StudijskiProgramNazivi)
                    {
                        <span class="badge bg-secondary me-1">@naziv</span>
                    }
                }
                else
                {
                    <span class="text-muted">Nema povezanih studijskih programa.</span>
                }
            </div>

            <hr />

            <div class="mb-4">
                <h5 class="text-primary">Sadržaj obavještenja:</h5>
                <p class="lead">@Model.Sadrzaj</p>
            </div>

            <div class="d-flex justify-content-between">
                @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.AutorAspNetUserId)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil-square"></i> Izmjena
                    </a>
                }

                @if (User.IsInRole("Student"))
                {
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
                    </a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Lista svih obavještenja
                    </a>
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    </script>
}
