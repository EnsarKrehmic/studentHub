@model StudentHub.Models.Obavjestenje

@{
    ViewData["Title"] = "Detalji obavještenja";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Podaci o obavještenju</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Naslov)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Naslov)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Sadrzaj)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Sadrzaj)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DatumObjave)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DatumObjave)</dd>

        <dt class="col-sm-2">Objavio/la</dt>
        <dd class="col-sm-10">
            @if (Model.Korisnik is StudentskaSluzba)
            {
                @Html.DisplayFor(modelItem => ((StudentskaSluzba)Model.Korisnik).Ime)
            }
            else if (Model.Korisnik is Profesor)
            {
                @Html.DisplayFor(modelItem => ((Profesor)Model.Korisnik).Ime)
            }
            else if (Model.Korisnik is Asistent)
            {
                @Html.DisplayFor(modelItem => ((Asistent)Model.Korisnik).Ime)
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Izmjena</a> |
    <a asp-action="Index">Nazad</a>
</div>
