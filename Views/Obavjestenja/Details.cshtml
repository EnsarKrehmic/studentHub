@model StudentHub.Models.Obavjestenje

@{
    ViewData["Title"] = Model.Naslov;
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <div class="card-body">
            <h1 class="card-title text-center mb-4">@Model.Naslov</h1>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">
                    <i class="bi bi-person-circle"></i>
                    <strong>Autor:</strong>
                    @if (Model.Korisnik is StudentskaSluzba)
                    {
                        @(((StudentskaSluzba)Model.Korisnik).Ime) @: @(((StudentskaSluzba)Model.Korisnik).Prezime)
                    }
                    else if (Model.Korisnik is Profesor)
                    {
                        @( ((Profesor)Model.Korisnik).ProfesorTitula ) @: @( ((Profesor)Model.Korisnik).Ime ) + " " + @(((Profesor)Model.Korisnik).Prezime)
                    }
                    else if (Model.Korisnik is Asistent)
                    {
                        @(((Asistent)Model.Korisnik).AsistentTitula) @: @(((Asistent)Model.Korisnik).Ime) + " " + @(((Asistent)Model.Korisnik).Prezime)
                    }
                    else
                    {
                        <span class="text-danger">Nepoznato</span>
                    }
                </span>

                <span class="text-muted">
                    <i class="bi bi-calendar-event"></i>
                    <strong>Datum objave:</strong> @Model.DatumObjave.ToString("dd.MM.yyyy")
                </span>
            </div>

            <hr />

            <div class="mb-3">
                <h5 class="text-primary">Studijski programi:</h5>
                @if (Model.ObavjestenjeStudijskiProgrami != null && Model.ObavjestenjeStudijskiProgrami.Any())
                {
                    @foreach (var osp in Model.ObavjestenjeStudijskiProgrami)
                    {
                        <span class="badge bg-secondary me-1">@osp.StudijskiProgram.Naziv</span>
                    }
                }
                else
                {
                    <span class="text-muted">Nema povezanih studijskih programa.</span>
                }
            </div>

            <hr />

            <div class="mb-4">
                <h5 class="text-primary">Sadržaj obavještenja:</h5>
                <p class="lead">@Model.Sadrzaj</p>
            </div>

            <div class="d-flex justify-content-between">
                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil-square"></i> Izmjena
                    </a>
                }

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Nazad na listu
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    </script>
}
