@model StudentHub.Models.Obavjestenje

@{
    ViewData["Title"] = "Izmjena podataka obavještenja";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Naslov" class="control-label">Naslov</label>
        <input asp-for="Naslov" class="form-control" />
        <span asp-validation-for="Naslov" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Sadrzaj" class="control-label">Sadrzaj</label>
        <textarea asp-for="Sadrzaj" class="form-control"></textarea>
        <span asp-validation-for="Sadrzaj" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="StudijskiProgramId" class="control-label">Studijski Program</label>
        <select asp-for="StudijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgrami"></select>
        <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Sačuvaj promjene</button>
    </div>
</form>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}