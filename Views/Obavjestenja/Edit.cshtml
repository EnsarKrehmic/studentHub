@model StudentHub.ViewModels.ObavjestenjeCreateViewModel

@{
    ViewData["Title"] = "Izmjena podataka obavještenja";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width:600px;">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="StudijskiProgramiIds" class="form-label fw-bold">Studijski programi</label>
                    <select asp-for="StudijskiProgramiIds" class="form-select" asp-items="ViewBag.StudijskiProgrami" multiple size="5"></select>
                    <span asp-validation-for="StudijskiProgramiIds" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Naslov" class="form-label fw-bold"></label>
                    <input asp-for="Naslov" class="form-control" />
                    <span asp-validation-for="Naslov" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Sadrzaj" class="form-label fw-bold"></label>
                    <textarea asp-for="Sadrzaj" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Sadrzaj" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save me-1"></i> Sačuvaj promjene
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
