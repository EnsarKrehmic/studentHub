@using System.Security.Claims
@model IEnumerable<StudentHub.ViewModels.ObavjestenjeViewModel>

@{
    ViewData["Title"] = "Obavještenja";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <select name="studijskiProgramId" class="form-control">
                <option value="">Svi studijski programi</option>
                @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                {
                    <option value="@program.Value" selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">@program.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <button type="submit" class="btn btn-primary me-2">Filtriraj</button>
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

@if (User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Studentska služba"))
{
    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="fas fa-plus-circle"></i> Kreiraj novo obavještenje
    </a>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Naslov</th>
                <th>Sadržaj</th>
                <th>Datum objave</th>
                <th>Autor</th>
                <th>Studijski program</th>
                <th class="text-center">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obavjestenje in Model)
            {
                <tr>
                    <td>@obavjestenje.Naslov</td>
                    <td>
                        @if (!string.IsNullOrEmpty(obavjestenje.Sadrzaj))
                        {
                            var preview = obavjestenje.Sadrzaj.Length > 20 ? obavjestenje.Sadrzaj.Substring(0, 20) + "..." : obavjestenje.Sadrzaj;
                            @preview
                        }
                        else
                        {
                            <span class="text-muted">Nema sadržaja</span>
                        }
                    </td>
                    <td>@obavjestenje.DatumObjave.ToString("dd.MM.yyyy")</td>
                    <td>@obavjestenje.AutorIme</td>
                    <td>@string.Join(", ", obavjestenje.StudijskiProgramNazivi)</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@obavjestenje.Id" class="btn btn-sm btn-info" title="Detalji">
                            <i class="fas fa-eye"></i>
                        </a>
                        @if (obavjestenje.KorisnikAspNetUserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                        {
                            <a asp-action="Edit" asp-route-id="@obavjestenje.Id" class="btn btn-sm btn-warning" title="Izmjena">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@obavjestenje.Id" class="btn btn-sm btn-danger" title="Brisanje">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
</a>
