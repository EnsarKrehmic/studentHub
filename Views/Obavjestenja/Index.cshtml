@model IEnumerable<StudentHub.Models.Obavjestenje>

@{
    ViewData["Title"] = "Lista obavještenja";
}

<h2>@ViewData["Title"]</h2>

<div class="row mb-3">
    <div class="col-md-4">
        <form method="get">
            <div class="form-group">
                <label for="StudijskiProgramId">Odaberite studijski program</label>
                <select class="form-control" id="StudijskiProgramId" name="studijskiProgramId" onchange="this.form.submit()">
                    <option value="">Svi studijski programi</option>
                    @foreach (var program in ViewData["StudijskiProgrami"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
                    {
                        <option value="@program.Value"
                                selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : "")">
                            @program.Text
                        </option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novo obavještenje</a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Naslov)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Sadrzaj)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().DatumObjave)</th>
                <th>Objavio/la</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Naslov)</td>
                    <td>@Html.DisplayFor(modelItem => item.Sadrzaj)</td>
                    <td>@Html.DisplayFor(modelItem => item.DatumObjave)</td>
                    <td>
                        @if (item.Korisnik is StudentskaSluzba)
                        {
                            @Html.DisplayFor(modelItem => ((StudentskaSluzba)item.Korisnik).Ime)
                        }
                        else if (item.Korisnik is Profesor)
                        {
                            @Html.DisplayFor(modelItem => ((Profesor)item.Korisnik).Ime)
                        }
                        else if (item.Korisnik is Asistent)
                        {
                            @Html.DisplayFor(modelItem => ((Asistent)item.Korisnik).Ime)
                        }
                        else
                        {
                            <span>Gost</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nema obavještenja za prikaz.</p>
}
