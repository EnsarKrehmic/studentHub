@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Unos nove ocjene";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Vrijednost" class="control-label"></label>
        <input asp-for="Vrijednost" class="form-control" />
        <span asp-validation-for="Vrijednost" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PredmetId" class="control-label"></label>
        <select asp-for="PredmetId" class="form-control" asp-items="ViewBag.PredmetId"></select>
    </div>
    <div class="form-group">
        <label asp-for="StudentId" class="control-label"></label>
        <select asp-for="StudentId" class="form-control" asp-items="ViewBag.brojIndeksa"></select>
    </div>
    <div class="form-group">
        <label asp-for="ProfesorId" class="control-label"></label>
        <select asp-for="ProfesorId" class="form-control" asp-items="ViewBag.ProfesorId"></select>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Kreiraj</button>
    </div>
</form>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}