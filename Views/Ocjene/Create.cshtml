@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Unos nove ocjene";
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group">
                <label asp-for="StudentId" class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentId"></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PredmetId" class="control-label">Predmet</label>
                <select asp-for="PredmetId" class="form-control" asp-items="ViewBag.PredmetId"></select>
                <span asp-validation-for="PredmetId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProfesorId" class="control-label">Profesor</label>
                <select asp-for="ProfesorId" class="form-control" asp-items="ViewBag.ProfesorId"></select>
                <span asp-validation-for="ProfesorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vrijednost" class="control-label">Vrijednost ocjene</label>
                <input asp-for="Vrijednost" class="form-control" />
                <span asp-validation-for="Vrijednost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kreiraj" class="btn btn-primary mt-3" />
                <a asp-action="Index" class="btn btn-secondary mt-3">Odustani</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}