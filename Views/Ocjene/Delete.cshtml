@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Brisanje ocjene";
}

<h2>@ViewData["Title"]</h2>

<h3>Da li ste sigurni da želite obrisati ovu ocjenu?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Vrijednost)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Vrijednost)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Predmet)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Predmet.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Profesor)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Profesor.Id)</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button> |
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>