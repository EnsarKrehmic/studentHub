@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Brisanje ocjene";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovu ocjenu?";
    ViewData["WarningDetails"] = Html.Raw(
        Model.DjelimicneOcjene != null && Model.DjelimicneOcjene.Any()
        ? "<strong class='text-danger'>Ova ocjena ima i parcijalne ocjene koje će također biti obrisane.</strong>"
        : ""
    );
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Student"] = $"{Model.Student?.Ime} {Model.Student?.Prezime} ({Model.Student?.BrojIndeksa})",
        ["Predmet"] = Model.Predmet?.Naziv,
        ["Nastavna aktivnost"] = Model.NastavnaAktivnost?.Naziv ?? "–",
        ["Profesor"] = $"{Model.Profesor?.ProfesorTitula} {Model.Profesor?.Ime} {Model.Profesor?.Prezime}",
        ["Vrijednost ocjene"] = (object)Html.Raw(
                                        $"<span class='badge {(Model.Vrijednost >= 8 ? "bg-success" : Model.Vrijednost >= 6 ? "bg-warning text-dark" : "bg-danger")} fs-5'>{Model.Vrijednost}</span>"
                                    ),
        ["Težina (%)"] = Model.TezinaProcentualno.HasValue
                                        ? $"{Model.TezinaProcentualno}%"
                                        : (object)Html.Raw("<span class='text-muted'>–</span>"),
        ["Komentar"] = !string.IsNullOrWhiteSpace(Model.Komentar)
                                        ? Model.Komentar
                                        : (object)Html.Raw("<span class='text-muted'>–</span>"),
        ["Datum unosa"] = Model.DatumUnosa != default
                                        ? Model.DatumUnosa.ToString("dd.MM.yyyy")
                                        : (object)Html.Raw("<span class='text-muted'>–</span>"),
        ["Parcijalne ocjene"] = (object)Html.Raw(
                                        (Model.DjelimicneOcjene != null && Model.DjelimicneOcjene.Any())
                                        ? "<ul>" + string.Join("", Model.DjelimicneOcjene.Select(dj =>
                                             $"<li><strong>{dj.Vrijednost}</strong>" +
                                             (string.IsNullOrWhiteSpace(dj.Komentar) ? "" : $" <em>({dj.Komentar})</em>") +
                                             (dj.TezinaProcentualno.HasValue
                                                ? $" <span class='badge bg-secondary'>{dj.TezinaProcentualno}%</span>"
                                                : "")
                                             + "</li>"
                                          )) + "</ul>"
                                        : "<span class='text-muted'>Nema parcijalnih ocjena</span>"
                                    )
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
