@model StudentHub.ViewModels.OcjenaViewModel

@{
    ViewData["Title"] = "Detalji ocjene";
    var jeGlavna = Model.ParentOcjenaId == null && Model.Tip == "Predmet";
}

<div class="container my-4">
    <div class="card shadow-lg mb-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="fas fa-award me-2"></i> @Model.PredmetNaziv</h3>
        </div>
        <div class="card-body">
            @* Ako je parcijalna ocjena *@
            @if (!jeGlavna && Model.ParentOcjena != null)
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="mb-2">
                            <i class="fas fa-link me-1"></i> Ova ocjena je dio zaključne ocjene
                        </h5>
                        <p class="mb-0">
                            <strong>Glavna ocjena:</strong>
                            <span class="badge bg-primary fs-6">@Model.ParentOcjena.Vrijednost</span>
                            <span class="ms-2 text-secondary">@Model.ParentOcjena.Komentar</span>
                        </p>
                    </div>
                    @if (User.IsInRole("Profesor"))
                    {
                        <div class="d-flex gap-2">
                            <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@Model.ParentOcjena.Id" class="btn btn-outline-secondary btn-sm" title="Detalji">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-controller="Ocjene" asp-action="Edit" asp-route-id="@Model.ParentOcjena.Id" class="btn btn-outline-warning btn-sm" title="Izmijeni">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-controller="Ocjene" asp-action="Delete" asp-route-id="@Model.ParentOcjena.Id" class="btn btn-outline-danger btn-sm" title="Obriši">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    }
                </div>
            }

            <div class="row gy-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-primary fw-bold mb-2"><i class="fas fa-user-graduate me-1"></i> Student</h5>
                        <p class="mb-1"><strong>Ime i prezime:</strong> @Model.StudentIme @Model.StudentPrezime</p>
                        <p class="mb-1"><strong>Broj indeksa:</strong> @Model.StudentBrojIndeksa</p>
                        <p class="mb-1"><strong>Studijski program:</strong> @Model.StudentStudijskiProgramNaziv</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-primary fw-bold mb-2"><i class="fas fa-chalkboard-teacher me-1"></i> Profesor</h5>
                        <p class="mb-1"><strong>Titula:</strong> @Model.ProfesorTitula</p>
                        <p class="mb-1"><strong>Ime i prezime:</strong> @Model.ProfesorIme @Model.ProfesorPrezime</p>
                    </div>
                </div>
            </div>
            <hr />

            <div class="row gy-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-primary fw-bold mb-2"><i class="fas fa-star me-1"></i> Ocjena</h5>
                        <p>
                            <strong>Vrijednost:</strong>
                            <span class="badge @(Model.Vrijednost >= 8 ? "bg-success" : Model.Vrijednost >= 6 ? "bg-warning text-dark" : "bg-danger") fs-5">
                                @Model.Vrijednost
                            </span>
                            @if (jeGlavna)
                            {
                                <span class="badge bg-primary ms-1">Zaključna</span>
                            }
                            else
                            {
                                <span class="badge bg-info ms-1">Parcijalna</span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(Model.Komentar))
                        {
                            <p><strong>Komentar:</strong> @Model.Komentar</p>
                        }
                        @if (Model.TezinaProcentualno.HasValue)
                        {
                            <p>
                                <strong>Težina:</strong>
                                <span class="badge bg-info">@Model.TezinaProcentualno %</span>
                            </p>
                        }
                        @if (Model.DatumDodjele.HasValue)
                        {
                            <p><strong>Datum unosa:</strong> @Model.DatumDodjele.Value.ToString("dd.MM.yyyy")</p>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-primary fw-bold mb-2"><i class="fas fa-book-open me-1"></i> Predmet</h5>
                        <p><strong>Naziv predmeta:</strong> @Model.PredmetNaziv</p>
                        @if (!string.IsNullOrEmpty(Model.NastavnaAktivnostNaziv))
                        {
                            <p><strong>Aktivnost:</strong> @Model.NastavnaAktivnostNaziv</p>
                        }
                    </div>
                </div>
            </div>

            @if (jeGlavna && Model.DjelimicneOcjene?.Any() == true)
            {
                <hr />
                <h5 class="fw-bold text-success mb-3"><i class="fas fa-layer-group me-1"></i> Parcijalne ocjene</h5>
                <ul class="list-group mb-3">
                    @foreach (var d in Model.DjelimicneOcjene)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@d.Vrijednost</strong>
                                @if (!string.IsNullOrWhiteSpace(d.Komentar))
                                {
                                    <span class="text-muted ms-2">(@d.Komentar)</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                @if (d.TezinaProcentualno.HasValue)
                                {
                                    <span class="badge bg-info">@d.TezinaProcentualno %</span>
                                }
                                @if (User.IsInRole("Profesor"))
                                {
                                    <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary" title="Detalji">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-controller="Ocjene" asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-warning" title="Izmjena">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="Ocjene" asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger" title="Brisanje">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                            </div>
                        </li>
                    }
                </ul>
                @if (User.IsInRole("Profesor"))
                {
                    <a asp-controller="Ocjene"
                       asp-action="Create"
                       asp-route-tip="Predmet"
                       asp-route-predmetId="@Model.PredmetId"
                       asp-route-studentId="@Model.StudentId"
                       asp-route-parentOcjenaId="@Model.Id"
                       class="btn btn-outline-primary">
                        <i class="fas fa-plus-circle me-1"></i> Dodaj parcijalnu ocjenu
                    </a>
                }
            }

            @if (jeGlavna && Model.BodoviSaIspita.Any())
            {
                <hr />
                <h5 class="fw-bold text-info mb-3"><i class="fas fa-file-alt me-1"></i> Bodovi sa ispita</h5>
                <ul class="list-group mb-3">
                    @foreach (var ispit in Model.BodoviSaIspita.OrderBy(i => i.Datum))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <a asp-controller="Ispiti" asp-action="Details" asp-route-id="@ispit.IspitId" class="text-decoration-none">
                                    @ispit.IspitNaziv
                                </a>
                            </span>
                            <span class="badge bg-primary">@ispit.Bodovi</span>
                        </li>
                    }
                </ul>
            }

            @if (jeGlavna)
            {
                <hr />
                <h5 class="fw-bold text-primary mb-3"><i class="fas fa-user-check me-1"></i> Prisustvo na aktivnostima</h5>
                <ul class="list-group mb-3">
                    <li class="list-group-item">Ukupno: <strong>@Model.ProcenatPrisustvaUkupno.ToString("0.0")%</strong></li>
                    <li class="list-group-item">Predavanja: <strong>@Model.ProcenatPrisustvaPredavanja.ToString("0.0")%</strong></li>
                    <li class="list-group-item">Vježbe: <strong>@Model.ProcenatPrisustvaVjezbi.ToString("0.0")%</strong></li>
                </ul>

                <a asp-controller="Predmeti"
                   asp-action="StudentDetails"
                   asp-route-predmetId="@Model.PredmetId"
                   asp-route-studentId="@Model.StudentId"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-user-check me-1"></i> Detaljna evidencija prisustva
                </a>
            }
        </div>
    </div>

    <div class="mt-3 text-center">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Nazad na listu
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
