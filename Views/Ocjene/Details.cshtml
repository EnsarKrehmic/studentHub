@model StudentHub.ViewModels.OcjenaViewModel

@{
    ViewData["Title"] = "Detalji ocjene";
    var jeGlavna = Model.ParentOcjenaId == null && Model.Tip == "Predmet";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-award me-2"></i> Detalji ocjene</h4>
            <div class="btn-group">
                @if (User.IsInRole("Profesor"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-danger btn-sm">
                        <i class="fas fa-edit me-1"></i> Uredi
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id"
                       class="btn btn-warning btn-sm">
                        <i class="fas fa-trash-alt me-1"></i> Obriši
                    </a>
                }
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Nazad na listu
                </a>
            </div>
        </div>
        <div class="card-body">

            @* Ako je parcijalna ocjena, pokaži info o glavnoj ocjeni *@
            @if (!jeGlavna && Model.ParentOcjena != null)
            {
                <div class="alert alert-info mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1"><i class="fas fa-link me-1"></i> Dio zaključne ocjene</h5>
                        <small>
                            <strong>Zaključna ocjena:</strong>
                            <span class="badge bg-primary">@Model.ParentOcjena.Vrijednost</span>
                            <span class="ms-2 text-secondary">@Model.ParentOcjena.Komentar</span>
                        </small>
                    </div>
                    <div class="btn-group">
                        <a asp-action="Details" asp-route-id="@Model.ParentOcjena.Id"
                           class="btn btn-sm btn-outline-secondary" title="Detalji">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </div>
            }

            @* Podaci o studentu i profesoru *@
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="fas fa-user-graduate me-1"></i> Student</dt>
                <dd class="col-sm-9">
                    @Model.StudentIme @Model.StudentPrezime (@Model.StudentBrojIndeksa)<br />
                    <small class="text-muted">@Model.StudentStudijskiProgramNaziv</small>
                </dd>

                <dt class="col-sm-3"><i class="fas fa-chalkboard-teacher me-1"></i> Profesor</dt>
                <dd class="col-sm-9">
                    @Model.ProfesorTitula @Model.ProfesorIme @Model.ProfesorPrezime
                </dd>
            </dl>

            <hr />

            @* Glavni podaci o ocjeni *@
            <dl class="row mb-4">
                <dt class="col-sm-3"><i class="fas fa-star me-1"></i> Vrijednost</dt>
                <dd class="col-sm-9">
                    <span class="badge
            @(Model.Vrijednost >= 8
                                          ? "bg-success"
                                          : Model.Vrijednost >= 6
                                            ? "bg-warning text-dark"
                                            : "bg-danger")
            fs-5">
                        @Model.Vrijednost
                    </span>
                    <span class="badge @(jeGlavna ? "bg-primary" : "bg-info") ms-2">
                        @(jeGlavna ? "Zaključna" : "Parcijalna")
                    </span>
                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.Komentar))
                {
                    <dt class="col-sm-3">Komentar</dt>
                    <dd class="col-sm-9">@Model.Komentar</dd>
                }

                @if (Model.TezinaProcentualno.HasValue)
                {
                    <dt class="col-sm-3">Težina</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info">@Model.TezinaProcentualno %</span>
                    </dd>
                }

                @if (Model.DatumDodjele.HasValue)
                {
                    <dt class="col-sm-3">Datum unosa</dt>
                    <dd class="col-sm-9">@Model.DatumDodjele.Value.ToString("dd.MM.yyyy")</dd>
                }
            </dl>

            @* Parcijalne ocjene ako ih ima *@
            @if (jeGlavna && Model.DjelimicneOcjene?.Any() == true)
            {
                <hr />
                <h5 class="fw-bold text-success mb-3"><i class="fas fa-layer-group me-1"></i> Parcijalne ocjene</h5>
                <ul class="list-group mb-4">
                    @foreach (var d in Model.DjelimicneOcjene)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@d.Vrijednost</strong>
                                @if (!string.IsNullOrWhiteSpace(d.Komentar))
                                {
                                    <span class="text-muted ms-2">(@d.Komentar)</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                @if (d.TezinaProcentualno.HasValue)
                                {
                                    <span class="badge bg-info">@d.TezinaProcentualno %</span>
                                }
                                @if (User.IsInRole("Profesor"))
                                {
                                    <a asp-action="Details" asp-route-id="@d.Id"
                                       class="btn btn-sm btn-outline-secondary" title="Detalji">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }

            @* Bodovi sa ispita *@
            @if (jeGlavna && Model.BodoviSaIspita.Any())
            {
                <hr />
                <h5 class="fw-bold text-info mb-3"><i class="fas fa-file-alt me-1"></i> Bodovi sa ispita</h5>
                <ul class="list-group mb-4">
                    @foreach (var ispit in Model.BodoviSaIspita.OrderBy(i => i.Datum))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Ispiti" asp-action="Details" asp-route-id="@ispit.IspitId" class="text-decoration-none">
                                @ispit.IspitNaziv
                            </a>
                            <span class="badge bg-primary">@ispit.Bodovi</span>
                        </li>
                    }
                </ul>
            }

            @* Prisustvo na aktivnostima *@
            @if (jeGlavna)
            {
                <hr />
                <h5 class="fw-bold text-primary mb-3"><i class="fas fa-user-check me-1"></i> Prisustvo na aktivnostima</h5>
                <ul class="list-group mb-4">
                    <li class="list-group-item">Ukupno: <strong>@Model.ProcenatPrisustvaUkupno</strong></li>
                    <li class="list-group-item">Predavanja: <strong>@Model.ProcenatPrisustvaPredavanja</strong></li>
                    <li class="list-group-item">Vježbe: <strong>@Model.ProcenatPrisustvaVjezbi</strong></li>
                </ul>
            }
        </div>
    </div>

    <div class="text-center">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na listu
        </a>
    </div>
</div>
