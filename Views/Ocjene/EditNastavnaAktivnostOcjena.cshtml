@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Uređivanje ocjene za nastavnu aktivnost";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="EditNastavnaAktivnostOcjena" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Tip" value="NastavnaAktivnost" />
            <input type="hidden" asp-for="NastavnaAktivnostId" value="@ViewBag.NastavnaAktivnostId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Nastavna aktivnost:</label>
                <span class="form-control-plaintext">@ViewBag.NastavnaAktivnostNaziv</span>
            </div>

            <div class="form-group">
                <label asp-for="Vrijednost">Ocjena (1–5)</label>
                <input asp-for="Vrijednost" class="form-control" type="number" min="1" max="5" />
                <span asp-validation-for="Vrijednost" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="TezinaProcentualno">Težina (%)</label>
                <input asp-for="TezinaProcentualno" class="form-control" type="number" min="0" max="100" />
                <span asp-validation-for="TezinaProcentualno" class="text-danger"></span>
                <div class="form-text">Opcionalno: koristi se za ponderaciju ako se računa zbirna ocjena.</div>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Komentar">Komentar</label>
                <textarea asp-for="Komentar" class="form-control" maxlength="200"></textarea>
                <span asp-validation-for="Komentar" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="DatumUnosa">Datum unosa</label>
                <input asp-for="DatumUnosa" class="form-control" type="date" value="@Model.DatumUnosa.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DatumUnosa" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Spremi izmjene</button>
                <a asp-action="Index" class="btn btn-secondary">Nazad</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
