@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Uređivanje ocjene za predmet";
    var povezane = ViewBag.PovezaneParcijalne as List<StudentHub.Models.Ocjena>;
    var noveParcijalne = ViewBag.NoveParcijalne as List<StudentHub.Models.Ocjena>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="EditPredmetOcjena" asp-route-id="@Model.Id" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Tip" value="Predmet" />
                        <input type="hidden" asp-for="PredmetId" />
                        <input type="hidden" asp-for="StudentId" />
                        @if (Model.ParentOcjenaId.HasValue)
                        {
                            <input type="hidden" asp-for="ParentOcjenaId" />
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">Predmet:</label>
                            <span class="form-control-plaintext">@ViewBag.PredmetNaziv</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Student:</label>
                            <span class="form-control-plaintext">@ViewBag.StudentImePrezime</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProfesorId" class="form-label">Profesor</label>
                            <select asp-for="ProfesorId" class="form-control" asp-items="ViewBag.ProfesorId"></select>
                            <span asp-validation-for="ProfesorId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Vrijednost" class="form-label">Ocjena (5–10)</label>
                            <input asp-for="Vrijednost" class="form-control" type="number" min="5" max="10" />
                            <span asp-validation-for="Vrijednost" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TezinaProcentualno" class="form-label">Težina (%)</label>
                            <input asp-for="TezinaProcentualno" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="TezinaProcentualno" class="text-danger"></span>
                            <div class="form-text">Opcionalno: koristi se ako je ovo parcijalna komponenta.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Komentar" class="form-label">Komentar</label>
                            <textarea asp-for="Komentar" class="form-control" maxlength="200"></textarea>
                            <span asp-validation-for="Komentar" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DatumUnosa" class="form-label">Datum unosa</label>
                            <input asp-for="DatumUnosa" class="form-control" type="date" value="@Model.DatumUnosa.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DatumUnosa" class="text-danger"></span>
                        </div>

                        <!-- Parcijalne ocjene povezane sa ovom ocjenom -->
                        @if (povezane != null && povezane.Any())
                        {
                            <div class="alert alert-info mb-3">
                                <strong>Već povezane parcijalne ocjene:</strong>
                                <ul class="mb-0">
                                    @foreach (var parcijalna in povezane)
                                    {
                                        <li>
                                            @parcijalna.Komentar (@parcijalna.Vrijednost)
                                            <span class="text-muted">[@parcijalna.DatumUnosa.ToString("dd.MM.yyyy")]</span>
                                            @if (parcijalna.TezinaProcentualno != null)
                                            {
                                                <span class="text-muted">, težina: @parcijalna.TezinaProcentualno%</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (noveParcijalne != null && noveParcijalne.Any())
                        {
                            <div class="alert alert-warning mb-3">
                                <strong>Napomena:</strong> Ova izmjena će automatski povezati @noveParcijalne.Count slobodnih parcijalnih ocjena iz ispita s ovom ocjenom.
                                <ul class="mb-0">
                                    @foreach (var parcijalna in noveParcijalne)
                                    {
                                        <li>
                                            @parcijalna.Komentar (@parcijalna.Vrijednost)
                                            <span class="text-muted">[@parcijalna.DatumUnosa.ToString("dd.MM.yyyy")]</span>
                                            @if (parcijalna.TezinaProcentualno != null)
                                            {
                                                <span class="text-muted">, težina: @parcijalna.TezinaProcentualno%</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Spremi izmjene
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Nazad
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
