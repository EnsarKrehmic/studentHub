@model StudentHub.Models.Ocjena
@{
    ViewData["Title"] = "Uređivanje ocjene za predmet";
    var povezane = ViewBag.PovezaneParcijalne as List<StudentHub.Models.Ocjena>;
    var noveParcijalne = ViewBag.NoveParcijalne as List<StudentHub.Models.Ocjena>;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h3>
                </div>
                <div class="card-body">

                    <form asp-action="EditPredmetOcjena" asp-route-id="@Model.Id" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Tip" value="Predmet" />
                        <input type="hidden" asp-for="PredmetId" />
                        <input type="hidden" asp-for="StudentId" />
                        @if (Model.ParentOcjenaId.HasValue)
                        {
                            <input type="hidden" asp-for="ParentOcjenaId" />
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">Predmet:</label>
                            <p class="form-control-plaintext">@ViewBag.PredmetNaziv</p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Student:</label>
                            <p class="form-control-plaintext">@ViewBag.StudentImePrezime</p>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProfesorId" class="form-label">Profesor</label>
                            <select asp-for="ProfesorId" class="form-select" asp-items="ViewBag.ProfesorId"></select>
                            <span asp-validation-for="ProfesorId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Vrijednost" class="form-label">Ocjena (5–10)</label>
                            <input asp-for="Vrijednost" class="form-control" type="number" min="5" max="10" step="1" />
                            <span asp-validation-for="Vrijednost" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TezinaProcentualno" class="form-label">Težina (%)</label>
                            <input asp-for="TezinaProcentualno" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="TezinaProcentualno" class="text-danger small"></span>
                            <div class="form-text">Opcionalno: koristi se ako je parcijalna komponenta.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Komentar" class="form-label">Komentar</label>
                            <textarea asp-for="Komentar" class="form-control" rows="3" maxlength="200"></textarea>
                            <span asp-validation-for="Komentar" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DatumUnosa" class="form-label">Datum unosa</label>
                            <input asp-for="DatumUnosa" class="form-control" type="date" value="@Model.DatumUnosa:yyyy-MM-dd" />
                            <span asp-validation-for="DatumUnosa" class="text-danger small"></span>
                        </div>

                        @* Već povezane parcijalne *@
                        @if (povezane?.Any() == true)
                        {
                            <div class="alert alert-info mb-3">
                                <strong>Već povezane parcijalne:</strong>
                                <ul class="mb-0">
                                    @foreach (var parc in povezane)
                                    {
                                        <li>
                                            @parc.Komentar (@parc.Vrijednost)
                                            <span class="text-muted">[@parc.DatumUnosa:dd.MM.yyyy]</span>
                                            @if (parc.TezinaProcentualno != null)
                                            {
                                                <span class="text-muted">, težina: @parc.TezinaProcentualno%</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @* Novi parcijalni koje će se povezati *@
                        @if (noveParcijalne?.Any() == true)
                        {
                            <div class="alert alert-warning mb-3">
                                <strong>Napomena:</strong> Povezat će se @noveParcijalne.Count nepovezanih parcijalnih:
                                <ul class="mb-0">
                                    @foreach (var parc in noveParcijalne)
                                    {
                                        <li>
                                            @parc.Komentar (@parc.Vrijednost)
                                            <span class="text-muted">[@parc.DatumUnosa:dd.MM.yyyy]</span>
                                            @if (parc.TezinaProcentualno != null)
                                            {
                                                <span class="text-muted">, težina: @parc.TezinaProcentualno%</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i> Spremi izmjene
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Nazad
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
