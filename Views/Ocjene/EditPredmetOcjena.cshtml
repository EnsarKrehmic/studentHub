@model StudentHub.Models.Ocjena

@{
    ViewData["Title"] = "Uređivanje ocjene za predmet";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="EditPredmetOcjena" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Tip" value="Predmet" />
            <input type="hidden" asp-for="PredmetId" />
            <input type="hidden" asp-for="StudentId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Predmet:</label>
                <span class="form-control-plaintext">@ViewBag.PredmetNaziv</span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Student:</label>
                <span class="form-control-plaintext">@ViewBag.StudentImePrezime</span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="ProfesorId">Profesor</label>
                <select asp-for="ProfesorId" class="form-control" asp-items="ViewBag.ProfesorId"></select>
                <span asp-validation-for="ProfesorId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Vrijednost">Ocjena (5–10)</label>
                <input asp-for="Vrijednost" class="form-control" type="number" min="5" max="10" />
                <span asp-validation-for="Vrijednost" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="TezinaProcentualno">Težina (%)</label>
                <input asp-for="TezinaProcentualno" class="form-control" type="number" min="0" max="100" />
                <span asp-validation-for="TezinaProcentualno" class="text-danger"></span>
                <div class="form-text">Opcionalno: koristi se ako je ovo parcijalna komponenta.</div>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Komentar">Komentar</label>
                <textarea asp-for="Komentar" class="form-control" maxlength="200"></textarea>
                <span asp-validation-for="Komentar" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="DatumUnosa">Datum unosa</label>
                <input asp-for="DatumUnosa" class="form-control" type="date" value="@Model.DatumUnosa.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DatumUnosa" class="text-danger"></span>
            </div>

            @if (Model.ParentOcjenaId.HasValue)
            {
                <input type="hidden" asp-for="ParentOcjenaId" />
            }

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Spremi izmjene</button>
                <a asp-action="Index" class="btn btn-secondary">Nazad</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
