@model IEnumerable<StudentHub.ViewModels.OcjenaViewModel>

@{
    ViewData["Title"] = "Lista ocjena";
    var userRole = User.IsInRole("Student") ? "Student" : User.IsInRole("Profesor") ? "Profesor" : "Studentska služba";
    var grouped = Model.GroupBy(o => o.PredmetNaziv).OrderBy(g => g.Key);
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Lista ocjena</h2>

    @if (userRole == "Profesor" || userRole == "Studentska služba")
    {
        var prosjekPoPredmetu = Model
        .Where(o => o.Tip == "Predmet")
        .GroupBy(o => o.PredmetNaziv)
        .Select(g => new { Predmet = g.Key, Prosjek = g.Average(o => o.Vrijednost) })
        .OrderBy(p => p.Predmet)
        .ToList();

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Prosjek ocjena po predmetima</h5>
                <button class="btn btn-sm btn-light" id="toggleProsjeciBtn">Prikaži</button>
            </div>
            <div class="card-body d-none" id="prosjekContainer">
                <ul class="list-group" id="prosjekList">
                    @foreach (var item in prosjekPoPredmetu)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center" data-predmet="@item.Predmet">
                            <span class="fw-bold">@item.Predmet</span>
                            <span class="badge bg-primary rounded-pill">@item.Prosjek.ToString("0.00")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="mb-4">
        <label for="predmetFilter" class="form-label">Filter po predmetu:</label>
        <select id="predmetFilter" class="form-select">
            <option value="">-- Prikaži sve --</option>
            @foreach (var predmet in grouped.Select(g => g.Key).Distinct())
            {
                <option value="@predmet">@predmet</option>
            }
        </select>
    </div>

    @foreach (var group in grouped)
    {
        <div class="card mb-3 ocjena-grupa" data-predmet="@group.Key">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <button class="btn btn-link text-start w-100 text-dark predmet-toggle">
                    <strong>@group.Key</strong>
                </button>
                <span class="badge bg-secondary">@group.Count() ocjena</span>
            </div>
            <div class="card-body p-0 d-none">
                <table class="table table-striped table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            @if (userRole != "Student")
                            {
                                <th>Student</th>
                            }
                            <th>Tip</th>
                            <th>Vrijednost</th>
                            <th>Težina</th>
                            <th>Datum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ocjena in group.OrderByDescending(o => o.DatumDodjele))
                        {
                            <tr>
                                @if (userRole != "Student")
                                {
                                    <td>@ocjena.StudentIme @ocjena.StudentPrezime</td>
                                }
                                <td>@ocjena.Tip</td>
                                <td>
                                    <span class="badge @(ocjena.Vrijednost >= 8 ? "bg-success" : ocjena.Vrijednost >= 6 ? "bg-warning" : "bg-danger")">
                                        @ocjena.Vrijednost
                                    </span>
                                </td>
                                <td>
                                    @if (ocjena.TezinaProcentualno.HasValue)
                                    {
                                        @($"{ocjena.TezinaProcentualno}%")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@ocjena.DatumDodjele?.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@ocjena.Id" class="btn btn-sm btn-outline-secondary">Detalji</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu</a>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle prikaz prosjeka
        document.getElementById("toggleProsjeciBtn")?.addEventListener("click", function () {
            const container = document.getElementById("prosjekContainer");
            container.classList.toggle("d-none");
            this.textContent = container.classList.contains("d-none") ? "Prikaži" : "Sakrij";
        });

        // Toggle prikaz ocjena po predmetu
        document.querySelectorAll(".predmet-toggle").forEach(btn => {
            btn.addEventListener("click", function () {
                const card = this.closest(".ocjena-grupa");
                const body = card.querySelector(".card-body");
                body.classList.toggle("d-none");
            });
        });

        // Filter po predmetu
        document.getElementById("predmetFilter").addEventListener("change", function () {
            const selected = this.value;
            document.querySelectorAll(".ocjena-grupa").forEach(group => {
                group.style.display = !selected || group.dataset.predmet === selected ? "block" : "none";
            });
            document.querySelectorAll("#prosjekList li").forEach(item => {
                item.style.display = !selected || item.dataset.predmet === selected ? "flex" : "none";
            });
        });
    </script>
}
