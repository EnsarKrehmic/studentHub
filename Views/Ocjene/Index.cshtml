@model IEnumerable<StudentHub.Models.Ocjena>

@{
    ViewData["Title"] = "Lista ocjena";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Vrijednost)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Predmet)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Student)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Profesor)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Vrijednost)</td>
                <td>@Html.DisplayFor(modelItem => item.Predmet.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Student.JMBG)</td>
                <td>@Html.DisplayFor(modelItem => item.Profesor.JMBG)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Detalji</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Izmjena</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>