@model IEnumerable<StudentHub.Models.Ocjena>

@{
    ViewData["Title"] = "Lista ocjena";
}

<h2>@ViewData["Title"]</h2>

<p>
    @if (User.IsInRole("Profesor"))
    {
        <a asp-action="Create" class="btn btn-primary">Kreiraj novu ocjenu</a>
    }
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Vrijednost)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Predmet)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Student)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Profesor)</th>
            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
            {
                <th>Akcije</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Vrijednost)</td>
                <td>@Html.DisplayFor(modelItem => item.Predmet.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Student.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Profesor.Id)</td>
                <td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                    {
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalji</a>
                    }
                    @if (User.IsInRole("Studentska služba"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Brisanje</a>
                    }
                    
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>