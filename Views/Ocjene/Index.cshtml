@model IEnumerable<StudentHub.ViewModels.OcjenaViewModel>
@{
    ViewData["Title"] = "Lista ocjena";
    Layout = "_Layout";
    var userRole = User.IsInRole("Student")
        ? "Student"
        : User.IsInRole("Profesor")
            ? "Profesor"
            : "Studentska služba";
    var grouped = Model.GroupBy(o => o.PredmetNaziv).OrderBy(g => g.Key);
    var prikaziTezinu = Model.Any(o => o.TezinaProcentualno.HasValue);
}

<div class="container py-4">
    <h2 class="text-center mb-4 text-primary fw-bold">
        <i class="fas fa-graduation-cap me-2"></i> @ViewData["Title"]
    </h2>

    @if (userRole == "Profesor" || userRole == "Studentska služba")
    {
        var prosjekPoPredmetu = Model
        .Where(o => o.Tip == "Predmet")
        .GroupBy(o => o.PredmetNaziv)
        .Select(g => new { Predmet = g.Key, Prosjek = g.Average(o => o.Vrijednost) })
        .OrderBy(p => p.Predmet)
        .ToList();

        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar me-2"></i> Prosjek ocjena po predmetima
                </h5>
                <button class="btn btn-sm btn-light border" id="toggleProsjeciBtn">Prikaži</button>
            </div>
            <div class="card-body d-none" id="prosjekContainer" style="transition: all 0.2s;">
                <ul class="list-group" id="prosjekList">
                    @foreach (var item in prosjekPoPredmetu)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center" data-predmet="@item.Predmet">
                            <span class="fw-bold">@item.Predmet</span>
                            <span class="badge bg-primary rounded-pill fs-6">@item.Prosjek.ToString("0.00")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="card card-body shadow-sm mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="predmetFilter" class="form-label fw-semibold mb-0">
                    <i class="fas fa-filter me-1"></i> Filter predmeta:
                </label>
            </div>
            <div class="col">
                <select id="predmetFilter" class="form-select form-select-sm w-auto d-inline-block">
                    <option value="">-- Prikaži sve --</option>
                    @foreach (var predmet in grouped.Select(g => g.Key))
                    {
                        <option value="@predmet">@predmet</option>
                    }
                </select>
            </div>
            <div class="col-auto d-flex align-items-center">
                <div class="form-check">
                    <input class="form-check-input me-2" type="checkbox" id="prikaziParcijalne" checked />
                    <label class="form-check-label" for="prikaziParcijalne">Prikaži parcijalne</label>
                </div>
            </div>
        </div>
    </div>

    @foreach (var group in grouped)
    {
        <div class="card mb-3 ocjena-grupa border" data-predmet="@group.Key">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <button class="btn btn-link text-start w-100 text-dark predmet-toggle p-0 no-wrap" style="font-size:1.13rem;">
                    <strong>@group.Key</strong>
                </button>
                <span class="badge bg-secondary no-wrap">@group.Count() ocjena</span>
            </div>
            <div class="card-body p-0 d-none">
                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                @if (userRole != "Student")
                                {
                                    <th class="no-wrap">Student</th>
                                }
                                <th class="no-wrap">Tip</th>
                                <th class="no-wrap">Vrijednost</th>
                                @if (prikaziTezinu)
                                {
                                    <th class="no-wrap">
                                        Težina
                                        <span data-bs-toggle="tooltip" title="Težina ocjene u ukupnoj ocjeni (procenti)">
                                            <i class="fas fa-info-circle text-secondary"></i>
                                        </span>
                                    </th>
                                }
                                <th class="no-wrap">Datum</th>
                                <th class="text-center no-wrap"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ocjena in group.OrderByDescending(o => o.DatumDodjele))
                            {
                                var isParcijalna = ocjena.ParentOcjenaId != null;
                                <tr class="@(isParcijalna ? "parcijalna-ocjena" : "")">
                                    @if (userRole != "Student")
                                    {
                                        <td class="no-wrap">@ocjena.StudentIme @ocjena.StudentPrezime</td>
                                    }
                                    <td class="no-wrap">
                                        @ocjena.Tip
                                        @if (ocjena.ParentOcjenaId == null && ocjena.Tip == "Predmet")
                                        {
                                            <span class="badge bg-primary ms-1">Zaključna</span>
                                        }
                                        else if (isParcijalna)
                                        {
                                            <span class="badge bg-info ms-1">Parcijalna</span>
                                        }
                                    </td>
                                    <td class="no-wrap">
                                        <span class="badge @(ocjena.Vrijednost >= 8
                                                                                                                  ? "bg-success"
                                                                                                                  : ocjena.Vrijednost >= 6
                                                                                                                      ? "bg-warning text-dark"
                                                                                                                      : "bg-danger") fs-6">
                                    @ocjena.Vrijednost
                                </span>
                            </td>
                            @if (prikaziTezinu)
                                    {
                                        <td class="no-wrap">
                                            @(ocjena.TezinaProcentualno.HasValue
                                                                            ? $"{ocjena.TezinaProcentualno}%"
                                                                            : "<span class=\"text-muted\">–</span>")
                            </td>
                                                        }
                                    <td class="no-wrap">@ocjena.DatumDodjele:dd.MM.yyyy</td>
                                    <td class="text-center no-wrap">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@ocjena.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Detalji">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (userRole != "Student")
                                            {
                                                <a asp-controller="Ocjene" asp-action="Delete" asp-route-id="@ocjena.Id"
                                                   class="btn btn-sm btn-outline-danger" title="Obriši">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary no-wrap">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tooltipovi
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
                new bootstrap.Tooltip(el);
            });
            // Toggle prosjeci
            document.getElementById("toggleProsjeciBtn")?.addEventListener("click", function () {
                const c = document.getElementById("prosjekContainer");
                c.classList.toggle("d-none");
                this.textContent = c.classList.contains("d-none") ? "Prikaži" : "Sakrij";
            });
            // Toggle grupe ocjena
            document.querySelectorAll(".predmet-toggle").forEach(btn => {
                btn.addEventListener("click", function () {
                    const body = this.closest(".ocjena-grupa").querySelector(".card-body");
                    body.classList.toggle("d-none");
                });
            });
            // Filter predmeta
            document.getElementById("predmetFilter").addEventListener("change", function () {
                const sel = this.value;
                document.querySelectorAll(".ocjena-grupa").forEach(g => {
                    g.style.display = !sel || g.dataset.predmet === sel ? "" : "none";
                });
                document.querySelectorAll("#prosjekList li").forEach(li => {
                    li.style.display = !sel || li.dataset.predmet === sel ? "flex" : "none";
                });
            });
            // Parcijalne ocjene
            const cb = document.getElementById("prikaziParcijalne");
            function refresh() {
                document.querySelectorAll(".parcijalna-ocjena").forEach(r => {
                    r.style.display = cb.checked ? "" : "none";
                });
            }
            cb?.addEventListener("change", refresh);
            refresh();
        });
    </script>
}

<style>
    /* sprječava prelamanje teksta */
    .no-wrap {
        white-space: nowrap;
    }
    /* parcijalne ocjene */
    .parcijalna-ocjena {
        opacity: 0.8;
    }
    /* accordion override */
    .accordion-item {
        border: 1px solid rgba(0,0,0,.125);
        margin-bottom: .5rem;
    }

    .accordion-button:not(.collapsed) {
        color: #0d6efd;
        background-color: #e7f1ff;
    }
</style>
