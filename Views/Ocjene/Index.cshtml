@model IEnumerable<StudentHub.ViewModels.OcjenaViewModel>

@{
    ViewData["Title"] = "Lista ocjena";
    var userRole = User.IsInRole("Student") ? "Student" : User.IsInRole("Profesor") ? "Profesor" : "Studentska služba";
}

<div class="container mt-4">
    <h2 class="text-center">Lista ocjena</h2>

    @if (Model.Any())
    {
        @if (userRole == "Student")
        {
            var prosjekOcjena = Model.Average(o => o.Vrijednost);
            <div class="card bg-primary text-white mb-4">
                <div class="card-body text-center">
                    <h5 class="card-title">Prosjek ocjena</h5>
                    <p class="card-text"><strong id="averageGrade">@prosjekOcjena.ToString("0.00")</strong></p>
                </div>
            </div>
        }
        else if (userRole == "Profesor")
        {
            var prosjekPoPredmetu = Model.Where(o => o.Tip == "Predmet")
            .GroupBy(o => o.PredmetNaziv)
            .Select(g => new { Predmet = g.Key, Prosjek = g.Average(o => o.Vrijednost) })
            .ToList();

            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Prosjek po predmetima</h5>
                    <ul class="list-group">
                        @foreach (var item in prosjekPoPredmetu)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong>@item.Predmet</strong>
                                <span class="badge bg-dark">@item.Prosjek.ToString("0.00")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    }

    <div class="row">
        @foreach (var item in Model)
        {
            @if (item.Tip == "Predmet")
            {
                @await Html.PartialAsync("OcjenaCard", item)
            }
            else if (item.Tip == "NastavnaAktivnost")
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">@item.NastavnaAktivnostNaziv</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Student:</strong> @item.StudentIme @item.StudentPrezime</p>
                            <p>
                                <strong>Ocjena:</strong>
                                <span class="badge @(item.Vrijednost >= 4 ? "bg-success" : item.Vrijednost >= 2 ? "bg-warning" : "bg-danger")">
                                    @item.Vrijednost
                                </span>
                            </p>
                            <div class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalji</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.11/signalr.min.js"></script>
    <script type="text/javascript">
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("UpdateAverageGrade", (predmetId, averageGrade) => {
            document.getElementById("averageGrade").innerText = averageGrade.toFixed(2);
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>
}