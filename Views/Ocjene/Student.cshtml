@model StudentHub.ViewModels.OcjeneViewModel

@{
    ViewData["Title"] = "Ocjene studenta";
}

<h2>@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3>Ocjene za @Model.StudentIme @Model.StudentPrezime</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Predmet</th>
                        <th>Ocjena</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ocjena in Model.Ocjene)
                    {
                        <tr>
                            <td>@ocjena.PredmetNaziv</td>
                            <td>@ocjena.OcjenaVrijednost</td>
                        </tr>
                    }
                </tbody>
            </table>
            <h4>Prosjek: @Model.Prosjek.ToString("0.00")</h4>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>