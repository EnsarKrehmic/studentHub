@model StudentHub.ViewModels.OcjenaViewModel

<div class="col-md-4 mb-4">
    <div class="card shadow-sm h-100">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@Model.PredmetId" class="text-white text-decoration-none">
                    @Model.PredmetNaziv
                </a>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.ParentOcjenaId.HasValue)
            {
                <div class="alert alert-info mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-stream"></i>
                        <div>
                            <h6 class="mb-1">Parcijalna ocjena</h6>
                            <small>
                                <strong>Glavna ocjena:</strong>
                                <a asp-action="Details" asp-route-id="@Model.ParentOcjenaId" class="text-decoration-underline">
                                    @Model.ParentNaziv
                                </a>
                            </small>
                        </div>
                    </div>
                </div>
            }

            <ul class="list-group mb-3">
                <li class="list-group-item">
                    <strong>Student:</strong> @Model.StudentIme @Model.StudentPrezime
                </li>
                <li class="list-group-item">
                    <strong>Profesor:</strong> @Model.ProfesorTitula @Model.ProfesorIme @Model.ProfesorPrezime
                </li>
                <li class="list-group-item">
                    <strong>Ocjena:</strong>
                    <span class="badge @(Model.Vrijednost >= 8 ? "bg-success" : Model.Vrijednost >= 6 ? "bg-warning text-dark" : "bg-danger") fs-6">
                        @Model.Vrijednost
                    </span>
                </li>
                @if (Model.PonderisanaVrijednost.HasValue)
                {
                    <li class="list-group-item">
                        <strong>Ponderisana vrijednost:</strong>
                        <span class="badge bg-info">@Model.PonderisanaVrijednost.Value.ToString("0.00")</span>
                    </li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Komentar))
                {
                    <li class="list-group-item">
                        <strong>Komentar:</strong> @Model.Komentar
                    </li>
                }
                @if (Model.TezinaProcentualno.HasValue)
                {
                    <li class="list-group-item">
                        <strong>Težina:</strong> @Model.TezinaProcentualno %
                    </li>
                }
                @if (Model.DatumDodjele.HasValue)
                {
                    <li class="list-group-item">
                        <strong>Datum unosa:</strong> @Model.DatumDodjele.Value.ToString("dd.MM.yyyy")
                    </li>
                }
                <li class="list-group-item">
                    <strong>Studijski program:</strong>
                    @if (Model.StudijskiProgramId > 0)
                    {
                        <a asp-controller="StudijskiProgrami" asp-action="Details" asp-route-id="@Model.StudijskiProgramId" class="text-decoration-none">
                            @Model.StudentStudijskiProgramNaziv
                        </a>
                    }
                    else
                    {
                        @Model.StudentStudijskiProgramNaziv
                    }
                </li>
            </ul>

            @if (User.IsInRole("Student") && Model.Vrijednost < 6)
            {
                <div class="alert alert-danger py-2 px-3">
                    <i class="fas fa-exclamation-circle"></i> Ova ocjena je ispod prolaznog praga!
                </div>
            }

            @if (Model.DjelimicneOcjene != null && Model.DjelimicneOcjene.Any())
            {
                <div class="mb-2">
                    <hr class="my-2" />
                    <h6 class="text-muted">Parcijalne ocjene</h6>
                    <ul class="list-group">
                        @foreach (var dj in Model.DjelimicneOcjene)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <strong>@dj.Vrijednost</strong>
                                    @if (!string.IsNullOrWhiteSpace(dj.Komentar))
                                    {
                                        <small class="text-muted ms-2">(@dj.Komentar)</small>
                                    }
                                </span>
                                @if (dj.TezinaProcentualno.HasValue)
                                {
                                    <span class="badge bg-secondary">@dj.TezinaProcentualno %</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (Model.BodoviSaIspita.Any())
            {
                <div class="mb-2">
                    <hr class="my-2" />
                    <h6 class="text-muted">Rezultati ispita</h6>
                    <ul class="list-group">
                        @foreach (var ispit in Model.BodoviSaIspita.OrderBy(i => i.Datum))
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@ispit.IspitNaziv (@ispit.Datum.ToString("dd.MM.yyyy"))</span>
                                <span class="badge bg-primary">@ispit.Bodovi</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <hr />
            <h6 class="mb-2">Prisustvo</h6>
            <ul class="list-group mb-3">
                <li class="list-group-item">Ukupno: <strong>@Model.ProcenatPrisustvaUkupno.ToString("0.0")%</strong></li>
                <li class="list-group-item">Predavanja: <strong>@Model.ProcenatPrisustvaPredavanja.ToString("0.0")%</strong></li>
                <li class="list-group-item">Vježbe: <strong>@Model.ProcenatPrisustvaVjezbi.ToString("0.0")%</strong></li>
            </ul>

            <div class="d-flex gap-2 justify-content-end mt-2 flex-wrap">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-eye"></i> Detalji
                </a>
                @if (User.IsInRole("Profesor") || User.IsInRole("Studentska služba"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">
                        <i class="fas fa-edit"></i> Izmjena
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                        <i class="fas fa-trash-alt"></i> Brisanje
                    </a>
                }
            </div>
        </div>
    </div>
</div>
