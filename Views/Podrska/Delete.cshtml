@model StudentHub.Models.PodrskaUpit

@{
    ViewData["Title"] = "Brisanje upita";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj upit?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti upit iz baze.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Naslov"] = Model.Naslov,
        ["Opis upita"] = Model.Opis
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
