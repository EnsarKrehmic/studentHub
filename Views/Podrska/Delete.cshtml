@model StudentHub.Models.PodrskaUpit
@{
    ViewData["Title"] = "Brisanje upita";
}
<div class="card shadow-sm mx-auto" style="max-width: 520px;">
    <div class="card-body">
        <h2 class="card-title">@ViewData["Title"]</h2>
        <hr />
        <p>Da li ste sigurni da želite obrisati ovaj upit?</p>
        <dl class="row">
            <dt class="col-sm-4">Naslov:</dt>
            <dd class="col-sm-8">@Model.Naslov</dd>
            <dt class="col-sm-4">Opis upita:</dt>
            <dd class="col-sm-8">@Model.Opis</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> Obriši
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Nazad
            </a>
        </form>
    </div>
</div>
