@model StudentHub.Models.PodrskaUpit
@{
    ViewData["Title"] = "Brisanje upita";
}

<h2>@ViewData["Title"]</h2>
<hr />
<p>Da li ste sigurni da želite obrisati ovaj upit?</p>
<dl class="row">
    <dt class="col-sm-3">Naslov:</dt>
    <dd class="col-sm-9">@Model.Naslov</dd>

    <dt class="col-sm-3">Opis upita:</dt>
    <dd class="col-sm-9">@Model.Opis</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
