@model StudentHub.Models.PodrskaUpit
@using StudentHub.Models
@{
    ViewData["Title"] = "Detalji upita";
    var aspNetUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isSluzba = User.IsInRole("Studentska služba");
}

<div class="container my-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-headset me-2"></i>@ViewData["Title"]
            </h5>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-4">Naslov</dt>
                <dd class="col-sm-8">@Model.Naslov</dd>

                <dt class="col-sm-4">Opis</dt>
                <dd class="col-sm-8">@Model.Opis</dd>

                <dt class="col-sm-4">Datum kreiranja</dt>
                <dd class="col-sm-8">@Model.DatumKreiranja.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @switch (Model.Status)
                    {
                        case UpitStatus.Podnesen:
                            <span class="badge bg-warning text-dark">Podnesen</span>
                            ; break;
                        case UpitStatus.UObradi:
                            <span class="badge bg-info text-dark">U obradi</span>
                            ; break;
                        case UpitStatus.Zatvoren:
                            <span class="badge bg-success">Zatvoren</span>
                            ; break;
                    }
                </dd>

                <dt class="col-sm-4">Podnio/la</dt>
                <dd class="col-sm-8">@($"{Model.Korisnik?.Ime} {Model.Korisnik?.Prezime}")</dd>

                @if (!string.IsNullOrWhiteSpace(Model.Odgovor))
                {
                    <dt class="col-sm-4 text-success">Odgovor službe</dt>
                    <dd class="col-sm-8 text-success">@Model.Odgovor</dd>

                    <dt class="col-sm-4">Datum odgovora</dt>
                    <dd class="col-sm-8">@Model.DatumOdgovora?.ToString("dd.MM.yyyy HH:mm")</dd>
                }
            </dl>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Nazad
                </a>

                @if (!isSluzba && Model.Korisnik.AspNetUserId == aspNetUserId && Model.Status == UpitStatus.Podnesen)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Uredi
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Obriši
                    </a>
                }

                @if (isSluzba && Model.Status == UpitStatus.Podnesen)
                {
                    <form asp-action="PostaviUObradi" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-hourglass-half me-1"></i> U obradi
                        </button>
                    </form>
                }

                @if (isSluzba && Model.Status == UpitStatus.UObradi)
                {
                    <a asp-action="Odgovori" asp-route-id="@Model.Id" class="btn btn-secondary">
                        <i class="fas fa-reply me-1"></i> Odgovori
                    </a>
                }

                @if (isSluzba && Model.Status == UpitStatus.Zatvoren)
                {
                    <a asp-action="EditOdgovor" asp-route-id="@Model.Id" class="btn btn-info">
                        <i class="fas fa-edit me-1"></i> Uredi odgovor
                    </a>
                }
            </div>
        </div>
    </div>
</div>
