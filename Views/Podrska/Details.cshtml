@model StudentHub.Models.PodrskaUpit
@using StudentHub.Models
@{
    ViewData["Title"] = "Detalji upita";
    bool isSluzba = User.IsInRole("Studentska služba");
    var aspNetUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title">@ViewData["Title"]</h2>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Naslov:</dt>
            <dd class="col-sm-9">@Model.Naslov</dd>

            <dt class="col-sm-3">Opis upita:</dt>
            <dd class="col-sm-9">@Model.Opis</dd>

            <dt class="col-sm-3">Datum kreiranja:</dt>
            <dd class="col-sm-9">@Model.DatumKreiranja.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">
                @switch (Model.Status)
                {
                    case UpitStatus.Podnesen:
                        <span class="badge bg-warning text-dark">Podnesen</span>
                        break;
                    case UpitStatus.UObradi:
                        <span class="badge bg-info text-dark">U obradi</span>
                        break;
                    case UpitStatus.Zatvoren:
                        <span class="badge bg-success">Zatvoren</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">Postavio/la:</dt>
            <dd class="col-sm-9">@($"{Model.Korisnik?.Ime} {Model.Korisnik?.Prezime}")</dd>

            @if (!string.IsNullOrEmpty(Model.Odgovor))
            {
                <dt class="col-sm-3 text-success">Odgovor studentske službe:</dt>
                <dd class="col-sm-9 text-success">@Model.Odgovor</dd>
                <dt class="col-sm-3">Datum odgovora:</dt>
                <dd class="col-sm-9">@Model.DatumOdgovora?.ToString("dd.MM.yyyy HH:mm")</dd>
            }
        </dl>
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Nazad
            </a>
            @if (!isSluzba && Model.Korisnik.AspNetUserId == aspNetUserId && Model.Status == UpitStatus.Podnesen)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Uredi
                </a>
            }
            @if (isSluzba && Model.Status == UpitStatus.Podnesen)
            {
                <form asp-action="PostaviUObradi" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-warning"><i class="fas fa-hourglass-half"></i> Postavi u obradi</button>
                </form>
            }
            @if (isSluzba && Model.Status == UpitStatus.UObradi)
            {
                <a asp-action="Odgovori" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="fas fa-reply"></i> Odgovori
                </a>
            }
            @if (isSluzba && Model.Status == UpitStatus.Zatvoren)
            {
                <a asp-action="EditOdgovor" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="fas fa-edit"></i> Uredi odgovor
                </a>
            }
        </div>
    </div>
</div>
