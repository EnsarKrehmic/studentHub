@model StudentHub.Models.PodrskaUpit
@{
    ViewData["Title"] = Model.Id == 0 ? "Novi upit za podršku" : "Uredi upit";
}

<div class="card shadow-sm mx-auto" style="max-width: 500px;">
    <div class="card-body">
        <h2 class="card-title">@ViewData["Title"]</h2>
        <hr />
        <form asp-action="@((Model.Id == 0) ? "Create" : "Edit")" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Naslov" class="form-label"></label>
                <input asp-for="Naslov" class="form-control" maxlength="60" placeholder="Kratko opišite problem (npr. Nemam pristup sistemu)" />
                <span asp-validation-for="Naslov" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Opis" class="form-label"></label>
                <textarea asp-for="Opis" class="form-control" rows="5" maxlength="2000" placeholder="Detaljno opišite upit ili problem..."></textarea>
                <span asp-validation-for="Opis" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success me-2">
                <i class="fas fa-paper-plane"></i> @(Model.Id == 0 ? "Pošalji upit" : "Sačuvaj")
            </button>
            <a asp-action="@(Model.Id == 0 ? "Index" : "Details")" asp-route-id="@(Model.Id)" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Nazad
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
