@model StudentHub.Models.PodrskaUpit
@{
    // We reuse the same logic; EditOdgovor simply sets isEdit = true
    ViewData["Title"] = "Uredi odgovor na upit";
}

<div class="card shadow-sm mx-auto" style="max-width: 560px;">
    <div class="card-header bg-warning text-dark">
        <h2 class="card-title mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h2>
    </div>
    <div class="card-body">
        <div class="mb-4">
            <p><strong>Naslov:</strong> @Model.Naslov</p>
            <p><strong>Opis upita:</strong> @Model.Opis</p>
            <p><strong>Postavio/la:</strong> @($"{Model.Korisnik?.Ime} {Model.Korisnik?.Prezime}")</p>
            <p><strong>Datum kreiranja:</strong> @Model.DatumKreiranja.ToString("dd.MM.yyyy HH:mm")</p>
        </div>

        <form asp-action="EditOdgovor" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label for="odgovor" class="form-label fw-bold">Uredi odgovor</label>
                <textarea name="odgovor" id="odgovor" class="form-control" rows="5" required>
          @Model.Odgovor
        </textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-1"></i>Sačuvaj odgovor
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Nazad
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
