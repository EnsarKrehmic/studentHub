@model IEnumerable<StudentHub.Models.PodrskaUpit>
@using StudentHub.Models
@{
    ViewData["Title"] = "Upiti za podršku";
    var aspNetUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isSluzba = User.IsInRole("Studentska služba");
    var selectedStatus = Context.Request.Query["status"];
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="status" class="form-select">
            <option value="">Svi statusi</option>
            <option value="Podnesen" selected="@(selectedStatus == "Podnesen" ? "selected" : null)">Podnesen</option>
            <option value="UObradi" selected="@(selectedStatus == "UObradi" ? "selected" : null)">U obradi</option>
            <option value="Zatvoren" selected="@(selectedStatus == "Zatvoren" ? "selected" : null)">Zatvoren</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <button type="submit" class="btn btn-primary me-2"><i class="fas fa-filter me-1"></i> Filtriraj</button>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-undo me-1"></i> Reset</a>
    </div>
</form>

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> Novi upit
    </a>
</div>

<div class="table-responsive shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Naslov</th>
                <th>Datum</th>
                <th>Status</th>
                <th>Korisnik</th>
                <th class="text-center">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var upit in Model)
            {
                <tr>
                    <td class="fw-semibold">@upit.Naslov</td>
                    <td>@upit.DatumKreiranja.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @switch (upit.Status)
                        {
                            case UpitStatus.Podnesen:
                                <span class="badge bg-warning text-dark">Podnesen</span>
                                ; break;
                            case UpitStatus.UObradi:
                                <span class="badge bg-info text-dark">U obradi</span>
                                ; break;
                            case UpitStatus.Zatvoren:
                                <span class="badge bg-success">Zatvoren</span>
                                ; break;
                        }
                    </td>
                    <td>@($"{upit.Korisnik?.Ime} {upit.Korisnik?.Prezime}")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@upit.Id" class="btn btn-sm btn-outline-primary me-1" title="Detalji">
                            <i class="fas fa-eye"></i>
                        </a>

                        @if (!isSluzba && upit.Korisnik.AspNetUserId == aspNetUserId && upit.Status == UpitStatus.Podnesen)
                        {
                            <a asp-action="Edit" asp-route-id="@upit.Id" class="btn btn-sm btn-outline-warning me-1" title="Uredi">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@upit.Id" class="btn btn-sm btn-outline-danger me-1" title="Obriši">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }

                        @if (isSluzba)
                        {
                            @if (upit.Status == UpitStatus.UObradi)
                            {
                                <a asp-action="Odgovori" asp-route-id="@upit.Id" class="btn btn-sm btn-outline-success me-1" title="Odgovori">
                                    <i class="fas fa-reply"></i>
                                </a>
                            }
                            else if (upit.Status == UpitStatus.Zatvoren)
                            {
                                <a asp-action="EditOdgovor" asp-route-id="@upit.Id" class="btn btn-sm btn-outline-info me-1" title="Uredi odgovor">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            }
                            <a asp-action="Delete" asp-route-id="@upit.Id" class="btn btn-sm btn-outline-danger" title="Obriši upit">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
    </a>
</div>
