@model IEnumerable<StudentHub.Models.PodrskaUpit>
@using StudentHub.Models
@{
    ViewData["Title"] = "Upiti za podršku";
    var aspNetUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isSluzba = User.IsInRole("Studentska služba");
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a class="btn btn-primary shadow-sm" asp-action="Create" title="Novi upit">
        <i class="fas fa-plus me-2"></i> Novi upit
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Naslov</th>
                        <th>Datum</th>
                        <th>Status</th>
                        <th>Korisnik</th>
                        <th class="text-center">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var upit in Model)
                    {
                        <tr>
                            <td>@upit.Naslov</td>
                            <td>@upit.DatumKreiranja.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @switch (upit.Status)
                                {
                                    case UpitStatus.Podnesen:
                                        <span class="badge bg-warning text-dark">Podnesen</span>
                                        break;
                                    case UpitStatus.UObradi:
                                        <span class="badge bg-info text-dark">U obradi</span>
                                        break;
                                    case UpitStatus.Zatvoren:
                                        <span class="badge bg-success">Zatvoren</span>
                                        break;
                                }
                            </td>
                            <td>
                                @($"{upit.Korisnik?.Ime} {upit.Korisnik?.Prezime}")
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-outline-primary me-1" asp-action="Details" asp-route-id="@upit.Id" title="Detalji">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (!isSluzba && upit.Korisnik.AspNetUserId == aspNetUserId && upit.Status == UpitStatus.Podnesen)
                                {
                                    <a class="btn btn-sm btn-outline-warning me-1" asp-action="Edit" asp-route-id="@upit.Id" title="Uredi">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                                @if (isSluzba)
                                {
                                    if (upit.Status == UpitStatus.UObradi)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Odgovori" asp-route-id="@upit.Id" title="Odgovori">
                                            <i class="fas fa-reply"></i>
                                        </a>
                                    }
                                    else if (upit.Status == UpitStatus.Zatvoren)
                                    {
                                        <a class="btn btn-sm btn-outline-info me-1" asp-action="EditOdgovor" asp-route-id="@upit.Id" title="Uredi odgovor">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@upit.Id" title="Obriši">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
