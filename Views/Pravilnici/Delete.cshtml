@model StudentHub.ViewModels.PravilnikViewModel
@{
    ViewData["Title"] = "Brisanje pravilnika";
    Layout = "_Layout";
}
<div class="container py-5">
    <div class="alert alert-danger text-center">
        <i class="fas fa-exclamation-triangle fa-2x"></i><br />
        <h4 class="fw-bold my-3">Potvrda brisanja pravilnika</h4>
        <p>
            Da li ste sigurni da želite <b>obrisati pravilnik "@Model.Naslov"</b>?
        </p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger px-4"><i class="fas fa-trash"></i> Obriši</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Otkaži</a>
        </form>
    </div>
</div>
