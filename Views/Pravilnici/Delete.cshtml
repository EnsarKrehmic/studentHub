@model StudentHub.ViewModels.PravilnikViewModel

@{
    ViewData["Title"] = "Brisanje pravilnika";
    Layout = "_Layout";

    ViewData["WarningMessage"] = $"Da li ste sigurni da želite obrisati pravilnik \"{Model.Naslov}\"?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti pravilnik iz sistema.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Naslov pravilnika"] = Model.Naslov,
        ["Opis"] = Model.Opis
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
