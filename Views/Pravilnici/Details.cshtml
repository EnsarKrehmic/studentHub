@model StudentHub.ViewModels.PravilnikViewModel

@{
    ViewData["Title"] = "Detalji pravilnika";
    bool isSluzba = User.IsInRole("Studentska služba");
}

<div class="container my-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-file-alt me-2"></i> @Model.Naslov
            </h5>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-4">Opis</dt>
                <dd class="col-sm-8 fs-5 text-secondary">@Model.Opis</dd>
            </dl>

            @if (Model.Clanovi != null && Model.Clanovi.Any())
            {
                <div class="alert alert-info mb-3">
                    <i class="fas fa-list-ol me-1"></i> Članovi pravilnika
                </div>

                <ol class="list-group list-group-numbered mb-4">
                    @foreach (var clanak in Model.Clanovi.OrderBy(c => c.RedniBroj))
                    {
                        <li class="list-group-item border-0" style="background: #f9fafd;">
                            <div class="fw-semibold mb-1">
                                @clanak.RedniBroj. @clanak.NaslovClanka
                            </div>
                            <div class="text-secondary" style="white-space: pre-line;">
                                @clanak.Sadrzaj
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-1"></i> Pravilnik nema dodanih članova.
                </div>
            }

            <div class="d-flex gap-2 flex-wrap mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Povratak na listu
                </a>

                @if (isSluzba)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Uredi
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Obriši
                    </a>
                }
            </div>
        </div>
    </div>
</div>
