@model IEnumerable<StudentHub.ViewModels.PravilnikViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Pravilnici i pravilna dokumentacija";
    bool isAdmin = User.IsInRole("Studentska služba");
}

<div class="container py-4">
    <h2 class="mb-4 text-success fw-bold text-center">
        <i class="fas fa-gavel"></i> Pravilnici i zvanična dokumentacija
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }

    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <input type="text"
                   id="pravilnikSearch"
                   class="form-control form-control-lg"
                   placeholder="Pretraži pravilnike ili članove..."
                   autocomplete="off" />
        </div>
        @if (isAdmin)
        {
            <div class="col-md-6 text-md-end text-start mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus me-1"></i> Dodaj novi pravilnik
                </a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Još uvijek nema objavljenih pravilnika.</div>
    }
    else
    {
        <div class="accordion" id="pravilnikAccordion">
            @foreach (var p in Model.OrderByDescending(x => x.Id))
            {
                var collapseId = $"collapse_{p.Id}";
                <div class="card shadow-sm mb-3 pravilnik-card" data-pravilnik="@p.Naslov.ToLower() @p.Opis.ToLower()">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fas fa-file-alt text-success fs-5"></i>
                            <span class="fs-5 fw-bold">@p.Naslov</span>
                        </div>
                        <button class="btn btn-link text-decoration-none fs-5"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                aria-expanded="false"
                                aria-controls="@collapseId">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>
                    <div id="@collapseId"
                         class="collapse"
                         data-bs-parent="#pravilnikAccordion">
                        <div class="card-body">
                            <div class="mb-2">
                                <span class="fw-bold text-secondary">Opis:</span>
                                <span>@p.Opis</span>
                            </div>
                            @if (p.Clanovi?.Any() == true)
                            {
                                <hr />
                                <div>
                                    <span class="fw-bold text-secondary">Članovi pravilnika:</span>
                                    <ul class="list-group mt-2 mb-2">
                                        @foreach (var clan in p.Clanovi.OrderBy(x => x.RedniBroj))
                                        {
                                            var clanCollapseId = $"clanak_{p.Id}_{clan.RedniBroj}";
                                            <li class="list-group-item pravilnik-clanak-item"
                                                data-clanak="@clan.NaslovClanka.ToLower() @clan.Sadrzaj.ToLower()">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <span class="badge bg-secondary me-2">Član @clan.RedniBroj</span>
                                                        <span class="fw-bold">@clan.NaslovClanka</span>
                                                    </div>
                                                    <button class="btn btn-link btn-sm p-0 text-info pravilnik-toggle-clanak"
                                                            type="button"
                                                            aria-expanded="false"
                                                            aria-controls="@clanCollapseId"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@clanCollapseId">
                                                        <i class="fas fa-angle-double-down"></i>
                                                    </button>
                                                </div>
                                                <div id="@clanCollapseId" class="collapse mt-2">
                                                    <div class="text-body">
                                                        @Html.Raw(clan.Sadrzaj.Replace("\n", "<br/>"))
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (isAdmin)
                            {
                                <div class="mt-3 d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit me-1"></i> Uredi
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash-alt me-1"></i> Obriši
                                    </a>
                                </div>
                            }
                            <div class="mt-2">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-info-circle me-1"></i> Prikaži detalje
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
        </a>
    </div>
</div>

<style>
    .pravilnik-card {
        border-radius: 1rem;
        transition: box-shadow 0.15s, background 0.15s;
        background: #f8fafc;
    }

        .pravilnik-card:hover {
            box-shadow: 0 0.5rem 2rem rgba(19,169,116,0.13), 0 0.125rem 0.5rem rgba(0,0,0,0.07);
            background: #f2fef7;
        }

    .pravilnik-clanak-item {
        background: #f7f9fa;
        border-radius: 0.7rem;
        margin-bottom: 0.5rem;
        border: 1px solid #e7e7e7;
        transition: background 0.2s;
    }

        .pravilnik-clanak-item:hover {
            background: #e6faf3;
        }

    .pravilnik-toggle-clanak {
        color: #19a974 !important;
        font-size: 1.3em;
    }
</style>

@section Scripts {
    <script>
        // Pretraga pravilnika i članova
        document.getElementById("pravilnikSearch").addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();
            document.querySelectorAll(".pravilnik-card").forEach(card => {
                const text = card.getAttribute("data-pravilnik");
                const clanItems = Array.from(card.querySelectorAll(".pravilnik-clanak-item"))
                    .map(li => li.getAttribute("data-clanak"))
                    .join(" ");
                const match = !query || text.includes(query) || clanItems.includes(query);
                card.style.display = match ? "" : "none";
            });
        });
    </script>
}
