@model StudentHub.ViewModels.PredmetCreateViewModel

@{
    ViewData["Title"] = "Kreiranje novog predmeta";
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="Naziv" class="control-label"></label>
                <input asp-for="Naziv" class="form-control" />
                <span asp-validation-for="Naziv" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Opis" class="control-label"></label>
                <textarea asp-for="Opis" class="form-control"></textarea>
                <span asp-validation-for="Opis" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ECTS" class="control-label"></label>
                <input asp-for="ECTS" class="form-control" type="number" />
                <span asp-validation-for="ECTS" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Profesori:</label>
                <select asp-for="ProfesorIds" multiple class="form-control">
                    @foreach (var profesor in ViewBag.Profesori)
                    {
                        <option value="@profesor.Id">@profesor.Ime @profesor.Prezime</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Asistenti:</label>
                <select asp-for="AsistentIds" multiple class="form-control">
                    @foreach (var asistent in ViewBag.Asistenti)
                    {
                        <option value="@asistent.Id">@asistent.Ime @asistent.Prezime</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="NastavniPlanId" class="control-label"></label>
                <select asp-for="NastavniPlanId" class="form-control" asp-items="ViewBag.NastavniPlanId"></select>
                <span asp-validation-for="NastavniPlanId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kreiraj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}