@model StudentHub.ViewModels.PredmetCreateViewModel

@{
    ViewData["Title"] = "Kreiranje predmeta";
    var programi = (IEnumerable<SelectListItem>)ViewBag.StudijskiProgrami;
    var nastavniPlanovi = ViewBag.NastavniPlanovi as IEnumerable<dynamic>;
    var profesori = ViewBag.Profesori as IEnumerable<dynamic>;
    var asistenti = ViewBag.Asistenti as IEnumerable<dynamic>;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Naziv" class="form-label"></label>
                                <input asp-for="Naziv" class="form-control" placeholder="Unesite naziv predmeta" />
                                <span asp-validation-for="Naziv" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ECTS" class="form-label"></label>
                                <input asp-for="ECTS" class="form-control" />
                                <span asp-validation-for="ECTS" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UkupnoBodova" class="form-label"></label>
                                <input asp-for="UkupnoBodova" class="form-control" min="1" max="1000" />
                                <small class="form-text text-muted">Ukupni broj bodova na predmetu (npr. 100).</small>
                                <span asp-validation-for="UkupnoBodova" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TipPredmeta" class="form-label"></label>
                                <select asp-for="TipPredmeta" class="form-control" asp-items="Html.GetEnumSelectList<TipPredmeta>()"></select>
                                <span asp-validation-for="TipPredmeta" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Semestar" class="form-label"></label>
                                <select asp-for="Semestar" class="form-control">
                                    <option value="">Odaberite semestar</option>
                                    <option value="1">1 (Zimski)</option>
                                    <option value="2">2 (Ljetni)</option>
                                </select>
                                <span asp-validation-for="Semestar" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="StudijskiProgramId" class="form-label">Studijski program</label>
                                <select asp-for="StudijskiProgramId" class="form-control" id="StudijskiProgramId">
                                    <option value="">Odaberite program</option>
                                    @foreach (var program in programi)
                                    {
                                        <option value="@program.Value">@program.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="StudijskiProgramId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GodinaStudija" class="form-label"></label>
                                <select asp-for="GodinaStudija" class="form-control" id="GodinaStudija">
                                    <option value="">Odaberite godinu</option>
                                    @for (int i = 1; i <= 6; i++)
                                    {
                                        <option value="@i">@i. godina</option>
                                    }
                                </select>
                                <span asp-validation-for="GodinaStudija" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Opis" class="form-label"></label>
                                <textarea asp-for="Opis" class="form-control" placeholder="Unesite opis predmeta"></textarea>
                                <span asp-validation-for="Opis" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="NastavniPlanId" class="form-label">Nastavni plan (opcionalno)</label>
                                <select asp-for="NastavniPlanId" class="form-control" id="NastavniPlanId">
                                    <option value="">Odaberite nastavni plan</option>
                                    @foreach (var plan in nastavniPlanovi)
                                    {
                                        <option value="@plan.Id"
                                                data-programid="@plan.StudijskiProgramId"
                                                data-godina="@plan.GodinaStudija">@plan.Naziv</option>
                                    }
                                </select>
                                <span asp-validation-for="NastavniPlanId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="SatiPredavanja" class="form-label"></label>
                                <input asp-for="SatiPredavanja" class="form-control" />
                                <span asp-validation-for="SatiPredavanja" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="SatiVjezbi" class="form-label"></label>
                                <input asp-for="SatiVjezbi" class="form-control" />
                                <span asp-validation-for="SatiVjezbi" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="ProfesorIds" class="form-label">Profesor/i (opcionalno)</label>
                                <select class="form-control" id="ProfesorIds" name="ProfesorIds" multiple>
                                    @foreach (var profesor in profesori)
                                    {
                                        <option value="@profesor.Id" data-programid="@profesor.StudijskiProgramId">@profesor.ImePrezime</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Odaberite jednog ili više profesora.</small>
                            </div>
                            <div class="col-md-6">
                                <label for="AsistentIds" class="form-label">Asistent/i (opcionalno)</label>
                                <select class="form-control" id="AsistentIds" name="AsistentIds" multiple>
                                    @foreach (var asistent in asistenti)
                                    {
                                        <option value="@asistent.Id" data-programid="@asistent.StudijskiProgramId">@asistent.ImePrezime</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Odaberite jednog ili više asistenata.</small>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4">Kreiraj predmet</button>
                            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Helper za filtraciju
        function filterByProgram() {
            var programId = $("#StudijskiProgramId").val();
            $("#GodinaStudija").val("");

            $("#ProfesorIds option").each(function () {
                $(this).toggle(!programId || $(this).data("programid") == programId);
            });

            $("#AsistentIds option").each(function () {
                $(this).toggle(!programId || $(this).data("programid") == programId);
            });

            $("#NastavniPlanId option").each(function () {
                var pid = $(this).data("programid");
                $(this).toggle(!programId || pid == programId || !pid);
            });
        }

        function filterNastavniPlanByGodina() {
            var godina = $("#GodinaStudija").val();
            var programId = $("#StudijskiProgramId").val();

            $("#NastavniPlanId option").each(function () {
                var pid = $(this).data("programid");
                var g = $(this).data("godina");
                var show = (!programId || pid == programId || !pid) && (!godina || g == godina || !g);
                $(this).toggle(show);
            });
        }

        $("#StudijskiProgramId").change(function () {
            filterByProgram();
            filterNastavniPlanByGodina();
        });
        $("#GodinaStudija").change(function () {
            filterNastavniPlanByGodina();
        });

        $(function () {
            filterByProgram();
            filterNastavniPlanByGodina();
        });
    </script>
}
