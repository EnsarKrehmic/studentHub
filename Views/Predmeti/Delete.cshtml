@model StudentHub.ViewModels.PredmetDetailsViewModel

@{
    ViewData["Title"] = "Brisanje predmeta";

    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj predmet?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o predmetu, uključujući ocjene, ispite, prijave i nastavne aktivnosti.";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Naziv predmeta"] = Model.Predmet.Naziv,
        ["Opis"] = Model.Predmet.Opis,
        ["ECTS bodovi"] = Model.Predmet.ECTS,
        ["Ukupni broj bodova"] = Model.Predmet.UkupnoBodova,
        ["Tip predmeta"] = Model.Predmet.TipPredmeta == StudentHub.Models.TipPredmeta.Osnovni
                                    ? "Osnovni"
                                    : "Izborni",
        ["Studijski program"] = Model.Predmet.StudijskiProgram?.Naziv ?? (object)Html.Raw("<span class='text-warning'>Nema programa</span>"),
        ["Godina studija"] = $"{Model.Predmet.GodinaStudija}. godina",
        ["Semestar"] = Model.Predmet.Semestar == 1
                                    ? "1 (Zimski)"
                                    : Model.Predmet.Semestar == 2
                                        ? "2 (Ljetni)"
                                        : Model.Predmet.Semestar.ToString(),
        ["Sati predavanja"] = Model.Predmet.SatiPredavanja,
        ["Sati vježbi"] = Model.Predmet.SatiVjezbi,
        ["Nastavni plan"] = Model.Predmet.NastavniPlan != null
                                    ? $"{Model.Predmet.NastavniPlan.GodinaStudija}. godina, {Model.Predmet.NastavniPlan.StudijskiProgram?.Naziv}"
                                    : (object)Html.Raw("<span class='text-warning'>Nema dodijeljen nastavni plan.</span>")
    };
}

@await Html.PartialAsync("_DeleteCard", Model.Predmet)
