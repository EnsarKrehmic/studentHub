@using System.Security.Claims
@model StudentHub.ViewModels.PredmetDetailsViewModel

@{
    ViewData["Title"] = "Detalji predmeta";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (Model?.Predmet == null)
{
    <div class="alert alert-danger">
        Predmet nije pronađen ili je uklonjen.
    </div>
}
else
{
    <div class="container mt-4">
        <!-- Opšti podaci o predmetu -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h3>Podaci o predmetu</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Naziv predmeta:</dt>
                    <dd class="col-sm-9">@Model.Predmet?.Naziv</dd>
                    <dt class="col-sm-3">Opis:</dt>
                    <dd class="col-sm-9">@Model.Predmet?.Opis</dd>
                    <dt class="col-sm-3">ECTS bodovi:</dt>
                    <dd class="col-sm-9">@Model.Predmet?.ECTS</dd>
                    <dt class="col-sm-3">Nastavni plan:</dt>
                    <dt class="col-sm-3">Tip predmeta:</dt>
                    <dd class="col-sm-9">@Model.Predmet.TipPredmeta.ToString()</dd>
                    <dd class="col-sm-9">
                        @if (Model.Predmet?.NastavniPlan != null)
                        {
                            <span>
                                Predmet pripada nastavnom planu:
                                @Model.Predmet.NastavniPlan.GodinaStudija. godina,
                                @(Model.Predmet.Semestar == 1 ? "prvi" :
                                    Model.Predmet.Semestar == 2 ? "drugi" :
                                    Model.Predmet.Semestar == 3 ? "treći" :
                                    Model.Predmet.Semestar == 4 ? "četvrti" :
                                    Model.Predmet.Semestar == 5 ? "peti" :
                                    Model.Predmet.Semestar == 6 ? "šesti" :
                                    Model.Predmet.Semestar == 7 ? "sedmi" :
                                    Model.Predmet.Semestar == 8 ? "osmi" :
                                    Model.Predmet.Semestar + ".") semestar
                            </span>
                        }
                        else
                        {
                            <span class="text-warning">Nema dodijeljen nastavni plan.</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Profesori -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4>Profesori</h4>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ime i prezime</th>
                            <th>Titula</th>
                            @if (User.IsInRole("Studentska služba"))
                            {
                                <th>Akcije</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Profesori.Any())
                        {
                            @foreach (var profesor in Model.Profesori)
                            {
                                <tr>
                                    <td>@profesor.Profesor?.Ime @profesor.Profesor?.Prezime</td>
                                    <td>@profesor.Profesor?.ProfesorTitula</td>
                                    @if (User.IsInRole("Studentska služba"))
                                    {
                                        <td>
                                            <form asp-action="RemoveProfesorFromSubject" asp-route-predmetId="@Model.Predmet.Id" asp-route-profesorId="@profesor.ProfesorId" method="post">
                                                <button type="submit" class="btn btn-danger btn-sm">Ukloni</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-warning">Nema dodijeljenog profesora.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (User.IsInRole("Studentska služba"))
                {
                    <form asp-action="AddProfesorToSubject" asp-route-predmetId="@Model.Predmet.Id" method="post">
                        <div class="form-group">
                            <label for="ProfesorId">Dodaj profesora:</label>
                            <select asp-for="ProfesorId" asp-items="ViewBag.Profesori" class="form-control"></select>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Dodaj profesora</button>
                    </form>
                }
            </div>
        </div>

        <!-- Asistenti -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4>Asistenti</h4>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ime i prezime</th>
                            <th>Titula</th>
                            @if (User.IsInRole("Studentska služba"))
                            {
                                <th>Akcije</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Asistenti.Any())
                        {
                            @foreach (var asistent in Model.Asistenti)
                            {
                                <tr>
                                    <td>@asistent.Asistent?.Ime @asistent.Asistent?.Prezime</td>
                                    <td>@asistent.Asistent?.AsistentTitula</td>
                                    @if (User.IsInRole("Studentska služba"))
                                    {
                                        <td>
                                            <form asp-action="RemoveAsistentFromSubject" asp-route-predmetId="@Model.Predmet.Id" asp-route-asistentId="@asistent.AsistentId" method="post">
                                                <button type="submit" class="btn btn-danger btn-sm">Ukloni</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-warning">Nema dodijeljenog asistenta.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (User.IsInRole("Studentska služba"))
                {
                    <form asp-action="AddAsistentToSubject" asp-route-predmetId="@Model.Predmet.Id" method="post">
                        <div class="form-group">
                            <label for="AsistentId">Dodaj asistenta:</label>
                            <select asp-for="AsistentId" asp-items="ViewBag.Asistenti" class="form-control"></select>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Dodaj asistenta</button>
                    </form>
                }
            </div>
        </div>

        <!-- Studenti na predmetu -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4>Studenti na predmetu</h4>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ime i prezime</th>
                            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                            {
                                <th>Broj indeksa</th>
                            }
                            <th>Godina studija</th>
                            <th>Ocjena</th>
                            @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                            {
                                <th>Akcije</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.StudentiNaPredmetu?.Any() == true)
                        {
                            @foreach (var studentNaPredmetu in Model.StudentiNaPredmetu)
                            {
                                <tr>
                                    <td>@studentNaPredmetu.Student?.Ime @studentNaPredmetu.Student?.Prezime</td>
                                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                    {
                                        <td>@studentNaPredmetu.Student?.BrojIndeksa</td>
                                    }
                                    <td>@studentNaPredmetu.Student?.GodinaStudija</td>
                                    <td>
                                        @if (User.IsInRole("Student"))
                                        {
                                            if (studentNaPredmetu.Student.AspNetUserId == User.FindFirst(ClaimTypes.NameIdentifier)?.Value)
                                            {
                                                @if (Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true && Model.Ocjene[studentNaPredmetu.StudentId].HasValue)
                                                {
                                                    <span class="badge badge-success">@Model.Ocjene[studentNaPredmetu.StudentId]</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning">Nema ocjene</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Ocjena nije dostupna</span>
                                            }
                                        }
                                        else
                                        {
                                            @if (Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true && Model.Ocjene[studentNaPredmetu.StudentId].HasValue)
                                            {
                                                <span class="badge badge-success">@Model.Ocjene[studentNaPredmetu.StudentId]</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Nema ocjene</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                                        {
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="dropdownMenuButton_@studentNaPredmetu.StudentId" data-toggle="dropdown" aria-expanded="false">
                                                    Akcije
                                                </button>
                                                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton_@studentNaPredmetu.StudentId">
                                                    @if (User.IsInRole("Profesor"))
                                                    {
                                                        @if (Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true && Model.Ocjene[studentNaPredmetu.StudentId].HasValue)
                                                        {
                                                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#editGradeModal_@studentNaPredmetu.StudentId">Izmijeni ocjenu</a>
                                                            <a class="dropdown-item text-danger" href="#" onclick="confirmDelete('RemoveGrade', @Model.Predmet.Id, @studentNaPredmetu.StudentId, 'ocjenu')">Ukloni ocjenu</a>
                                                        }
                                                        else
                                                        {
                                                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#addGradeModal_@studentNaPredmetu.StudentId">Dodaj ocjenu</a>
                                                        }
                                                    }
                                                    @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                                                    {
                                                        <a class="dropdown-item text-danger" href="#" onclick="confirmDelete('RemoveStudentFromSubject', @Model.Predmet.Id, @studentNaPredmetu.StudentId, 'studenta')">Ukloni studenta</a>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Modal za dodavanje ocjene -->
                                            <div class="modal fade" id="addGradeModal_@studentNaPredmetu.StudentId" tabindex="-1" role="dialog" aria-labelledby="addGradeModalLabel_@studentNaPredmetu.StudentId" aria-hidden="true">
                                                <div class="modal-dialog" role="document">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="addGradeModalLabel_@studentNaPredmetu.StudentId">Dodaj ocjenu za @studentNaPredmetu.Student.Ime @studentNaPredmetu.Student.Prezime</h5>
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>
                                                        <form asp-action="AddGrade" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="predmetId" value="@Model.Predmet.Id" />
                                                                <input type="hidden" name="studentId" value="@studentNaPredmetu.StudentId" />
                                                                <div class="form-group">
                                                                    <label for="ocjena">Ocjena (5-10)</label>
                                                                    <input type="number" name="ocjena" min="5" max="10" step="1" class="form-control" required />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Odustani</button>
                                                                <button type="submit" class="btn btn-primary">Dodaj ocjenu</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Modal za izmjenu ocjene -->
                                            <div class="modal fade" id="editGradeModal_@studentNaPredmetu.StudentId" tabindex="-1" role="dialog" aria-labelledby="editGradeModalLabel_@studentNaPredmetu.StudentId" aria-hidden="true">
                                                <div class="modal-dialog" role="document">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="editGradeModalLabel_@studentNaPredmetu.StudentId">Izmijeni ocjenu za @studentNaPredmetu.Student.Ime @studentNaPredmetu.Student.Prezime</h5>
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>
                                                        <form asp-action="EditGrade" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="predmetId" value="@Model.Predmet.Id" />
                                                                <input type="hidden" name="studentId" value="@studentNaPredmetu.StudentId" />
                                                                <div class="form-group">
                                                                    <label for="ocjena">Ocjena (5-10)</label>
                                                                    <input type="number" name="ocjena" min="5" max="10" step="1" class="form-control" value="@(Model.Ocjene.ContainsKey(studentNaPredmetu.StudentId) && Model.Ocjene[studentNaPredmetu.StudentId].HasValue ? Model.Ocjene[studentNaPredmetu.StudentId] : null)" required />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Odustani</button>
                                                                <button type="submit" class="btn btn-primary">Spremi promjene</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-warning">Nema studenata na ovom predmetu.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                {
                    <form asp-action="AddStudentToSubject" asp-route-predmetId="@Model.Predmet.Id" method="post">
                        <div class="form-group">
                            <label for="StudentId">Dodaj studenta:</label>
                            <select asp-for="StudentId" asp-items="ViewBag.Studenti" class="form-control"></select>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Dodaj studenta</button>
                    </form>
                }
            </div>
        </div>

        <!-- Nastavne aktivnosti -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <h4>Nastavne aktivnosti</h4>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                {
                    <div class="mb-3">
                        <a asp-controller="NastavneAktivnosti"
                           asp-action="Create"
                           asp-route-predmetId="@Model.Predmet.Id"
                           class="btn btn-primary">
                            <i class="fas fa-plus"></i> Dodaj novu aktivnost
                        </a>
                    </div>
                }

                <!-- Predavanja -->
                <div class="mb-5">
                    <h5 class="text-primary mb-3">
                        <i class="fas fa-chalkboard-teacher"></i> Predavanja
                    </h5>
                    @{
                        var predavanja = Model.NastavneAktivnosti?
                        .Where(a => a.Tip == TipNastavneAktivnosti.Predavanje)
                        .OrderBy(a => a.DatumVrijemeOdrzavanja)
                        .ToList();
                    }
                    @if (predavanja?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Datum i vrijeme</th>
                                        <th>Status</th>
                                        <th>Akcije</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aktivnost in predavanja)
                                    {
                                        <tr class="@(!aktivnost.JeDostupno ? "table-secondary" : "")">
                                            <td>@aktivnost.Naziv</td>
                                            <td>@aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(aktivnost.JeDostupno ? "badge-success" : "badge-secondary")">
                                                    @(aktivnost.JeDostupno ? "Dostupno" : "Zaključano")
                                                </span>
                                            </td>
                                            <td>
                                                <!-- Detalji dugme -->
                                                @if (aktivnost.JeDostupno || !User.IsInRole("Student"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Details"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-info">
                                                        Detalji
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="btn btn-sm btn-secondary disabled"
                                                          data-toggle="tooltip"
                                                          title="Aktivnost će postati dostupna @aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")">
                                                        Detalji
                                                    </span>
                                                }

                                                <!-- Akcije za nastavno osoblje -->
                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Edit"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-warning">
                                                        Uredi
                                                    </a>
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Delete"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-danger">
                                                        Obriši
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nema evidentiranih predavanja.</p>
                    }
                </div>

                <!-- Vježbe -->
                <div class="mb-5">
                    <h5 class="text-success mb-3">
                        <i class="fas fa-dumbbell"></i> Vježbe
                    </h5>
                    @{
                        var vjezbe = Model.NastavneAktivnosti?
                        .Where(a => a.Tip == TipNastavneAktivnosti.Vjezba)
                        .OrderBy(a => a.DatumVrijemeOdrzavanja)
                        .ToList();
                    }
                    @if (vjezbe?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Datum i vrijeme</th>
                                        <th>Status</th>
                                        <th>Akcije</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aktivnost in vjezbe)
                                    {
                                        <tr class="@(!aktivnost.JeDostupno ? "table-secondary" : "")">
                                            <td>@aktivnost.Naziv</td>
                                            <td>@aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(aktivnost.JeDostupno ? "badge-success" : "badge-secondary")">
                                                    @(aktivnost.JeDostupno ? "Dostupno" : "Zaključano")
                                                </span>
                                            </td>
                                            <td>
                                                <!-- Detalji dugme -->
                                                @if (aktivnost.JeDostupno || !User.IsInRole("Student"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Details"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-info">
                                                        Detalji
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="btn btn-sm btn-secondary disabled"
                                                          data-toggle="tooltip"
                                                          title="Aktivnost će postati dostupna @aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")">
                                                        Detalji
                                                    </span>
                                                }

                                                <!-- Akcije za nastavno osoblje -->
                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Edit"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-warning">
                                                        Uredi
                                                    </a>
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Delete"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-danger">
                                                        Obriši
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nema evidentiranih vježbi.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Akcije -->
<div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Predmet.Id" class="btn btn-warning">Izmjena</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- JavaScript za potvrdu brisanja -->
    <script>
        function confirmDelete(action, predmetId, studentId, item) {
            if (confirm(`Jeste li sigurni da želite ukloniti ${item}?`)) {
                var form = document.createElement("form");
                form.method = "post";
                form.action = `/Predmeti/${action}`;

                var predmetInput = document.createElement("input");
                predmetInput.type = "hidden";
                predmetInput.name = "predmetId";
                predmetInput.value = predmetId;
                form.appendChild(predmetInput);

                var studentInput = document.createElement("input");
                studentInput.type = "hidden";
                studentInput.name = "studentId";
                studentInput.value = studentId;
                form.appendChild(studentInput);

                var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var tokenInput = document.createElement("input");
                tokenInput.type = "hidden";
                tokenInput.name = "__RequestVerificationToken";
                tokenInput.value = csrfToken;
                form.appendChild(tokenInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}