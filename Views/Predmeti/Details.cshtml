@model StudentHub.Models.Predmet

@{
    ViewData["Title"] = "Detalji predmeta";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Podaci o predmetu</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Naziv)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Naziv)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Opis)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Opis)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ECTS)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ECTS)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Profesor)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Profesor.Ime)</dd>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Profesor.Prezime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Asistent)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Asistent.Ime)</dd>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Asistent.Prezime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.NastavniPlan)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NastavniPlan.Id)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Izmjena</a> |
    <a asp-action="Index">Nazad</a>
</div>
