@using System.Security.Claims
@model StudentHub.ViewModels.PredmetDetailsViewModel

@{
    ViewData["Title"] = "Detalji predmeta";
}

<h2>@ViewData["Title"]</h2>

<form style="display:none;">
    @Html.AntiForgeryToken()
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model?.Predmet == null)
{
    <div class="alert alert-danger">
        Predmet nije pronađen ili je uklonjen.
    </div>
}
else
{
    <div class="container mt-4">
        <!-- Podaci o predmetu + Statistika -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Informacije o predmetu</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Lijevi stupac: osnovne informacije -->
                    <div class="col-md-6 mb-3 mb-md-0">
                        <dl class="row">
                            <dt class="col-sm-5">Naziv predmeta:</dt>
                            <dd class="col-sm-7">@Model.NazivPredmeta</dd>

                            <dt class="col-sm-5">Studijski program:</dt>
                            <dd class="col-sm-7">
                                @if (!string.IsNullOrWhiteSpace(Model.StudijskiProgram))
                                {
                                    @Model.StudijskiProgram
                                }
                                else
                                {
                                    <span class="text-warning">Nema programa</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Godina studija:</dt>
                            <dd class="col-sm-7">@Model.GodinaStudija. godina</dd>

                            <dt class="col-sm-5">Semestar:</dt>
                            <dd class="col-sm-7">
                                @(Model.Semestar == 1 ? "1 (Zimski)" : Model.Semestar == 2 ? "2 (Ljetni)" : Model.Semestar.ToString())
                            </dd>

                            <dt class="col-sm-5">ECTS bodovi:</dt>
                            <dd class="col-sm-7">@Model.ECTS</dd>

                            <dt class="col-sm-5">Tip predmeta:</dt>
                            <dd class="col-sm-7">@Model.TipPredmeta</dd>

                            <dt class="col-sm-5">Sati predavanja:</dt>
                            <dd class="col-sm-7">@Model.SatiPredavanja</dd>

                            <dt class="col-sm-5">Sati vježbi:</dt>
                            <dd class="col-sm-7">@Model.SatiVjezbi</dd>
                        </dl>
                    </div>

                    <!-- Desni stupac: statistike predmeta -->
                    <div class="col-md-6 border-start ps-md-4">
                        <dl class="row">
                            <dt class="col-sm-6">Nastavni plan:</dt>
                            <dd class="col-sm-6">
                                @if (Model.Predmet?.NastavniPlan != null && Model.Predmet.NastavniPlan.StudijskiProgram != null)
                                {
                                    <span>@Model.Predmet.NastavniPlan.GodinaStudija. godina (@Model.Predmet.NastavniPlan.StudijskiProgram.Naziv)</span>
                                }
                                else
                                {
                                    <span class="text-warning">Nema dodijeljen nastavni plan ili studijski program.</span>
                                }
                            </dd>

                            <dt class="col-sm-6">Ukupno bodova:</dt>
                            <dd class="col-sm-6">
                                @if (Model.Predmet?.UkupnoBodova != null)
                                {
                                    <span class="badge bg-success">@Model.Predmet.UkupnoBodova bodova</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>

                            <dt class="col-sm-6">Prosječna ocjena:</dt>
                            <dd class="col-sm-6">
                                @if (Model.ProsjecnaOcjena.HasValue)
                                {
                                    <span class="badge bg-info">@Model.ProsjecnaOcjena.Value.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>

                            <dt class="col-sm-6">Prosječno prisustvo:</dt>
                            <dd class="col-sm-6">
                                @if (Model.ProsjecnoPrisustvo.HasValue)
                                {
                                    <span class="badge bg-success">@Model.ProsjecnoPrisustvo.Value.ToString("F1")%</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>

                            <dt class="col-sm-6">Ukupno aktivnosti:</dt>
                            <dd class="col-sm-6">@Model.NastavneAktivnosti?.Count() ?? 0</dd>

                            <dt class="col-sm-6">Status studenata:</dt>
                            <dd class="col-sm-6">
                                @Model.BrojPoloziliPredmet od @Model.UkupnoStudenata studenata položilo predmet
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- Opis predmeta (pun red) -->
                <div class="mt-4">
                    <h5>Opis predmeta:</h5>
                    <p class="mb-0">@Model.OpisPredmeta ?? "<span class='text-muted'>Nema opisa predmeta.</span>"</p>
                </div>
            </div>
        </div>

        <!-- Profesori -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4>Profesori</h4>
            </div>
            <div class="card-body">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Titula</th>
                            <th>Ime i prezime</th>
                            @if (User.IsInRole("Studentska služba"))
                            {
                                <th>Akcije</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Profesori.Any())
                        {
                            @foreach (var profesor in Model.Profesori)
                            {
                                <tr>
                                    <td>@profesor.Profesor?.ProfesorTitula</td>
                                    <td>@profesor.Profesor?.Ime @profesor.Profesor?.Prezime</td>
                                    @if (User.IsInRole("Studentska služba"))
                                    {
                                        <td>
                                            <form asp-action="RemoveProfesorFromSubject" asp-route-predmetId="@Model.Predmet.Id" asp-route-profesorId="@profesor.ProfesorId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">Ukloni</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-warning">Nema dodijeljenih profesora.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (User.IsInRole("Studentska služba"))
                {
                    <form asp-action="AddProfesorToSubject" asp-route-predmetId="@Model.Predmet.Id" method="post">
                        <div class="mb-3">
                            <label for="ProfesorId" class="form-label">Dodaj profesora:</label>
                            <select asp-for="ProfesorId" asp-items="ViewBag.Profesori" class="form-select"></select>
                        </div>
                        <button type="submit" class="btn btn-primary">Dodaj profesora</button>
                    </form>
                }
            </div>
        </div>

        <!-- Asistenti -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4>Asistenti</h4>
            </div>
            <div class="card-body">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Titula</th>
                            <th>Ime i prezime</th>
                            @if (User.IsInRole("Studentska služba"))
                            {
                                <th>Akcije</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Asistenti.Any())
                        {
                            @foreach (var asistent in Model.Asistenti)
                            {
                                <tr>
                                    <td>@asistent.Asistent?.AsistentTitula</td>
                                    <td>@asistent.Asistent?.Ime @asistent.Asistent?.Prezime</td>
                                    @if (User.IsInRole("Studentska služba"))
                                    {
                                        <td>
                                            <form asp-action="RemoveAsistentFromSubject" asp-route-predmetId="@Model.Predmet.Id" asp-route-asistentId="@asistent.AsistentId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">Ukloni</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-warning">Nema dodijeljenih asistenata.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (User.IsInRole("Studentska služba"))
                {
                    <form asp-action="AddAsistentToSubject" asp-route-predmetId="@Model.Predmet.Id" method="post">
                        <div class="mb-3">
                            <label for="AsistentId" class="form-label">Dodaj asistenta:</label>
                            <select asp-for="AsistentId" asp-items="ViewBag.Asistenti" class="form-select"></select>
                        </div>
                        <button type="submit" class="btn btn-primary">Dodaj asistenta</button>
                    </form>
                }
            </div>
        </div>

        <!-- Studenti na predmetu -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h4>Studenti na predmetu</h4>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Studentska služba"))
                {
                    <a asp-action="Prisustvo" asp-route-id="@Model.Predmet.Id" class="btn btn-outline-info mb-3">
                        <i class="fas fa-user-check me-1"></i> Pregled prisustva studenata
                    </a>
                }
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Ime i prezime</th>
                                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                {
                                    <th>Broj indeksa</th>
                                }
                                <th>Godina studija</th>
                                <th>Ocjena</th>
                                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                                {
                                    <th>Akcije</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.StudentiNaPredmetu?.Any() == true)
                            {
                                var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                foreach (var studentNaPredmetu in Model.StudentiNaPredmetu)
                                {
                                    <tr>
                                        <td>@studentNaPredmetu.Student?.Ime @studentNaPredmetu.Student?.Prezime</td>
                                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                        {
                                            <td>@studentNaPredmetu.Student?.BrojIndeksa</td>
                                        }
                                        <td>@studentNaPredmetu.Student?.GodinaStudija</td>
                                        <td>
                                            @if (User.IsInRole("Student"))
                                            {
                                                if (studentNaPredmetu.Student.AspNetUserId == currentUserId)
                                                {
                                                    if (Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true && Model.Ocjene[studentNaPredmetu.StudentId].HasValue)
                                                    {
                                                        var ocjena = Model.Ocjene[studentNaPredmetu.StudentId].Value;
                                                        <span class="badge @(ocjena >= 6 ? "bg-success" : "bg-danger")">@ocjena</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-warning">Nema ocjene</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Ocjena nije dostupna</span>
                                                }
                                            }
                                            else
                                            {
                                                if (Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true && Model.Ocjene[studentNaPredmetu.StudentId].HasValue)
                                                {
                                                    var ocjena = Model.Ocjene[studentNaPredmetu.StudentId].Value;
                                                    <span class="badge @(ocjena >= 6 ? "bg-success" : "bg-danger")">@ocjena</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning">Nema ocjene</span>
                                                }
                                            }
                                        </td>
                                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                                        {
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @if (Model?.OcjenaIds?.ContainsKey(studentNaPredmetu.StudentId) == true)
                                                    {
                                                        var ocjenaId = Model.OcjenaIds[studentNaPredmetu.StudentId];
                                                        <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@ocjenaId" class="btn btn-info btn-sm">Detalji</a>
                                                        @if (User.IsInRole("Profesor"))
                                                        {
                                                            <a asp-controller="Ocjene" asp-action="EditPredmetOcjena" asp-route-id="@ocjenaId" class="btn btn-warning btn-sm">Izmjena</a>
                                                            <a asp-controller="Ocjene" asp-action="Delete" asp-route-id="@ocjenaId" class="btn btn-danger btn-sm">Brisanje</a>
                                                        }
                                                    }
                                                    else if (User.IsInRole("Profesor"))
                                                    {
                                                        <a asp-controller="Predmeti"
                                                           asp-action="StudentDetails"
                                                           asp-route-predmetId="@Model.Predmet.Id"
                                                           asp-route-studentId="@studentNaPredmetu.StudentId"
                                                           class="btn btn-outline-info btn-sm">
                                                            Detalji studenta
                                                        </a>
                                                    }

                                                    <form asp-action="RemoveStudentFromSubject" asp-route-predmetId="@Model.Predmet.Id" asp-route-studentId="@studentNaPredmetu.StudentId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Jeste li sigurni da želite ukloniti ovog studenta s predmeta?')">
                                                            Ukloni
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(4 + ((User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent")) ? 1 : 0))" class="text-warning">Nema studenata na ovom predmetu.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                {
                    <form asp-action="AddStudentToSubject" asp-route-predmetId="@Model.Predmet.Id" method="post">
                        <div class="mb-3">
                            <label for="StudentId" class="form-label">Dodaj studenta:</label>
                            <select asp-for="StudentId" asp-items="ViewBag.Studenti" class="form-select"></select>
                        </div>
                        <button type="submit" class="btn btn-primary">Dodaj studenta</button>
                    </form>
                }
            </div>
        </div>

        <!-- Nastavne aktivnosti -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <h4>Nastavne aktivnosti</h4>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                {
                    <div class="mb-3">
                        <a asp-controller="NastavneAktivnosti"
                           asp-action="Create"
                           asp-route-predmetId="@Model.Predmet.Id"
                           class="btn btn-primary">
                            <i class="fas fa-plus"></i> Dodaj novu aktivnost
                        </a>
                    </div>
                }

                <!-- Predavanja -->
                <div class="mb-5">
                    <h5 class="text-primary mb-3">
                        <i class="fas fa-chalkboard-teacher"></i> Predavanja
                    </h5>
                    @{
                        var predavanja = Model.NastavneAktivnosti?
                        .Where(a => a.Tip == TipNastavneAktivnosti.Predavanje)
                        .OrderBy(a => a.DatumVrijemeOdrzavanja)
                        .ToList();
                    }
                    @if (predavanja?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Datum i vrijeme</th>
                                        <th>Status</th>
                                        <th>Akcije</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aktivnost in predavanja)
                                    {
                                        <tr class="@(!aktivnost.JeDostupno ? "table-secondary" : "")">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@aktivnost.Naziv</span>
                                                    @if (!aktivnost.JeDostupno && User.IsInRole("Student"))
                                                    {
                                                        var remaining = aktivnost.DatumVrijemeOdrzavanja - DateTime.Now;
                                                        if (remaining.TotalSeconds > 0)
                                                        {
                                                            <span class="small mt-1 text-muted countdown-wrapper">
                                                                <i class="fas fa-lock me-1"></i>
                                                                Dostupno za:
                                                                <span class="badge bg-warning text-dark countdown-timer"
                                                                      data-countdown="@aktivnost.DatumVrijemeOdrzavanja.ToString("O")">
                                                                    Učitavanje...
                                                                </span>
                                                            </span>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td>@aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(aktivnost.JeDostupno ? "bg-success" : "bg-secondary")">
                                                    @(aktivnost.JeDostupno ? "Dostupno" : "Zaključano")
                                                </span>
                                            </td>
                                            <td>
                                                @if (aktivnost.JeDostupno || !User.IsInRole("Student"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Details"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-info">
                                                        Detalji
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="btn btn-sm btn-secondary disabled"
                                                          data-bs-toggle="tooltip"
                                                          title="Aktivnost će postati dostupna @aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")">
                                                        Detalji
                                                    </span>
                                                }

                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Edit"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-warning">
                                                        Uredi
                                                    </a>
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Delete"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-danger">
                                                        Obriši
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nema evidentiranih predavanja.</p>
                    }
                </div>

                <!-- Vježbe -->
                <div class="mb-5">
                    <h5 class="text-success mb-3">
                        <i class="fas fa-dumbbell"></i> Vježbe
                    </h5>
                    @{
                        var vjezbe = Model.NastavneAktivnosti?
                        .Where(a => a.Tip == TipNastavneAktivnosti.Vjezba)
                        .OrderBy(a => a.DatumVrijemeOdrzavanja)
                        .ToList();
                    }
                    @if (vjezbe?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Datum i vrijeme</th>
                                        <th>Status</th>
                                        <th>Akcije</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aktivnost in vjezbe)
                                    {
                                        <tr class="@(!aktivnost.JeDostupno ? "table-secondary" : "")">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@aktivnost.Naziv</span>
                                                    @if (!aktivnost.JeDostupno && User.IsInRole("Student"))
                                                    {
                                                        var remaining = aktivnost.DatumVrijemeOdrzavanja - DateTime.Now;
                                                        if (remaining.TotalSeconds > 0)
                                                        {
                                                            <span class="small mt-1 text-muted countdown-wrapper">
                                                                <i class="fas fa-lock me-1"></i>
                                                                Dostupno za:
                                                                <span class="badge bg-warning text-dark countdown-timer"
                                                                      data-countdown="@aktivnost.DatumVrijemeOdrzavanja.ToString("O")">
                                                                    Učitavanje...
                                                                </span>
                                                            </span>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td>@aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(aktivnost.JeDostupno ? "bg-success" : "bg-secondary")">
                                                    @(aktivnost.JeDostupno ? "Dostupno" : "Zaključano")
                                                </span>
                                            </td>
                                            <td>
                                                @if (aktivnost.JeDostupno || !User.IsInRole("Student"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Details"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-info">
                                                        Detalji
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="btn btn-sm btn-secondary disabled"
                                                          data-bs-toggle="tooltip"
                                                          title="Aktivnost će postati dostupna @aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")">
                                                        Detalji
                                                    </span>
                                                }

                                                @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                                {
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Edit"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-warning">
                                                        Uredi
                                                    </a>
                                                    <a asp-controller="NastavneAktivnosti"
                                                       asp-action="Delete"
                                                       asp-route-id="@aktivnost.Id"
                                                       class="btn btn-sm btn-danger">
                                                        Obriši
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nema evidentiranih vježbi.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Akcije -->
<div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Predmet.Id" class="btn btn-warning">Izmjena</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Potvrda za brisanje (nije potrebna ako nema "Delete" dugmeta za nastavne aktivnosti)
        function confirmDelete(action, predmetId, studentId, item) {
            if (confirm(`Jeste li sigurni da želite ukloniti ${item}?`)) {
                var form = document.createElement("form");
                form.method = "post";
                form.action = `/Predmeti/${action}`;

                var predmetInput = document.createElement("input");
                predmetInput.type = "hidden";
                predmetInput.name = "predmetId";
                predmetInput.value = predmetId;
                form.appendChild(predmetInput);

                var studentInput = document.createElement("input");
                studentInput.type = "hidden";
                studentInput.name = "studentId";
                studentInput.value = studentId;
                form.appendChild(studentInput);

                var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var tokenInput = document.createElement("input");
                tokenInput.type = "hidden";
                tokenInput.name = "__RequestVerificationToken";
                tokenInput.value = csrfToken;
                form.appendChild(tokenInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>

    <script>
        // JS za countdown na aktivnosti
        function startCountdowns() {
            document.querySelectorAll('.countdown-timer').forEach(el => {
                const targetTime = new Date(el.dataset.countdown);
                const interval = setInterval(() => {
                    const now = new Date();
                    const diff = targetTime - now;

                    if (diff <= 0) {
                        el.textContent = "Otključano!";
                        el.classList.remove("bg-warning", "text-dark");
                        el.classList.add("bg-success", "text-white");
                        clearInterval(interval);
                    } else {
                        const h = Math.floor(diff / 3600000);
                        const m = Math.floor((diff % 3600000) / 60000);
                        const s = Math.floor((diff % 60000) / 1000);
                        el.textContent = `${h}h ${m}m ${s}s`;
                    }
                }, 1000);
            });
        }
        document.addEventListener("DOMContentLoaded", startCountdowns);
    </script>

    <style>
        .countdown-wrapper {
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

            .countdown-wrapper .badge {
                font-weight: 500;
                padding: 0.3em 0.6em;
            }
    </style>
}
