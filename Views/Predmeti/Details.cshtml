@model StudentHub.ViewModels.PredmetDetailsViewModel

@{
    ViewData["Title"] = "Detalji predmeta";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container mt-4">
    <!-- Opšti podaci o predmetu -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Podaci o predmetu</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Naziv predmeta:</dt>
                <dd class="col-sm-9">@Model.Predmet?.Naziv</dd>

                <dt class="col-sm-3">Opis:</dt>
                <dd class="col-sm-9">@Model.Predmet?.Opis</dd>

                <dt class="col-sm-3">ECTS bodovi:</dt>
                <dd class="col-sm-9">@Model.Predmet?.ECTS</dd>

                <dt class="col-sm-3">Nastavni plan:</dt>
                <dd class="col-sm-9">
                    @if (Model.Predmet?.NastavniPlan != null)
                    {
                        <span>
                            Predmet pripada nastavnom planu:
                            @Model.Predmet.NastavniPlan.GodinaStudija. godina,
                            @(Model.Predmet.Semestar == 1 ? "prvi" :
                                Model.Predmet.Semestar == 2 ? "drugi" :
                                Model.Predmet.Semestar == 3 ? "treći" :
                                Model.Predmet.Semestar + ".") semestar
                        </span>
                    }
                    else
                    {
                        <span class="text-warning">Nema dodijeljen nastavni plan.</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <!-- Nastavno osoblje -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h4>Nastavno osoblje</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Uloga</th>
                        <th>Ime i prezime</th>
                        <th>Titula</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Profesor -->
                    @if (Model.Profesori.Any())
                    {
                        @foreach (var profesor in Model.Profesori)
                        {
                            <tr>
                                <td>Profesor</td>
                                <td>@profesor.Profesor?.Ime @profesor.Profesor?.Prezime</td>
                                <td>@profesor.Profesor?.ProfesorTitula</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>Profesor</td>
                            <td colspan="2" class="text-warning">Nema dodijeljen profesor.</td>
                        </tr>
                    }

                    <!-- Asistent -->
                    @if (Model.Asistenti.Any())
                    {
                        @foreach (var asistent in Model.Asistenti)
                        {
                            <tr>
                                <td>Asistent</td>
                                <td>@asistent.Asistent?.Ime @asistent.Asistent?.Prezime</td>
                                <td>@asistent.Asistent.AsistentTitula</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>Asistent</td>
                            <td colspan="2" class="text-warning">Nema dodijeljen asistent.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Studenti na predmetu -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h4>Studenti na predmetu</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Ime i prezime</th>
                        <th>Broj indeksa</th>
                        <th>Godina studija</th>
                        <th>Ocjena</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.StudentiNaPredmetu?.Any() == true)
                    {
                        @foreach (var studentNaPredmetu in Model.StudentiNaPredmetu)
                        {
                            <tr>
                                <td>@studentNaPredmetu.Student?.Ime @studentNaPredmetu.Student?.Prezime</td>
                                <td>@studentNaPredmetu.Student?.BrojIndeksa</td>
                                <td>@studentNaPredmetu.Student?.GodinaStudija</td>
                                <td>
                                    @if (Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true)
                                    {
                                        @Model.Ocjene[studentNaPredmetu.StudentId]
                                    }
                                    else
                                    {
                                        <span class="text-warning">Nema ocjene</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="RemoveStudentFromSubject" method="post" style="display:inline;">
                                        <input type="hidden" name="predmetId" value="@Model?.Predmet?.Id" />
                                        <input type="hidden" name="studentId" value="@studentNaPredmetu.StudentId" />
                                        <button type="submit" class="btn btn-danger btn-sm">Ukloni</button>
                                    </form>
                                    <form asp-action="AddGrade" method="post" style="display:inline;">
                                        <input type="hidden" name="predmetId" value="@Model?.Predmet?.Id" />
                                        <input type="hidden" name="studentId" value="@studentNaPredmetu.StudentId" />
                                        <input type="number" name="ocjena" min="5" max="10" step="0.5" class="form-control d-inline-block w-auto" required />
                                        <button type="submit" class="btn btn-primary btn-sm">Dodaj ocjenu</button>
                                    </form>
                                    <form asp-action="EditGrade" method="post" style="display:inline;">
                                        <input type="hidden" name="predmetId" value="@Model?.Predmet?.Id" />
                                        <input type="hidden" name="studentId" value="@studentNaPredmetu.StudentId" />
                                        <input type="number" name="ocjena" min="5" max="10" step="0.5" class="form-control d-inline-block w-auto" value="@(Model?.Ocjene?.ContainsKey(studentNaPredmetu.StudentId) == true ? Model.Ocjene[studentNaPredmetu.StudentId] : (float?)null)" required />
                                        <button type="submit" class="btn btn-warning btn-sm">Izmijeni ocjenu</button>
                                    </form>
                                    <form asp-action="RemoveGrade" method="post" style="display:inline;">
                                        <input type="hidden" name="predmetId" value="@Model?.Predmet?.Id" />
                                        <input type="hidden" name="studentId" value="@studentNaPredmetu.StudentId" />
                                        <button type="submit" class="btn btn-danger btn-sm">Ukloni ocjenu</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-warning">Nema studenata na ovom predmetu.</td>
                        </tr>
                        }
                    }
                </tbody>
            </table>

            <form asp-action="AddStudentToSubject" method="post">
                <div class="form-group">
                    <label for="StudentId">Dodaj studenta:</label>
                    <select asp-for="StudentId" asp-items="ViewBag.Studenti" class="form-control"></select>
                </div>
                <input type="hidden" asp-for="Predmet.Id" />
                <button type="submit" class="btn btn-primary">Dodaj</button>
            </form>
        </div>
    </div>


<!-- Akcije -->
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Predmet.Id" class="btn btn-warning">Izmjena</a>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}