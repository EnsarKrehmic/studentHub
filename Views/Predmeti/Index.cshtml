@model IEnumerable<StudentHub.Models.Predmet>

@{
    ViewData["Title"] = "Lista predmeta";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novi predmet</a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Naziv)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Opis)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().ECTS)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Profesor)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Asistent)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Naziv)</td>
                    <td>@Html.DisplayFor(modelItem => item.Opis)</td>
                    <td>@Html.DisplayFor(modelItem => item.ECTS)</td>
                    <td>
                        @if (item.Profesor != null)
                        {
                            @item.Profesor.Ime @item.Profesor.Prezime
                        }
                        else
                        {
                            <span>Profesor nije dodijeljen.</span>
                        }
                    </td>
                    <td>
                        @if (item.Asistent != null)
                        {
                            @item.Asistent.Ime @item.Asistent.Prezime
                        }
                        else
                        {
                            <span>Asistent nije dodijeljen.</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <p>Nema predmeta za prikaz.</p>
}   