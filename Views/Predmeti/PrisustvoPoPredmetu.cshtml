@model StudentHub.ViewModels.PrisustvoPoPredmetuViewModel
@{
    ViewData["Title"] = "Evidencija prisustva";
}

<div class="container mt-4">
    <!-- Predmet Header Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white d-flex flex-wrap align-items-center justify-content-between">
            <h4 class="mb-0">
                <i class="fas fa-user-check me-2"></i>Evidencija prisustva za:
                <strong>@Model.Predmet.Naziv</strong>
            </h4>
            <div class="mt-2 mt-md-0">
                <span class="badge bg-info me-2">Ukupno bodova: @Model.Predmet.UkupnoBodova</span>
                <span class="badge bg-secondary me-2">ECTS: @Model.Predmet.ECTS</span>
                <span class="badge bg-primary">
                    Semestar: @(Model.Predmet.Semestar == 1 ? "Zimski" : "Ljetni")
                </span>
            </div>
        </div>
        <div class="card-body">
            @if (User.IsInRole("Profesor") || User.IsInRole("Asistent"))
            {
                <form asp-controller="Predmeti" asp-action="PostaviPragovePrisustva" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="predmetId" value="@Model.Predmet.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="pragPredavanja" class="form-label">
                                Prag za predavanja (%)
                                <i class="fas fa-info-circle" data-bs-toggle="tooltip" title="Minimalni procenat prisustva na predavanjima"></i>
                            </label>
                            <input type="number" id="pragPredavanja" class="form-control" name="pragPredavanja"
                                   min="0" max="100" step="1" value="@Model.PragPrisustvaPredavanja" required />
                        </div>
                        <div class="col-md-4">
                            <label for="pragVjezbe" class="form-label">
                                Prag za vježbe (%)
                                <i class="fas fa-info-circle" data-bs-toggle="tooltip" title="Minimalni procenat prisustva na vježbama"></i>
                            </label>
                            <input type="number" id="pragVjezbe" class="form-control" name="pragVjezbe"
                                   min="0" max="100" step="1" value="@Model.PragPrisustvaVjezbe" required />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-save me-2"></i> Spremi pragove
                            </button>
                        </div>
                    </div>
                </form>

                @if (TempData["PragUpdateSuccess"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i>@TempData["PragUpdateSuccess"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Prag za predavanja: <strong>@Model.PragPrisustvaPredavanja %</strong>,
                    prag za vježbe: <strong>@Model.PragPrisustvaVjezbe %</strong>,
                    ukupni prag: <strong>@Model.PragPrisustvaUkupno %</strong>
                </div>
            }
        </div>
    </div>

    @* 1. Ukupno prisustvo *@
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Ukupno prisustvo</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Prisutan na</th>
                            <th>Ukupno aktivnosti</th>
                            <th>Procenat</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StatistikaUkupno)
                        {
                            var badgeClass = s.Procenat >= Model.PragPrisustvaUkupno
                            ? "bg-success"
                            : s.Procenat >= 50
                            ? "bg-warning text-dark"
                            : "bg-danger";
                            var status = s.Procenat >= Model.PragPrisustvaUkupno
                            ? "✅"
                            : s.Procenat >= 50
                            ? "⚠"
                            : "❌";
                            <tr>
                                <td>@s.Student.Ime @s.Student.Prezime</td>
                                <td>@s.BrojPrisustava</td>
                                <td>@s.UkupnoAktivnosti</td>
                                <td>@s.Procenat.ToString("F1")%</td>
                                <td><span class="badge @badgeClass">@status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* 2. Prisustvo na predavanjima *@
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Prisustvo na predavanjima</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Prisutan na</th>
                            <th>Ukupno predavanja</th>
                            <th>Procenat</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StatistikaPredavanja)
                        {
                            var badgeClass = s.Procenat >= Model.PragPrisustvaPredavanja
                            ? "bg-success"
                            : s.Procenat >= 50
                            ? "bg-warning text-dark"
                            : "bg-danger";
                            var status = s.Procenat >= Model.PragPrisustvaPredavanja
                            ? "✅"
                            : s.Procenat >= 50
                            ? "⚠"
                            : "❌";
                            <tr>
                                <td>@s.Student.Ime @s.Student.Prezime</td>
                                <td>@s.BrojPrisustava</td>
                                <td>@s.UkupnoAktivnosti</td>
                                <td>@s.Procenat.ToString("F1")%</td>
                                <td><span class="badge @badgeClass">@status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* 3. Prisustvo na vježbama *@
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Prisustvo na vježbama</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Prisutan na</th>
                            <th>Ukupno vježbi</th>
                            <th>Procenat</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StatistikaVjezbe)
                        {
                            var badgeClass = s.Procenat >= Model.PragPrisustvaVjezbe
                            ? "bg-success"
                            : s.Procenat >= 50
                            ? "bg-warning text-dark"
                            : "bg-danger";
                            var status = s.Procenat >= Model.PragPrisustvaVjezbe
                            ? "✅"
                            : s.Procenat >= 50
                            ? "⚠"
                            : "❌";
                            <tr>
                                <td>@s.Student.Ime @s.Student.Prezime</td>
                                <td>@s.BrojPrisustava</td>
                                <td>@s.UkupnoAktivnosti</td>
                                <td>@s.Procenat.ToString("F1")%</td>
                                <td><span class="badge @badgeClass">@status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Back button -->
    <div class="text-end">
        <a asp-action="Details" asp-route-id="@Model.Predmet.Id" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na detalje predmeta
        </a>
    </div>
</div>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>
}
