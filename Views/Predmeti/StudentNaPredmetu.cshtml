@model StudentHub.ViewModels.StudentNaPredmetuViewModel

@{
    ViewData["Title"] = "Detalji studenta na predmetu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-center">@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- Info kartica -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">Podaci o studentu</div>
                <div class="card-body">
                    <p><strong>Ime:</strong> @Model.Student.Ime @Model.Student.Prezime</p>
                    <p><strong>Broj indeksa:</strong> @Model.Student.BrojIndeksa</p>
                    <p><strong>Email:</strong> @Model.Student.Email</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-dark text-white">Informacije o predmetu</div>
                <div class="card-body">
                    <p><strong>Naziv:</strong> @Model.Predmet.Naziv</p>
                    <p><strong>ECTS:</strong> @Model.Predmet.ECTS</p>
                    <p><strong>Semestar:</strong> @Model.Predmet.Semestar</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Evidencija aktivnosti sa prisustvom i ocjenom -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-warning text-dark">Evidencija aktivnosti</div>
        <div class="card-body">
            @if (Model.Aktivnosti.Any())
            {
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Datum</th>
                            <th>Naziv</th>
                            <th>Tip</th>
                            <th>Prisustvo</th>
                            <th>Ocjena</th>
                            <th>Unio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aktivnost in Model.Aktivnosti)
                        {
                            var prisutan = Model.Prisustva.Any(p => p.NastavnaAktivnostId == aktivnost.Id);
                            var ocjena = Model.OcjenaPoAktivnosti.ContainsKey(aktivnost.Id)
                            ? Model.OcjenaPoAktivnosti[aktivnost.Id]
                            : null;

                            <tr>
                                <td>@aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@aktivnost.Naziv</td>
                                <td>@aktivnost.Tip</td>
                                <td>
                                    @if (prisutan)
                                    {
                                        <span class="badge bg-success">Prisutan</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Odsutan</span>
                                    }
                                </td>
                                <td>
                                    @if (ocjena != null)
                                    {
                                        <span class="badge @(ocjena.Vrijednost >= 4 ? "bg-success" : ocjena.Vrijednost >= 2 ? "bg-warning" : "bg-danger")">
                                            @ocjena.Vrijednost
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(Model.ProfesorPoAktivnosti.ContainsKey(aktivnost.Id) ? Model.ProfesorPoAktivnosti[aktivnost.Id] : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning">Nema nastavnih aktivnosti.</div>
            }
        </div>
    </div>

    <!-- Rezultati ispita -->
    @if (Model.Prijave?.Any() == true)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">Rezultati ispita</div>
            <div class="card-body">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Datum ispita</th>
                            <th>Lokacija</th>
                            <th>Osvojeni bodovi</th>
                            <th>Ukupno bodova</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prijava in Model.Prijave.OrderByDescending(p => p.Ispit.DatumOdrzavanja))
                        {
                            var bodovi = prijava.Bodovi;
                            var prag = prijava.Ispit.UslovZaPolaganje;
                            var polozen = bodovi.HasValue && bodovi >= prag;

                            <tr>
                                <td>@prijava.Ispit.DatumOdrzavanja.ToString("dd.MM.yyyy")</td>
                                <td>@(string.IsNullOrEmpty(prijava.Ispit.Lokacija) ? "—" : prijava.Ispit.Lokacija)</td>
                                <td>
                                    @if (bodovi.HasValue)
                                    {
                                        <span>@bodovi.Value</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nije ocijenjeno</span>
                                    }
                                </td>
                                <td>@prijava.Ispit.BrojBodova</td>
                                <td>
                                    @if (!bodovi.HasValue)
                                    {
                                        <span class="badge bg-secondary">N/A</span>
                                    }
                                    else if (polozen)
                                    {
                                        <span class="badge bg-success">Položen</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Nije položen</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Zaključna ocjena -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">Zaključna ocjena</div>
        <div class="card-body">
            <p>
                <strong>Zaključna ocjena:</strong>
                @if (Model.ZakljucnaOcjena.HasValue)
                {
                    <span class="badge bg-primary fs-5">@Model.ZakljucnaOcjena</span>
                }
                else
                {
                    <span class="text-muted">Nije unijeta</span>
                }
            </p>

            @if (Model.PonderisanaOcjena.HasValue)
            {
                <p>
                    <strong>Ponderisana ocjena (iz parcijalnih):</strong>
                    <span class="badge bg-secondary fs-5">@Model.PonderisanaOcjena.Value.ToString("0.00")</span>
                </p>
            }

            @if (Model.Ocjene.FirstOrDefault(o => o.Tip == TipOcjene.Predmet) is var glavnaOcjena && glavnaOcjena != null)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a asp-controller="Ocjene"
                       asp-action="Details"
                       asp-route-id="@glavnaOcjena.Id"
                       class="btn btn-outline-secondary">
                        Detalji zaključne ocjene
                    </a>

                    @if (User.IsInRole("Profesor"))
                    {
                        <a asp-controller="Ocjene"
                           asp-action="EditPredmetOcjena"
                           asp-route-id="@glavnaOcjena.Id"
                           class="btn btn-outline-warning">
                            Izmijeni zaključnu ocjenu
                        </a>

                        <a asp-controller="Ocjene"
                           asp-action="Create"
                           asp-route-tip="Predmet"
                           asp-route-predmetId="@Model.Predmet.Id"
                           asp-route-studentId="@Model.Student.Id"
                           asp-route-parentOcjenaId="@glavnaOcjena.Id"
                           class="btn btn-outline-info">
                            Dodaj parcijalnu ocjenu
                        </a>
                    }
                </div>
            }
            else if (User.IsInRole("Profesor"))
            {
                <a asp-controller="Ocjene"
                   asp-action="Create"
                   asp-route-tip="Predmet"
                   asp-route-predmetId="@Model.Predmet.Id"
                   asp-route-studentId="@Model.Student.Id"
                   class="btn btn-outline-dark mt-3">
                    Dodaj zaključnu ocjenu
                </a>
            }
        </div>
    </div>

    <!-- Parcijalne ocjene -->
    @if (Model.ParcijalneOcjene?.Any() == true)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span>Parcijalne ocjene</span>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    @foreach (var grupisano in Model.ParcijalneOcjene)
                    {
                        foreach (var ocjena in grupisano.Value)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Vrijednost:</strong> @ocjena.Vrijednost
                                    @if (!string.IsNullOrWhiteSpace(ocjena.Komentar))
                                    {
                                        <span class="text-muted ms-2">(@ocjena.Komentar)</span>
                                    }

                                    @if (ocjena.DatumUnosa != default)
                                    {
                                        <div><small class="text-muted">(@ocjena.DatumUnosa.ToString("dd.MM.yyyy"))</small></div>
                                    }
                                </div>

                                <div class="d-flex gap-2 align-items-center">
                                    @if (ocjena.TezinaProcentualno.HasValue)
                                    {
                                        <span class="badge bg-info">@ocjena.TezinaProcentualno %</span>
                                    }

                                    @if (User.IsInRole("Profesor"))
                                    {
                                        <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@ocjena.Id"
                                           class="btn btn-outline-secondary btn-sm" title="Detalji">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <a asp-controller="Ocjene" asp-action="Edit" asp-route-id="@ocjena.Id"
                                           class="btn btn-outline-warning btn-sm" title="Izmijeni">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="Ocjene" asp-action="Delete" asp-route-id="@ocjena.Id"
                                           class="btn btn-outline-danger btn-sm" title="Obriši">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    }

    <!-- Navigacija -->
    <div class="d-flex gap-2 mt-4">
        <a asp-controller="Studenti" asp-action="Details"
           asp-route-id="@Model.Student.Id"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na studenta
        </a>

        <a asp-controller="Predmeti" asp-action="Details"
           asp-route-id="@Model.Predmet.Id"
           class="btn btn-outline-secondary">
            <i class="fas fa-book me-1"></i> Detalji predmeta
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('chartPrisustvo');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Prisustva', 'Izostanci'],
                datasets: [{
                    label: 'Prisustvo',
                    data: [
                        @Model.Prisustva.Count(),
                        @Model.Aktivnosti.Count() - @Model.Prisustva.Count()
                    ],
                    backgroundColor: ['#28a745', '#dc3545']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const value = context.raw;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = (value / total * 100).toFixed(1);
                                return `${context.label}: ${value} (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    </script>
}