@model StudentHub.ViewModels.StudentNaPredmetuViewModel

@{
    ViewData["Title"] = "Detalji studenta na predmetu";
}

<div class="container mt-4">
    <!-- Page header with back button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user-graduate me-2"></i>@ViewData["Title"]</h2>
        <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@Model.Predmet.Id" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na predmet
        </a>
    </div>

    <!-- Info cards: student & predmet -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-user me-2"></i>Podaci o studentu
                </div>
                <div class="card-body">
                    <p><strong>Ime:</strong> @Model.Student.Ime @Model.Student.Prezime</p>
                    <p><strong>Broj indeksa:</strong> @Model.Student.BrojIndeksa</p>
                    <p><strong>Email:</strong> @Model.Student.Email</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-book-open me-2"></i>Informacije o predmetu
                </div>
                <div class="card-body">
                    <p><strong>Naziv:</strong> @Model.Predmet.Naziv</p>
                    <p><strong>ECTS:</strong> @Model.Predmet.ECTS</p>
                    <p>
                        <strong>Semestar:</strong>
                        @(Model.Predmet.Semestar == 1 ? "1 (Zimski)" : Model.Predmet.Semestar == 2 ? "2 (Ljetni)" : Model.Predmet.Semestar.ToString())
                    </p>
                    <p>
                        <strong>Ukupni bodovi na predmetu:</strong>
                        <span class="badge bg-info">@Model.Predmet.UkupnoBodova</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Evidencija aktivnosti -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-list me-2"></i>Evidencija aktivnosti
        </div>
        <div class="card-body p-0">
            @if (Model.Aktivnosti.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Datum</th>
                                <th>Naziv</th>
                                <th>Tip</th>
                                <th>Prisustvo</th>
                                <th>Ocjena</th>
                                <th>Unio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aktivnost in Model.Aktivnosti)
                            {
                                var prisutan = Model.Prisustva.Any(p => p.NastavnaAktivnostId == aktivnost.Id);
                                var ocjena = Model.OcjenaPoAktivnosti.ContainsKey(aktivnost.Id)
                                ? Model.OcjenaPoAktivnosti[aktivnost.Id]
                                : null;
                                <tr>
                                    <td>@aktivnost.DatumVrijemeOdrzavanja.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@aktivnost.Naziv</td>
                                    <td>
                                        @(aktivnost.Tip == TipNastavneAktivnosti.Predavanje
                                                                        ? "Predavanje"
                                                                        : aktivnost.Tip == TipNastavneAktivnosti.Vjezba
                                                                        ? "Vježba"
                                                                        : aktivnost.Tip.ToString())
                            </td>
                            <td>
                                <span class="badge @(prisutan ? "bg-success" : "bg-danger")">
                                    @(prisutan ? "Prisutan" : "Odsutan")
                                </span>
                            </td>
                            <td>
                                @if (ocjena != null)
                                        {
                                            var clr = ocjena.Vrijednost >= 4
                                            ? "bg-success"
                                            : ocjena.Vrijednost >= 2
                                            ? "bg-warning"
                                            : "bg-danger";
                                            <span class="badge @clr">@ocjena.Vrijednost</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                </td>
                                <td>
                                    @(Model.ProfesorPoAktivnosti.ContainsKey(aktivnost.Id)
                                                                    ? Model.ProfesorPoAktivnosti[aktivnost.Id]
                                                                    : "—")
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning m-3">Nema nastavnih aktivnosti.</div>
            }
        </div>
    </div>

    <!-- Rezultati ispita -->
    @if (Model.Prijave?.Any() == true)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <i class="fas fa-file-alt me-2"></i>Rezultati ispita
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Datum ispita</th>
                                <th>Lokacija</th>
                                <th>Osvojeni bodovi</th>
                                <th>Ukupno bodova (ispit)</th>
                                <th>Ukupno bodova (predmet)</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prijava in Model.Prijave.OrderByDescending(p => p.Ispit.DatumOdrzavanja))
                            {
                                var bodovi = prijava.Bodovi;
                                var prag = prijava.Ispit.UslovZaPolaganje;
                                var polozen = bodovi.HasValue && bodovi >= prag;
                                <tr>
                                    <td>@prijava.Ispit.DatumOdrzavanja.ToString("dd.MM.yyyy")</td>
                                    <td>@(string.IsNullOrEmpty(prijava.Ispit.Lokacija) ? "—" : prijava.Ispit.Lokacija)</td>
                                    <td>
                                        @if (bodovi.HasValue)
                                        {
                                            <span>@bodovi.Value</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Nije ocijenjeno</span>
                                        }
                                    </td>
                                    <td>@prijava.Ispit.BrojBodova</td>
                                    <td><span class="badge bg-secondary">@Model.Predmet.UkupnoBodova</span></td>
                                    <td>
                                        @if (!bodovi.HasValue)
                                        {
                                            <span class="badge bg-secondary">N/A</span>
                                        }
                                        else if (polozen)
                                        {
                                            <span class="badge bg-success">Položen</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Nije položen</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    <!-- Zaključna ocjena -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <i class="fas fa-star me-2"></i>Zaključna ocjena
        </div>
        <div class="card-body">
            <p>
                <strong>Zaključna ocjena:</strong>
                @if (Model.ZakljucnaOcjena.HasValue)
                {
                    <span class="badge text-bg-primary fs-5">@Model.ZakljucnaOcjena</span>
                }
                else
                {
                    <span class="text-muted">Nije unijeta</span>
                }
            </p>

            <p>
                <strong>Ukupni bodovi na predmetu:</strong>
                <span class="badge text-bg-info">@Model.Predmet.UkupnoBodova</span>
            </p>

            @if (Model.PonderisanaOcjena.HasValue)
            {
                <p>
                    <strong>Ponderisana ocjena (iz parcijalnih):</strong>
                    <span class="badge text-bg-secondary fs-5">@Model.PonderisanaOcjena.Value.ToString("0.00")</span>
                </p>
            }

            @if (Model.Ocjene.FirstOrDefault(o => o.Tip == TipOcjene.Predmet) is var glavnaOcjena && glavnaOcjena != null)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@glavnaOcjena.Id"
                       class="btn btn-outline-secondary">
                        <i class="fas fa-info-circle me-1"></i> Detalji
                    </a>

                    @if (User.IsInRole("Profesor"))
                    {
                        <a asp-controller="Ocjene" asp-action="EditPredmetOcjena" asp-route-id="@glavnaOcjena.Id"
                           class="btn btn-outline-warning">
                            <i class="fas fa-edit me-1"></i> Izmijeni
                        </a>

                        <a asp-controller="Ocjene" asp-action="Create" asp-route-tip="Predmet"
                           asp-route-predmetId="@Model.Predmet.Id"
                           asp-route-studentId="@Model.Student.Id"
                           asp-route-parentOcjenaId="@glavnaOcjena.Id"
                           class="btn btn-outline-info">
                            <i class="fas fa-plus me-1"></i> Dodaj parcijalnu
                        </a>
                    }
                </div>
            }
            else if (User.IsInRole("Profesor"))
            {
                <a asp-controller="Ocjene" asp-action="Create" asp-route-tip="Predmet"
                   asp-route-predmetId="@Model.Predmet.Id"
                   asp-route-studentId="@Model.Student.Id"
                   class="btn btn-outline-dark mt-3">
                    <i class="fas fa-plus me-1"></i> Dodaj zaključnu ocjenu
                </a>
            }
        </div>
    </div>

    <!-- Parcijalne ocjene -->
@if (Model.ParcijalneOcjene?.Any() == true)
{
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <strong><i class="fas fa-tasks me-2"></i>Parcijalne ocjene</strong>
                <small class="text-muted">Ukupni bodovi: <strong>@Model.Predmet.UkupnoBodova</strong></small>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var grupisano in Model.ParcijalneOcjene)
                    {
                        foreach (var ocjena in grupisano.Value)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start flex-wrap">
                                <div class="me-auto">
                                    <strong>Vrijednost:</strong> @ocjena.Vrijednost

                                    @if (!string.IsNullOrWhiteSpace(ocjena.Komentar))
                                    {
                                        <span class="text-muted ms-2">(@ocjena.Komentar)</span>
                                    }

                                    @if (ocjena.DatumUnosa != default)
                                    {
                                        <div><small class="text-muted">@ocjena.DatumUnosa.ToString("dd.MM.yyyy")</small></div>
                                    }
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    @if (ocjena.TezinaProcentualno.HasValue)
                                    {
                                        <span class="badge text-bg-info">@ocjena.TezinaProcentualno %</span>
                                    }

                                    @if (User.IsInRole("Profesor"))
                                    {
                                        <a asp-controller="Ocjene" asp-action="Details" asp-route-id="@ocjena.Id"
                                           class="btn btn-outline-secondary btn-sm" title="Detalji">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <a asp-controller="Ocjene" asp-action="Edit" asp-route-id="@ocjena.Id"
                                           class="btn btn-outline-warning btn-sm" title="Izmijeni">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="Ocjene" asp-action="Delete" asp-route-id="@ocjena.Id"
                                           class="btn btn-outline-danger btn-sm" title="Obriši">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
}

    <!-- Navigacija -->
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-controller="Studenti" asp-action="Details" asp-route-id="@Model.Student.Id" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na studenta
        </a>
        <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@Model.Predmet.Id" class="btn btn-outline-secondary">
            <i class="fas fa-book me-1"></i> Detalji predmeta
        </a>
    </div>

@section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const ctx = document.getElementById('chartPrisustvo');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Prisustva', 'Izostanci'],
                    datasets: [{
                        label: 'Prisustvo',
                        data: [
                            @Model.Prisustva.Count(),
                            @Model.Aktivnosti.Count() - @Model.Prisustva.Count()
                        ],
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = (value / total * 100).toFixed(1);
                                    return `${context.label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        </script>
}
