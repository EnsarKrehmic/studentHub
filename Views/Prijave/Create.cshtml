@model StudentHub.Models.Prijava
@{
    ViewData["Title"] = "Prijava ispita";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 500px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-file-signature"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="IspitId" class="form-label"></label>
                    <select asp-for="IspitId" class="form-select" asp-items="ViewBag.IspitId">
                        <option value="">-- Odaberite ispit --</option>
                    </select>
                    <span asp-validation-for="IspitId" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Kreiraj prijavu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
