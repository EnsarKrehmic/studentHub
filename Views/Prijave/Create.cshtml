@model StudentHub.Models.Prijava

@{
    ViewData["Title"] = "Kreiraj prijavu";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="IspitId" class="control-label"></label>
        <select asp-for="IspitId" class="form-control" asp-items="ViewBag.IspitId"></select>
        <span asp-validation-for="IspitId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Kreiraj" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}