@model StudentHub.Models.Prijava

@{
    ViewData["Title"] = "Kreiraj prijavu";
}

<h2>@ViewData["Title"]</h2>

<h4>Prijava</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="IspitId" class="control-label"></label>
                <select asp-for="IspitId" class="form-control" asp-items="ViewBag.IspitId"></select>
                <span asp-validation-for="IspitId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kreiraj" class="btn btn-primary mt-3" />
                <a asp-action="Index" class="btn btn-secondary mt-3">Odustani</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}