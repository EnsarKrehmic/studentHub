@model StudentHub.Models.Prijava

@{
    ViewData["Title"] = "Brisanje prijave";
}

<h2>@ViewData["Title"]</h2>

<h3>Da li ste sigurni da želite obrisati ovu prijavu?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.datumPrijave)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.datumPrijave)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ispit)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Ispit.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.JMBG)</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button> |
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>