@model StudentHub.Models.Prijava

@{
    ViewData["Title"] = "Brisanje prijave";

    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovu prijavu?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o prijavi.";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Predmet"] = Model.Ispit?.Predmet ?? (object)"<span class='text-muted'>Nije definirano</span>",
        ["Broj indeksa"] = Model.Student?.BrojIndeksa ?? (object)"<span class='text-muted'>Nije definirano</span>"
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
