@model StudentHub.Models.Prijava

@{
    ViewData["Title"] = "Brisanje prijave";
}

<h2>@ViewData["Title"]</h2>

<p>Da li ste sigurni da želite obrisati prijavu za ispit na predmetu: "@Model.Ispit?.Predmet" studenta "@Model.Student?.BrojIndeksa"?</p>

<form asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>
