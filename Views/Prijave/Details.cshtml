@model StudentHub.Models.Prijava

@{
    ViewData["Title"] = "Detalji prijave";
}

<h2>@ViewData["Title"]</h2>

<dl>
    <dt>Ispit:</dt>
    <dd>@Model.Ispit?.Predmet</dd>

    <dt>Broj indeksa:</dt>
    <dd>@Model.Student?.BrojIndeksa</dd>

    <dt>Datum prijave:</dt>
    <dd>@Model.DatumPrijave.ToShortDateString()</dd>
</dl>

<div>
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>
