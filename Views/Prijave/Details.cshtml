@model StudentHub.Models.Prijava
@{
    ViewData["Title"] = "Detalji prijave";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-file-alt me-2"></i>@ViewData["Title"]
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Ispit:</dt>
                <dd class="col-sm-8">@Model.Ispit?.Predmet</dd>

                <dt class="col-sm-4">Broj indeksa:</dt>
                <dd class="col-sm-8">@Model.Student?.BrojIndeksa</dd>

                <dt class="col-sm-4">Datum prijave:</dt>
                <dd class="col-sm-8">@Model.DatumPrijave.ToString("dd.MM.yyyy")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na listu
        </a>
    </div>
</div>
