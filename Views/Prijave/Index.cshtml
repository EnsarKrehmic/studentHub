@model IEnumerable<StudentHub.Models.Prijava>

@{
    ViewData["Title"] = "Lista prijava";
}

<h2>@ViewData["Title"]</h2>

<table class="table">
    <thead>
        <tr>
            <th>Datum prijave</th>
            <th>Ispit</th>
            <th>Student</th>
            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
            {
                <th>Akcije</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var prijava in Model)
        {
            <tr>
                <td>@prijava.DatumPrijave.ToShortDateString()</td>
                <td>@prijava.Ispit?.Predmet</td>
                <td>@prijava.Student?.BrojIndeksa</td>
                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                {
                    <td>
                        <a asp-action="Details" asp-route-id="@prijava.Id">Detalji</a>
                        <a asp-action="Delete" asp-route-id="@prijava.Id">Brisanje</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>