@model StudentHub.ViewModels.ProfesorCreateViewModel
@{
    ViewData["Title"] = "Dodaj novog profesora";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-user-plus"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <h5 class="mt-3"><i class="fas fa-sign-in-alt me-2"></i>Prijava</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Unesite e-mail adresu" />
                        <small class="form-text text-muted">Službena adresa.</small>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Unesite lozinku" />
                        <small class="form-text text-muted">Min. 6 karaktera.</small>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Ponovite lozinku" />
                        <small class="form-text text-muted">Potvrdite lozinku.</small>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <h5><i class="fas fa-user-tie me-2"></i>Podaci o profesoru</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="JMBG" class="form-label"></label>
                        <input asp-for="JMBG" class="form-control" placeholder="Unesite JMBG" />
                        <small class="form-text text-muted">Tačno 13 cifara.</small>
                        <span asp-validation-for="JMBG" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ime" class="form-label"></label>
                        <input asp-for="Ime" class="form-control" placeholder="Unesite ime" />
                        <span asp-validation-for="Ime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Prezime" class="form-label"></label>
                        <input asp-for="Prezime" class="form-control" placeholder="Unesite prezime" />
                        <span asp-validation-for="Prezime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProfesorTitula" class="form-label"></label>
                        <input asp-for="ProfesorTitula" class="form-control" placeholder="Npr. red. prof." />
                        <small class="form-text text-muted">Akademska titula.</small>
                        <span asp-validation-for="ProfesorTitula" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StudijskiProgramIds" class="form-label"></label>
                        <select asp-for="StudijskiProgramIds" id="StudijskiProgramIds" multiple class="form-select" asp-items="ViewBag.StudijskiProgrami">
                        </select>
                        <small class="form-text text-muted">Držite Ctrl/Cmd za više odabira.</small>
                        <span asp-validation-for="StudijskiProgramIds" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PredmetIds" class="form-label"></label>
                        <select asp-for="PredmetIds" id="PredmetIds" multiple class="form-select">
                        </select>
                        <small class="form-text text-muted">Predmeti koje predaje.</small>
                        <span asp-validation-for="PredmetIds" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-plus"></i> Dodaj profesora
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('StudijskiProgramIds').addEventListener('change', function () {
            var selected = Array.from(this.selectedOptions).map(o => o.value);
            fetch('/Profesori/GetPredmetiByStudijskiProgram', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(selected)
            })
            .then(r => r.json())
            .then(data => {
                var pred = document.getElementById('PredmetIds');
                pred.innerHTML = '';
                data.forEach(p => {
                    var opt = document.createElement('option');
                    opt.value = p.id;  opt.text = p.naziv;
                    pred.appendChild(opt);
                });
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
