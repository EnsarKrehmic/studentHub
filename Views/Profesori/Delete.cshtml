@model StudentHub.Models.Profesor

@{
    ViewData["Title"] = "Brisanje profesora";

    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovog profesora?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o profesoru.";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Ime"] = Model.Ime,
        ["Prezime"] = Model.Prezime,
        ["JMBG"] = Model.JMBG,
        ["Email"] = Model.Email,
        ["Titula"] = Model.ProfesorTitula,
        ["Uloga"] = Model.Uloga
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
