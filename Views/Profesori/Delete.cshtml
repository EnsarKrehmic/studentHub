@model StudentHub.Models.Profesor

@{
    ViewData["Title"] = "Brisanje profesora";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovog profesora?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti sve podatke o profesoru.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o profesoru</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Ime:</dt>
            <dd class="col-sm-9">@Model.Ime</dd>

            <dt class="col-sm-3">Prezime:</dt>
            <dd class="col-sm-9">@Model.Prezime</dd>

            <dt class="col-sm-3">JMBG:</dt>
            <dd class="col-sm-9">@Model.JMBG</dd>

            <dt class="col-sm-3">Email:</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Titula:</dt>
            <dd class="col-sm-9">@Model.ProfesorTitula</dd>

            <dt class="col-sm-3">Uloga:</dt>
            <dd class="col-sm-9">@Model.Uloga</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>