@model StudentHub.ViewModels.ProfesorDetailsViewModel

@{
    ViewData["Title"] = "Detalji profesora";
}

<h2>@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Podaci o profesoru</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Ime:</dt>
                <dd class="col-sm-9">@Model.Profesor.Ime</dd>

                <dt class="col-sm-3">Prezime:</dt>
                <dd class="col-sm-9">@Model.Profesor.Prezime</dd>

                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                {
                    <dt class="col-sm-3">JMBG:</dt>
                    <dd class="col-sm-9">@Model.Profesor.JMBG</dd>
                }

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.Profesor.Email</dd>

                <dt class="col-sm-3">Titula:</dt>
                <dd class="col-sm-9">@Model.Profesor.ProfesorTitula</dd>

                <dt class="col-sm-3">Uloga:</dt>
                <dd class="col-sm-9">@Model.Profesor.Uloga</dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h4>Studijski programi</h4>
        </div>
        <div class="card-body">
            <ul>
                @foreach (var studijskiProgram in Model.StudijskiProgrami)
                {
                    <li>@studijskiProgram.Naziv</li>
                }
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h4>Predmeti</h4>
        </div>
        <div class="card-body">
            <ul>
                @foreach (var predmet in Model.Predmeti)
                {
                    <li>@predmet.Naziv</li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Profesor.Id" class="btn btn-warning">Izmjena</a>
    }    
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>