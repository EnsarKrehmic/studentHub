@model StudentHub.ViewModels.ProfesorDetailsViewModel
@{
    ViewData["Title"] = "Detalji profesora";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-chalkboard-teacher me-2"></i>@ViewData["Title"]</h2>

    <div class="row">
        <!-- Podaci o profesoru -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-user me-2"></i>Podaci o profesoru
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Ime:</dt>
                        <dd class="col-sm-8">@Model.Profesor.Ime</dd>

                        <dt class="col-sm-4">Prezime:</dt>
                        <dd class="col-sm-8">@Model.Profesor.Prezime</dd>

                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                        {
                            <dt class="col-sm-4">JMBG:</dt>
                            <dd class="col-sm-8">@Model.Profesor.JMBG</dd>
                        }

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Profesor.Email</dd>

                        <dt class="col-sm-4">Titula:</dt>
                        <dd class="col-sm-8">@Model.Profesor.ProfesorTitula</dd>

                        <dt class="col-sm-4">Uloga:</dt>
                        <dd class="col-sm-8">@Model.Profesor.Uloga</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Studijski programi -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-graduation-cap me-2"></i>Studijski programi
                </div>
                <div class="card-body">
                    @if (Model.StudijskiProgrami.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var sp in Model.StudijskiProgrami)
                            {
                                <li class="list-group-item">
                                    <a asp-controller="StudijskiProgrami" asp-action="Details" asp-route-id="@sp.Id" class="text-decoration-none">
                                        @sp.Naziv
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Profesor trenutno nije dodijeljen nijednom studijskom programu.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Predmeti -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-book me-2"></i>Predmeti
        </div>
        <div class="card-body">
            @if (Model.Predmeti.Any())
            {
                <div class="row">
                    @foreach (var predmet in Model.Predmeti)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@predmet.Id" class="text-decoration-none">
                                            @predmet.Naziv
                                        </a>
                                    </h5>
                                    <p class="mb-1"><strong>ECTS:</strong> @predmet.ECTS</p>
                                    <p class="mb-1"><strong>Semestar:</strong> @predmet.Semestar</p>
                                    <p class="mb-0"><strong>Opis:</strong> @(string.IsNullOrEmpty(predmet.Opis) ? "Nema opisa." : predmet.Opis)</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Profesor trenutno nije dodijeljen nijednom predmetu.</p>
            }
        </div>
    </div>

    <!-- Akcije -->
    <div class="d-flex gap-2 mt-3">
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Profesor.Id" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Izmjena
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na listu
        </a>
    </div>
</div>
