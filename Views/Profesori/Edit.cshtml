@model StudentHub.ViewModels.ProfesorEditViewModel

@{
    ViewData["Title"] = "Izmijeni profesora";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label asp-for="Ime" class="control-label"></label>
        <input asp-for="Ime" class="form-control" />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Prezime" class="control-label"></label>
        <input asp-for="Prezime" class="form-control" />
        <span asp-validation-for="Prezime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JMBG" class="control-label"></label>
        <input asp-for="JMBG" class="form-control" />
        <span asp-validation-for="JMBG" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Lozinka" class="control-label"></label>
        <input asp-for="Lozinka" class="form-control" />
        <span asp-validation-for="Lozinka" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProfesorTitula" class="control-label"></label>
        <input asp-for="ProfesorTitula" class="form-control" />
        <span asp-validation-for="ProfesorTitula" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Uloga" class="control-label"></label>
        <select asp-for="Uloga" class="form-control" asp-items="Html.GetEnumSelectList<Uloga>()"></select>
        <span asp-validation-for="Uloga" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="StudijskiProgramIds">Studijski programi</label>
        <select asp-for="StudijskiProgramIds" class="form-control" asp-items="ViewBag.StudijskiProgrami" id="StudijskiProgramIds" multiple="multiple"></select>
        <span asp-validation-for="StudijskiProgramIds" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="PredmetIds">Predmeti</label>
        <select asp-for="PredmetIds" class="form-control" asp-items="ViewBag.Predmeti" id="PredmetIds" multiple="multiple"></select>
        <span asp-validation-for="PredmetIds" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Sačuvaj" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>

@section Scripts {
    <script>
        document.getElementById('StudijskiProgramIds').addEventListener('change', function () {
            var selectedProgramIds = Array.from(this.selectedOptions).map(option => option.value);
            fetch('/Profesori/GetPredmetiByStudijskiProgram', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(selectedProgramIds)
            })
            .then(response => response.json())
            .then(data => {
                var predmetSelect = document.getElementById('PredmetIds');
                predmetSelect.innerHTML = '';
                data.forEach(predmet => {
                    var option = document.createElement('option');
                    option.value = predmet.id;
                    option.text = predmet.naziv;
                    predmetSelect.appendChild(option);
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}