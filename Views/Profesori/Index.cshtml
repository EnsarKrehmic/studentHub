@model IEnumerable<StudentHub.Models.Profesor>

@{
    ViewData["Title"] = "Lista profesora svih studijskih programa";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novog profesora</a>
</p>

<form asp-action="Index" method="get">
    <div class="form-group">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Pretraži profesora" />
    </div>
    <div class="form-group">
        <label for="StudijskiProgramId">Filtrirajte profesore prema studijskom programu</label>
        <select id="StudijskiProgramId" name="studijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgrami">
            <option value="">Svi programi</option>
        </select>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Pretraži</button>
    </div>
</form>

<table class="table table-bordered table-hover mt-3">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Ime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Prezime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().JMBG)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Email)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().ProfesorTitula)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                <td>@Html.DisplayFor(modelItem => item.JMBG)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.ProfesorTitula)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>
