@model IEnumerable<StudentHub.Models.Profesor>
@{
    ViewData["Title"] = "Lista svih profesora na fakultetu";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    @if (User.IsInRole("Studentska služba"))
    {
        <a class="btn btn-success shadow-sm" asp-controller="Profesori" asp-action="Create" title="Dodaj profesora">
            <i class="fas fa-user-plus me-2"></i> Dodaj profesora
        </a>
    }
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="searchString" class="form-control" placeholder="Pretraga po imenu/prezimenu profesora..." value="@Context.Request.Query["searchString"]">
        </div>
        <div class="col-md-4">
            <select name="studijskiProgramId" class="form-select">
                <option value="">Svi studijski programi</option>
                @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                {
                    <option value="@program.Value" selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">@program.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filtriraj</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> Reset</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["NameSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-body">
                                Ime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["SurnameSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-body">
                                Prezime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                        {
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["JMBGSortParm"]"
                                   asp-route-searchString="@Context.Request.Query["searchString"]"
                                   asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                                   class="text-decoration-none text-body">
                                    JMBG <i class="fas fa-sort"></i>
                                </a>
                            </th>
                        }
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["EmailSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-body">
                                Email <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["TitulaSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-body">
                                Titula <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                        {
                            <th class="text-center">Akcije</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Ime</td>
                            <td>@p.Prezime</td>
                            @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                            {
                                <td>@p.JMBG</td>
                            }
                            <td>@p.Email</td>
                            <td>@p.ProfesorTitula</td>
                            <td class="text-center">
                                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                {
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary me-1" title="Detalji">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                }
                                @if (User.IsInRole("Studentska služba"))
                                {
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning me-1" title="Uredi">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Obriši">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary mt-3">
    <i class="fas fa-arrow-left"></i> Povratak na početnu
</a>
