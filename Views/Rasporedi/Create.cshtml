@model StudentHub.Models.Raspored
@{
    ViewData["Title"] = "Dodaj novi raspored";
    Layout = "_Layout";
    var programi = ViewBag.StudijskiProgrami as List<StudentHub.Models.StudijskiProgram>
                   ?? new List<StudentHub.Models.StudijskiProgram>();
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="StudijskiProgramId" class="form-label">🎓 Studijski program</label>
                    <select asp-for="StudijskiProgramId" class="form-select" required>
                        <option value="">-- Odaberi program --</option>
                        @if (programi.Any())
                        {
                            foreach (var p in programi)
                            {
                                <option value="@p.Id">@p.Naziv</option>
                            }
                        }
                        else
                        {
                            <option disabled>Nema dostupnih programa</option>
                        }
                    </select>
                    <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GodinaStudija" class="form-label">📘 Godina studija</label>
                    <input asp-for="GodinaStudija" class="form-control" placeholder="npr. 1, 2, 3..." required />
                    <span asp-validation-for="GodinaStudija" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Semestar" class="form-label">📅 Semestar</label>
                    <select asp-for="Semestar" class="form-select" required>
                        <option value="">-- Odaberi semestar --</option>
                        <option value="1">Zimski</option>
                        <option value="2">Ljetni</option>
                    </select>
                    <span asp-validation-for="Semestar" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AkademskaGodina" class="form-label">🗓️ Akademska godina</label>
                    <input asp-for="AkademskaGodina" class="form-control" placeholder="npr. 2024/2025" required />
                    <span asp-validation-for="AkademskaGodina" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Sačuvaj raspored
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
