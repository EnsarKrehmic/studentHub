@model StudentHub.Models.Raspored

@{
    ViewData["Title"] = "Brisanje rasporeda";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">
        <i class="fas fa-exclamation-triangle"></i> Potvrda brisanja rasporeda
    </h2>

    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="fas fa-info-circle fa-lg"></i>
        <div>
            Brisanjem ovog rasporeda trajno će biti <strong>uklonjeni svi njegovi termini nastave</strong> iz sistema!
            <br />
            <strong>Ova radnja je nepovratna.</strong>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">📘 Studijski program:</dt>
                <dd class="col-sm-8">@Model.StudijskiProgram?.Naziv</dd>

                <dt class="col-sm-4">🎓 Godina studija:</dt>
                <dd class="col-sm-8">@Model.GodinaStudija</dd>

                <dt class="col-sm-4">📅 Semestar:</dt>
                <dd class="col-sm-8">@(Model.Semestar == 1 ? "Zimski" : "Ljetni")</dd>

                <dt class="col-sm-4">🗓️ Akademska godina:</dt>
                <dd class="col-sm-8">@Model.AkademskaGodina</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"
          onsubmit="return confirm('Da li ste sigurni da želite obrisati ovaj raspored i sve njegove termine?');">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash-alt"></i> Obriši raspored
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Odustani
        </a>
    </form>
</div>
