@model StudentHub.Models.Raspored

@{
    ViewData["Title"] = "Brisanje rasporeda";

    ViewData["WarningMessage"] = "Potvrda brisanja rasporeda";
    ViewData["WarningDetails"] = "Brisanjem ovog rasporeda trajno će biti uklonjeni svi njegovi termini nastave iz sistema!";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Studijski program"] = Model.StudijskiProgram?.Naziv,
        ["Godina studija"] = Model.GodinaStudija,
        ["Semestar"] = Model.Semestar == 1 ? "Zimski" : "Ljetni",
        ["Akademska godina"] = Model.AkademskaGodina
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
