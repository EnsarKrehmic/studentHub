@model StudentHub.ViewModels.RasporedDetailsViewModel

@{
    ViewData["Title"] = "Detalji rasporeda";
    var jeSlužba = Model.KorisnickaUloga == "Studentska služba";

    var daniBosanski = new List<(DayOfWeek dan, string naziv, int redoslijed)>
    {
        (DayOfWeek.Monday, "Ponedjeljak", 0),
        (DayOfWeek.Tuesday, "Utorak", 1),
        (DayOfWeek.Wednesday, "Srijeda", 2),
        (DayOfWeek.Thursday, "Četvrtak", 3),
        (DayOfWeek.Friday, "Petak", 4),
        (DayOfWeek.Saturday, "Subota", 5),
        (DayOfWeek.Sunday, "Nedjelja", 6)
    };
}

<!-- DataTables stilovi -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/rowgroup/1.3.1/css/rowGroup.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <h2 class="mb-0">
            <i class="fas fa-calendar-day text-primary me-2"></i>@ViewData["Title"]
        </h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad na listu
            </a>
            @if (jeSlužba)
            {
                <a asp-action="Edit" asp-route-id="@Model.Raspored.Id" class="btn btn-outline-primary">
                    <i class="fas fa-edit me-1"></i> Uredi raspored
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-start border-4 border-primary">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-info-circle me-2"></i> Osnovne informacije
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">📘 Studijski program:</dt>
                <dd class="col-sm-8">@Model.Raspored.StudijskiProgram?.Naziv</dd>
                <dt class="col-sm-4">🎓 Godina studija:</dt>
                <dd class="col-sm-8">@Model.Raspored.GodinaStudija</dd>
                <dt class="col-sm-4">📆 Semestar:</dt>
                <dd class="col-sm-8">@(Model.Raspored.Semestar == 1 ? "Zimski" : "Ljetni")</dd>
                <dt class="col-sm-4">📅 Akademska godina:</dt>
                <dd class="col-sm-8">@Model.Raspored.AkademskaGodina</dd>
            </dl>
        </div>
    </div>

    @if (Model.PrikazSamoLični)
    {
        <div class="alert alert-info shadow-sm d-flex align-items-center mb-4">
            <i class="fas fa-user-shield me-2"></i>
            Prikaz termina je filtriran prema vašoj ulozi: <strong class="ms-1">@Model.KorisnickaUloga</strong>
        </div>
    }

    <h4 class="mb-3">
        <i class="fas fa-clock text-secondary me-2"></i>Termini nastave
    </h4>

    @if (Model.Termini.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="detaljiRasporedTable" class="table table-hover table-bordered mb-0 align-middle w-100">
                        <thead class="table-light text-center">
                            <tr>
                                <th>📘 Predmet</th>
                                <th>📚 Vrsta</th>
                                <th style="display:none;">DanRedoslijed</th>
                                <th>📅 Dan</th>
                                <th>⏰ Vrijeme</th>
                                <th>🏫 Lokacija</th>
                                @if (jeSlužba)
                                {
                                    <th>⚙️ Akcije</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Termini.OrderBy(x => daniBosanski.First(d => d.dan == x.Dan).redoslijed).ThenBy(x => x.VrijemeOd))
                            {
                                var danInfo = daniBosanski.First(d => d.dan == t.Dan);
                                <tr>
                                    <td>@t.Predmet?.Naziv</td>
                                    <td>@t.Vrsta</td>
                                    <td style="display:none;">@danInfo.redoslijed</td>
                                    <td class="text-center">@danInfo.naziv</td>
                                    <td class="text-center">@t.VrijemeOd - @t.VrijemeDo</td>
                                    <td>@t.Lokacija</td>
                                    @if (jeSlužba)
                                    {
                                        <td class="text-nowrap text-center">
                                            <a asp-controller="TerminiNastave" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary me-1" title="Izmijeni">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-controller="TerminiNastave" asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger" title="Obriši">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-secondary mt-3 shadow-sm">
            <i class="fas fa-info-circle me-2"></i> Nema definisanih termina za prikaz.
        </div>
    }

    @if (jeSlužba)
    {
        <div class="text-center mt-4">
            <a asp-action="GenerisiTermine" asp-route-id="@Model.Raspored.Id" class="btn btn-warning">
                <i class="fas fa-magic me-1"></i> Automatski generiši termine
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.3.1/js/dataTables.rowGroup.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        const daniBosanskiJS = {
            0: "Ponedjeljak",
            1: "Utorak",
            2: "Srijeda",
            3: "Četvrtak",
            4: "Petak",
            5: "Subota",
            6: "Nedjelja"
        };

        $(document).ready(function () {
            $('#detaljiRasporedTable').DataTable({
                responsive: true,
                autoWidth: false,
                paging: true,
                searching: true,
                ordering: true,
                order: [[2, 'asc']],
                lengthMenu: [5, 10, 25, 50],
                columnDefs: [
                    { targets: 2, visible: false, searchable: false },
                    { targets: 3, orderData: 2 }
                ],
                rowGroup: {
                    dataSrc: 2,
                    startRender: function (rows, group) {
                        return `<span class="fw-bold text-primary fs-5"><i class="fas fa-calendar-day me-2"></i> ${daniBosanskiJS[group]}</span>`;
                    }
                },
                language: {
                    search: "Pretraži:",
                    lengthMenu: "Prikaži _MENU_ redova",
                    info: "Prikazujem _START_ do _END_ od ukupno _TOTAL_ termina",
                    paginate: {
                        first: "Prvi",
                        last: "Posljednji",
                        next: "Sljedeći",
                        previous: "Prethodni"
                    },
                    zeroRecords: "Nema rezultata za prikaz"
                }
            });
        });
    </script>
}
