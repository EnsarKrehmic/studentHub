@model StudentHub.ViewModels.RasporedDetailsViewModel

@{
    ViewData["Title"] = "Detalji rasporeda";
    var jeSlužba = Model.KorisnickaUloga == "Studentska služba";

    var daniBosanski = new List<(DayOfWeek dan, string naziv, int redoslijed)>
    {
        (DayOfWeek.Monday, "Ponedjeljak", 0),
        (DayOfWeek.Tuesday, "Utorak", 1),
        (DayOfWeek.Wednesday, "Srijeda", 2),
        (DayOfWeek.Thursday, "Četvrtak", 3),
        (DayOfWeek.Friday, "Petak", 4),
        (DayOfWeek.Saturday, "Subota", 5),
        (DayOfWeek.Sunday, "Nedjelja", 6)
    };
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/rowgroup/1.3.1/css/rowGroup.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-calendar-day text-primary"></i> Detalji rasporeda</h2>

    <div class="card shadow-sm mb-4 border-start-primary">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">📘 Studijski program:</dt>
                <dd class="col-sm-8">@Model.Raspored.StudijskiProgram?.Naziv</dd>
                <dt class="col-sm-4">🎓 Godina studija:</dt>
                <dd class="col-sm-8">@Model.Raspored.GodinaStudija</dd>
                <dt class="col-sm-4">📆 Semestar:</dt>
                <dd class="col-sm-8">@(Model.Raspored.Semestar == 1 ? "Zimski" : "Ljetni")</dd>
                <dt class="col-sm-4">📅 Akademska godina:</dt>
                <dd class="col-sm-8">@Model.Raspored.AkademskaGodina</dd>
            </dl>
        </div>
    </div>

    @if (Model.PrikazSamoLični)
    {
        <div class="alert alert-info d-flex align-items-center mb-4">
            <i class="fas fa-user-shield me-2"></i>
            Prikaz termina je filtriran prema vašoj ulozi: <strong>@Model.KorisnickaUloga</strong>
        </div>
    }

    <h4 class="mb-3"><i class="fas fa-clock text-secondary"></i> Termini nastave</h4>

    @if (Model.Termini.Any())
    {
        <div class="table-responsive shadow-sm">
            <table id="detaljiRasporedTable" class="table table-hover table-bordered align-middle w-100">
                <thead class="table-light text-center">
                    <tr>
                        <th>📘 Predmet</th>
                        <th>📚 Vrsta</th>
                        <th style="display:none;">DanRedoslijed</th>
                        <th>📅 Dan</th>
                        <th>⏰ Vrijeme</th>
                        <th>🏫 Lokacija</th>
                        @if (jeSlužba)
                        {
                            <th>Akcije</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Termini.OrderBy(x => daniBosanski.First(d => d.dan == x.Dan).redoslijed).ThenBy(x => x.VrijemeOd))
                    {
                        var danInfo = daniBosanski.FirstOrDefault(d => d.dan == t.Dan);
                        var nazivDana = danInfo.naziv;
                        var redoslijedDana = danInfo.redoslijed;
                        <tr>
                            <td>@t.Predmet?.Naziv</td>
                            <td>@t.Vrsta</td>
                            <td style="display:none;">@redoslijedDana</td>
                            <td class="text-center">@nazivDana</td>
                            <td class="text-center">@t.VrijemeOd.ToString(@"hh\:mm") - @t.VrijemeDo.ToString(@"hh\:mm")</td>
                            <td>@t.Lokacija</td>
                            @if (jeSlužba)
                            {
                                <td class="text-nowrap text-center">
                                    <a asp-controller="TerminiNastave" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="TerminiNastave" asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            <i class="fas fa-info-circle"></i> Nema definisanih termina za prikaz.
        </div>
    }

    @if (jeSlužba)
    {
        <div class="card my-4 shadow-sm border-warning">
            <a asp-action="GenerisiTermine" asp-route-id="@Model.Raspored.Id" class="btn btn-warning mt-4">
                <i class="fas fa-magic"></i> Automatski generiši termine
            </a>
        </div>
    }

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Nazad na listu
        </a>
        @if (jeSlužba)
        {
            <a asp-action="Edit" asp-route-id="@Model.Raspored.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Uredi raspored
            </a>
        }
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.3.1/js/dataTables.rowGroup.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        // JS mapa za prikaz dana na bosanskom
        const daniBosanskiJS = {
            0: "Ponedjeljak",
            1: "Utorak",
            2: "Srijeda",
            3: "Četvrtak",
            4: "Petak",
            5: "Subota",
            6: "Nedjelja"
        };

        $(document).ready(function () {
            $('#detaljiRasporedTable').DataTable({
                responsive: true,
                autoWidth: false,
                paging: true,
                searching: true,
                ordering: true,
                order: [[2, 'asc']], // Po redoslijedu dana u sedmici
                lengthMenu: [5, 10, 25, 50],
                columnDefs: [
                    { targets: 2, visible: false, searchable: false }, // Skrivena kolona DanRedoslijed
                    { targets: 3, orderData: 2 }
                ],
                rowGroup: {
                    dataSrc: 2,
                    startRender: function (rows, group) {
                        return `<span class="fw-bold text-primary fs-5"><i class="fas fa-calendar-day"></i> ${daniBosanskiJS[group]}</span>`;
                    }
                },
                language: {
                    search: "Pretraži:",
                    lengthMenu: "Prikaži _MENU_ redova",
                    info: "Prikazujem _START_ do _END_ od ukupno _TOTAL_ termina",
                    paginate: {
                        first: "Prvi",
                        last: "Posljednji",
                        next: "Sljedeći",
                        previous: "Prethodni"
                    },
                    zeroRecords: "Nema rezultata za prikaz"
                }
            });
        });
    </script>
}
