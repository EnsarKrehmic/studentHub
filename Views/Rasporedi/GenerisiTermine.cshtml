@model StudentHub.ViewModels.GenerisanjeTerminaViewModel

@{
    ViewData["Title"] = "Automatsko generisanje termina";
    var daniBosanski = new List<(DayOfWeek dan, string naziv)> {
        (DayOfWeek.Monday, "Ponedjeljak"),
        (DayOfWeek.Tuesday, "Utorak"),
        (DayOfWeek.Wednesday, "Srijeda"),
        (DayOfWeek.Thursday, "Četvrtak"),
        (DayOfWeek.Friday, "Petak"),
        (DayOfWeek.Saturday, "Subota"),
    };
}

<div class="container mt-4">
    <h3 class="mb-4">
        <i class="fas fa-magic text-warning me-2"></i>@ViewData["Title"]
    </h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            @Html.Raw(TempData["Success"])
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-start border-3 border-warning">
        <div class="card-body">
            <form asp-action="GenerisiTermine" asp-route-id="@Model.RasporedId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RasporedId" />

                <!-- Dani u sedmici -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Dani u sedmici:</label>
                    <div class="row">
                        @foreach (var dan in daniBosanski)
                        {
                            <div class="col-auto">
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="Dani"
                                           value="@dan.dan"
                                           class="form-check-input"
                                           id="dan_@dan.dan"
                                           @(Model.Dani.Contains(dan.dan) ? "checked" : null) />
                                    <label class="form-check-label" for="dan_@dan.dan">@dan.naziv</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Parametri -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Početni sat:</label>
                        <input asp-for="SatOd" type="number" class="form-control" min="6" max="20" />
                        <span asp-validation-for="SatOd" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Zadnji sat:</label>
                        <input asp-for="SatDo" type="number" class="form-control" min="7" max="22" />
                        <span asp-validation-for="SatDo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Trajanje termina (min):</label>
                        <input asp-for="TrajanjeMin" type="number" class="form-control" min="30" max="120" />
                        <span asp-validation-for="TrajanjeMin" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Pauza (min):</label>
                        <input asp-for="PauzaMin" type="number" class="form-control" min="0" max="60" />
                        <span asp-validation-for="PauzaMin" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Broj sedmica:</label>
                        <input asp-for="BrojSedmica" type="number" class="form-control" min="1" max="30" />
                        <span asp-validation-for="BrojSedmica" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Lokacije -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Dostupne učionice:</label>
                    <div class="row">
                        @foreach (var lokacija in Model.SveLokacije)
                        {
                            <div class="col-auto">
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="OdabraneLokacije"
                                           value="@lokacija"
                                           class="form-check-input"
                                           id="lok_@lokacija"
                                           @(Model.OdabraneLokacije.Contains(lokacija) ? "checked" : null) />
                                    <label class="form-check-label" for="lok_@lokacija">@lokacija</label>
                                </div>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="OdabraneLokacije" class="text-danger small"></span>
                </div>

                <!-- Dodatne opcije -->
                <div class="form-check mb-2">
                    <input asp-for="NeRasporedjujPetkomPopodne" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="NeRasporedjujPetkomPopodne">
                        Ne raspoređuj petkom poslije 14h
                    </label>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="IzbjegavajUzastopneTermine" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="IzbjegavajUzastopneTermine">
                        Izbjegavaj uzastopne termine istom nastavniku
                    </label>
                </div>

                <!-- Dugmad -->
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-magic me-1"></i> Generiši termine
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.RasporedId" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
