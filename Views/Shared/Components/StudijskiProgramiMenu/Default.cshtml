@model IEnumerable<StudentHub.Models.StudijskiProgram>

<ul class="collapse list-unstyled" id="studijskiprogramiSubmenu">
    @foreach (var program in Model)
    {
        <li>
            <a class="dropdown-item" asp-controller="StudijskiProgrami" asp-action="Details" asp-route-id="@program.Id">
                @program.Naziv
            </a>
        </li>
    }
</ul>
