@model IEnumerable<object>
@{
    // Očekuje ViewData["Title"], opcionalno CreateAction/CreateController i ViewData["CreateText"]
    var title = ViewData["Title"] as string ?? "Lista";
    var createAction = ViewData["CreateAction"] as string;
    var createController = ViewData["CreateController"] as string;
    var createText = ViewData["CreateText"] as string ?? "Dodaj novi";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
    <h2 class="mb-0">@title</h2>
    @* Dugme za Create *@
    @if (!string.IsNullOrEmpty(createAction) && User.IsInRole("Studentska služba"))
    {
        <a class="btn btn-success shadow-sm"
           asp-controller="@createController"
           asp-action="@createAction"
           title="@createText">
            <i class="fas fa-plus-circle me-2"></i> @createText
        </a>
    }
</div>

@* FILTER sekcija, opcionalna *@
@if (IsSectionDefined("FilterSection"))
{
    <form method="get" class="card card-body shadow-sm mb-3">
        @RenderSection("FilterSection", required: false)
    </form>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    @RenderSection("HeaderSection", required: true)
                </thead>
                <tbody>
                    @RenderBody()
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Footer link natrag na home *@
@if (IsSectionDefined("FooterSection"))
{
    @RenderSection("FooterSection", required: false)
}
else
{
    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Povratak na početnu
    </a>
}
