<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentHub</title>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap 5 CSS (local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessibility.css" />
    <link rel="stylesheet" href="~/css/support.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="bg-light border-end">
            <div class="sidebar-header p-3 bg-primary text-white">
                <h3 class="fw-bold mb-0 d-flex align-items-center">
                    <i class="fas fa-graduation-cap me-2"></i> StudentHub
                </h3>
                <hr class="my-2 bg-light">
            </div>

            <ul class="list-unstyled components px-2">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link d-flex align-items-center">
                        <i class="fas fa-home me-2"></i> Početna
                    </a>
                </li>

                <!-- Osoblje Dropdown -->
                <li class="nav-item">
                    <a href="#osobljeSubmenu" data-bs-toggle="collapse" aria-expanded="false"
                       class="nav-link dropdown-toggle d-flex align-items-center">
                        <i class="fas fa-users me-2"></i> Osoblje
                    </a>
                    <ul class="collapse list-unstyled ps-4" id="osobljeSubmenu">
                        <li class="nav-item"><a class="nav-link" asp-controller="Studenti" asp-action="Index"><i class="fas fa-user-graduate me-2"></i>Studenti</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profesori" asp-action="Index"><i class="fas fa-chalkboard-teacher me-2"></i>Profesori</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Asistenti" asp-action="Index"><i class="fas fa-user-tie me-2"></i>Asistenti</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="StudentskaSluzba" asp-action="Index"><i class="fas fa-headset me-2"></i>Studentska Služba</a></li>
                    </ul>
                </li>

                <!-- Akademski podaci Dropdown -->
                <li class="nav-item">
                    <a href="#akademskipodaciSubmenu" data-bs-toggle="collapse" aria-expanded="false"
                       class="nav-link dropdown-toggle d-flex align-items-center">
                        <i class="fas fa-book me-2"></i> Akademski podaci
                    </a>
                    <ul class="collapse list-unstyled ps-4" id="akademskipodaciSubmenu">
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Ispiti" asp-action="Index">Ispiti</a></li>
                        }
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Ocjene" asp-action="Index">Ocjene</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="Predmeti" asp-action="Index">Predmeti</a></li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="StatistikaIzbornihPredmeta" asp-action="Index">Statistika izbornih predmeta</a></li>
                        }
                        @if (User.IsInRole("Studentska služba"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="StudijskiProgramIzborniLimiti" asp-action="Index">Limiti izbornih predmeta</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Rasporedi" asp-action="Index">Rasporedi</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="NastavniPlanovi" asp-action="Index">Nastavni planovi</a></li>
                    </ul>
                </li>

                <!-- Studijski Podaci Dropdown -->
                <li class="nav-item">
                    <a href="#studijskiprogramiSubmenu" data-bs-toggle="collapse" aria-expanded="false"
                       class="nav-link dropdown-toggle d-flex align-items-center">
                        <i class="fas fa-graduation-cap me-2"></i> Studijski programi
                    </a>
                    <ul class="collapse list-unstyled ps-4" id="studijskiprogramiSubmenu">
                        @await Component.InvokeAsync("StudijskiProgramiMenu")
                    </ul>
                </li>

                <!-- Ostalo Dropdown -->
                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                {
                    <li class="nav-item">
                        <a href="#ostaloSubmenu" data-bs-toggle="collapse" aria-expanded="false"
                           class="nav-link dropdown-toggle d-flex align-items-center">
                            <i class="fas fa-ellipsis-h me-2"></i> Ostalo
                        </a>
                        <ul class="collapse list-unstyled ps-4" id="ostaloSubmenu">
                            <li class="nav-item"><a class="nav-link" asp-controller="Zahtjevi" asp-action="Index" asp-route-id="1">Zahtjevi</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Uvjerenja" asp-action="Index" asp-route-id="1">Uvjerenja</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Dokumenti" asp-action="Index" asp-route-id="1">Dokumenti</a></li>
                        </ul>
                    </li>
                }

                <!-- Obavještenja -->
                @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="Obavjestenja" asp-action="Index">
                            <i class="fas fa-bullhorn me-2"></i> Obavještenja
                        </a>
                    </li>
                }

                <!-- Moji Podaci -->
                @if (User.IsInRole("Student") || User.IsInRole("Profesor") || User.IsInRole("Asistent") || User.IsInRole("Studentska služba"))
                {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="MojiPodaci" asp-action="Index">
                            <i class="fas fa-user-circle me-2"></i> Moji podaci
                        </a>
                    </li>
                }

                <!-- Pravilnici -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" asp-controller="Pravilnici" asp-action="Index">
                        <i class="fas fa-file-alt me-2"></i> Pravilnici
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer p-3 mt-auto bg-light">
                <div class="theme-switcher d-flex align-items-center justify-content-between">
                    <span class="d-flex align-items-center">
                        <i class="fas fa-sun me-2"></i>Tema:
                    </span>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="darkModeSwitch">
                        <label class="form-check-label" for="darkModeSwitch">
                            <i class="fas fa-moon"></i>
                        </label>
                    </div>
                </div>
            </div>
        </nav>
        <div id="sidebar-overlay"></div>

        <!-- Main Content -->
        <div id="content">
            <!-- Top Navigation -->
            <nav class="navbar navbar-expand-lg shadow-sm">
                <div class="container-fluid">
                    <button id="sidebarToggle" class="btn btn-sm btn-outline-primary me-2">
                        <i class="fas fa-bars"></i>
                    </button>

                    <div class="d-flex align-items-center ms-auto">
                        <div class="me-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-user-circle me-2 text-primary"></i>
                                <span class="fw-medium">@User.Identity?.Name</span>
                            </div>
                        </div>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main role="main" class="flex-grow-1">
                <div class="container-fluid p-4">
                    @await Html.PartialAsync("_AccessibilityPanel")
                    @await Html.PartialAsync("_SupportPanel")
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/accessibility.js"></script>
    <script src="~/js/support.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>