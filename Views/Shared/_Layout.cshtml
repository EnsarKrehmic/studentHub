@using (Html.BeginForm("SomeAction", "SomeController", FormMethod.Post))
{
    @Html.AntiForgeryToken()
}

<form id="__AjaxAntiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentHub</title>

    <!-- Bootstrap 4 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <!-- Dodatni CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentHub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <!-- Custom Styles -->
    <style>
        .badge {
            font-size: 0.9em;
            padding: 0.5em 0.75em;
            vertical-align: middle;
        }

        dl.row dt {
            font-weight: 500;
            color: #6c757d;
            white-space: nowrap;
        }

        .footer-map {
            min-height: 200px;
            background: #f8f9fa;
            border-radius: 8px;
            overflow: hidden;
        }

        [data-toggle="tooltip"] {
            cursor: help;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">StudentHub</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Početna</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-expanded="false">
                                Osoblje
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" asp-controller="Studenti" asp-action="Index">Studenti</a></li>
                                <li><a class="dropdown-item" asp-controller="Profesori" asp-action="Index">Profesori</a></li>
                                <li><a class="dropdown-item" asp-controller="Asistenti" asp-action="Index">Asistenti</a></li>
                                <li><a class="dropdown-item" asp-controller="StudentskaSluzba" asp-action="Index">Studentska Služba</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAcademic" role="button" data-toggle="dropdown" aria-expanded="false">
                                Akademski podaci
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownAcademic">
                                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Ispiti" asp-action="Index">Ispiti</a></li>
                                }
                                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Ocjene" asp-action="Index">Ocjene</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Predmeti" asp-action="Index">Predmeti</a></li>
                                <li><a class="dropdown-item" asp-controller="NastavniPlanovi" asp-action="Index">Nastavni planovi</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownPrograms" role="button" data-toggle="dropdown" aria-expanded="false">
                                Studijski Programi
                            </a>
                            @await Component.InvokeAsync("StudijskiProgramiMenu")
                        </li>
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownOther" role="button" data-toggle="dropdown" aria-expanded="false">
                                    Ostalo
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownOther">
                                    <li><a class="dropdown-item" asp-controller="Zahtjevi" asp-action="Index" asp-route-id="1">Zahtjevi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Uvjerenja" asp-action="Index" asp-route-id="1">Uvjerenja</a></li>
                                    <li><a class="dropdown-item" asp-controller="Dokumenti" asp-action="Index" asp-route-id="1">Dokumenti</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Obavjestenja" asp-action="Index">Obavještenja</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container footer-container">
            <!-- Informacije u footeru -->
            <div class="footer-info">
                <p class="text-muted">&copy; 2024 - StudentHub</p>
                <p class="text-muted">Kontakt: info@studenthub.com | Telefon: +387-33-123-456</p>
            </div>

            <!-- Mapa u footeru -->
            <div class="footer-map">
                <div id="map"></div>
            </div>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Popper.js -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>

    <!-- Bootstrap 4 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script>
        // Inicijalizacija mape
        $(document).ready(function() {
            var map = L.map('map').setView([44.199135, 17.903445], 17);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

            L.marker([44.199135, 17.903445]).addTo(map)
                .bindPopup('<b>Mašinski fakultet Zenica</b><br>Univerzitet u Zenici')
                .openPopup();

            // Inicijalizacija tooltipova
            $('[data-toggle="tooltip"]').tooltip({
                trigger: 'hover',
                placement: 'auto'
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>