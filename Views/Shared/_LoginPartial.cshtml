@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav ml-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        var korisnik = await UserManager.GetUserAsync(User);
        var uloge = korisnik != null ? await UserManager.GetRolesAsync(korisnik) : new List<string>();

        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Upravljanje nalogom">
                Zdravo @User.Identity?.Name!
            </a>
        </li>

        @if (uloge.Contains("Studentska služba"))
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-expanded="false">
                    Dodaj korisnika
                </a>
                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                    <li>
                        <a class="dropdown-item" asp-controller="Studenti" asp-action="Create">Dodaj studenta</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Profesori" asp-action="Create">Dodaj profesora</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Asistenti" asp-action="Create">Dodaj asistenta</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="StudentskaSluzba" asp-action="Create">Dodaj člana studentske službe</a>
                    </li>
                </ul>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Odjavi se</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Prijava</a>
        </li>
    }
</ul>
