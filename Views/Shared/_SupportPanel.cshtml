<!-- Floating Support Button -->
<button id="supportFab" aria-label="Podrška" class="support-fab" type="button" title="Podrška korisnicima">
    <i class="fas fa-comments"></i>
</button>

<!-- Support Panel -->
<div id="supportPanel" class="support-panel d-none" role="dialog" aria-modal="true" tabindex="-1">
    <div class="support-panel-content">
        <button id="supportPanelClose" aria-label="Zatvori" class="support-close-btn" type="button">&times;</button>
        <h4 class="mb-3 d-flex align-items-center gap-2">
            <i class="fas fa-hands-helping text-success"></i> <span>Podrška korisnicima</span>
        </h4>
        <ul class="nav nav-tabs mb-3 border-0" id="supportTabNav" role="tablist">
            <li class="nav-item flex-fill text-center">
                <button class="nav-link active" id="tab-chatbot" data-bs-toggle="tab" data-bs-target="#tabChatbot" type="button" role="tab">
                    <i class="fas fa-robot"></i> AI Chatbot
                </button>
            </li>
            <li class="nav-item flex-fill text-center">
                <button class="nav-link" id="tab-upit" data-bs-toggle="tab" data-bs-target="#tabUpit" type="button" role="tab">
                    <i class="fas fa-envelope"></i> Upit službi
                </button>
            </li>
            <li class="nav-item flex-fill text-center">
                <button class="nav-link" id="tab-bug" data-bs-toggle="tab" data-bs-target="#tabBug" type="button" role="tab">
                    <i class="fas fa-bug"></i> Bug/Poboljšanje
                </button>
            </li>
        </ul>
        <div class="tab-content" id="supportTabContent">
            <!-- AI Chatbot TAB -->
            <div class="tab-pane fade show active" id="tabChatbot" role="tabpanel">
                <div id="chatbotArea">
                    <div id="chatbotMessages" class="mb-3 chatbot-messages"></div>
                    <form id="chatbotForm" autocomplete="off" class="d-flex align-items-center gap-2">
                        <input type="text" class="form-control chatbot-input" id="chatbotInput" placeholder="Postavite pitanje...">
                        <button class="btn btn-success" id="chatbotSend" type="submit" aria-label="Pošalji">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
                <div class="chatbot-tip text-muted mt-2">
                    <i class="fas fa-info-circle"></i> AI chatbot odgovara iz baze znanja, FAQ-a i pravilnika. Ako ne pronađe odgovor, vaše pitanje ide službi!
                </div>
                <script>
                    $(function () {
                        function appendMessage(html, align = "left") {
                            const wrap = `<div class='mb-2 d-flex ${align === "right" ? "justify-content-end" : ""}'>
                                <div class="chat-bubble chat-bubble-${align}">${html}</div>
                            </div>`;
                            $('#chatbotMessages').append(wrap);
                            $('#chatbotMessages').scrollTop($('#chatbotMessages')[0].scrollHeight);
                        }
                        $('#chatbotForm').on('submit', function (e) {
                            e.preventDefault();
                            var q = $('#chatbotInput').val();
                            if (!q) return;
                            appendMessage("<span class='fw-bold'>Vi:</span> " + $('<div>').text(q).html(), "right");
                            $('#chatbotInput').val('');
                            appendMessage("<span class='text-muted'><i class='fas fa-spinner fa-spin'></i> Chatbot piše odgovor...</span>", "left");
                            $.ajax({
                                url: '/api/Chatbot/Ask',
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ question: q }),
                                success: function (res) {
                                    $('#chatbotMessages .chat-bubble-left:last').parent().remove();
                                    appendMessage(
                                        "<span class='fw-bold text-success'>Bot:</span> " +
                                        $('<div>').text(res.answer).html() +
                                        (res.source ? `<br><small class='text-muted'><i class='fas fa-book'></i> Izvor: ${res.source}</small>` : ""),
                                        "left"
                                    );
                                },
                                error: function () {
                                    $('#chatbotMessages .chat-bubble-left:last').parent().remove();
                                    appendMessage("<span class='text-danger'>Došlo je do greške. Pokušajte ponovo.</span>", "left");
                                }
                            });
                        });
                    });
                </script>
            </div>

            <!-- Upit službi TAB -->
            <div class="tab-pane fade" id="tabUpit" role="tabpanel">
                <div class="d-grid gap-2 mb-2">
                    <a href="@Url.Action("Create", "Podrska")" class="btn btn-primary support-loader-btn" id="supportUpitBtn">
                        <span class="btn-text"><i class="fas fa-envelope-open-text"></i> Pošalji upit studentskoj službi</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </a>
                    <a href="@Url.Action("Index", "Podrska")" class="btn btn-outline-secondary">
                        <i class="fas fa-list"></i> Moji upiti i odgovori
                    </a>
                </div>
                <div class="alert alert-light border-0 p-2 mb-0 small">
                    Za sva pitanja ili zahtjeve, kontaktirajte studentsku službu putem ovog formulara.<br>
                    Svoje prethodne upite možete pregledati klikom na dugme iznad.
                </div>
            </div>

            <!-- Bug/Poboljšanje TAB -->
            <div class="tab-pane fade" id="tabBug" role="tabpanel">
                <div class="d-grid gap-2 mb-2">
                    <a href="@Url.Action("Create", "BugReport")" class="btn btn-danger support-loader-btn" id="supportBugBtn">
                        <span class="btn-text"><i class="fas fa-bug"></i> Prijavi grešku ili predloži poboljšanje</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </a>
                    <a href="@Url.Action("Index", "BugReport")" class="btn btn-outline-secondary">
                        <i class="fas fa-list"></i> Moje prijave bugova/poboljšanja
                    </a>
                </div>
                <div class="alert alert-light border-0 p-2 mb-0 small">
                    Pomozite nam da unaprijedimo sistem – prijavite uočenu grešku ili dajte prijedlog!<br>
                    Svoje prijave i njihov status pratite klikom na dugme iznad.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Pamćenje zadnjeg taba ---
        document.querySelectorAll('#supportTabNav .nav-link').forEach(function(tab){
            tab.addEventListener('shown.bs.tab', function (event) {
                localStorage.setItem('supportPanelTab', event.target.id);
                if(event.target.id === "tab-chatbot") {
                    setTimeout(() => document.getElementById('chatbotInput').focus(), 120);
                }
            });
        });
        document.addEventListener('DOMContentLoaded', function() {
            var savedTab = localStorage.getItem('supportPanelTab');
            if(savedTab) {
                var tabBtn = document.getElementById(savedTab);
                if(tabBtn) new bootstrap.Tab(tabBtn).show();
            }
        });

        // --- Otvaranje/skrivanje panela i FAB-a ---
        document.getElementById('supportFab').onclick = function() {
            document.getElementById('supportPanel').classList.remove('d-none');
            document.getElementById('supportFab').style.display = 'none';
            setTimeout(() => document.getElementById('supportPanel').focus(), 200);
        };
        document.getElementById('supportPanelClose').onclick = function() {
            document.getElementById('supportPanel').classList.add('d-none');
            document.getElementById('supportFab').style.display = 'flex';
        };
        document.addEventListener('keydown', function(e){
            if(e.key === "Escape" && !document.getElementById('supportPanel').classList.contains('d-none')){
                document.getElementById('supportPanelClose').click();
            }
        });
        document.getElementById('supportPanel').addEventListener('click', function(e){
            if(e.target === this) document.getElementById('supportPanelClose').click();
        });

        // --- Loader na dugmad (Upit i Bug) ---
        document.querySelectorAll('.support-loader-btn').forEach(function(btn){
            btn.addEventListener('click', function(e){
                btn.querySelector('.btn-text').style.display = 'none';
                btn.querySelector('.spinner-border').classList.remove('d-none');
                // Ako koristiš AJAX ovdje ide .then()/.finally() za vraćanje dugmeta
            });
        });
    </script>
}
