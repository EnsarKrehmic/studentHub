@model List<StudentHub.ViewModels.IzborniPredmetStatistikaGroupedViewModel>

@{
    ViewData["Title"] = "Statistika izbornih predmeta";
}

<h2 class="mb-4">
    <i class="fas fa-chart-bar"></i> @ViewData["Title"]
</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Trenutno nema podataka o izboru izbornih predmeta.
    </div>
}
else
{
    @foreach (var programGroup in Model)
    {
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-graduation-cap"></i> @programGroup.StudijskiProgramNaziv</h4>
            </div>
            <div class="card-body">
                @foreach (var godinaGroup in programGroup.GodineStudija)
                {
                    <h5 class="mt-3 text-secondary">
                        <i class="fas fa-calendar-alt"></i> Godina: @godinaGroup.GodinaStudija
                        <span class="badge badge-info ml-2">
                            @godinaGroup.Statistika.Count predmet(a)
                        </span>
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle">
                            <thead class="thead-light">
                                <tr>
                                    <th>Predmet</th>
                                    <th>Broj studenata</th>
                                    <th>Procenat (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in godinaGroup.Statistika)
                                {
                                    <tr class="@(item.Procenat >= 50 ? "table-success" : item.Procenat >= 30 ? "table-warning" : "")">
                                        <td>@item.NazivPredmeta</td>
                                        <td>@item.BrojStudenata</td>
                                        <td>@item.Procenat.ToString("F2")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left"></i> Nazad na akademske podatke
</a>
