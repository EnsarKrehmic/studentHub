@model StudentHub.ViewModels.BirajIzbornePredmeteViewModel

@{
    ViewData["Title"] = "Biraj izborne predmete";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-book-open me-2"></i>@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <dl class="row small">
                        <dt class="col-5 col-md-4">Student:</dt>
                        <dd class="col-7 col-md-8">@Model.ImePrezime</dd>
                        <dt class="col-5 col-md-4">Studijski program:</dt>
                        <dd class="col-7 col-md-8">@Model.StudijskiProgramNaziv</dd>
                        <dt class="col-5 col-md-4">Godina studija:</dt>
                        <dd class="col-7 col-md-8">@Model.GodinaStudija</dd>
                        <dt class="col-5 col-md-4">Dozvoljeno izbornih predmeta:</dt>
                        <dd class="col-7 col-md-8">min @Model.MinIzborniPredmeti &ndash; max @Model.MaxIzborniPredmeti</dd>
                    </dl>

                    @if (Model.IsLocked)
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="fas fa-lock"></i> Vaš izbor izbornih predmeta je <strong>zaključan</strong>. Nije moguće vršiti izmjene.
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    @if (!Model.IsLocked)
                    {
                        <form asp-action="BirajIzbornePredmete" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="StudentId" />
                            <input type="hidden" asp-for="GodinaStudija" />
                            <input type="hidden" asp-for="StudijskiProgramId" />
                            <input type="hidden" asp-for="StudijskiProgramNaziv" />
                            <input type="hidden" asp-for="MinIzborniPredmeti" />
                            <input type="hidden" asp-for="MaxIzborniPredmeti" />
                            <input type="hidden" asp-for="BrojVecOdabranihPredmeta" />

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:70px;">Odaberi</th>
                                            <th>Naziv predmeta</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Predmeti)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox"
                                                           name="SelectedPredmetiIds"
                                                           value="@p.PredmetId"
                                                           @(p.IsSelected ? "checked" : "")
                                                           @(Model.IsMaxLimitReached && !p.IsSelected ? "disabled" : "") />
                                                </td>
                                                <td>@p.Naziv</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="alert alert-info mt-3 d-flex align-items-center gap-2" id="selectedCounter">
                                <i class="fas fa-check-circle text-primary"></i>
                                Odabrano: <span id="selectedCount">@Model.BrojVecOdabranihPredmeta</span> / @Model.MaxIzborniPredmeti
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Spremi izbor
                                </button>
                                <a asp-controller="Studenti" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Odustani
                                </a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="card mt-4 shadow-sm">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0"><i class="fas fa-list"></i> Odabrani izborni predmeti</h5>
                            </div>
                            <div class="card-body">
                                @if (Model.Predmeti.Any(p => p.IsSelected))
                                {
                                    <ul class="list-group">
                                        @foreach (var p in Model.Predmeti.Where(p => p.IsSelected))
                                        {
                                            <li class="list-group-item">
                                                <i class="fas fa-book me-1 text-primary"></i> @p.Naziv
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted">Niste odabrali nijedan izborni predmet.</p>
                                }
                            </div>
                        </div>
                        <a asp-controller="Studenti" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-secondary mt-3">
                            <i class="fas fa-arrow-left"></i> Nazad na detalje studenta
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var maxIzborni = @Model.MaxIzborniPredmeti;

            function updateCounter() {
                var selectedCount = $('input[type="checkbox"][name="SelectedPredmetiIds"]:checked').length;
                $('#selectedCount').text(selectedCount);

                // Disable other checkboxes if max reached
                if (selectedCount >= maxIzborni) {
                    $('input[type="checkbox"][name="SelectedPredmetiIds"]').not(':checked').attr('disabled', true);
                    $('button[type="submit"]').attr('disabled', true);
                } else {
                    $('input[type="checkbox"][name="SelectedPredmetiIds"]').not(':checked').removeAttr('disabled');
                    $('button[type="submit"]').removeAttr('disabled');
                }
            }
            updateCounter();
            $('input[type="checkbox"][name="SelectedPredmetiIds"]').on('change', updateCounter);
        });
    </script>
}
