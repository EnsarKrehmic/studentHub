@model StudentHub.ViewModels.StudentCreateViewModel
@{
    ViewData["Title"] = "Dodaj novog studenta";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <h5 class="mt-2">Prijava</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="E-mail adresa" />
                        <small class="form-text text-muted">Unesite službeni e-mail.</small>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Lozinka" />
                        <small class="form-text text-muted">Min. 6 karaktera.</small>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Ponovite lozinku" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <h5>Podaci o studentu</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="JMBG" class="form-label"></label>
                        <input asp-for="JMBG" class="form-control" placeholder="JMBG" maxlength="13" />
                        <small class="form-text text-muted">13 cifara.</small>
                        <span asp-validation-for="JMBG" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BrojIndeksa" class="form-label"></label>
                        <input asp-for="BrojIndeksa" class="form-control" placeholder="Broj indeksa" />
                        <small class="form-text text-muted">npr. 2023/001</small>
                        <span asp-validation-for="BrojIndeksa" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ime" class="form-label"></label>
                        <input asp-for="Ime" class="form-control" placeholder="Ime" maxlength="50" />
                        <span asp-validation-for="Ime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Prezime" class="form-label"></label>
                        <input asp-for="Prezime" class="form-control" placeholder="Prezime" maxlength="50" />
                        <span asp-validation-for="Prezime" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="PrethodnoObrazovanje" class="form-label"></label>
                        <input asp-for="PrethodnoObrazovanje" class="form-control" placeholder="Prethodno obrazovanje" maxlength="200" />
                        <small class="form-text text-muted">npr. gimnazija, tehnička škola</small>
                        <span asp-validation-for="PrethodnoObrazovanje" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="GodinaStudija" class="form-label"></label>
                        <input asp-for="GodinaStudija" class="form-control" type="number" min="1" max="6" placeholder="Godina (1–6)" />
                        <span asp-validation-for="GodinaStudija" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Semestar" class="form-label"></label>
                        <input asp-for="Semestar" class="form-control" type="number" min="1" max="2" placeholder="Semestar (1–2)" />
                        <span asp-validation-for="Semestar" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StudijskiProgramId" class="form-label"></label>
                        <select asp-for="StudijskiProgramId" class="form-select" asp-items="ViewBag.StudijskiProgrami"></select>
                        <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NastavniPlanId" class="form-label"></label>
                        <select asp-for="NastavniPlanId" class="form-select" asp-items="ViewBag.NastavniPlanovi">
                            <option value="">-- Odaberite --</option>
                        </select>
                        <span asp-validation-for="NastavniPlanId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PredmetIds" class="form-label"></label>
                        <select asp-for="PredmetIds" class="form-select" asp-items="ViewBag.Predmeti" multiple></select>
                        <small class="form-text text-muted">Više predmeta: <kbd>Ctrl</kbd> ili <kbd>Cmd</kbd></small>
                        <span asp-validation-for="PredmetIds" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-user-plus me-1"></i> Dodaj studenta
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const ddlProgram = document.getElementById('StudijskiProgramId');
            const ddlPlan = document.getElementById('NastavniPlanId');
            const ddlPredmeti = document.getElementById('PredmetIds');
            const txtGodina = document.getElementById('GodinaStudija');
            const txtSemestar = document.getElementById('Semestar');

            function fillSelect(select, items, includeEmptyOption) {
                select.innerHTML = includeEmptyOption ? '<option value="">-- Odaberite --</option>' : '';
                items.forEach(p => select.add(new Option(p.naziv, p.id)));
            }

            async function loadPlans(programId) {
                if (!programId) {
                    fillSelect(ddlPlan, [], true);
                    return [];
                }
                const res = await fetch(`/Studenti/GetNastavniPlanovi/${programId}`);
                const plans = await res.json();
                fillSelect(ddlPlan, plans, true);
                return plans; // sadrži i { godinaStudija }
            }

            async function loadSubjects(programId, godina, semestar) {
                if (!programId) { ddlPredmeti.innerHTML = ''; return; }
                const params = new URLSearchParams();
                if (godina) params.set('godinaStudija', godina);
                if (semestar) params.set('semestar', semestar);
                const res = await fetch(`/Studenti/GetPredmetiByStudijskiProgram/${programId}?` + params.toString());
                const preds = await res.json();
                ddlPredmeti.innerHTML = '';
                preds.forEach(p => ddlPredmeti.add(new Option(p.naziv, p.id)));
            }

            async function onProgramChange() {
                const pid = ddlProgram.value;
                const plans = await loadPlans(pid);

                // ako je popunjena godina → auto-odaberi plan s tom godinom
                const godina = txtGodina.value;
                if (godina && plans && plans.length) {
                    const match = plans.find(p => (p.godinaStudija + '') === (godina + ''));
                    if (match) ddlPlan.value = match.id;
                }

                await loadSubjects(pid, godina, txtSemestar.value);
            }

            async function onGodinaChange() {
                const pid = ddlProgram.value;
                if (!pid) return;

                // planovi pa auto-match po godini
                const plans = await loadPlans(pid);
                const godina = txtGodina.value;
                const match = plans.find(p => (p.godinaStudija + '') === (godina + ''));
                if (match) ddlPlan.value = match.id;

                await loadSubjects(pid, godina, txtSemestar.value);
            }

            async function onSemestarChange() {
                const pid = ddlProgram.value;
                if (!pid) return;
                await loadSubjects(pid, txtGodina.value, txtSemestar.value);
            }

            ddlProgram?.addEventListener('change', onProgramChange);
            txtGodina?.addEventListener('input', onGodinaChange);
            txtSemestar?.addEventListener('input', onSemestarChange);
        })();
    </script>
}
