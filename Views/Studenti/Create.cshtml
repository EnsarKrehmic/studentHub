@model StudentHub.ViewModels.StudentCreateViewModel

@{
    ViewData["Title"] = "Dodaj novog studenta";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <!-- Identity podaci -->
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="control-label"></label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword" class="control-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <!-- Poslovni podaci -->
    <div class="form-group">
        <label asp-for="JMBG" class="control-label"></label>
        <input asp-for="JMBG" class="form-control" />
        <span asp-validation-for="JMBG" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Ime" class="control-label"></label>
        <input asp-for="Ime" class="form-control" />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Prezime" class="control-label"></label>
        <input asp-for="Prezime" class="form-control" />
        <span asp-validation-for="Prezime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BrojIndeksa" class="control-label"></label>
        <input asp-for="BrojIndeksa" class="form-control" />
        <span asp-validation-for="BrojIndeksa" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PrethodnoObrazovanje" class="control-label"></label>
        <input asp-for="PrethodnoObrazovanje" class="form-control" />
        <span asp-validation-for="PrethodnoObrazovanje" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="GodinaStudija" class="control-label"></label>
        <input asp-for="GodinaStudija" class="form-control" />
        <span asp-validation-for="GodinaStudija" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Semestar" class="control-label"></label>
        <input asp-for="Semestar" class="form-control" />
        <span asp-validation-for="Semestar" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="StudijskiProgramId">Studijski program</label>
        <select asp-for="StudijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgrami"></select>
        <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="NastavniPlanId">Nastavni plan</label>
        <select asp-for="NastavniPlanId" class="form-control" asp-items="ViewBag.NastavniPlanovi"></select>
        <span asp-validation-for="NastavniPlanId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="PredmetIds">Predmeti</label>
        <select asp-for="PredmetIds" class="form-control" asp-items="ViewBag.Predmeti" id="PredmetIds" multiple="multiple"></select>
        <span asp-validation-for="PredmetIds" class="text-danger"></span>
    </div>

    <!-- Submit dugmad -->
    <div class="form-group">
        <input type="submit" value="Dodaj studenta" class="btn btn-primary mt-3" />
        <a asp-action="Index" class="btn btn-secondary mt-3">Odustani</a>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('StudijskiProgramId').addEventListener('change', function () {
            var selectedProgramId = this.value;

            // Dohvatanje nastavnih planova
            fetch('/Studenti/GetNastavniPlanovi/' + selectedProgramId)
                .then(response => response.json())
                .then(data => {
                    var nastavniPlanSelect = document.getElementById('NastavniPlanId');
                    nastavniPlanSelect.innerHTML = '<option value="">-- Odaberite nastavni plan --</option>';
                    data.forEach(plan => {
                        var option = document.createElement('option');
                        option.value = plan.id;
                        option.text = plan.naziv;
                        nastavniPlanSelect.appendChild(option);
                    });
                });

            // Dohvatanje predmeta
            fetch('/Studenti/GetPredmetiByStudijskiProgram/' + selectedProgramId)
                .then(response => response.json())
                .then(data => {
                    var predmetSelect = document.getElementById('PredmetIds');
                    predmetSelect.innerHTML = '';
                    data.forEach(predmet => {
                        var option = document.createElement('option');
                        option.value = predmet.id;
                        option.text = predmet.naziv;
                        predmetSelect.appendChild(option);
                    });
                });
        });
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
