@model StudentHub.Models.Student

@{
    ViewData["Title"] = "Brisanje studenta";

    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovog studenta?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o studentu.";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Ime"] = Model.Ime,
        ["Prezime"] = Model.Prezime,
        ["JMBG"] = Model.JMBG,
        ["Email"] = Model.Email,
        ["Broj indeksa"] = Model.BrojIndeksa,
        ["Godina studija"] = $"<span class=\"badge bg-primary\">{Model.GodinaStudija}</span>",
        ["Semestar"] = $"<span class=\"badge bg-info text-dark\">{Model.Semestar}</span>",
        ["Uloga"] = Model.Uloga
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
