@model StudentHub.Models.Student

@{
    ViewData["Title"] = "Brisanje studenta";
}

<h2>@ViewData["Title"]</h2>

<h3>Da li ste sigurni da želite obrisati ovog studenta?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Ime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Prezime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Prezime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.JMBG)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.JMBG)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.JMBG)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.JMBG)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.studijskiProgram)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.studijskiProgram)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.predhodnoObrazovanje)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.predhodnoObrazovanje)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.podaciUplata)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.podaciUplata)</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="JMBG" />
    <button type="submit" class="btn btn-danger">Obriši</button> |
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>
