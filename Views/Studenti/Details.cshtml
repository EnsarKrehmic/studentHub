@model StudentHub.ViewModels.StudentDetailsViewModel

@{
    ViewData["Title"] = "Detalji studenta";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="container">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Podaci o studentu</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-primary">Osnovni podaci</h5>
                    <p><strong>Ime i prezime:</strong> @Model.Student.Ime @Model.Student.Prezime</p>
                    <p><strong>Email:</strong> @Model.Student.Email</p>
                    <p><strong>Broj indeksa:</strong> @Model.Student.BrojIndeksa</p>
                    <p><strong>Godina studija:</strong> @Model.Student.GodinaStudija</p>
                    <p><strong>Semestar:</strong> @Model.Student.Semestar</p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-primary">Dodatne informacije</h5>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <p><strong>JMBG:</strong> @Model.Student.JMBG</p>
                    }
                    <p><strong>Uloga:</strong> @Model.Student.Uloga</p>
                    <p>
                        <strong>Studijski program:</strong>
                        @(Model.Student.StudentStudijskiProgrami.FirstOrDefault()?.StudijskiProgram?.Naziv ?? "Nepoznato")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h3>Predmeti koje student pohađa</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Naziv predmeta</th>
                        <th>ECTS</th>
                        <th>Semestar</th>
                        <th>Ocjena</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snp in Model.Student.StudentNaPredmetima)
                    {
                        var predmet = snp.Predmet;
                        <tr>
                            <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@predmet.Id" class="text-decoration-none">
                            <td>@predmet.Naziv</td>
                            </a>
                            <td>@predmet.ECTS</td>
                            <td>@predmet.Semestar</td>
                            <td>
                                @if (Model.Ocjene.TryGetValue(predmet.Id, out var ocjena))
                                {
                                    <span class="badge @(ocjena >= 8 ? "bg-success" : ocjena >= 6 ? "bg-warning" : "bg-danger")">
                                        @ocjena
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning">Nema ocjene</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Student.Id" class="btn btn-warning">Izmjena</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
