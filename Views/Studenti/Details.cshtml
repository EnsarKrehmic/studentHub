@model StudentHub.ViewModels.StudentDetailsViewModel

@{
    ViewData["Title"] = "Detalji studenta";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>@Model.Student.Ime @Model.Student.Prezime</h4>
    <p>JMBG: @Model.Student.JMBG</p>
    <p>Email: @Model.Student.Email</p>
    <p>Broj Indeksa: @Model.Student.BrojIndeksa</p>
    <p>Godina Studija: @Model.Student.GodinaStudija</p>
    <p>Semestar: @Model.Student.Semestar</p>
    <p>Studijski Program: @Model.Student.StudijskiProgram.Naziv</p>
</div>

<div class="mt-4">
    <h4>Predmeti koje student pohađa</h4>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Naziv Predmeta</th>
                <th>Opis</th>
                <th>ECTS</th>
                <th>Semestar</th>
                <th>Ocjena</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var predmet in Model.Predmeti)
            {
                <tr>
                    <td>@predmet.Naziv</td>
                    <td>@predmet.Opis</td>
                    <td>@predmet.ECTS</td>
                    <td>@predmet.Semestar</td>
                    <td>
                        @if (Model.Ocjene.ContainsKey(predmet.Id))
                        {
                            @Model.Ocjene[predmet.Id]
                        }
                        else
                        {
                            <span class="text-warning">Nema ocjene</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a href="@Url.Action("Index", "Studenti")" class="btn btn-secondary">Povratak na listu studenata</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
