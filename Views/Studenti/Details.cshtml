@model StudentHub.ViewModels.StudentDetailsViewModel
@{
    ViewData["Title"] = "Detalji studenta";
}

<div class="card shadow-sm mb-4 mx-auto" style="max-width: 960px;">
    <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fas fa-user-graduate me-2"></i>
        <h2 class="mb-0">@ViewData["Title"]</h2>
    </div>
    <div class="card-body">
        <div class="row gy-4">
            <div class="col-md-6">
                <h5 class="text-primary mb-3"><i class="fas fa-id-badge me-2"></i>Osnovni podaci</h5>
                <dl class="row">
                    <dt class="col-5">Ime i prezime:</dt>
                    <dd class="col-7 fw-bold">@Model.Student.Ime @Model.Student.Prezime</dd>
                    <dt class="col-5">Email:</dt>
                    <dd class="col-7">@Model.Student.Email</dd>
                    <dt class="col-5">Broj indeksa:</dt>
                    <dd class="col-7">@Model.Student.BrojIndeksa</dd>
                    <dt class="col-5">Godina studija:</dt>
                    <dd class="col-7"><span class="badge bg-primary">@Model.Student.GodinaStudija</span></dd>
                    <dt class="col-5">Semestar:</dt>
                    <dd class="col-7"><span class="badge bg-info text-dark">@Model.Student.Semestar</span></dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="text-primary mb-3"><i class="fas fa-info-circle me-2"></i>Dodatne informacije</h5>
                <dl class="row">
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <dt class="col-6">JMBG:</dt>
                        <dd class="col-6">@Model.Student.JMBG</dd>
                    }
                    <dt class="col-6">Uloga:</dt>
                    <dd class="col-6">@Model.Student.Uloga</dd>
                    <dt class="col-6">Studijski program:</dt>
                    <dd class="col-6">
                        <span class="badge bg-secondary">
                            @(Model.Student.StudentStudijskiProgrami.FirstOrDefault()?.StudijskiProgram?.Naziv ?? "Nepoznato")
                        </span>
                    </dd>
                    <dt class="col-6">Izbor iz. predmeta:</dt>
                    <dd class="col-6">
                        @if (Model.Student.IzborIzbornihPredmetaZakljucan)
                        {
                            <span class="badge bg-danger">Zaključano</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Otključano</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (Model.StudijskiProgramIzborniLimit != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <i class="fas fa-list-ol me-2"></i>Izborni predmeti – Pregled odabira
        </div>
        <div class="card-body">
            <p><strong>Limit za izborne predmete:</strong> min @Model.StudijskiProgramIzborniLimit.MinIzborniPredmeti / max @Model.StudijskiProgramIzborniLimit.MaxIzborniPredmeti</p>
            @if (Model.Student.StudentNaPredmetima.Any(snp => snp.Predmet.TipPredmeta == TipPredmeta.Izborni))
            {
                <table class="table table-sm table-bordered table-hover shadow-sm mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>Naziv predmeta</th>
                            <th>ECTS</th>
                            <th>Semestar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var snp in Model.Student.StudentNaPredmetima.Where(snp => snp.Predmet.TipPredmeta == TipPredmeta.Izborni))
                        {
                            <tr>
                                <td>@snp.Predmet.Naziv</td>
                                <td>@snp.Predmet.ECTS</td>
                                <td>@snp.Predmet.Semestar</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mt-2 small">
                    Ukupno odabranih izbornih predmeta:
                    <span class="fw-bold">@Model.Student.StudentNaPredmetima.Count(snp => snp.Predmet.TipPredmeta == TipPredmeta.Izborni)</span>
                    /
                    <span class="fw-bold">@Model.StudijskiProgramIzborniLimit.MaxIzborniPredmeti</span>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Trenutno niste odabrali nijedan izborni predmet.
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-warning mb-4">
        <i class="fas fa-exclamation-circle"></i>
        Nije definisan limit za izborne predmete za ovaj studijski program i godinu studenta.
    </div>
}

@if (User.IsInRole("Student"))
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <i class="fas fa-cog me-2"></i>Mogućnosti studenta
        </div>
        <div class="card-body">
            <p>Možete odabrati izborne predmete za trenutnu akademsku godinu:</p>
            <a class="btn btn-primary btn-lg" asp-controller="Studenti" asp-action="BirajIzbornePredmete">
                <i class="fas fa-book-open"></i> Biraj izborne predmete
            </a>
        </div>
    </div>
}

@if (User.IsInRole("Studentska služba"))
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-user-shield me-2"></i>Administracija izbora izbornih predmeta
        </div>
        <div class="card-body">
            @if (Model.Student.IzborIzbornihPredmetaZakljucan)
            {
                <form asp-action="OtkjucajIzborIzbornihPredmeta" asp-route-id="@Model.Student.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-lock-open"></i> Otključaj izbor izbornih predmeta
                    </button>
                </form>
            }
            else
            {
                <form asp-action="ZakljucajIzborIzbornihPredmeta" asp-route-id="@Model.Student.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-lock"></i> Zaključaj izbor izbornih predmeta
                    </button>
                </form>
            }
        </div>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white">
        <i class="fas fa-book me-2"></i>Predmeti koje student pohađa
    </div>
    <div class="card-body p-0">
        <table class="table table-bordered table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Naziv predmeta</th>
                    <th>ECTS</th>
                    <th>Semestar</th>
                    <th>Ocjena</th>
                    <th>Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var snp in Model.Student.StudentNaPredmetima)
                {
                    var predmet = snp.Predmet;
                    <tr>
                        <td>
                            <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@predmet.Id" class="text-decoration-none">
                                @predmet.Naziv
                            </a>
                        </td>
                        <td>@predmet.ECTS</td>
                        <td>@predmet.Semestar</td>
                        <td>
                            @{
                                var ocjenaVM = Model.OcjenePredmeta.FirstOrDefault(o => o.PredmetId == predmet.Id && o.Tip == "Predmet");
                            }
                            @if (ocjenaVM != null)
                            {
                                <span class="badge @(ocjenaVM.Vrijednost >= 8 ? "bg-success" : ocjenaVM.Vrijednost >= 6 ? "bg-warning" : "bg-danger")">
                                    @ocjenaVM.Vrijednost
                                </span>
                            }
                            else
                            {
                                <span class="text-warning">Nema ocjene</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Predmeti" asp-action="StudentDetails"
                                   asp-route-predmetId="@predmet.Id"
                                   asp-route-studentId="@Model.Student.Id"
                                   class="btn btn-outline-primary btn-sm"
                                   title="Detalji o prisustvu i ocjenama za ovaj predmet">
                                    <i class="fas fa-user-graduate"></i>
                                </a>
                                <a asp-controller="Predmeti" asp-action="Details"
                                   asp-route-id="@predmet.Id"
                                   class="btn btn-outline-secondary btn-sm"
                                   title="Pogledaj sve informacije o predmetu">
                                    <i class="fas fa-book-open"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex gap-2 mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Student.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Izmjena
        </a>
    }
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Nazad na listu
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
