@model StudentHub.ViewModels.StudentDetailsViewModel

@{
    ViewData["Title"] = "Detalji studenta";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="container">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Podaci o studentu</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-primary">Osnovni podaci</h5>
                    <p><strong>Ime i prezime:</strong> @Model.Student.Ime @Model.Student.Prezime</p>
                    <p><strong>Email:</strong> @Model.Student.Email</p>
                    <p><strong>Broj indeksa:</strong> @Model.Student.BrojIndeksa</p>
                    <p><strong>Godina studija:</strong> @Model.Student.GodinaStudija</p>
                    <p><strong>Semestar:</strong> @Model.Student.Semestar</p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-primary">Dodatne informacije</h5>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <p><strong>JMBG:</strong> @Model.Student.JMBG</p>
                    }
                    <p><strong>Uloga:</strong> @Model.Student.Uloga</p>
                    <p>
                        <strong>Studijski program:</strong>
                        @(Model.Student.StudentStudijskiProgrami.FirstOrDefault()?.StudijskiProgram?.Naziv ?? "Nepoznato")
                    </p>
                    <p>
                        <strong>Status izbora izbornih predmeta:</strong>
                        @if (Model.Student.IzborIzbornihPredmetaZakljucan)
                        {
                            <span class="badge badge-danger">Zaključano</span>
                        }
                        else
                        {
                            <span class="badge badge-success">Otključano</span>
                        }
                    </p>

                    @if (Model.StudijskiProgramIzborniLimit != null)
                    {
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-info text-white">
                                <h3>Izborni predmeti - Pregled odabira</h3>
                            </div>
                            <div class="card-body">
                                <p><strong>Limit za izborne predmete:</strong> min @Model.StudijskiProgramIzborniLimit.MinIzborniPredmeti / max @Model.StudijskiProgramIzborniLimit.MaxIzborniPredmeti</p>
                                @if (Model.Student.StudentNaPredmetima.Any(snp => snp.Predmet.TipPredmeta == TipPredmeta.Izborni))
                                {
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Naziv predmeta</th>
                                                <th>ECTS</th>
                                                <th>Semestar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var snp in Model.Student.StudentNaPredmetima
                                                      .Where(snp => snp.Predmet.TipPredmeta == TipPredmeta.Izborni))
                                            {
                                                <tr>
                                                    <td>@snp.Predmet.Naziv</td>
                                                    <td>@snp.Predmet.ECTS</td>
                                                    <td>@snp.Predmet.Semestar</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    <p class="mt-2">
                                        Ukupno odabranih izbornih predmeta: 
                                        <strong>@Model.Student.StudentNaPredmetima.Count(snp => snp.Predmet.TipPredmeta == TipPredmeta.Izborni)</strong> / 
                                        <strong>@Model.StudijskiProgramIzborniLimit.MaxIzborniPredmeti</strong>
                                    </p>
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        Trenutno niste odabrali nijedan izborni predmet.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            Nije definisan limit za izborne predmete za ovaj studijski program i godinu studenta.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

    @if (User.IsInRole("Student"))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <h3>Mogućnosti studenta</h3>
            </div>
            <div class="card-body">
                <p>Možete odabrati izborne predmete za trenutnu akademsku godinu:</p>
                <a class="btn btn-primary btn-lg" asp-controller="Studenti" asp-action="BirajIzbornePredmete">
                    <i class="fas fa-book-open"></i> Biraj izborne predmete
                </a>
            </div>
        </div>
    }

    @if (User.IsInRole("Studentska služba"))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning text-dark">
                <h3>Administracija izbora izbornih predmeta</h3>
            </div>
            <div class="card-body">
                @if (Model.Student.IzborIzbornihPredmetaZakljucan)
                {
                    <form asp-action="OtkjucajIzborIzbornihPredmeta" asp-route-id="@Model.Student.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">Otključaj izbor izbornih predmeta</button>
                    </form>
                }
                else
                {
                    <form asp-action="ZakljucajIzborIzbornihPredmeta" asp-route-id="@Model.Student.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">Zaključaj izbor izbornih predmeta</button>
                    </form>
                }
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h3>Predmeti koje student pohađa</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Naziv predmeta</th>
                        <th>ECTS</th>
                        <th>Semestar</th>
                        <th>Ocjena</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snp in Model.Student.StudentNaPredmetima)
                    {
                        var predmet = snp.Predmet;
                        <tr>
                        <td>
                            <a asp-controller="Predmeti" asp-action="Details" asp-route-id="@predmet.Id" class="text-decoration-none">
                                @predmet.Naziv
                            </a>
                        </td>
                        <td>@predmet.Semestar</td>
                        <td>@predmet.ECTS</td>
                        <td>
                            @{
                                var ocjenaVM = Model.OcjenePredmeta.FirstOrDefault(o => o.PredmetId == predmet.Id && o.Tip == "Predmet");
                            }

                            @if (ocjenaVM != null)
                            {
                                <span class="badge @(ocjenaVM.Vrijednost >= 8 ? "bg-success" : ocjenaVM.Vrijednost >= 6 ? "bg-warning" : "bg-danger")">
                                    @ocjenaVM.Vrijednost
                                </span>
                            }
                            else
                            {
                                <span class="text-warning">Nema ocjene</span>
                            }
                        </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <!-- Detalji po predmetu za studenta -->
                                    <a asp-controller="Predmeti" asp-action="StudentDetails"
                                       asp-route-predmetId="@predmet.Id"
                                       asp-route-studentId="@Model.Student.Id"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Detalji o prisustvu i ocjenama za ovaj predmet">
                                        <i class="fas fa-user-graduate me-1"></i> Detalji studenta
                                    </a>

                                    <!-- Link ka predmetu -->
                                    <a asp-controller="Predmeti" asp-action="Details"
                                       asp-route-id="@predmet.Id"
                                       class="btn btn-outline-secondary btn-sm"
                                       title="Pogledaj sve informacije o predmetu">
                                        <i class="fas fa-book-open me-1"></i> Detalji predmeta
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Student.Id" class="btn btn-warning">Izmjena</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
