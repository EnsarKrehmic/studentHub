@model IEnumerable<StudentHub.Models.Student>
@{
    ViewData["Title"] = "Lista svih studenata na fakultetu";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Create" asp-controller="Studenti" class="btn btn-success shadow-sm">
                <i class="fas fa-user-plus me-2"></i> Dodaj studenta
            </a>
        }
    </div>

    <form method="get" class="card card-body shadow-sm mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text"
                       name="searchString"
                       class="form-control"
                       placeholder="Pretraga po imenu/prezimenu..."
                       value="@Context.Request.Query["searchString"]" />
            </div>
            <div class="col-md-4">
                <select name="studijskiProgramId"
                        class="form-select"
                        onchange="this.form.submit()">
                    <option value="">Svi studijski programi</option>
                    @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                    {
                        <option value="@program.Value"
                                selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">
                            @program.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Filtriraj
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-undo"></i> Reset
                </a>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["NameSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-light">
                                Ime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["SurnameSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-light">
                                Prezime <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                        {
                            <th class="no-wrap">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["JMBGSortParm"]"
                                   asp-route-searchString="@Context.Request.Query["searchString"]"
                                   asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                                   class="text-decoration-none text-light">
                                    JMBG <i class="fas fa-sort"></i>
                                </a>
                            </th>
                        }
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["EmailSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-light">
                                Email <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th class="no-wrap">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["IndexSortParm"]"
                               asp-route-searchString="@Context.Request.Query["searchString"]"
                               asp-route-studijskiProgramId="@Context.Request.Query["studijskiProgramId"]"
                               class="text-decoration-none text-light">
                                Broj indeksa <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>Semestar</th>
                        <th>Godina</th>
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                        {
                            <th>Prethodno obrazovanje</th>
                        }
                        <th class="text-center no-wrap">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="no-wrap">@s.Ime</td>
                            <td class="no-wrap">@s.Prezime</td>
                            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                            {
                                <td class="no-wrap">@s.JMBG</td>
                            }
                            <td class="no-wrap">@s.Email</td>
                            <td class="no-wrap">@s.BrojIndeksa</td>
                            <td>
                                <span class="badge bg-info text-dark">@s.Semestar</span>
                            </td>
                            <td>
                                <span class="badge bg-primary">@s.GodinaStudija</span>
                            </td>
                            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                            {
                                <td>@s.PrethodnoObrazovanje</td>
                            }
                            <td class="text-center no-wrap">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@s.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Detalji">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Studentska služba"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@s.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Uredi">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@s.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Obriši">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index"
           asp-controller="Home"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Povratak na početnu
        </a>
    </div>
</div>
