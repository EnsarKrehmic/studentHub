@model IEnumerable<StudentHub.Models.Student>

@{
    ViewData["Title"] = "Lista svih studenata na fakultetu";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="searchString" class="form-control" placeholder="Pretraga po imenu/prezimenu studenta..." value="@Context.Request.Query["searchString"]">
        </div>
        <div class="col-md-4">
            <select name="studijskiProgramId" class="form-control">
                <option value="">Svi studijski programi</option>
                @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                {
                    <option value="@program.Value" selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">@program.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <button type="submit" class="btn btn-primary me-2">Filtriraj</button>
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

@if (User.IsInRole("Studentska služba"))
{
    <a class="btn btn-success mb-3" asp-area="Identity" asp-page="/Account/Register">
        <i class="fas fa-user-plus"></i> Dodaj studenta
    </a>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                        Ime <i class="fas fa-sort"></i>
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["SurnameSortParm"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                        Prezime <i class="fas fa-sort"></i>
                    </a>
                </th>
                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                {
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["JMBGSortParm"]"
                           asp-route-searchString="@ViewData["CurrentFilter"]"
                           asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                            JMBG <i class="fas fa-sort"></i>
                        </a>
                    </th>
                }
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["EmailSortParm"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                        Email <i class="fas fa-sort"></i>
                    </a>
                </th>
                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                {
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IndexSortParm"]"
                           asp-route-searchString="@ViewData["CurrentFilter"]"
                           asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                            Broj indeksa <i class="fas fa-sort"></i>
                        </a>
                    </th>
                }
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Semestar)</th>
                <th>@Html.DisplayNameFor(model => model.FirstOrDefault().GodinaStudija)</th>
                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                {
                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().PrethodnoObrazovanje)</th>
                }
                @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                {
                    <th class="text-center">Akcije</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                    <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <td>@Html.DisplayFor(modelItem => item.JMBG)</td>
                    }
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                    {
                        <td>@Html.DisplayFor(modelItem => item.BrojIndeksa)</td>

                    }
                    <td>@Html.DisplayFor(modelItem => item.Semestar)</td>
                    <td>@Html.DisplayFor(modelItem => item.GodinaStudija)</td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <td>@Html.DisplayFor(modelItem => item.PrethodnoObrazovanje)</td>

                    }
                    <td class="text-center">
                        @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalji">
                                <i class="fas fa-eye"></i>
                            </a>
                        }
                        @if (User.IsInRole("Studentska služba"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Izmjena">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Brisanje">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
</a>