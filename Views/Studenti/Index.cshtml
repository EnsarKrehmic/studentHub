@model IEnumerable<StudentHub.Models.Student>

@{
    ViewData["Title"] = "Lista studenata";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novog studenta</a>
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Ime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Prezime)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().JMBG)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Email)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().BrojIndeksa)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().GodinaStudija)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().PredhodnoObrazovanje)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                <td>@Html.DisplayFor(modelItem => item.JMBG)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.BrojIndeksa)</td>
                <td>@Html.DisplayFor(modelItem => item.GodinaStudija)</td>
                <td>@Html.DisplayFor(modelItem => item.PredhodnoObrazovanje)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>
