@model StudentHub.ViewModels.StudentskaSluzbaCreateViewModel
@{
    ViewData["Title"] = "Dodaj člana studentske službe";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-user-shield me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <h5 class="mt-3">Prijava</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="E-mail adresa" />
                        <small class="form-text text-muted">Unesite službeni e-mail.</small>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Lozinka" />
                        <small class="form-text text-muted">Min. 6 karaktera.</small>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Ponovite lozinku" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <h5>Osobni podaci</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="JMBG" class="form-label"></label>
                        <input asp-for="JMBG" class="form-control" maxlength="13" placeholder="JMBG" />
                        <small class="form-text text-muted">13 cifara.</small>
                        <span asp-validation-for="JMBG" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ime" class="form-label"></label>
                        <input asp-for="Ime" class="form-control" placeholder="Ime" />
                        <span asp-validation-for="Ime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Prezime" class="form-label"></label>
                        <input asp-for="Prezime" class="form-control" placeholder="Prezime" />
                        <span asp-validation-for="Prezime" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="StudijskiProgramIds" class="form-label"></label>
                        <select asp-for="StudijskiProgramIds" class="form-select"
                                asp-items="ViewBag.StudijskiProgrami" multiple>
                        </select>
                        <small class="form-text text-muted">
                            Držite <kbd>Ctrl</kbd> ili <kbd>Cmd</kbd> za višestruki odabir.
                        </small>
                        <span asp-validation-for="StudijskiProgramIds" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-user-plus me-1"></i> Dodaj
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
