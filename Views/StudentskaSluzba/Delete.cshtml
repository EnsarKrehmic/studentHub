@model StudentHub.Models.StudentskaSluzba

@{
    ViewData["Title"] = "Brisanje člana studentske službe";

    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovog člana studentske službe?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o korisniku.";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Ime"] = Model.Ime,
        ["Prezime"] = Model.Prezime,
        ["JMBG"] = Model.JMBG,
        ["Email"] = Model.Email,
        ["Uloga"] = Model.Uloga
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
