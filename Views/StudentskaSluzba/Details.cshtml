@model StudentHub.ViewModels.StudentskaSluzbaDetailsViewModel

@{
    ViewData["Title"] = "Detalji člana studentske službe";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-user-cog text-primary me-2"></i> @ViewData["Title"]
        </h2>
    </div>

    <div class="row g-4">
        <!-- Podaci o osobi -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-id-card me-2"></i> Osnovni podaci
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Ime:</dt>
                        <dd class="col-sm-7">@Model.StudentskaSluzba.Ime</dd>

                        <dt class="col-sm-5">Prezime:</dt>
                        <dd class="col-sm-7">@Model.StudentskaSluzba.Prezime</dd>

                        @if (User.IsInRole("Studentska služba"))
                        {
                            <dt class="col-sm-5">JMBG:</dt>
                            <dd class="col-sm-7">@Model.StudentskaSluzba.JMBG</dd>
                        }

                        <dt class="col-sm-5">Email:</dt>
                        <dd class="col-sm-7">@Model.StudentskaSluzba.Email</dd>

                        <dt class="col-sm-5">Uloga:</dt>
                        <dd class="col-sm-7">@Model.StudentskaSluzba.Uloga</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Studijski programi -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-graduation-cap me-2"></i> Studijski programi
                </div>
                <div class="card-body">
                    @if (Model.StudijskiProgrami.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var program in Model.StudijskiProgrami)
                            {
                                <li class="list-group-item">
                                    <a asp-controller="StudijskiProgrami"
                                       asp-action="Details"
                                       asp-route-id="@program.Id"
                                       class="text-decoration-none">
                                        @program.Naziv
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Nema povezanih studijskih programa.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Dugmad -->
    <div class="mt-4 d-flex flex-wrap gap-2">
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Edit" asp-route-id="@Model.StudentskaSluzba.Id" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Izmjena
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Nazad na listu
        </a>
    </div>
</div>
