@model StudentHub.ViewModels.StudentskaSluzbaEditViewModel

@{
    ViewData["Title"] = "Izmijeni člana studentske službe";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Ime" class="form-label"></label>
                                <input asp-for="Ime" class="form-control" />
                                <span asp-validation-for="Ime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Prezime" class="form-label"></label>
                                <input asp-for="Prezime" class="form-control" />
                                <span asp-validation-for="Prezime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JMBG" class="form-label"></label>
                                <input asp-for="JMBG" class="form-control" />
                                <small class="form-text text-muted">Unesite tačno 13 cifara.</small>
                                <span asp-validation-for="JMBG" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Uloga" class="form-label"></label>
                                <select asp-for="Uloga" class="form-control" asp-items="Html.GetEnumSelectList<Uloga>()"></select>
                                <span asp-validation-for="Uloga" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="StudijskiProgramiIds" class="form-label"></label>
                                <select asp-for="StudijskiProgramiIds" class="form-control" asp-items="ViewBag.StudijskiProgrami" multiple="multiple"></select>
                                <small class="form-text text-muted">Studijski programi za koje je zadužen/a.</small>
                                <span asp-validation-for="StudijskiProgramiIds" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4">Sačuvaj promjene</button>
                            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
