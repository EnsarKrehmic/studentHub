@model StudentHub.ViewModels.StudentskaSluzbaEditViewModel

@{
    ViewData["Title"] = "Izmijeni člana studentske službe";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Ime" class="control-label"></label>
        <input asp-for="Ime" class="form-control" />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Prezime" class="control-label"></label>
        <input asp-for="Prezime" class="form-control" />
        <span asp-validation-for="Prezime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="JMBG" class="control-label"></label>
        <input asp-for="JMBG" class="form-control" />
        <span asp-validation-for="JMBG" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Uloga" class="control-label"></label>
        <select asp-for="Uloga" class="form-control" asp-items="Html.GetEnumSelectList<Uloga>()"></select>
        <span asp-validation-for="Uloga" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="StudijskiProgramiIds">Studijski programi</label>
        <select asp-for="StudijskiProgramiIds" class="form-control" asp-items="ViewBag.StudijskiProgrami" multiple></select>
    </div>
    <div class="form-group">
        <input type="submit" value="Sačuvaj promjene" class="btn btn-primary mt-3" />
        <a asp-action="Index" class="btn btn-secondary mt-3">Odustani</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}