@model StudentHub.ViewModels.StudentskaSluzbaEditViewModel
@{
    ViewData["Title"] = "Izmijeni člana studentske službe";
    Layout = "_Layout";
}
<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-user-edit me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <h5 class="mt-2">Prijava</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="E-mail adresa" />
                        <small class="form-text text-muted">Službeni e-mail.</small>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="ChangePassword" id="chkChangePassword" />
                            <label class="form-check-label" for="chkChangePassword">Želim promijeniti lozinku</label>
                        </div>
                    </div>
                    <div id="passwordFields" class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <small class="form-text text-muted">
                                Ako ne želiš mijenjati lozinku, ostavi polja na vrijednosti
                                <code>@StudentHub.ViewModels.StudentskaSluzbaEditViewModel.PasswordSentinel</code>.
                            </small>
                        </div>
                    </div>
                </div>

                <h5>Osobni podaci</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Ime" class="form-label"></label>
                        <input asp-for="Ime" class="form-control" />
                        <span asp-validation-for="Ime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Prezime" class="form-label"></label>
                        <input asp-for="Prezime" class="form-control" />
                        <span asp-validation-for="Prezime" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="JMBG" class="form-label"></label>
                        <input asp-for="JMBG" class="form-control" maxlength="13" />
                        <small class="form-text text-muted">13 cifara.</small>
                        <span asp-validation-for="JMBG" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Uloga" class="form-label"></label>
                        <select asp-for="Uloga" class="form-select" asp-items="Html.GetEnumSelectList<Uloga>()"></select>
                        <span asp-validation-for="Uloga" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="StudijskiProgramiIds" class="form-label"></label>
                        <select asp-for="StudijskiProgramiIds" class="form-select"
                                asp-items="ViewBag.StudijskiProgrami" multiple>
                        </select>
                        <small class="form-text text-muted">
                            Držite <kbd>Ctrl</kbd> ili <kbd>Cmd</kbd> za više izbora.
                        </small>
                        <span asp-validation-for="StudijskiProgramiIds" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Sačuvaj
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const chk = document.getElementById('chkChangePassword');
            const fields = document.getElementById('passwordFields');

            function toggle() {
                const enable = chk.checked;
                fields.querySelectorAll('input[type="password"]').forEach(i => { i.readOnly = !enable; });
                fields.style.opacity = enable ? '1' : '0.6';
            }
            if (chk) {
                toggle();
                chk.addEventListener('change', toggle);
            }
        })();
    </script>
}
