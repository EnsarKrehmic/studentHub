@model IEnumerable<StudentHub.Models.StudentskaSluzba>

@{
    ViewData["Title"] = "Lista članova studentske službe";
}

<h2>@ViewData["Title"]</h2>

<p>
    @if (User.IsInRole("Studentska služba"))
    {
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Dodaj novog člana studentske službe</a>
    }
</p>

<form asp-action="Index" method="get">
    <div class="form-group">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Pretraži člana" />
    </div>
    <div class="form-group">
        <label for="StudijskiProgramId">Filtrirajte člana studentske službe prema studijskom programu</label>
        <select id="StudijskiProgramId" name="studijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgrami">
            <option value="">Svi programi</option>
        </select>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary mt-3">Pretraži</button>
    </div>
</form>

<table class="table table-bordered table-hover mt-3">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" 
                asp-route-sortOrder="@ViewData["NameSortParm"]" 
                asp-route-searchString="@ViewData["CurrentFilter"]" 
                asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                    @Html.DisplayNameFor(model => model.FirstOrDefault().Ime)
                </a>
            </th>
            <th>
                <a asp-action="Index" 
                asp-route-sortOrder="@ViewData["SurnameSortParm"]" 
                asp-route-searchString="@ViewData["CurrentFilter"]" 
                asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                    @Html.DisplayNameFor(model => model.FirstOrDefault().Prezime)
                </a>
            </th>
            @if (User.IsInRole("Studentska služba"))
            {
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["JMBGSortParm"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                        @Html.DisplayNameFor(model => model.FirstOrDefault().JMBG)
                    </a>
                </th>
            }
            <th>
                <a asp-action="Index" 
                asp-route-sortOrder="@ViewData["EmailSortParm"]" 
                asp-route-searchString="@ViewData["CurrentFilter"]" 
                asp-route-studijskiProgramId="@ViewData["CurrentStudijskiProgramId"]">
                    @Html.DisplayNameFor(model => model.FirstOrDefault().Email)
                </a>
            </th>
            <th>Studijski program</th>
            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
            {
                <th>Akcije</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                @if (User.IsInRole("Studentska služba"))
                {
                    <td>@Html.DisplayFor(modelItem => item.JMBG)</td>
                }
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>
                    @if (item.StudentskaSluzbaStudijskiProgrami.Any())
                    {
                        @string.Join(", ", item.StudentskaSluzbaStudijskiProgrami.Select(sp => sp.StudijskiProgram.Naziv))
                    }
                    else
                    {
                        <span>Nema dodijeljenih programa</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba") || User.IsInRole("Profesor") || User.IsInRole("Asistent"))
                    {
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                    }
                    @if (User.IsInRole("Studentska služba"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                    }
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <a asp-controller="Dokumenti" asp-action="Index" class="btn btn-secondary">Dokumenti</a>
                        <a asp-controller="Uvjerenja" asp-action="Index" class="btn btn-secondary">Uvjerenja</a>
                        <a asp-controller="Zahtjevi" asp-action="Index" class="btn btn-secondary">Zahtjevi</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>