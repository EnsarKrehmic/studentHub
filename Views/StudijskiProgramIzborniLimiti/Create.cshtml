@model StudentHub.Models.StudijskiProgramIzborniLimit
@{
    ViewData["Title"] = "Novi limit izbornih predmeta";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="StudijskiProgramId" class="form-label">Studijski program</label>
                    <select asp-for="StudijskiProgramId" class="form-select" asp-items="ViewBag.StudijskiProgramId">
                        <option value="">-- Odaberite program --</option>
                    </select>
                    <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GodinaStudija" class="form-label">Godina studija</label>
                    <input asp-for="GodinaStudija" type="number" min="1" class="form-control" placeholder="npr. 1" />
                    <span asp-validation-for="GodinaStudija" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MinIzborniPredmeti" class="form-label">Min. izbornih predmeta</label>
                    <input asp-for="MinIzborniPredmeti" type="number" min="0" class="form-control" />
                    <span asp-validation-for="MinIzborniPredmeti" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxIzborniPredmeti" class="form-label">Max. izbornih predmeta</label>
                    <input asp-for="MaxIzborniPredmeti" type="number" min="0" class="form-control" />
                    <span asp-validation-for="MaxIzborniPredmeti" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Spremi limit
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad na listu
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
