@model StudentHub.Models.StudijskiProgramIzborniLimit

@{
    ViewData["Title"] = "Dodaj novi limit";
}

<h2 class="mb-4">
    <i class="fas fa-plus-circle"></i> @ViewData["Title"]
</h2>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="StudijskiProgramId" class="control-label"></label>
                <select asp-for="StudijskiProgramId" class="form-control" asp-items="ViewBag.StudijskiProgramId"></select>
                <span asp-validation-for="StudijskiProgramId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GodinaStudija" class="control-label"></label>
                <input asp-for="GodinaStudija" class="form-control" />
                <span asp-validation-for="GodinaStudija" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinIzborniPredmeti" class="control-label"></label>
                <input asp-for="MinIzborniPredmeti" class="form-control" />
                <span asp-validation-for="MinIzborniPredmeti" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaxIzborniPredmeti" class="control-label"></label>
                <input asp-for="MaxIzborniPredmeti" class="form-control" />
                <span asp-validation-for="MaxIzborniPredmeti" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success mt-3">
                <i class="fas fa-save"></i> Spremi
            </button>
            <a asp-action="Index" class="btn btn-secondary mt-3">
                <i class="fas fa-arrow-left"></i> Nazad na listu
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
