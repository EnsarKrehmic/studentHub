@model StudentHub.Models.StudijskiProgramIzborniLimit

@{
    ViewData["Title"] = "Obriši limit";
}

<h2 class="mb-4 text-danger">
    <i class="fas fa-trash-alt"></i> @ViewData["Title"]
</h2>

<div class="alert alert-danger">
    <h5>Da li ste sigurni da želite obrisati ovaj limit?</h5>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <p><strong>Studijski program:</strong> @Model.StudijskiProgram?.Naziv</p>
        <p><strong>Godina studija:</strong> @Model.GodinaStudija</p>
        <p><strong>Minimalno izbornih predmeta:</strong> @Model.MinIzborniPredmeti</p>
        <p><strong>Maksimalno izbornih predmeta:</strong> @Model.MaxIzborniPredmeti</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> Potvrdi brisanje
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Odustani
            </a>
        </form>
    </div>
</div>
