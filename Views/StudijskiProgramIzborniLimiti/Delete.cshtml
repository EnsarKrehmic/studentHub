@model StudentHub.Models.StudijskiProgramIzborniLimit

@{
    ViewData["Title"] = "Obriši limit";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj limit?";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Studijski program"] = Model.StudijskiProgram?.Naziv ?? "(nije postavljen)",
        ["Godina studija"] = Model.GodinaStudija,
        ["Min izborni predmeti"] = Model.MinIzborniPredmeti,
        ["Max izborni predmeti"] = Model.MaxIzborniPredmeti
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
