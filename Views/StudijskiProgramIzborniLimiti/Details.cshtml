@model StudentHub.Models.StudijskiProgramIzborniLimit

@{
    ViewData["Title"] = "Detalji limita";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-sliders-h text-primary me-2"></i>@ViewData["Title"]
    </h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-graduation-cap me-2"></i>@Model.StudijskiProgram?.Naziv
        </div>
        <div class="card-body">
            <p><strong>Godina studija:</strong> @Model.GodinaStudija</p>
            <p><strong>Minimalno izbornih predmeta:</strong> @Model.MinIzborniPredmeti</p>
            <p><strong>Maksimalno izbornih predmeta:</strong> @Model.MaxIzborniPredmeti</p>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i> Izmijeni
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="fas fa-trash-alt me-1"></i> Obriši
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Nazad na listu
                </a>
            </div>
        </div>
    </div>
</div>
