@model IEnumerable<StudentHub.Models.StudijskiProgramIzborniLimit>

@{
    ViewData["Title"] = "Limiti izbornih predmeta";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <!-- Naslov + dugme -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fas fa-sliders-h me-2"></i>@ViewData["Title"]
            </h4>
            @if (User.IsInRole("Studentska služba"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm text-primary fw-bold">
                    <i class="fas fa-plus-circle me-1"></i> Dodaj novi limit
                </a>
            }
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info shadow-sm">
                    Trenutno nema definisanih limita za izborne predmete.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in Model.OrderBy(x => x.StudijskiProgram.Naziv).ThenBy(x => x.GodinaStudija))
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border rounded shadow-sm">
                                <div class="card-header bg-secondary text-white">
                                    <i class="fas fa-graduation-cap me-2"></i>@item.StudijskiProgram?.Naziv
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0 small">
                                        <dt class="col-6">Godina studija:</dt>
                                        <dd class="col-6">@item.GodinaStudija</dd>

                                        <dt class="col-6">Minimalno izbornih:</dt>
                                        <dd class="col-6">@item.MinIzborniPredmeti</dd>

                                        <dt class="col-6">Maksimalno izbornih:</dt>
                                        <dd class="col-6">@item.MaxIzborniPredmeti</dd>
                                    </dl>
                                </div>
                                <div class="card-footer d-flex flex-wrap gap-2 justify-content-start">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i> Detalji
                                    </a>
                                    @if (User.IsInRole("Studentska služba"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit me-1"></i> Izmijeni
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash-alt me-1"></i> Obriši
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card-footer text-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light text-white">
                <i class="fas fa-arrow-left me-1"></i> Nazad na početnu
            </a>
        </div>
    </div>
</div>
