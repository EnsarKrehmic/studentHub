@model IEnumerable<StudentHub.Models.StudijskiProgramIzborniLimit>

@{
    ViewData["Title"] = "Limiti izbornih predmeta";
}

<h2 class="mb-4">
    <i class="fas fa-sliders-h"></i> @ViewData["Title"]
</h2>

<a class="btn btn-success mb-4" asp-action="Create">
    <i class="fas fa-plus-circle"></i> Dodaj novi limit
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Trenutno nema definisanih limita za izborne predmete.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model.OrderBy(x => x.StudijskiProgram.Naziv).ThenBy(x => x.GodinaStudija))
        {
            <div class="col-md-6">
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-graduation-cap"></i> @item.StudijskiProgram?.Naziv
                        </h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Godina studija:</strong> @item.GodinaStudija</p>
                        <p><strong>Minimalno izbornih predmeta:</strong> @item.MinIzborniPredmeti</p>
                        <p><strong>Maksimalno izbornih predmeta:</strong> @item.MaxIzborniPredmeti</p>

                        <div class="mt-3">
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">
                                <i class="fas fa-eye"></i> Detalji
                            </a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">
                                <i class="fas fa-edit"></i> Izmijeni
                            </a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">
                                <i class="fas fa-trash-alt"></i> Obriši
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left"></i> Nazad na početnu
</a>
