@model StudentHub.Models.StudijskiProgram

@{
    ViewData["Title"] = "Brisanje nastavnog plana";

    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj nastavni plan?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o nastavnom planu.";

    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Naziv"] = Model.Naziv,
        ["Opis"] = Model.Opis,
        ["Trajanje (godine)"] = Model.TrajanjeUGodinama
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
