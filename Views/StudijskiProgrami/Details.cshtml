@model StudentHub.ViewModels.StudijskiProgramDetailsViewModel

@{
    ViewData["Title"] = "Detalji studijskog programa";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Index" asp-controller="StudijskiProgrami" class="btn btn-info">Lista svih studijskih programa</a>
</p>

<div>
    <h4>@Model.StudijskiProgram.Naziv</h4>
    <p>@Model.StudijskiProgram.Opis</p>
    <p>Trajanje: @Model.StudijskiProgram.TrajanjeUGodinama godine</p>
</div>

<div class="mt-4">
    <h4>Statistika</h4>
    <div class="row text-center">
        <div class="col-md-4">
            <h5>Broj studenata</h5>
            <h2>@Model.BrojStudenata</h2>
        </div>
        <div class="col-md-4">
            <h5>Broj profesora</h5>
            <h2>@Model.BrojProfesora</h2>
        </div>
        <div class="col-md-4">
            <h5>Broj asistenata</h5>
            <h2>@Model.BrojAsistenata</h2>
        </div>
    </div>
</div>

<div class="mt-4">
    <h4>Obavijesti za ovaj studijski program</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Naslov</th>
                <th>Sadržaj (skraćeno)</th>
                <th>Kreirano od</th>
                <th>Datum objave</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obavijest in Model.Obavjestenja)
            {
                <tr>
                    <td>@obavijest.Naslov</td>
                    <td>@(obavijest.Sadrzaj.Length > 150 ? obavijest.Sadrzaj.Substring(0, 150) + "..." : obavijest.Sadrzaj)</td>
                    <td>@obavijest.Kreirao</td>
                    <td>@obavijest.DatumObjave.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-controller="Obavjestenja" asp-action="Details" asp-route-id="@obavijest.Id" class="btn btn-info btn-sm">Detalji</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    @if (User.IsInRole("Studentska služba"))
    {
        <a asp-action="Create" class="btn btn-primary">Kreiraj novi studijski program</a>
    }
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>

