@model StudentHub.Models.StudijskiProgram

@{
    ViewData["Title"] = "Detalji o studijskom programu";
}

<h1>
    <h2>@ViewData["Title"]</h2>

    <div>
        <h4>Podaci o studijskom programu</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Naziv)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Naziv)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Opis)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Opis)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.trajanjeUGodinama)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.trajanjeUGodinama)</dd>
        </dl>
    </div>

    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id">Izmjena</a> |
        <a asp-action="Index">Nazad</a>
    </div>
</h1>