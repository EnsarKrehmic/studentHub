@model StudentHub.Models.StudijskiProgram

@{
    ViewData["Title"] = "Detalji studijskog programa";
    var obavjestenja = ViewBag.Obavjestenja as List<StudentHub.Models.Obavjestenje>;
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>@Model.Naziv</h4>
    <p>@Model.Opis</p>
    <p>Trajanje: @Model.TrajanjeUGodinama godine</p>
</div>

<div>
    <h4>Obavijesti za ovaj studijski program</h4>
    <ul class="list-group">
        @foreach (var obavijest in obavjestenja)
        {
            <li class="list-group-item">
                <h5>@obavijest.Naslov</h5>
                <p>@obavijest.Sadrzaj</p>
                <small class="text-muted">@obavijest.DatumObjave.ToString("dd.MM.yyyy")</small>
            </li>
        }
    </ul>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>
