@model StudentHub.ViewModels.StudijskiProgramDetailsViewModel

@{
    ViewData["Title"] = "Detalji studijskog programa";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-graduation-cap text-primary me-2"></i>@ViewData["Title"]</h2>
        <a asp-action="Index" asp-controller="StudijskiProgrami" class="btn btn-outline-secondary">
            <i class="fas fa-list me-1"></i> Svi programi
        </a>
    </div>

    <!-- Osnovne informacije -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-info-circle me-2"></i>Osnovne informacije
        </div>
        <div class="card-body">
            <h4 class="text-body">@Model.StudijskiProgram.Naziv</h4>
            <p class="text-body">@Model.StudijskiProgram.Opis</p>
            <p class="text-body">
                Trajanje:
                <span class="badge bg-secondary">@Model.StudijskiProgram.TrajanjeUGodinama godina</span>
            </p>
        </div>
    </div>

    <!-- Statistika -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <i class="fas fa-chart-bar me-2"></i>Statistika
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4">
                    <h6>Broj studenata</h6>
                    <h2 class="text-primary">@Model.BrojStudenata</h2>
                </div>
                <div class="col-md-4">
                    <h6>Broj profesora</h6>
                    <h2 class="text-success">@Model.BrojProfesora</h2>
                </div>
                <div class="col-md-4">
                    <h6>Broj asistenata</h6>
                    <h2 class="text-info">@Model.BrojAsistenata</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Obavještenja -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-bullhorn me-2"></i>Obavijesti vezane za program
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Naslov</th>
                            <th>Sadržaj</th>
                            <th>Autor</th>
                            <th>Datum</th>
                            <th>Akcija</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obavijest in Model.Obavjestenja)
                        {
                            <tr>
                                <td>@obavijest.Naslov</td>
                                <td>@(obavijest.Sadrzaj.Length > 150 ? obavijest.Sadrzaj[..150] + "..." : obavijest.Sadrzaj)</td>
                                <td>@obavijest.AutorIme</td>
                                <td>@obavijest.DatumObjave.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <a asp-controller="Obavjestenja" asp-action="Details" asp-route-id="@obavijest.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Detalji
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Akcije -->
    <div class="d-flex gap-2 mt-3">
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Novi studijski program
            </a>
        }
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
            <i class="fas fa-home me-1"></i> Početna
        </a>
    </div>
</div>
