@model StudentHub.Models.StudijskiProgram

@{
    ViewData["Title"] = "Izmjena podataka studijskog programa";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Naziv" class="control-label">Naziv</label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Opis" class="control-label">Opis</label>
        <textarea asp-for="Opis" class="form-control"></textarea>
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TrajanjeUGodinama" class="control-label">Trajanje u godinama</label>
        <input asp-for="TrajanjeUGodinama" class="form-control" />
        <span asp-validation-for="TrajanjeUGodinama" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Sačuvaj promjene</button>
    </div>
</form>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}