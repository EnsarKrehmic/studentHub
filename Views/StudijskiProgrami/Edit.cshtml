@model StudentHub.Models.StudijskiProgram
@{
    ViewData["Title"] = "Uredi studijski program";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Naziv" class="form-label">Naziv</label>
                    <input asp-for="Naziv" class="form-control" />
                    <span asp-validation-for="Naziv" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Opis" class="form-label">Opis</label>
                    <textarea asp-for="Opis" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Opis" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TrajanjeUGodinama" class="form-label">Trajanje (godine)</label>
                    <input asp-for="TrajanjeUGodinama" type="number" min="1" class="form-control" />
                    <span asp-validation-for="TrajanjeUGodinama" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save me-1"></i> Sačuvaj
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
