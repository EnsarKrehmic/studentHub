@model IEnumerable<StudentHub.Models.StudijskiProgram>

@{
    ViewData["Title"] = "Lista studijskih programa";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">@Html.DisplayFor(modelItem => item.Naziv)</h5>
                    <p class="card-text"><strong>Opis:</strong> @Html.DisplayFor(modelItem => item.Opis)</p>
                    <p class="card-text"><strong>Trajanje:</strong> @Html.DisplayFor(modelItem => item.TrajanjeUGodinama) godina</p>
                </div>
                <div class="card-footer bg-white text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm fw-bold">
                        <i class="bi bi-eye-fill"></i> Pregled
                    </a>
                    @if (User.IsInRole("Studentska služba"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm fw-bold">
                            <i class="bi bi-pencil-fill"></i> Izmjena
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm fw-bold">
                            <i class="bi bi-trash-fill"></i> Brisanje
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>
