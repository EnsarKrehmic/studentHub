@model IEnumerable<StudentHub.Models.StudijskiProgram>

@{
    ViewData["Title"] = "Lista studijskih programa";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Kreiraj novi studijski program</a>
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Naziv)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Opis)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().TrajanjeUGodinama)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Naziv)</td>
                <td>@Html.DisplayFor(modelItem => item.Opis)</td>
                <td>@Html.DisplayFor(modelItem => item.TrajanjeUGodinama)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                </td>
                }
            </tr>
        }
    </tbody>
</table>
