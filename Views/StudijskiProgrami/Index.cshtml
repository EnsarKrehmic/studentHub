@model IEnumerable<StudentHub.Models.StudijskiProgram>

@{
    ViewData["Title"] = "Lista studijskih programa";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Naziv)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Opis)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().trajanjeUGodinama)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Naziv)</td>
                <td>@Html.DisplayFor(modelItem => item.Opis)</td>
                <td>@Html.DisplayFor(modelItem => item.trajanjeUGodinama)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Detalji</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Izmjena</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>