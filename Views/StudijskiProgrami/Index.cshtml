@model IEnumerable<StudentHub.Models.StudijskiProgram>
@{
    ViewData["Title"] = "Lista studijskih programa";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <h2 class="mb-0">
            <i class="fas fa-university text-primary me-2"></i>
            @ViewData["Title"]
        </h2>
        @if (User.IsInRole("Studentska služba"))
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> Dodaj novi program
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle me-1"></i>
            Nema definisanih studijskih programa.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var program in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold no-wrap">
                                @program.Naziv
                            </h5>
                            <p class="card-text flex-grow-1">
                                <strong>Opis:</strong>
                                @(string.IsNullOrWhiteSpace(program.Opis)
                                                        ? "<span class=\"text-muted\">Nema opisa</span>"
                                                        : (program.Opis.Length > 100
                                                        ? program.Opis.Substring(0, 100) + "…"
                                                        : program.Opis))
                    </p>
                    <p class="card-text mb-2">
                        <strong>Trajanje:</strong> @program.TrajanjeUGodinama godina
                    </p>
                </div>
                <div class="card-footer bg-white text-end">
                    <a asp-action="Details" asp-route-id="@program.Id"
                       class="btn btn-info btn-sm fw-bold me-1">
                        <i class="fas fa-eye me-1"></i> Pregled
                    </a>
                    @if (User.IsInRole("Studentska služba"))
                            {
                                <a asp-action="Edit" asp-route-id="@program.Id"
                                   class="btn btn-warning btn-sm fw-bold me-1">
                                    <i class="fas fa-pencil-alt me-1"></i> Izmjena
                                </a>
                                <a asp-action="Delete" asp-route-id="@program.Id"
                                   class="btn btn-danger btn-sm fw-bold">
                                    <i class="fas fa-trash-alt me-1"></i> Brisanje
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
        </a>
    </div>
</div>
