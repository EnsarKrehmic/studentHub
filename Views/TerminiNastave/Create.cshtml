@model StudentHub.Models.TerminNastave

@{
    ViewData["Title"] = "Dodaj novi termin";
    long rasporedId = ViewBag.RasporedId ?? 0;
    long? studijskiProgramId = ViewBag.StudijskiProgramId as long?;
    int? semestar = ViewBag.Semestar as int?;
    var godinaStudija = ViewBag.GodinaStudija as int?;

    // Lista dana na bosanskom, od ponedjeljka do nedjelje
    var dani = new List<(DayOfWeek EnumValue, string Ime)>()
    {
        (DayOfWeek.Monday, "Ponedjeljak"),
        (DayOfWeek.Tuesday, "Utorak"),
        (DayOfWeek.Wednesday, "Srijeda"),
        (DayOfWeek.Thursday, "Četvrtak"),
        (DayOfWeek.Friday, "Petak"),
        (DayOfWeek.Saturday, "Subota"),
        (DayOfWeek.Sunday, "Nedjelja")
    };
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-plus-circle text-success"></i> Dodavanje termina u raspored</h2>

    <form asp-controller="TerminiNastave" asp-action="Create" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="RasporedId" value="@rasporedId" />

        <div class="mb-3">
            <label asp-for="PredmetId" class="form-label">Predmet</label>
            <select asp-for="PredmetId" class="form-select" required id="PredmetId">
                <option value="">-- Učitavanje predmeta... --</option>
            </select>
            <span asp-validation-for="PredmetId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Vrsta" class="form-label">Vrsta nastave</label>
            <select asp-for="Vrsta" class="form-select" required>
                <option value="">-- Odaberi vrstu --</option>
                <option value="1" selected="@(Model.Vrsta == StudentHub.Models.VrstaNastave.Predavanje ? "selected" : null)">Predavanje</option>
                <option value="2" selected="@(Model.Vrsta == StudentHub.Models.VrstaNastave.Vjezbe ? "selected" : null)">Vježbe</option>
            </select>
            <span asp-validation-for="Vrsta" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Dan" class="form-label">Dan u sedmici</label>
            <select asp-for="Dan" class="form-select" required>
                <option value="">-- Odaberi dan --</option>
                @foreach (var dan in dani)
                {
                    <option value="@dan.EnumValue" selected="@(Model.Dan == dan.EnumValue ? "selected" : null)">
                        @dan.Ime
                    </option>
                }
            </select>
            <span asp-validation-for="Dan" class="text-danger"></span>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="VrijemeOd" class="form-label">Vrijeme početka</label>
                <input asp-for="VrijemeOd" type="time" class="form-control" required />
                <span asp-validation-for="VrijemeOd" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="VrijemeDo" class="form-label">Vrijeme završetka</label>
                <input asp-for="VrijemeDo" type="time" class="form-control" required />
                <span asp-validation-for="VrijemeDo" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Lokacija" class="form-label">Lokacija</label>
            <input asp-for="Lokacija" class="form-control" required />
            <span asp-validation-for="Lokacija" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save"></i> Sačuvaj termin
            </button>
            <a asp-controller="Rasporedi" asp-action="Details" asp-route-id="@rasporedId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Nazad
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            var studijskiProgramId = '@ViewBag.StudijskiProgramId';
            var godinaStudija = '@ViewBag.GodinaStudija';
            var semestar = '@ViewBag.Semestar';

            if (studijskiProgramId && godinaStudija && semestar) {
                $.ajax({
                    url: '/TerminiNastave/PredmetiZaProgram',
                    type: 'GET',
                    data: {
                        studijskiProgramId: studijskiProgramId,
                        godinaStudija: parseInt(godinaStudija),
                        semestar: parseInt(semestar)
                    },
                    success: function (data) {
                        var predmetSelect = $('#PredmetId');
                        predmetSelect.empty();
                        predmetSelect.append($('<option>').val('').text('-- Odaberi predmet --'));
                        $.each(data, function (index, predmet) {
                            var selected = predmet.id == '@Model.PredmetId' ? 'selected' : '';
                            predmetSelect.append($('<option ' + selected + '>').val(predmet.id).text(predmet.naziv));
                        });
                    },
                    error: function () {
                        alert('Greška prilikom učitavanja predmeta.');
                    }
                });
            } else {
                $('#PredmetId').empty().append($('<option>').val('').text('-- Nema dostupnih predmeta --'));
            }
        });
    </script>
}
