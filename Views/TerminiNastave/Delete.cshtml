@model StudentHub.Models.TerminNastave

@{
    ViewData["Title"] = "Brisanje termina";
    ViewData["WarningMessage"] = "Brisanjem ovog termina trajno će nestati iz rasporeda i više neće biti vidljiv studentima, profesorima ni asistentima.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Predmet"] = Model.Predmet?.Naziv ?? "(nije postavljen)",
        ["Vrsta nastave"] = Model.Vrsta,
        ["Dan"] = Model.Dan.ToString(), // or call DanNaBosanskom helper if you prefer
        ["Vrijeme"] = $"{Model.VrijemeOd:hh\\:mm} – {Model.VrijemeDo:hh\\:mm}",
        ["Lokacija"] = Model.Lokacija
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
