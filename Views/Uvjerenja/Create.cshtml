@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Kreiranje novog uvjerenja";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Namjena" class="control-label"></label>
        <input asp-for="Namjena" class="form-control" />
        <span asp-validation-for="Namjena" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DatumIzdavanja" class="control-label"></label>
        <input asp-for="DatumIzdavanja" class="form-control" />
        <span asp-validation-for="DatumIzdavanja" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StudentId" class="control-label"></label>
        <select asp-for="StudentId" class="form-control" asp-items="ViewBag.Studenti"></select>
        <span asp-validation-for="StudentId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Vrsta" class="control-label"></label>
        <select asp-for="Vrsta" class="form-control"></select>
        <span asp-validation-for="Vrsta" class="text-danger"></span>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Kreiraj</button>
    </div>
</form>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
