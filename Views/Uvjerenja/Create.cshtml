@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Novo uvjerenje";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="StudentId" class="form-label">Student</label>
                    <select asp-for="StudentId" class="form-select" asp-items="ViewBag.Studenti" required></select>
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VrstaUvjerenja" class="form-label">Vrsta uvjerenja</label>
                    <select asp-for="VrstaUvjerenja" class="form-select" asp-items="Html.GetEnumSelectList<VrstaUvjerenja>()"></select>
                    <span asp-validation-for="VrstaUvjerenja" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Namjena" class="form-label">Namjena</label>
                    <input asp-for="Namjena" class="form-control" placeholder="Unesite namjenu uvjerenja" />
                    <span asp-validation-for="Namjena" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Sačuvaj
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
