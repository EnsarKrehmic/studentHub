@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Kreiranje uvjerenja";
}

<h2>@ViewData["Title"]</h2>

<h4>Uvjerenje</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group">
                <label asp-for="StudentId" class="control-label"></label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.Studenti" required></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VrstaUvjerenja" class="control-label">Vrsta uvjerenja</label>
                <select asp-for="VrstaUvjerenja" class="form-control" asp-items="Html.GetEnumSelectList<VrstaUvjerenja>()"></select>
                <span asp-validation-for="VrstaUvjerenja" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Namjena" class="control-label">Namjena uvjerenja</label>
                <input asp-for="Namjena" class="form-control" placeholder="Unesite namjenu uvjerenja" />
                <span asp-validation-for="Namjena" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Kreiraj" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Odustani</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
