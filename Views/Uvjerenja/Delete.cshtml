@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Brisanje uvjerenja";
}

<h2>@ViewData["Title"]</h2>

<h3>Da li ste sigurni da želite obrisati ovo uvjerenje?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Namjena)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Namjena)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.datumIzdavanja)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.datumIzdavanja)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.StudentskaSluzba)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StudentskaSluzba.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Vrsta)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Vrsta)</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button> |
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>