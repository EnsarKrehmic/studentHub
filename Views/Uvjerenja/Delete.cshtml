@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Brisanje uvjerenja";
}

<h2>@ViewData["Title"]</h2>

<h3>Da li ste sigurni da želite obrisati ovo uvjerenje?</h3>
<div>
    <h4>Uvjerenje</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Namjena)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Namjena)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DatumIzdavanja)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DatumIzdavanja)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.BrojIndeksa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.BrojIndeksa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Ime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Ime)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Prezime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Prezime)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <input type="submit" value="Obriši" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-secondary">Nazad</a>
        </div>
    </form>
</div>
