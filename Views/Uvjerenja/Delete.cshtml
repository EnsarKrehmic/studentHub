@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Brisanje uvjerenja";
}

<h2 class="text-danger">@ViewData["Title"]</h2>

<div class="alert alert-warning">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovo uvjerenje?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti sve podatke o uvjerenju.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o uvjerenju</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student:</dt>
            <dd class="col-sm-9">@Model.Student.Ime @Model.Student.Prezime</dd>

            <dt class="col-sm-3">Broj indeksa:</dt>
            <dd class="col-sm-9">@Model.Student.BrojIndeksa</dd>

            <dt class="col-sm-3">Studentska služba:</dt>
            <dd class="col-sm-9">@Model.StudentskaSluzba.Ime @Model.StudentskaSluzba.Prezime</dd>

            <dt class="col-sm-3">Vrsta:</dt>
            <dd class="col-sm-9">@Model.VrstaUvjerenja</dd>

            <dt class="col-sm-3">Namjena:</dt>
            <dd class="col-sm-9">@Model.Namjena</dd>

            <dt class="col-sm-3">Datum izdavanja:</dt>
            <dd class="col-sm-9">@Model.DatumIzdavanja.ToShortDateString()</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>
