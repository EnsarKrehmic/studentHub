@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Brisanje uvjerenja";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovo uvjerenje?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o uvjerenju.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Student"] = $"{Model.Student.Ime} {Model.Student.Prezime}",
        ["Broj indeksa"] = Model.Student.BrojIndeksa,
        ["Vrsta uvjerenja"] = Model.VrstaUvjerenja,
        ["Namjena"] = Model.Namjena,
        ["Datum izdavanja"] = Model.DatumIzdavanja.ToShortDateString()
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
