@model StudentHub.Models.Uvjerenje

@{
    ViewData["Title"] = "Detalji uvjerenja";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="fas fa-file-alt me-2"></i>
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">👤 Student:</dt>
                <dd class="col-sm-8">@Model.Student?.Ime @Model.Student?.Prezime</dd>

                <dt class="col-sm-4">📘 Broj indeksa:</dt>
                <dd class="col-sm-8">@Model.Student?.BrojIndeksa</dd>

                <dt class="col-sm-4">📄 Vrsta uvjerenja:</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-info text-dark">@Html.DisplayFor(m => m.VrstaUvjerenja)</span>
                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.Namjena))
                {
                    <dt class="col-sm-4">🎯 Namjena:</dt>
                    <dd class="col-sm-8">@Model.Namjena</dd>
                }

                <dt class="col-sm-4">📅 Datum izdavanja:</dt>
                <dd class="col-sm-8">@Model.DatumIzdavanja.ToString("dd.MM.yyyy HH:mm")</dd>

                @if (User.IsInRole("Studentska služba"))
                {
                    <dt class="col-sm-4">🛡️ Izdato od:</dt>
                    <dd class="col-sm-8">@Model.StudentskaSluzba?.Ime @Model.StudentskaSluzba?.Prezime</dd>
                }
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            @if (User.IsInRole("Studentska služba"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i> Izmjena
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad na listu
            </a>
        </div>
    </div>
</div>
