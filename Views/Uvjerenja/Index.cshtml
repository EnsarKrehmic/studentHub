@model IEnumerable<StudentHub.Models.Uvjerenje>

@{
    ViewData["Title"] = "Lista uvjerenja";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novo uvjerenje</a>
</p>

<table class="table table-bordered table-hover mt-3">
    <thead>
        <tr>
            <th>Namjena</th>
            <th>Datum Izdavanja</th>
            <th>Student</th>
            <th>Vrsta</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Namjena</td>
                <td>@item.DatumIzdavanja</td>
                <td>@item.Student.BrojIndeksa</td>
                <td>@item.Student.Ime</td>
                <td>@item.Student.Prezime</td>
                <td>@item.Vrsta</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>
