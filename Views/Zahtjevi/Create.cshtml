@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Novi zahtjev";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="TipZahtjeva" class="form-label">Tip zahtjeva</label>
                    <select asp-for="TipZahtjeva" class="form-select" asp-items="Html.GetEnumSelectList<TipZahtjeva>()" required>
                        <option value="">-- Odaberite tip --</option>
                    </select>
                    <span asp-validation-for="TipZahtjeva" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Napomena" class="form-label">Napomena</label>
                    <textarea asp-for="Napomena" class="form-control" rows="4" placeholder="Unesite detalje zahtjeva"></textarea>
                    <span asp-validation-for="Napomena" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-paper-plane me-1"></i> Pošalji zahtjev
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Odustani
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
