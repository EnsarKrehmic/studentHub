@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Kreiranje novog zahtjeva";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="tipZahtjeva" class="control-label"></label>
        <select asp-for="tipZahtjeva" class="form-control"></select>
        <span asp-validation-for="tipZahtjeva" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="statusZahtjeva" class="control-label"></label>
        <select asp-for="statusZahtjeva" class="form-control"></select>
        <span asp-validation-for="statusZahtjeva" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="datumPodnosenja" class="control-label"></label>
        <input asp-for="datumPodnosenja" class="form-control" />
        <span asp-validation-for="datumPodnosenja" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="datumRjesavanja" class="control-label"></label>
        <input asp-for="datumRjesavanja" class="form-control" />
        <span asp-validation-for="datumRjesavanja" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="brojIndeksa" class="control-label"></label>
        <select asp-for="brojIndeksa" class="form-control" asp-items="ViewBag.brojIndeksa"></select>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Kreiraj</button>
    </div>
</form>

<div>
    <a asp-action="Index">Nazad</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
