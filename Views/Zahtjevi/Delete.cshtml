@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Brisanje zahtjeva";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning" role="alert">
    <h4 class="alert-heading">Da li ste sigurni da želite obrisati ovaj zahtjev?</h4>
    <p>Ova akcija je nepovratna i trajno će ukloniti sve podatke o zahtjevu.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h5>Podaci o zahtjevu</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student:</dt>
            <dd class="col-sm-9">@Model.Student.Ime @Model.Student.Prezime</dd>

            <dt class="col-sm-3">Broj indeksa:</dt>
            <dd class="col-sm-9">@Model.Student.BrojIndeksa</dd>

            <dt class="col-sm-3">Tip zahtjeva:</dt>
            <dd class="col-sm-9">@Model.TipZahtjeva</dd>

            <dt class="col-sm-3">Status zahtjeva:</dt>
            <dd class="col-sm-9">@Model.StatusZahtjeva</dd>

            <dt class="col-sm-3">Datum podnošenja:</dt>
            <dd class="col-sm-9">@Model.DatumPodnosenja</dd>

            <dt class="col-sm-3">Datum rješavanja:</dt>
            <dd class="col-sm-9">@Model.DatumRjesavanja</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Index" class="btn btn-secondary">Odustani</a>
    </div>
</form>
