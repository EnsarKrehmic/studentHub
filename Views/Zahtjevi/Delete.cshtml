@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Brisanje zahtjeva";
    ViewData["WarningMessage"] = "Da li ste sigurni da želite obrisati ovaj zahtjev?";
    ViewData["WarningDetails"] = "Ova akcija je nepovratna i trajno će ukloniti sve podatke o zahtjevu.";
    ViewData["DeleteFields"] = new Dictionary<string, object>
    {
        ["Student"] = $"{Model.Student.Ime} {Model.Student.Prezime}",
        ["Broj indeksa"] = Model.Student.BrojIndeksa,
        ["Tip zahtjeva"] = Model.TipZahtjeva,
        ["Status zahtjeva"] = Model.StatusZahtjeva,
        ["Datum podnošenja"] = Model.DatumPodnosenja,
        ["Datum rješavanja"] = Model.DatumRjesavanja?.ToString() ?? "(nije obrađeno)"
    };
}

@await Html.PartialAsync("_DeleteCard", Model)
