@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Detalji zahtjeva";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="fas fa-envelope-open-text me-2"></i>
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">👤 Student:</dt>
                <dd class="col-sm-8">@Model.Student?.Ime @Model.Student?.Prezime</dd>

                <dt class="col-sm-4">📘 Broj indeksa:</dt>
                <dd class="col-sm-8">@Model.Student?.BrojIndeksa</dd>

                <dt class="col-sm-4">📄 Tip zahtjeva:</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-info text-dark">@Html.DisplayFor(m => m.TipZahtjeva)</span>
                </dd>

                <dt class="col-sm-4">📌 Status zahtjeva:</dt>
                <dd class="col-sm-8">
                    <span class="badge
                        @(Model.StatusZahtjeva == StatusZahtjeva.Prihvaćen ? "bg-success" :
                                                    Model.StatusZahtjeva == StatusZahtjeva.Odbijen ? "bg-danger" :
                                                    Model.StatusZahtjeva == StatusZahtjeva.Primljen ? "bg-warning" :
                                                    "bg-secondary")">
                        @Html.DisplayFor(m => m.StatusZahtjeva)
                    </span>
                </dd>

                <dt class="col-sm-4">📅 Datum podnošenja:</dt>
                <dd class="col-sm-8">@Model.DatumPodnosenja.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-4">📆 Datum rješavanja:</dt>
                <dd class="col-sm-8">
                    @if (Model.DatumRjesavanja.HasValue)
                    {
                        <span>@Model.DatumRjesavanja.Value.ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span class="text-muted">Zahtjev još nije riješen</span>
                    }
                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.Napomena))
                {
                    <dt class="col-sm-4">🗒️ Napomena:</dt>
                    <dd class="col-sm-8">@Model.Napomena</dd>
                }
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i> Izmjena
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Nazad na listu
            </a>
        </div>
    </div>
</div>
