@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Detalji zahtjeva";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Podaci o zahtjevu</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipZahtjeva)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TipZahtjeva)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.StatusZahtjeva)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusZahtjeva)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DatumPodnosenja)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DatumPodnosenja)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DatumRjesavanja)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DatumRjesavanja)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student.BrojIndeksa)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.BrojIndeksa)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student.Ime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.Ime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student.Prezime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Student.Prezime)</dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Izmjena</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad na listu</a>
</div>
