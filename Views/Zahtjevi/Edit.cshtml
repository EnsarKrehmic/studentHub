@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Uredi zahtjev";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="TipZahtjeva" class="form-label">Tip zahtjeva</label>
                    <select asp-for="TipZahtjeva" class="form-select" asp-items="Html.GetEnumSelectList<TipZahtjeva>()" required>
                        <option value="">-- Odaberite tip --</option>
                    </select>
                    <span asp-validation-for="TipZahtjeva" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Napomena" class="form-label">Napomena</label>
                    <textarea asp-for="Napomena" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Napomena" class="text-danger"></span>
                </div>

                @if (User.IsInRole("Studentska služba"))
                {
                    <div class="mb-3">
                        <label asp-for="StatusZahtjeva" class="form-label">Status zahtjeva</label>
                        <select asp-for="StatusZahtjeva" class="form-select" asp-items="Html.GetEnumSelectList<StatusZahtjeva>()">
                            <option value="">-- Odaberite status --</option>
                        </select>
                        <span asp-validation-for="StatusZahtjeva" class="text-danger"></span>
                    </div>
                }

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save me-1"></i> Sačuvaj promjene
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Nazad
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
