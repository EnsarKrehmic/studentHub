@model StudentHub.Models.Zahtjev

@{
    ViewData["Title"] = "Izmjena zahtjeva";
}

<h2>@ViewData["Title"]</h2>

<h4>Zahtjev</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div class="form-group">
                <label asp-for="TipZahtjeva" class="control-label"></label>
                <select asp-for="TipZahtjeva" class="form-control" asp-items="Html.GetEnumSelectList<TipZahtjeva>()"></select>
                <span asp-validation-for="TipZahtjeva" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Napomena" class="control-label"></label>
                <textarea asp-for="Napomena" class="form-control"></textarea>
                <span asp-validation-for="Napomena" class="text-danger"></span>
            </div>
            @if (User.IsInRole("Studentska služba"))
            {
                <div class="form-group">
                    <label asp-for="StatusZahtjeva" class="control-label"></label>
                    <select asp-for="StatusZahtjeva" class="form-control" asp-items="Html.GetEnumSelectList<StatusZahtjeva>()"></select>
                    <span asp-validation-for="StatusZahtjeva" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <input type="submit" value="Spremi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Odustani</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
