@model IEnumerable<StudentHub.Models.Zahtjev>
@using StudentHub.Models
@{
    ViewData["Title"] = "Zahtjevi";
    Layout = "_Layout";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <h2 class="mb-0">
            <i class="fas fa-file-alt text-primary me-2"></i>@ViewData["Title"]
        </h2>
        @if (User.IsInRole("Student"))
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> Novi zahtjev
            </a>
        }
    </div>

    <!-- Filtriranje za službu -->
    @if (User.IsInRole("Studentska služba"))
    {
        <form method="get" class="card card-body shadow-sm mb-4">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Pretraga po imenu/prezimenu..."
                           value="@Context.Request.Query["searchString"]" />
                </div>
                <div class="col-md-4">
                    <select name="studijskiProgramId" class="form-select">
                        <option value="">Svi studijski programi</option>
                        @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                        {
                            <option value="@program.Value"
                                    selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">
                                @program.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i> Filtriraj
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-undo me-1"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    }

    <!-- Tabela zahtjeva -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Tip</th>
                        <th>Status</th>
                        <th>Podnesen</th>
                        <th>Rješen</th>
                        <th class="text-center">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div>@item.Student?.Ime @item.Student?.Prezime</div>
                                <small class="text-muted">(@item.Student?.BrojIndeksa)</small>
                            </td>
                            <td>@Html.DisplayFor(_ => item.TipZahtjeva)</td>
                            <td>
                                <span class="badge
                                        @(item.StatusZahtjeva == StatusZahtjeva.Podnešen ? "bg-warning" :
                                                                            item.StatusZahtjeva == StatusZahtjeva.Odbijen ? "bg-danger" :
                                                                            item.StatusZahtjeva == StatusZahtjeva.Prihvaćen ? "bg-success" :
                                                                            "bg-info")">
                                @Html.DisplayFor(_ => item.StatusZahtjeva)
                            </span>
                        </td>
                        <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (item.DatumRjesavanja.HasValue)
                                {
                                    <span class="text-success">@item.DatumRjesavanja.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Nije riješen</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Detalji">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Studentska služba") ||
                                                                    (User.IsInRole("Student") && item.StatusZahtjeva == StatusZahtjeva.Podnešen))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Izmijeni">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Obriši">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Navigacija -->
    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
        </a>
    </div>
</div>
