@model IEnumerable<StudentHub.Models.Zahtjev>

@{
    ViewData["Title"] = "Lista zahtjeva";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().tipZahtjeva)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().statusZahtjeva)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().datumPodnosenja)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().datumRjesavanja)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Student)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.tipZahtjeva)</td>
                <td>@Html.DisplayFor(modelItem => item.statusZahtjeva)</td>
                <td>@Html.DisplayFor(modelItem => item.datumPodnosenja)</td>
                <td>@Html.DisplayFor(modelItem => item.datumRjesavanja)</td>
                <td>@Html.DisplayFor(modelItem => item.Student.Id)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Detalji</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Izmjena</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Brisanje</a>
                </td>
            </tr>
        }
    </tbody>
</table>
