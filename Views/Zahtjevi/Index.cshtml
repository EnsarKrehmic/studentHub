@model IEnumerable<StudentHub.Models.Zahtjev>

@{
    ViewData["Title"] = "Lista zahtjeva";
}

<h2>@ViewData["Title"]</h2>

<p>
    @if (User.IsInRole("Student"))
    {
        <a asp-action="Create" class="btn btn-primary">Kreiraj novi zahtjev</a>
    }
</p>

<table class="table table-bordered table-hover mt-3">
    <thead>
        <tr>
            <th>Student</th>
            <th>Broj indeksa</th>
            <th>Tip zahtjeva</th>
            <th>Status zahtjeva</th>
            <th>Datum podnošenja</th>
            <th>Datum rješavanja</th>
            @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
            {
                <th>Akcije</th>
            }

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Student.Ime @item.Student.Prezime</td>
                <td>@item.Student.BrojIndeksa</td>
                <td>@Html.DisplayFor(modelItem => item.TipZahtjeva)</td>
                <td>@Html.DisplayFor(modelItem => item.StatusZahtjeva)</td>
                <td>@Html.DisplayFor(modelItem => item.DatumPodnosenja)</td>
                <td>@Html.DisplayFor(modelItem => item.DatumRjesavanja)</td>
                <td>
                    @if (User.IsInRole("Student") || User.IsInRole("Studentska služba"))
                    {
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalji</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Izmjena</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Brisanje</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Povratak na početnu stranicu</a>
</div>