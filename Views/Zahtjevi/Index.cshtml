@model IEnumerable<StudentHub.Models.Zahtjev>

@{
    ViewData["Title"] = "Zahtjevi";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

@if (User.IsInRole("Studentska služba"))
{
    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" name="searchString" class="form-control" placeholder="Pretraga po imenu/prezimenu studenta..." value="@Context.Request.Query["searchString"]">
            </div>
            <div class="col-md-4">
                <select name="studijskiProgramId" class="form-control">
                    <option value="">Svi studijski programi</option>
                    @foreach (var program in (SelectList)ViewBag.StudijskiProgrami)
                    {
                        <option value="@program.Value" selected="@(Context.Request.Query["studijskiProgramId"] == program.Value ? "selected" : null)">@program.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <button type="submit" class="btn btn-primary me-2">Filtriraj</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </div>
        </div>
    </form>
}

@if (User.IsInRole("Student"))
{
    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="fas fa-plus"></i> Kreiraj novi zahtjev
    </a>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Tip zahtjeva</th>
                <th>Status</th>
                <th>Datum podnošenja</th>
                <th>Datum rješavanja</th>
                <th class="text-center">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Student?.Ime @item.Student?.Prezime (@item.Student?.BrojIndeksa)</td>
                    <td>@Html.DisplayFor(modelItem => item.TipZahtjeva)</td>
                    <td>
                        <span class="badge @(item.StatusZahtjeva == StatusZahtjeva.Podnešen ? "bg-warning" : "bg-success")">
                            @Html.DisplayFor(modelItem => item.StatusZahtjeva)
                        </span>
                    </td>
                    <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (item.DatumRjesavanja.HasValue)
                        {
                            <span class="text-success">@item.DatumRjesavanja.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-danger">Nije riješen</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalji">
                            <i class="fas fa-eye"></i>
                        </a>
                        @if (User.IsInRole("Studentska služba") || (User.IsInRole("Student") && item.StatusZahtjeva == StatusZahtjeva.Podnešen))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Izmjena">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Brisanje">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Povratak na početnu stranicu
</a>
