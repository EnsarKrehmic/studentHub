@model IEnumerable<StudentHub.Models.Zahtjev>
@using StudentHub.Models

@{
    ViewData["Title"] = "Moji zahtjevi";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-file-alt text-primary me-2"></i>@ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Novi zahtjev
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            Trenutno nemate podnesenih zahtjeva.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tip zahtjeva</th>
                            <th>Status</th>
                            <th>Datum podnošenja</th>
                            <th>Datum rješavanja</th>
                            <th class="text-center">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(m => item.TipZahtjeva)</td>
                                <td>
                                    <span class="badge 
                                        @(item.StatusZahtjeva switch {
                                            StatusZahtjeva.Podnešen => "bg-warning text-dark",
                                            StatusZahtjeva.Primljen => "bg-primary",
                                            StatusZahtjeva.Odbijen => "bg-danger",
                                            StatusZahtjeva.Prihvaćen => "bg-success",
                                            _ => "bg-secondary"
                                        })">
                                        @Html.DisplayFor(m => item.StatusZahtjeva)
                                    </span>
                                </td>
                                <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (item.DatumRjesavanja.HasValue)
                                    {
                                        @item.DatumRjesavanja.Value.ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nije riješen</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary" title="Detalji">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.StatusZahtjeva == StatusZahtjeva.Podnešen)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning" title="Izmjena">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger" title="Brisanje">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Povratak na početnu
        </a>
    </div>
</div>
